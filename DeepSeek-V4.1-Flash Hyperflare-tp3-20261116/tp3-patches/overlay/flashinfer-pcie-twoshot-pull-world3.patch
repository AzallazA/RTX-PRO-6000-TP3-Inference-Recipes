+# BF16 two-shot all-reduce alternatives: "twoshot" is the upstream entry (push
+# reduce-scatter + push all-gather, two launches); "twoshot_pull" is the
+# single-launch pull transport of the same PCIeTwoShotBF16 runtime.
+TWOSHOT_PULL = "twoshot_pull"
+TWOSHOT_ALTERNATIVES = ("twoshot", TWOSHOT_PULL)
+
+
+def twoshot_pull_enabled() -> bool:
+    """Race the BF16 two-shot pull transport beside the upstream push entry.
+
+    TP3 patch (ds41-tp3, 2026-11-15). Upstream declares the two-shot
+    alternative without a transport, so ``_twoshot_preparation`` defaults it
+    to ``push`` and the pull kernel (``_TwoShotPullAllReduceLaunch``) is never
+    raced. On the Threadripper PRO 7965WX host (three GPUs on separate root
+    ports, SM-issued peer reads ~40 GB/s, posted peer writes much slower) a
+    world-3 microbench measured two-shot pull at 443 vs 505 us (one-shot pull)
+    for 1,024 x 5,120 BF16 rows and 256 vs 381 us at 768 rows (2026-11-13).
+    ``B12X_PCIE_TWOSHOT_PULL``: ``0`` (default, upstream candidate set and
+    selection keys) or ``1`` (add a ``twoshot_pull`` alternative with the
+    same thread/block sweep as ``twoshot``). Turning it on changes the query
+    of every staged plain BF16 all-reduce that admits two-shot, so exactly
+    those collective races re-measure; no other selection key moves.
+    """
+    mode = os.environ.get("B12X_PCIE_TWOSHOT_PULL", "0").strip().lower()
+    if mode in ("", "0", "off", "false", "no"):
+        return False
+    if mode in ("1", "on", "true", "yes"):
+        return True
+    raise ValueError("B12X_PCIE_TWOSHOT_PULL must be 0 or 1")
+
 
