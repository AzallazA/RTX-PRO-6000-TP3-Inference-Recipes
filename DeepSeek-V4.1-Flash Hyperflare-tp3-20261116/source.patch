+/// Tail merge settings with and without tools and with and without a reasoning generation prompt:
+/// off, on (the fork keeps thinking requests without tools unmerged), and the fork's tools-only
+/// rule (merges only the request with tools).
+const MERGE_CASES: [(PrefillTailMerge, bool, bool); 6] = [
+    (PrefillTailMerge::Off, false, false),
+    (PrefillTailMerge::On, false, false),
+    (PrefillTailMerge::On, false, true),
+    (PrefillTailMerge::On, true, true),
+    (PrefillTailMerge::ToolsOnly, false, false),
+    (PrefillTailMerge::ToolsOnly, true, false),
+];
+
+#[test]
+fn all_selected_message_boundaries_are_offered() {
+    for (mode, tools, reasoning) in MERGE_CASES {
+        let mut s = scheduler_with_concurrency(16, false, 64, 1);
+        s.configure_policy(PolicyConfig { prefill_tail_merge: mode, ..PolicyConfig::default() })
+            .unwrap();
+        s.enable_publications();
+        let mut request = spec(None, 130, 3);
+        request.message_boundaries = vec![127, 129];
+        request.tools = tools;
+        request.reasoning_prompt = reasoning;
+        let h = s.admit(request).unwrap();
+        finish(&mut s, h);
+        // With the tail merge (PR #69) the whole 130-token prompt is one chunk, so no
+        // message checkpoint is captured and PR #227 has nothing to offer.
+        let expected: &[u64] = if mode.applies(tools, reasoning) { &[130] } else { &[127, 129, 130] };
+        assert_eq!(
+            s.take_publications()
+                .iter()
+                .map(|p| p.key.consumed_tokens)
+                .collect::<Vec<_>>(),
+            expected,
+            "{mode:?} tools={tools} reasoning={reasoning}"
+        );
+    }
+}
