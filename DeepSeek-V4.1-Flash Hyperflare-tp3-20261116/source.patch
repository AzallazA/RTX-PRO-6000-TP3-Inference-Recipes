+@pytest.mark.parametrize("local", [768, 704])
+@pytest.mark.parametrize("encoding", ENCODINGS)
+def test_a16_compact_pad_columns_are_lifted_clamped_row_bases(encoding, local):
+    """The shared-scratch decoder at A16 fills padded K groups with lifted row bases clamped to 240."""
+    from b12x.moe._shared.kernels.w4a16.prepare import _nvfp4_compute_scale_factor, _process_nvfp4_packed_scales
+
+    from tests.recipes.glm53_a16_layout import a16_packed_scales
+
+    # Positive E4M3 scales only, as a checkpoint holds: [256 hidden rows, 128 K groups]; rank 2 of 3 keeps
+    # groups 96..127 plus 16 pads. Row 7's base is the E4M3 maximum (448) to exercise the 240 clamp.
+    torch.manual_seed(3)
+    bases = torch.randint(64, 100, (256,), dtype=torch.int16)
+    scales = (bases[:, None] + torch.randint(0, 16, (256, 128), dtype=torch.int16)).to(torch.uint8)
+    scales[7] = 126
+    planes = encode(encoding, scales)
+    assert torch.equal(decode(encoding, planes, 256, 128), scales)
+    bases = row_bases(encoding, planes)
+    assert int(bases[7]) == 126
+    groups, first = local // 16, 2 * local // 16  # rank 2 of 3 starts at column 2 x local
+    covered = 128 - first
+    logical = expand_csf_scales_padded(scales, bases, row_range=(0, 256), column_range=(first, 128),
+                                       padded_columns=groups, compact=True)[None]
+    grid = a16_packed_scales(logical, torch.ones(1), size_k=local, size_n=256, io_dtype=torch.bfloat16,
+                             pad_groups=(covered, groups)).view(torch.uint8)[0]
+    assert grid.shape == (groups, 256)
+    factor = _nvfp4_compute_scale_factor(logical.view(torch.float8_e4m3fn), torch.bfloat16)
+    alphabet = torch.arange(256, dtype=torch.uint8).view(torch.float8_e4m3fn)[:, None].expand(256, 4).contiguous()
+    table = _process_nvfp4_packed_scales(alphabet.to(torch.bfloat16), scale_factor=factor).view(torch.uint8)[:, 0]
+    lifted_bases = table[bases.long()].clamp_max(240)
+    for row in range(covered, groups):
+        assert sorted(grid[row].tolist()) == sorted(lifted_bases.tolist())  # permuted along N, values intact
+    assert int(table[126]) > 240 and int(lifted_bases[7]) == 240
+    assert not grid[covered:, :].eq(0).any()
+    plain = a16_packed_scales(logical, torch.ones(1), size_k=local, size_n=256, io_dtype=torch.bfloat16).view(torch.uint8)[0]
+    assert torch.equal(plain[:covered], grid[:covered]) and (plain[covered:] != grid[covered:]).sum() == groups - covered
diff --git a/tests/recipes/test_glm53_dcp3_collectives_cuda.py b/tests/recipes/test_glm53_dcp3_collectives_cuda.py
new file mode 100644
index 00000000..06bf76d8
--- /dev/null
+++ b/tests/recipes/test_glm53_dcp3_collectives_cuda.py
@@ -0,0 +1,219 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 Flare community contributors
+# SPDX-License-Identifier: Apache-2.0
+
+"""GLM DCP3 decode exchanges on three GPUs through the production wrappers, against torch references, with timing.
+
+Per MLA layer and decode pass, DCP3 runs three b12x PCIe collectives (glm53/mla.py, indexer.py): the query-head
+all-gather (24 x 512 BF16 per rank -> 72 heads), the LSE reduce-scatter of 72-head partial attention back to each
+rank's 24 heads, and the candidate all-gather (2048 BF16 lanes of 512 FP32 (score, pool) pairs per rank -> 6144).
+b12x serves world 3 through its generic modulo path (tp3-patches/flashinfer-dcp-a2a-world3.patch); vLLM's DCP3 used
+it at up to 8 rows only, so rows 1..48 (c8 verification at five drafts) are checked here, including rows and heads
+whose LSE is -inf on some or every rank. Gathers must be bit-exact; the combine is checked against b12x's own
+reference and an independent FP32 one. Each exchange is then captured in a CUDA graph of 11 calls (GLM's MLA
+layers) and timed; FLARE_DCP3_TIMING=<path> writes the per-call microseconds as JSON (rank 0).
+
+    CUDA_VISIBLE_DEVICES=0,1,2 FLARE_RUN_CUDA_TESTS=1 pytest -s tests/recipes/test_glm53_dcp3_collectives_cuda.py
+"""
+
+import json
+import os
+from datetime import timedelta
+
+import pytest
+import torch
+import torch.distributed as dist
+import torch.multiprocessing as mp
+
+pytestmark = pytest.mark.skipif(os.environ.get("FLARE_RUN_CUDA_TESTS") != "1",
+                                reason="requires WORLD assigned GPUs and FLARE_RUN_CUDA_TESTS=1")
+
+# FLARE_DCP_TEST_WORLD=2 runs the same exchanges at DCP2 (TP2: 64 heads, 32 per rank, no padded heads) to time the
+# world-2 gather (upstream TP2 push, or the overlay's pull with B12X_PCIE_DCP_GATHER_PULL=1). Default 3 (DCP3).
+WORLD = int(os.environ.get("FLARE_DCP_TEST_WORLD", "3"))
+if WORLD not in (2, 3):
+    raise ValueError("FLARE_DCP_TEST_WORLD must be 2 or 3")
+HEADS, DIM, LAYERS = (72 if WORLD == 3 else 64), 512, 11
+HEAD_ROWS = (1, 2, 3, 4, 5, 6, 7, 8, 9, 12, 16, 24, 32, 47, 48)
+CANDIDATE_ROWS = (1, 6, 8, 9, 48, 100, 256, 511, 512)
+
+
+def _inputs(rows, source, seed):
+    """Rank `source`'s partial attention and LSE, reproducible on every rank."""
+    generator = torch.Generator().manual_seed(seed * 1000 + rows * 10 + source)
+    partial = (torch.randn((rows, HEADS, DIM), generator=generator) * 2).to(torch.bfloat16)
+    lse = torch.randn((rows, HEADS), generator=generator) * 4
+    # -inf patterns: row 0 attends only on rank 0 (short context, empty shards), row 1 on no rank (inactive),
+    # row 2 on every rank but 0, one head per row only on the last rank, and the padded heads 64..71.
+    if source > 0:
+        lse[0] = -float("inf")
+    if rows > 1:
+        lse[1] = -float("inf")
+    if rows > 2 and source == 0:
+        lse[2] = -float("inf")
+    if source < WORLD - 1:
+        lse[:, 7] = -float("inf")
+    # Ranks with nothing to attend write zero output; large values elsewhere check that -inf weights stay zero.
+    partial[torch.isinf(lse)] = 0
+    partial[:, 64:] = 0
+    return partial, lse
+
+
+def _reference(partials, lses, rank):
+    """Independent FP32 combine of this rank's head shard."""
+    local = HEADS // WORLD
+    shard = slice(rank * local, (rank + 1) * local)
+    lse = torch.stack([value[:, shard] for value in lses])
+    largest = lse.max(0).values
+    base = torch.where(torch.isfinite(largest), largest, torch.zeros_like(largest))
+    weights = torch.exp(lse - base)
+    total = weights.sum(0)
+    combined = sum(w[..., None] * p[:, shard].float() for w, p in zip(weights, partials))
+    return torch.where(total[..., None] > 0, combined / total.clamp_min(1e-30)[..., None], torch.zeros_like(combined))
+
+
+def _time(call, device, iterations=30):
+    """Microseconds per call of `call` captured LAYERS times in one CUDA graph, replayed in lockstep."""
+    stream = torch.cuda.Stream(device=device)
+    stream.wait_stream(torch.cuda.current_stream(device))
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph, stream=stream):
+        for _ in range(LAYERS):
+            call()
+    torch.cuda.synchronize(device)
+    for _ in range(3):
+        dist.barrier()
+        graph.replay()
+        torch.cuda.synchronize(device)
+    dist.barrier()
+    start, end = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+    start.record()
+    for _ in range(iterations):
+        graph.replay()
+    end.record()
+    torch.cuda.synchronize(device)
+    graph.reset()
+    return start.elapsed_time(end) * 1e3 / (iterations * LAYERS)
+
+
+def _rank(rank, rendezvous, timing_path):
+    from b12x.comm.pcie.pcie_dcp_a2a import lse_reduce_scatter_reference
+
+    from ignition.components.collectives import PreparedAllGather, PreparedLseReduceScatter
+    from ignition.preparation.collectives import (CollectivePreparation, create_all_gather_runtime,
+                                                  create_head_exchange)
+    from ignition.preparation.tuning import RecordedPreparationSession
+
+    torch.cuda.set_device(rank)
+    device = torch.device("cuda", rank)
+    dist.init_process_group("gloo", init_method=rendezvous, rank=rank, world_size=WORLD,
+                            timeout=timedelta(minutes=5))
+    group = dist.group.WORLD
+    coordinator = CollectivePreparation(group)
+    local = HEADS // WORLD
+    rows_max = max(HEAD_ROWS)
+    # As bootstrap.py sizes them for eight slots at five drafts (48 rows) and 512-row candidate slices.
+    heads = create_head_exchange(group, device, max_rows=rows_max, heads=HEADS, head_dim=DIM)
+    candidates = create_all_gather_runtime(group, device, max_rows=max(CANDIDATE_ROWS), columns=2048 * WORLD)
+    query = torch.zeros((rows_max, local * DIM), dtype=torch.bfloat16, device=device)
+    gathered = torch.zeros((rows_max, HEADS * DIM), dtype=torch.bfloat16, device=device)
+    partial = torch.zeros((rows_max, HEADS, DIM), dtype=torch.bfloat16, device=device)
+    lse = torch.zeros((rows_max, HEADS), dtype=torch.float32, device=device)
+    attended = torch.zeros((rows_max, local, DIM), dtype=torch.bfloat16, device=device)
+    packed = torch.zeros((max(CANDIDATE_ROWS), 512, 2), dtype=torch.float32, device=device)
+    merged = torch.zeros((max(CANDIDATE_ROWS), WORLD * 512, 2), dtype=torch.float32, device=device)
+    timings = {"head_gather": {}, "lse_reduce_scatter": {}, "candidate_gather": {}}
+    try:
+        with RecordedPreparationSession(device=device, checkpoint="glm-dcp3-collectives",
+                workload_schema="glm-dcp3-collectives-v1", numerical_policy="default",
+                coordinator=coordinator) as session:
+            gathers = {rows: PreparedAllGather(query[:rows], gathered[:rows], runtime=heads, session=session,
+                                               coordinator=coordinator, name=f"heads{rows}") for rows in HEAD_ROWS}
+            combines = {rows: PreparedLseReduceScatter(partial[:rows], lse[:rows], attended[:rows], runtime=heads,
+                                                       session=session, coordinator=coordinator,
+                                                       name=f"combine{rows}") for rows in HEAD_ROWS}
+            # The indexer gathers FP32 pairs as BF16 lanes (indexer.py).
+            selections = {rows: PreparedAllGather(packed[:rows].view(torch.bfloat16).view(rows, 2048),
+                                                  merged[:rows].view(torch.bfloat16).view(rows, 2048 * WORLD),
+                                                  runtime=candidates, session=session, coordinator=coordinator,
+                                                  name=f"candidates{rows}") for rows in CANDIDATE_ROWS}
+            session.tune()
+            failures = []
+            for rows in HEAD_ROWS:
+                # Query heads: rank r's 24 heads land at columns [r * 24 * 512, (r + 1) * 24 * 512) on every rank.
+                sources = [torch.randint(-2**15, 2**15 - 1, (rows, local * DIM), dtype=torch.int16,
+                                         generator=torch.Generator().manual_seed(rows * 10 + r)) for r in range(WORLD)]
+                query[:rows].view(torch.int16).copy_(sources[rank])
+                gathered.zero_()
+                dist.barrier()
+                gathers[rows](query[:rows])
+                torch.cuda.synchronize(device)
+                if not torch.equal(gathered[:rows].view(torch.int16).cpu(), torch.cat(sources, dim=1)):
+                    failures.append(f"head gather rows {rows}")
+                # LSE reduce-scatter.
+                inputs = [_inputs(rows, source, 1) for source in range(WORLD)]
+                partial[:rows].copy_(inputs[rank][0])
+                lse[:rows].copy_(inputs[rank][1])
+                attended.fill_(7)
+                dist.barrier()
+                combines[rows](partial[:rows], lse[:rows])
+                torch.cuda.synchronize(device)
+                got = attended[:rows].float().cpu()
+                b12x = lse_reduce_scatter_reference(torch.stack([p for p, _ in inputs]),
+                                                    torch.stack([l for _, l in inputs]), rank).float()
+                mine = _reference([p for p, _ in inputs], [l for _, l in inputs], rank)
+                if not torch.isfinite(got).all():
+                    failures.append(f"lse rows {rows}: non-finite output")
+                for name, want in (("b12x reference", b12x), ("fp32 reference", mine)):
+                    try:
+                        torch.testing.assert_close(got, want, rtol=1e-2, atol=2e-2)
+                    except AssertionError as error:
+                        failures.append(f"lse rows {rows} vs {name}: {str(error).splitlines()[0:4]}")
+                if rows > 1 and got[1].count_nonzero():
+                    failures.append(f"lse rows {rows}: a row no rank attended is not zero")
+                if HEADS > 64 and rank == WORLD - 1 and got[:, 64 - (WORLD - 1) * local:].count_nonzero():
+                    failures.append(f"lse rows {rows}: padded heads are not zero")
+            for rows in CANDIDATE_ROWS:
+                sources = [torch.randint(-2**15, 2**15 - 1, (rows, 2048), dtype=torch.int16,
+                                         generator=torch.Generator().manual_seed(7000 + rows * 10 + r))
+                           for r in range(WORLD)]
+                packed[:rows].view(torch.int16).view(rows, 2048).copy_(sources[rank])
+                merged.zero_()
+                dist.barrier()
+                selections[rows](packed[:rows].view(torch.bfloat16).view(rows, 2048))
+                torch.cuda.synchronize(device)
+                if not torch.equal(merged[:rows].view(torch.int16).view(rows, -1).cpu(), torch.cat(sources, dim=1)):
+                    failures.append(f"candidate gather rows {rows}")
+            outcome = [None] * WORLD
+            dist.all_gather_object(outcome, failures, group=group)
+            assert not any(outcome), outcome
+            # Timing, after correctness: the same prepared operations inside CUDA graphs.
+            with session.capture():
+                for rows in HEAD_ROWS:
+                    timings["head_gather"][rows] = _time(lambda: gathers[rows](query[:rows]), device)
+                    timings["lse_reduce_scatter"][rows] = _time(lambda: combines[rows](partial[:rows], lse[:rows]),
+                                                                device)
+                for rows in CANDIDATE_ROWS:
+                    view = packed[:rows].view(torch.bfloat16).view(rows, 2048)
+                    timings["candidate_gather"][rows] = _time(lambda: selections[rows](view), device)
+            session.freeze()
+        if rank == 0:
+            print(f"\nDCP{WORLD} exchanges, us per call (CUDA graph of {LAYERS} calls):")
+            for name, table in timings.items():
+                print(f"  {name:20s} " + "  ".join(f"{rows}:{value:.1f}" for rows, value in table.items()))
+            for label, rows in (("c1 verify", 6), ("c8 verify", 48)):
+                total = sum(timings[name][rows] for name in ("head_gather", "lse_reduce_scatter")) + \
+                    timings["candidate_gather"][rows if rows in CANDIDATE_ROWS else 8]
+                print(f"  {label} ({rows} rows): {total:.1f} us per MLA layer (all three exchanges, none hidden)")
+            if timing_path:
+                with open(timing_path, "w") as handle:
+                    json.dump(timings, handle, indent=1)
+    finally:
+        heads.close()
+        candidates.close()
+        dist.destroy_process_group()
+
+
+def test_dcp3_head_gather_lse_reduce_scatter_and_candidate_gather(tmp_path):
+    assert os.environ.get("CUDA_VISIBLE_DEVICES") and torch.cuda.device_count() >= WORLD
+    mp.spawn(_rank, args=((tmp_path / "rendezvous").as_uri(), os.environ.get("FLARE_DCP3_TIMING", "")),
+             nprocs=WORLD, join=True)
diff --git a/tests/recipes/test_glm53_dcp3_interpret.py b/tests/recipes/test_glm53_dcp3_interpret.py
new file mode 100644
index 00000000..cb5fe8f8
--- /dev/null
+++ b/tests/recipes/test_glm53_dcp3_interpret.py
@@ -0,0 +1,355 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 Flare community contributors
+# SPDX-License-Identifier: Apache-2.0
+
+"""GLM decode context parallelism over two, three and four ranks: the dcp.py kernels on Triton's CPU interpreter.
+
+The CUDA tests (`test_glm53_dcp_cuda.py`, `test_glm53_dcp_records_cuda.py`) check the same kernels on a GPU at
+two and four ranks. Three ranks (DCP3) gather 3 x 512 candidates, which Triton cannot sort directly (arange and
+sort lengths are powers of two), so the merge sorts 2048 keys with the last 512 masked as missing. These cases
+run the actual kernels under `TRITON_INTERPRET=1` (chosen when the kernels are decorated, hence one subprocess
+per case) against brute-force references: candidate pack and merge (full, ragged, tied, empty shards and empty
+rows), merge plus local expansion (positions below 4 * W leave some ranks empty), prefill expansion to global
+positions, the CUDA IPC context pull and the windowed pack/scatter path at 768-token pages, and the
+log-sum-exp combine of partial attention with ranks whose LSE is -inf (the RoCE head exchange's Triton merge;
+the PCIe path's b12x reduce-scatter is GPU-only, tp3-tools/glm-dcp3-gpu.sh stage 2).
+"""
+
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+import torch
+
+CASES = ("placement", "merge", "merge_expand_local", "expand_tokens", "records", "lse_combine")
+ROOT = Path(__file__).resolve().parents[2]
+
+
+@pytest.mark.parametrize("world", [2, 3, 4])
+@pytest.mark.parametrize("case", CASES)
+def test_dcp_kernels_with_cpu_interpreter(case, world):
+    env = dict(os.environ, TRITON_INTERPRET="1", CUDA_VISIBLE_DEVICES="",
+               PYTHONPATH=os.pathsep.join(filter(None, (str(ROOT), os.environ.get("PYTHONPATH")))))
+    result = subprocess.run([sys.executable, str(Path(__file__).resolve()), case, str(world)],
+                            env=env, text=True, capture_output=True, timeout=900)
+    assert result.returncode == 0, result.stdout[-4000:] + result.stderr[-4000:]
+
+
+def test_three_rank_shards_and_pages():
+    from ignition.recipes.glm53.dcp import ContextShards
+
+    for world in (1, 2, 3, 4):
+        assert ContextShards.on(world - 1, world, "cpu").page_tokens == 256 * world
+    with pytest.raises(ValueError, match="1, 2, 3 or 4 ranks"):
+        ContextShards.on(0, 5, "cpu")
+    with pytest.raises(ValueError):
+        ContextShards(3, 3)
+    # 2^20 is not a whole number of 768-token pages: 1366 pages, the last holding 256 positions.
+    assert -(-1048576 // 768) == 1366 and 1366 * 768 - 1048576 == 512
+
+
+# Fill for outputs the kernels must overwrite whole (the compiled forward allocates them unfilled).
+POISON = 0x7F7F7F7F
+
+
+def owner_local(t, world):
+    return (t // 4) % world, (t // (4 * world)) * 4 + t % 4
+
+
+def _placement(world, device):
+    from ignition.recipes.glm53.dcp import ContextShards
+
+    for rank in range(world):
+        shards = ContextShards.on(rank, world, device)
+        blocks = 24
+        table = torch.randperm(4096)[:blocks].int().to(device)
+        positions = torch.randint(-1, blocks * 256 * world, (3000,), device=device)
+        positions[:16] = torch.arange(-1, 15)
+        slots = shards.token_slots(positions, table.expand(positions.numel(), -1))
+        for p, s in zip(positions.tolist(), slots.tolist()):
+            o, l = owner_local(p, world)
+            want = -1 if p < 0 or o != rank else int(table[l // 256]) * 256 + l % 256
+            assert s == want, (world, rank, p, s, want)
+        lengths = torch.arange(0, 3000, device=device)
+        brute = torch.tensor([sum(1 for t in range(n) if owner_local(t, world)[0] == rank) for n in range(3000)])
+        assert torch.equal(shards.local_tokens(lengths).cpu(), brute), "local_tokens"
+        pools = torch.arange(0, 700, device=device)
+        brute = torch.tensor([sum(1 for q in range(n) if q % world == rank) for n in range(700)])
+        assert torch.equal(shards.local_pools(pools).cpu(), brute), "local_pools"
+        # Every record a page addresses is one rank's: page p of a request covers positions [p * 256W, (p+1) * 256W).
+        page = 256 * world
+        for t in (0, page - 1, page, 3 * page + 5):
+            assert owner_local(t, world)[1] // 256 == t // page
+
+
+def _candidates(world, rows, device, generator):
+    """Each rank's local top pools and scores, with full, ragged, tied, short, empty-shard and empty rows."""
+    local_ids = [torch.full((rows, 512), -1, dtype=torch.int32) for _ in range(world)]
+    scores = [torch.full((rows, 512), -float("inf")) for _ in range(world)]
+    for rank in range(world):
+        count = torch.randint(0, 513, (rows,), generator=generator).tolist()
+        count[0] = 3 + rank                      # short context: fewer than 512 between the ranks
+        count[1] = 512                           # every rank full
+        count[2] = 0                             # an empty row
+        count[3] = 0 if rank else 100            # empty shards on every rank but the first
+        count[4] = 37 if rank == world - 1 else 0  # only the last rank has candidates
+        for r, c in enumerate(count):
+            local_ids[rank][r, :c] = torch.randperm(5000, generator=generator)[:c].int()
+            # Coarse scores tie often; ties prefer the lower global pool id.
+            scores[rank][r, :c] = torch.randint(0, 50, (c,), generator=generator).float() / 7
+    return [t.to(device) for t in local_ids], [t.to(device) for t in scores]
+
+
+def _brute_top(local_ids, scores, world, r):
+    candidates = []
+    for rank in range(world):
+        for l, s in zip(local_ids[rank][r].tolist(), scores[rank][r].tolist()):
+            if l >= 0:
+                candidates.append((-s, l * world + rank))
+    candidates.sort()
+    return [g for _, g in candidates[:512]]
+
+
+def _merge(world, device):
+    from ignition.recipes.glm53.dcp import ContextShards, merge_candidates, pack_candidates
+
+    generator = torch.Generator().manual_seed(world)
+    rows = 9
+    local_ids, scores = _candidates(world, rows, device, generator)
+    packed = []
+    for rank in range(world):
+        out = torch.full((rows, 512, 2), 7.0, device=device)
+        pack_candidates(local_ids[rank], scores[rank], out, ContextShards.on(rank, world, device))
+        # Each rank's list is in descending key order, missing entries (-inf, -1) at the back.
+        for r in range(rows):
+            present = int((local_ids[rank][r] >= 0).sum())
+            ids = out[r, :, 1].tolist()
+            assert all(i >= 0 for i in ids[:present]) and all(i == -1 for i in ids[present:]), ("pack", rank, r)
+            assert out[r, present:, 0].eq(-float("inf")).all()
+            keys = [(-s, i) for s, i in zip(out[r, :present, 0].tolist(), ids[:present])]
+            assert keys == sorted(keys), ("pack order", rank, r)
+        packed.append(out)
+    gathered = torch.cat(packed, dim=1).contiguous()
+    merged = torch.full((rows, 512), 99, dtype=torch.int32, device=device)
+    merge_candidates(gathered, merged)
+    for r in range(rows):
+        want = _brute_top(local_ids, scores, world, r)
+        got = merged[r].tolist()
+        # Expansion reads the first min(pools, 512) entries, so the selected pools lead in any order.
+        assert sorted(got[:len(want)]) == sorted(want) and all(v == -1 for v in got[len(want):]), ("merge", world, r)
+
+
+def _merge_expand_local(world, device):
+    from ignition.recipes.glm53.dcp import ContextShards, merge_expand_local
+
+    generator = torch.Generator().manual_seed(10 + world)
+    # The interpreter sorts 2048 keys slowly: few rows, and four ranks (also covered on the GPU) one placement.
+    seqs, blocks, rows = 3, 12, 8
+    tables = torch.stack([torch.randperm(1000, generator=generator)[:blocks] for _ in range(seqs)]).int().to(device)
+    requests = torch.randint(0, seqs, (rows,), dtype=torch.int32, generator=generator).to(device)
+    positions = torch.randint(-1, blocks * 256 * world - 1, (rows,), generator=generator)
+    # Inactive, below one group per rank (some ranks own nothing), short and long contexts.
+    positions[:7] = torch.tensor([-1, 0, 3, 4 * world - 2, 4 * world - 1, 32, 1001])
+    positions = positions.to(device)
+    pools = torch.full((rows, 512), -1, dtype=torch.int32)
+    for r in range(rows):
+        complete = (int(positions[r]) + 1) // 4
+        take = min(complete, 512)
+        if take:
+            pools[r, :take] = torch.randperm(complete, generator=generator)[:take].int()
+    for split in (True,) if world == 4 else (False, True):
+        candidates = torch.zeros((rows, world * 512, 2), dtype=torch.float32)
+        candidates[:, :, 0] = -float("inf")
+        candidates[:, :, 1] = -1
+        for r in range(rows):
+            listed = [0] * world
+            for i, pool in enumerate(pools[r].tolist()):
+                if pool >= 0:
+                    owner = pool % world if split else 0
+                    candidates[r, owner * 512 + listed[owner]] = torch.tensor([1000.0 - i, pool])
+                    listed[owner] += 1
+        candidates = candidates.to(device)
+        for rank in range(world):
+            shards = ContextShards.on(rank, world, device)
+            # Poisoned outputs: the compiled forward hands these kernels unfilled scratch, so every row is checked
+            # whole, inactive rows (position -1) included.
+            output = torch.full((rows, 2051), POISON, dtype=torch.int32, device=device)
+            counts = torch.full((rows,), POISON, dtype=torch.int32, device=device)
+            merged = torch.full((rows, 512), POISON, dtype=torch.int32, device=device)
+            merge_expand_local(candidates, merged, positions, requests, tables, output, counts, shards)
+            for r in range(rows):
+                take = int((pools[r] >= 0).sum())
+                selected = merged[r].tolist()
+                assert sorted(selected[:take]) == sorted(pools[r, :take].tolist()), ("merge", world, rank, split, r)
+                assert all(v == -1 for v in selected[take:]), ("merge tail", world, rank, split, r)
+                length = int(positions[r]) + 1
+                complete = length // 4
+                tokens = [pool * 4 + k for pool in selected[:take] for k in range(4)]
+                tokens += list(range(complete * 4, length))
+                want = []
+                for t in tokens:
+                    o, l = owner_local(t, world)
+                    if o == rank:
+                        want.append(int(tables[int(requests[r]), l // 256]) * 256 + l % 256)
+                assert counts[r].item() == len(want), ("count", world, rank, split, r, counts[r].item(), len(want))
+                got = output[r].tolist()
+                assert got[:len(want)] == want and all(v == -1 for v in got[len(want):]), \
+                    ("expand", world, rank, split, r)
+                if length <= 4 * rank:
+                    assert len(want) == 0, ("empty shard", world, rank, r)
+
+
+def _expand_tokens(world, device):
+    from ignition.recipes.glm53.dcp import ContextShards, expand_tokens, merge_candidates, pack_candidates
+
+    # Prefill: every rank merges the same global pools and expands them to global positions.
+    generator = torch.Generator().manual_seed(20 + world)
+    rows = 9
+    local_ids, scores = _candidates(world, rows, device, generator)
+    positions = torch.randint(5000 * 4 * world, 6000 * 4 * world, (rows,), generator=generator)
+    positions[0] = 4 * world + 2
+    positions = positions.to(device)
+    # Pool ids must lie below each row's complete pools.
+    for rank in range(world):
+        complete = (positions.cpu() + 1) // 4
+        for r in range(rows):
+            ids = local_ids[rank][r]
+            live = ids >= 0
+            ids[live & (ids * world + rank >= complete[r])] = -1
+    packed = []
+    for rank in range(world):
+        out = torch.full((rows, 512, 2), 7.0, device=device)
+        pack_candidates(local_ids[rank], scores[rank], out, ContextShards.on(rank, world, device))
+        packed.append(out)
+    gathered = torch.cat(packed, dim=1).contiguous()
+    merged = torch.full((rows, 512), POISON, dtype=torch.int32, device=device)
+    merge_candidates(gathered, merged)
+    output = torch.full((rows, 2051), POISON, dtype=torch.int32, device=device)
+    counts = torch.full((rows,), POISON, dtype=torch.int32, device=device)
+    expand_tokens(merged, positions, output, counts)
+    for r in range(rows):
+        want_pools = _brute_top(local_ids, scores, world, r)
+        length = int(positions[r]) + 1
+        complete = length // 4
+        selected = min(complete, 512)
+        got = output[r].tolist()
+        count = int(counts[r])
+        history = sorted(t for t in got[:count] if t < complete * 4)
+        expected = sorted(pool * 4 + k for pool in want_pools for k in range(4))
+        # Expansion reads min(complete, 512) entries and skips missing ones, so it covers the present pools.
+        assert selected >= len(want_pools) and history == expected, ("history", world, r)
+        assert sorted(t for t in got[:count] if t >= complete * 4) == list(range(complete * 4, length))
+        assert all(v == -1 for v in got[count:])
+
+
+def _records(world, device):
+    from ignition.recipes.glm53.dcp import (ContextShards, pack_records, pull_context, scatter_records,
+                                            window_counts)
+
+    pages, columns, window = 6, 4, 192
+    positions = columns * 256 * world
+    table = torch.tensor([3, 0, 5, 1], dtype=torch.int32, device=device)
+    generator = torch.Generator().manual_seed(30 + world)
+    caches = [torch.randint(-2**31, 2**31 - 1, (pages * 256, 132), dtype=torch.int32, generator=generator).to(device)
+              for _ in range(world)]
+    page = 256 * world
+    for end in sorted({1, 3, 4, 5, 4 * world - 1, 4 * world, 4 * world + 1, 37, 1000, page - 1, page, page + 1,
+                       2 * page + 255, positions - 1, positions}):
+        final = torch.tensor([end], dtype=torch.int64, device=device)
+        # Brute force: every position below `end` read from its owner's cache through the page table.
+        brute = torch.zeros(positions, 132, dtype=torch.int32)
+        for t in range(end):
+            o, l = owner_local(t, world)
+            brute[t] = caches[o][int(table[l // 256]) * 256 + l % 256].cpu()
+        expected = torch.zeros(positions, 132, dtype=torch.int32, device=device)
+        addresses = torch.tensor([cache.data_ptr() for cache in caches], dtype=torch.int64, device=device)
+        pull_context(addresses, table, final, expected, ContextShards.on(0, world, device))
+        assert torch.equal(expected.cpu(), brute), ("pull", world, end)
+        slab = torch.zeros_like(expected)
+        total = 0
+        for first in range(0, columns * 256, window):
+            counts = window_counts(final, world, first, window)
+            total += int(counts.sum())
+            gathered = torch.full((world, window * 528), 255, dtype=torch.uint8, device=device)
+            for rank in range(world):
+                records = torch.full((world, window * 528), 255, dtype=torch.uint8, device=device)
+                pack_records(caches[rank], table, final, records, ContextShards.on(rank, world, device), first)
+                gathered[rank, :int(counts[rank])] = records[rank, :int(counts[rank])]
+            scatter_records(gathered.view(torch.bfloat16), final, slab, ContextShards.on(world - 1, world, device),
+                            first)
+        assert total == end * 528, ("window bytes", world, end)
+        assert torch.equal(slab.cpu(), brute), ("scatter", world, end)
+
+
+def lse_reference(partials, lses):
+    """Combine per-rank partial attention [W][rows, H, D] with natural-log LSEs [W][rows, H] in FP32.
+
+    Ranks whose LSE is -inf contribute nothing; a head no rank attended combines to zero.
+    """
+    lse = torch.stack([l.float() for l in lses])
+    largest = lse.max(0).values
+    base = torch.where(torch.isfinite(largest), largest, torch.zeros_like(largest))
+    weights = torch.exp(lse - base)
+    total = weights.sum(0)
+    combined = sum(w[..., None] * p.float() for w, p in zip(weights, partials))
+    return torch.where(total[..., None] > 0, combined / total.clamp_min(1e-30)[..., None],
+                       torch.zeros_like(combined))
+
+
+def _lse_combine(world, device):
+    from ignition.components.head_exchange import merge, pack, pack_width
+
+    # Three ranks exchange 72 heads (24 per rank, rank 2's last 8 zero heads); two and four ranks 64.
+    heads = 72 if world == 3 else 64
+    local, dim, rows = heads // world, 512, 6
+    generator = torch.Generator().manual_seed(40 + world)
+    partials, lses = [], []
+    for rank in range(world):
+        partials.append((torch.randn((rows, heads, dim), generator=generator) * 2).to(torch.bfloat16))
+        lse = torch.randn((rows, heads), generator=generator) * 3
+        # Empty shards: row 1 has no records on ranks above 0, row 2 none on rank 0, row 3 none anywhere.
+        if rank > 0:
+            lse[1] = -float("inf")
+        if rank == 0:
+            lse[2] = -float("inf")
+        lse[3] = -float("inf")
+        # One head where only the last rank attended anything.
+        if rank < world - 1:
+            lse[4, 5] = -float("inf")
+        # Zero heads (q = 0) give a uniform softmax and a finite LSE.
+        if world == 3:
+            partials[rank][:, 64:] = 0
+        lses.append(lse)
+    # Inactive ranks leave zero output where their LSE is -inf, as the attention kernel does.
+    for rank in range(world):
+        partials[rank][~torch.isfinite(lses[rank])] = 0
+    reference = lse_reference(partials, lses).to(torch.bfloat16)
+    width = pack_width(world, heads, dim)
+    sends = []
+    for rank in range(world):
+        send = torch.zeros((rows, width), dtype=torch.bfloat16, device=device)
+        pack(partials[rank].to(device), lses[rank].to(device), send, torch.tensor([rank], device=device), world)
+        sends.append(send)
+    received = torch.cat(sends, dim=1).contiguous()
+    for rank in range(world):
+        output = torch.full((rows, local, dim), 7, dtype=torch.bfloat16, device=device)
+        merge(received, partials[rank].to(device), lses[rank].to(device), output,
+              torch.tensor([rank], device=device), world)
+        want = reference[:, rank * local:(rank + 1) * local]
+        torch.testing.assert_close(output.cpu().float(), want.float(), rtol=1e-2, atol=2e-2)
+        assert not output[3].any(), ("no rank attended", world, rank)
+        assert torch.isfinite(output.float()).all()
+        if world == 3 and rank == 2:
+            assert not output[:, 16:].any(), "zero heads stay zero"
+
+
+def main(case, world):
+    assert os.environ.get("TRITON_INTERPRET") == "1" and not os.environ.get("CUDA_VISIBLE_DEVICES")
+    torch.manual_seed(world)
+    {"placement": _placement, "merge": _merge, "merge_expand_local": _merge_expand_local,
+     "expand_tokens": _expand_tokens, "records": _records, "lse_combine": _lse_combine}[case](world, "cpu")
+
+
+if __name__ == "__main__":
+    main(sys.argv[1], int(sys.argv[2]))
