+@pytest.mark.skipif(not _CUDA, reason="requires an explicitly assigned CUDA device and FLARE_RUN_CUDA_TESTS=1")
+@torch.no_grad()
+@pytest.mark.parametrize("compiler", ["none", "worker"])
