+class _Recorder:
+    def __init__(self, log, name):
+        self.log, self.name = log, name
+
+    def stage(self, index, sources):
+        self.log.append((self.name, "stage", index))
+
+    def join(self, index, dependency):
+        self.log.append((self.name, "join", index, dependency))
