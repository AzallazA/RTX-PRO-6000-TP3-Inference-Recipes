-        }
-        if self.costs.fresh_duration(GraphKind::Snapshot, 1).is_none() {
-            return Ok(false);
-        }
-        let accounting = &self.request(handle)?.checkpoints;
-        let Some(prefill) = accounting.initial_prefill_ns else {
