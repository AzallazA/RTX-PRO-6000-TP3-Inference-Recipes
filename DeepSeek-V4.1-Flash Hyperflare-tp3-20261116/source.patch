+fn ttft_policy(target_ms: f64, max_chunk: usize, interleave: u32) -> PolicyConfig {
+    PolicyConfig { ttft_target_ms: target_ms, ttft_max_chunk: max_chunk, ttft_decode_interleave: interleave,
