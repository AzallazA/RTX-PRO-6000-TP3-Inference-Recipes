diff --git a/ignition/recipes/deepseek41/host_embedding.py b/ignition/recipes/deepseek41/host_embedding.py
new file mode 100644
index 00000000..c8f2b185
--- /dev/null
+++ b/ignition/recipes/deepseek41/host_embedding.py
@@ -0,0 +1,99 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 Flare community contributors
+# SPDX-License-Identifier: Apache-2.0
+
+"""TP3 fork (``tp3.embed_rows``): token-embedding rows from the host-parked table in decode, verification and draft
+graphs.
+
+With ``embed_host`` the 1.23 GiB BF16 table lives in device-visible host memory and every step reads its rows over
+PCIe. b12x's embedding kernel copies a row with one dependent 2-byte load + store per thread and iteration (40 per
+5120-wide row), so a lookup costs ~40 PCIe round trips (~26-28 us at any row count up to 48, 2026-11-15 trace). DSpark
+draft blocks are the accepted token plus ``block - 1`` copies of one noise token, and concurrent reads of one host row
+serialise: the draft lookup costs ~131 us at c4 (20 rows) and ~280-360 us at c8 (40 rows).
+
+``HostRowGather`` replaces that lookup (and the zero fill before it) with one Triton launch that issues all of a row's
+16-byte loads before its stores, and, given a noise token, reads that token's row from a 10 KB device copy instead of
+the host table. Every output row is bit-identical to b12x's ``embedding_out`` after ``PreparedEmbedding``'s zero fill:
+``table[ids[r]]`` for ``r < live``, zero for the rest. Two deliberate differences, both only for inputs b12x traps on
+(no valid step produces them): an id outside the table is clamped into it, and a live count outside ``[0, rows]`` is
+clamped into that range.
+"""
+
+import torch
+import triton
+import triton.language as tl
+
+from ignition.preparation.persistent import persistent_copy
+
+
+@triton.jit
+def _gather_host_rows(table, ids, count, noise_row, out, capacity, table_rows, noise_token,
+                      WIDTH: tl.constexpr, STRIDE: tl.constexpr, BLOCK: tl.constexpr,
+                      HAS_COUNT: tl.constexpr, HAS_NOISE: tl.constexpr):
+    row = tl.program_id(0)
+    live = capacity
+    if HAS_COUNT:
+        live = tl.minimum(tl.maximum(tl.load(count).to(tl.int32), 0), capacity)
+    active = row < live
+    token = tl.load(ids + row).to(tl.int64)
+    token = tl.minimum(tl.maximum(token, 0), table_rows - 1)
+    cols = tl.arange(0, BLOCK)
+    inside = cols < WIDTH
+    if HAS_NOISE:
+        noise = token == noise_token
+        real = token != noise_token
+        # One masked load each: a live noise row reads only the device copy, a live real row only the table.
+        values = tl.load(table + token * STRIDE + cols, mask=inside & active & real, other=0.0)
+        copies = tl.load(noise_row + cols, mask=inside & active & noise, other=0.0)
+        values = tl.where(noise, copies, values)
+    else:
+        values = tl.load(table + token * STRIDE + cols, mask=inside & active, other=0.0)
+    tl.store(out + row.to(tl.int64) * WIDTH + cols, values, mask=inside)
+
+
+def device_noise_row(table, token):
+    """A persistent device copy of ``table[token]`` (10 KB at DS41's width). One per graph, made where the graph's other
+    persistent constants are (``CompressedRotary``'s frequency tables), so its lifetime is theirs."""
+    return persistent_copy(table[token:token + 1].contiguous())
+
+
+class HostRowGather:
+    """Gather ``table`` rows into a fresh ``(ids.numel(), width)`` tensor inside a traced forward (b12x semantics)."""
+
+    NUM_WARPS = 4
+
+    def __init__(self, table, *, rows, noise_token=None):
+        if table.ndim != 2 or table.stride(1) != 1 or table.stride(0) < table.shape[1]:
+            raise ValueError("host row gather needs a [table_rows, width] table with contiguous rows")
+        if table.dtype not in (torch.bfloat16, torch.float32):
+            raise TypeError("host row gather copies BF16 or FP32 rows")
+        if type(rows) is not int or rows <= 0:
+            raise ValueError("host row gather needs a positive row capacity")
+        if noise_token is not None and not 0 <= noise_token < table.shape[0]:
+            raise ValueError("noise token outside the embedding table")
+        self.table, self.rows, self.noise_token = table, rows, noise_token
+        self.noise_row = None if noise_token is None else device_noise_row(table, int(noise_token))
+
+    def __call__(self, ids, num_rows=None):
+        if ids.ndim != 1 or ids.numel() != self.rows or ids.dtype not in (torch.int32, torch.int64):
+            raise ValueError(f"host row gather expects {self.rows} flat Int32/Int64 ids")
+        table = self.table
+        width = table.shape[1]
+        out = torch.empty((self.rows, width), dtype=table.dtype, device=ids.device)
+        if out.is_cuda:
+            noise = table if self.noise_row is None else self.noise_row  # dummy pointer when HAS_NOISE is off
+            count = ids if num_rows is None else num_rows
+            torch.library.wrap_triton(_gather_host_rows)[(self.rows,)](
+                table, ids, count, noise, out, self.rows, table.shape[0],
+                -1 if self.noise_token is None else self.noise_token,
+                WIDTH=width, STRIDE=table.stride(0), BLOCK=triton.next_power_of_2(width),
+                HAS_COUNT=num_rows is not None, HAS_NOISE=self.noise_row is not None, num_warps=self.NUM_WARPS)
+            return out
+        # CPU reference (tests): the same semantics with torch ops.
+        live = self.rows if num_rows is None else int(num_rows.reshape(-1)[0].clamp(0, self.rows))
+        tokens = ids.long().clamp(0, table.shape[0] - 1)
+        out.zero_()
+        values = table[tokens[:live]]
+        if self.noise_row is not None:
+            values = torch.where((tokens[:live] == self.noise_token)[:, None], self.noise_row, values)
+        out[:live] = values
+        return out
diff --git a/ignition/recipes/deepseek41/probe.py b/ignition/recipes/deepseek41/probe.py
new file mode 100644
index 00000000..5f969c47
--- /dev/null
+++ b/ignition/recipes/deepseek41/probe.py
@@ -0,0 +1,185 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Debug-only per-layer residual probes for the DeepSeek decode-corruption hunt (flare#193).
+
+Enabled by TP3Config.probe (FLARE_DS41_PROBE=1; debug-serve only, never export with it); the decoder owns a
+``Probe`` and every layer records through it. Each captured forward records
+four statistics (sum, sum of squares, max |x|, first element) per probed tensor:
+
+  * decode graphs: row 0, into a ring buffer indexed by a device-side decode step counter;
+  * prefill graphs: every row, into a prefill table (overwritten by each prefill chunk).
+
+Rank 0 dumps the buffers to /tmp/flare_probe.pt whenever /tmp/flare_probe_req exists.
+"""
+
+import os
+import threading
+import time
+
+import torch
+
+RING, LAYERS, STAGES, PREFILL_ROWS = 512, 40, 6, 4096
+FULL_LAYERS = (37, 38, 39)  # full-row captures of the MoE input and routed output (bf16)
+_STATE = {}
+
+
+def _state(device):
+    key = torch.device(device).index
+    if key not in _STATE:
+        # Persistent storage: the probe state must outlive the transient pools that preparation constructs in.
+        from ignition.preparation.persistent import persistent_zeros as zeros
+        state = {
+            "ring": zeros((RING, LAYERS, STAGES, 4), dtype=torch.float32, device=device),
+            "counter": zeros((1,), dtype=torch.int64, device=device),
+            "prefill": zeros((PREFILL_ROWS, LAYERS, STAGES, 4), dtype=torch.float32, device=device),
+            "prefill_rows": zeros((1,), dtype=torch.int64, device=device),
+            "ring_pos": zeros((RING,), torch.int64, device).fill_(-1),
+            "prefill_pos": zeros((PREFILL_ROWS,), torch.int64, device).fill_(-1),
+            "ring_ids": zeros((RING, LAYERS, 6), torch.int32, device).fill_(-1),
+            "ring_w": zeros((RING, LAYERS, 6), dtype=torch.float32, device=device),
+            "prefill_ids": zeros((PREFILL_ROWS, LAYERS, 6), torch.int32, device).fill_(-1),
+            "prefill_w": zeros((PREFILL_ROWS, LAYERS, 6), dtype=torch.float32, device=device),
+            "ring_in": zeros((RING, len(FULL_LAYERS), 5120), dtype=torch.bfloat16, device=device),
+            "ring_out": zeros((RING, len(FULL_LAYERS), 5120), dtype=torch.bfloat16, device=device),
+            "prefill_in": zeros((PREFILL_ROWS, len(FULL_LAYERS), 5120), dtype=torch.bfloat16, device=device),
+            "prefill_out": zeros((PREFILL_ROWS, len(FULL_LAYERS), 5120), dtype=torch.bfloat16, device=device),
+        }
+        _STATE[key] = state
+        if key == 0:
+            threading.Thread(target=_dumper, args=(state,), daemon=True).start()
+    return _STATE[key]
+
+
+def _dumper(state):
+    while True:
+        if os.path.exists("/tmp/flare_probe_req"):
+            try:
+                torch.save({name: value.detach().cpu() for name, value in state.items()}, "/tmp/flare_probe.pt.tmp")
+                os.replace("/tmp/flare_probe.pt.tmp", "/tmp/flare_probe.pt")
+            finally:
+                os.remove("/tmp/flare_probe_req")
+        time.sleep(0.2)
+
+
+@torch.library.custom_op("flare_debug::probe_step", mutates_args=("counter",))
+def _probe_step(counter: torch.Tensor) -> None:
+    counter.add_(1)
+
+
+@_probe_step.register_fake
+def _probe_step_fake(counter):
+    pass
+
+
+@torch.library.custom_op("flare_debug::probe_record", mutates_args=("ring", "prefill", "prefill_rows"))
+def _probe_record(value: torch.Tensor, ring: torch.Tensor, prefill: torch.Tensor, prefill_rows: torch.Tensor,
+                  counter: torch.Tensor, layer: int, stage: int, decode: bool) -> None:
+    rows = value.shape[0]
+    flat = value.reshape(rows, -1).float()
+    stats = torch.stack((flat.sum(1), (flat * flat).sum(1), flat.abs().amax(1), flat[:, 0]), dim=1)
+    if decode:
+        slot = torch.remainder(counter, RING)
+        ring[:, layer, stage].index_copy_(0, slot, stats[:1])
+    else:
+        count = min(rows, PREFILL_ROWS)
+        prefill[:count, layer, stage].copy_(stats[:count])
+        prefill_rows.fill_(rows)
+
+
+@_probe_record.register_fake
+def _probe_record_fake(value, ring, prefill, prefill_rows, counter, layer, stage, decode):
+    pass
+
+
+@torch.library.custom_op("flare_debug::probe_positions", mutates_args=("ring_pos", "prefill_pos"))
+def _probe_positions(positions: torch.Tensor, ring_pos: torch.Tensor, prefill_pos: torch.Tensor,
+                     counter: torch.Tensor, decode: bool) -> None:
+    if decode:
+        ring_pos.index_copy_(0, torch.remainder(counter, RING), positions[:1].long())
+    else:
+        count = min(positions.shape[0], PREFILL_ROWS)
+        prefill_pos[:count].copy_(positions[:count].long())
+
+
+@_probe_positions.register_fake
+def _probe_positions_fake(positions, ring_pos, prefill_pos, counter, decode):
+    pass
+
+
+
+
+@torch.library.custom_op("flare_debug::probe_router",
+                         mutates_args=("ring_ids", "ring_w", "prefill_ids", "prefill_w"))
+def _probe_router(ids: torch.Tensor, weights: torch.Tensor, ring_ids: torch.Tensor, ring_w: torch.Tensor,
+                  prefill_ids: torch.Tensor, prefill_w: torch.Tensor, counter: torch.Tensor, layer: int,
+                  decode: bool) -> None:
+    if decode:
+        slot = torch.remainder(counter, RING)
+        ring_ids[:, layer].index_copy_(0, slot, ids[:1].int())
+        ring_w[:, layer].index_copy_(0, slot, weights[:1].float())
+    else:
+        count = min(ids.shape[0], PREFILL_ROWS)
+        prefill_ids[:count, layer].copy_(ids[:count].int())
+        prefill_w[:count, layer].copy_(weights[:count].float())
+
+
+@_probe_router.register_fake
+def _probe_router_fake(ids, weights, ring_ids, ring_w, prefill_ids, prefill_w, counter, layer, decode):
+    pass
+
+
+
+
+@torch.library.custom_op("flare_debug::probe_full", mutates_args=("ring", "prefill"))
+def _probe_full(value: torch.Tensor, ring: torch.Tensor, prefill: torch.Tensor, counter: torch.Tensor,
+                index: int, decode: bool) -> None:
+    rows = value.reshape(value.shape[0], -1)
+    if decode:
+        ring[:, index].index_copy_(0, torch.remainder(counter, RING), rows[:1].to(ring.dtype))
+    else:
+        count = min(rows.shape[0], PREFILL_ROWS)
+        prefill[:count, index].copy_(rows[:count].to(prefill.dtype))
+
+
+@_probe_full.register_fake
+def _probe_full_fake(value, ring, prefill, counter, index, decode):
+    pass
+
+
+class Probe:
+    """Recording entry points; every method is a no-op unless ``enabled`` (one instance per prepared decoder)."""
+
+    def __init__(self, enabled=False):
+        self.enabled = bool(enabled)
+
+    def allocate(self, device):
+        """Allocate the device state eagerly, outside traced forwards."""
+        if self.enabled:
+            _state(device)
+
+    def positions(self, value, mode):
+        if self.enabled and mode in ("decode", "prefill"):
+            state = _state(value.device)
+            _probe_positions(value.reshape(-1), state["ring_pos"], state["prefill_pos"], state["counter"], mode == "decode")
+
+    def router(self, ids, weights, layer, mode):
+        if self.enabled and mode in ("decode", "prefill") and ids.shape[-1] == 6:
+            state = _state(ids.device)
+            _probe_router(ids, weights, state["ring_ids"], state["ring_w"], state["prefill_ids"], state["prefill_w"],
+                          state["counter"], layer, mode == "decode")
+
+    def full(self, value, layer, kind, mode):
+        if (self.enabled and mode in ("decode", "prefill") and layer in FULL_LAYERS
+                and value.reshape(value.shape[0], -1).shape[1] == 5120):
+            state = _state(value.device)
+            _probe_full(value, state["ring_" + kind], state["prefill_" + kind], state["counter"],
+                        FULL_LAYERS.index(layer), mode == "decode")
+
+    def step(self, device, mode):
+        if self.enabled and mode == "decode":
+            _probe_step(_state(device)["counter"])
+
+    def record(self, value, layer, stage, mode):
+        if self.enabled and mode in ("decode", "prefill"):
+            state = _state(value.device)
+            _probe_record(value, state["ring"], state["prefill"], state["prefill_rows"], state["counter"],
+                          layer, stage, mode == "decode")
