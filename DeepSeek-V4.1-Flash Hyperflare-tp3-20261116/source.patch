+/// Resume point of the next turn after a request with a system message (100 tokens) and a last
+/// message ending two tokens before the prompt end (a DeepSeek V4.1 generation prompt). A
+/// thinking turn without tools (`reasoning_prompt`) is rendered in the next turn's history as
+/// `<｜Assistant｜></think>...` instead of its `<｜Assistant｜><think>`, so that turn diverges one
+/// token after the last message. With tools DeepSeek V4.1 keeps the `<think>` header, and without
+/// reasoning the generation prompt is the same, so the next turn extends the whole prompt.
+fn follow_up_resume(mode: PrefillTailMerge, tools: bool, reasoning: bool, prompt: usize) -> usize {
+    let mut s = scheduler_with_concurrency(16, false, 64, 1);
+    s.configure_policy(PolicyConfig { prefill_tail_merge: mode, ..PolicyConfig::default() })
+        .unwrap();
+    let mut first = spec(Some(100), prompt, 3);
+    first.message_boundaries.push(prompt - 2);
+    first.tools = tools;
+    first.reasoning_prompt = reasoning;
+    let h = s.admit(first).unwrap();
+    finish(&mut s, h);
+    let shared = if reasoning && !tools { prompt - 1 } else { prompt };
+    let mut follow_up = spec(None, 1, 1);
+    follow_up.prompt = (0..shared as u32).chain([7777, 7778, 7779]).collect();
+    follow_up.tools = tools;
+    follow_up.reasoning_prompt = reasoning;
+    s.plan_admission(&follow_up).unwrap().resident_tokens() as usize
 }
 
