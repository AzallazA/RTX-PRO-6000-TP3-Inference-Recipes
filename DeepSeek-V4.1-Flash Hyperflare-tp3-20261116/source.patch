+def test_parking_requires_the_loaded_cuda_table():
+    tree = _tree(torch.zeros((8, 4), dtype=torch.bfloat16))
+    calls = []
+    with pytest.raises(ValueError, match="CUDA"):
+        park_embedding(tree, lambda *args: calls.append(args))
+    assert not calls
