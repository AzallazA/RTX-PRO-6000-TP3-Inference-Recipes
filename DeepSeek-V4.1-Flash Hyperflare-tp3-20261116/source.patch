+            [json!({"tool_calls":[{"index":0,"id":"call_request_0","type":"function",
+                "function":{"name":"lookup","arguments":"{\"n\": three}"}}]})]
+        );
+        assert_eq!(output.message()["tool_calls"][0]["function"]["arguments"], "{\"n\": three}");
