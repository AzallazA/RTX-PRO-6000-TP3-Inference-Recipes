diff --git a/tp3-tools/bench_cell.py b/tp3-tools/bench_cell.py
new file mode 100644
index 00000000..15b89775
--- /dev/null
+++ b/tp3-tools/bench_cell.py
@@ -0,0 +1,30 @@
+"""One-line summary of llm_decode_bench JSON results for chain logs: per cell tok/s, steps/s, tokens/step, acceptance.
+
+    python3 tp3-tools/bench_cell.py RESULT.json [RESULT.json ...]
+Prints e.g. `c1 305/116.9s/2.61t/0.39a c4 ... c8 ...` (tok/s, steps/s, tok per step, draft acceptance). Cells whose
+aggregate is not positive (bench loop artifact) print `c4 ERR`.
+"""
+import json, sys
+
+parts = []
+for path in sys.argv[1:]:
+    try:
+        results = json.load(open(path))["results"]
+    except Exception as exc:  # noqa: BLE001
+        parts.append(f"{path.rsplit('/', 1)[-1]}:ERR({exc.__class__.__name__})")
+        continue
+    for r in results:
+        label = f"c{r.get('concurrency', '?')}"
+        tps = r.get("aggregate_tps", 0) or 0
+        if tps <= 0:
+            parts.append(f"{label} ERR")
+            continue
+        f = r.get("server_flare_metrics") or {}
+        if f.get("valid"):
+            c = f["counter_delta"]
+            steps = f["verification_graphs_per_second"]
+            tok_step = c["raw_emitted_tokens"] / max(c["verification_graphs"], 1)
+            parts.append(f"{label} {tps:.0f}/{steps:.1f}s/{tok_step:.2f}t/{f['raw_draft_acceptance']:.2f}a")
+        else:
+            parts.append(f"{label} {tps:.0f}")
+print(" ".join(parts))
diff --git a/tp3-tools/bench_steps.py b/tp3-tools/bench_steps.py
new file mode 100644
index 00000000..cef7faec
--- /dev/null
+++ b/tp3-tools/bench_steps.py
@@ -0,0 +1,16 @@
+"""Print steps/s and tokens/step per cell from llm_decode_bench (>=0.9) JSON results for a Flare server."""
+import json, sys
+for path in sys.argv[1:]:
+    d = json.load(open(path))
+    print(path.rsplit("/", 1)[-1])
+    print(f"  {'ctx':>6} {'conc':>4} {'tok/s':>7} {'steps/s':>8} {'tok/step':>8} {'accept':>6} {'GPU busy':>8} {'engram wait':>11}")
+    for r in d["results"]:
+        f = r.get("server_flare_metrics") or {}
+        if not f.get("valid"):
+            continue
+        c, s = f["counter_delta"], f["measurement_seconds"]
+        steps = f["verification_graphs_per_second"]
+        tps = r.get("aggregate_tps", 0)
+        print(f"  {r.get('context_label', r.get('context', '?')):>6} {r.get('concurrency', '?'):>4} {tps:7.1f} {steps:8.1f} "
+              f"{c['raw_emitted_tokens'] / c['verification_graphs']:8.2f} {f['raw_draft_acceptance']:6.2f} "
+              f"{c['verification_gpu_nanoseconds'] / 1e9 / s * 100:7.0f}% {c['embedding_readiness_nanoseconds'] / 1e9 / s * 100:10.1f}%")
