+def sparse_supported(rows, swa_width, idx_width, heads, dim) -> bool:
+    ext = sparse_extension()
+    return (rows <= SPARSE_ROWS and heads == ext.H and dim == ext.D and swa_width == 128
+            and ext.ctas_for(swa_width + idx_width) > 0)
