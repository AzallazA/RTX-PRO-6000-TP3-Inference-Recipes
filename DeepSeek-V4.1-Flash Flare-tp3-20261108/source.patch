+        .checked_add(input_window)
+        .and_then(|bytes| bytes.checked_add(source_window))
+        .ok_or_else(|| invalid("CPU image input windows overflow host memory"))?;
+    Ok(CacheSizing {
+        reserve,
+        page_tokens,
+        contract,
+        width,
+        input_window,
+        offload_bytes,
+        offload_host,
+        host_future,
+    })
