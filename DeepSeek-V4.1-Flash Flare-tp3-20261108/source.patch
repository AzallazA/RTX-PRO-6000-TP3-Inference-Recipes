+                dist.all_gather_object(peers, verify.output.token_ids.cpu().tolist())
+                assert all(peer == peers[0] for peer in peers)
+            dist.barrier()
+    finally:
+        if worker is not None:
+            worker.close()
+        if graph is not None:
+            graph.reset()
+        runtime.close()
+        dist.destroy_process_group()
+
+
