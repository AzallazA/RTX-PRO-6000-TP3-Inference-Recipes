+                        assert!(range.start as u64 <= *pages.first().unwrap(), "row {row}");
+                        assert!(range.end as u64 > *pages.last().unwrap(), "row {row}");
+                    }
+                }
+            }
+        }
+        assert!(padded > 0, "sweep never produced a padding-only row");
+    }
