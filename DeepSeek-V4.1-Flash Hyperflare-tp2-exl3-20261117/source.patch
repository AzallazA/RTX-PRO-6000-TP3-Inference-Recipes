diff --git a/ignition/recipes/deepseek41/exl3/kernels/xmoe/quant/exl3_moe_flat_kernel.cuh b/ignition/recipes/deepseek41/exl3/kernels/xmoe/quant/exl3_moe_flat_kernel.cuh
new file mode 100644
index 00000000..e7befc93
--- /dev/null
+++ b/ignition/recipes/deepseek41/exl3/kernels/xmoe/quant/exl3_moe_flat_kernel.cuh
@@ -0,0 +1,203 @@
+#pragma once
+
+// xmoe flat scheduler for decode-sized batches. The group kernel (exl3_moe_kernel) hands each active expert to one
+// 8-SM group and processes experts in rounds, so with 36 active experts on 23 groups the second round idles 10 groups
+// and every expert pays 5 group barriers. Here the whole grid (one block per SM) runs five phases over ALL active
+// experts at once, separated by 4 grid barriers:
+//   1 gather + input Hadamard (g, u)   2 gate+up GEMM, flattened over experts   3 output Had + act + down input Had
+//   4 down GEMM, flattened              5 output Had + weighted scatter-add
+// Rows stay in token_sorted (expert-sorted) pair order in the temp buffers, so expert e's rows are contiguous.
+// Experts with more than 16 rows are split into 16-row jobs.
+
+#include <cuda_bf16.h>
+#include "exl3_moe_common.cuh"
+#include "../util.h"
+#include "../util.cuh"
+#include "exl3_kernel_map.cuh"
+#include "hadamard_inner.cuh"
+#include "exl3_gemm_inner_flat_p.cuh"   // xmoe_ds41p: t stage loop with group barriers / mbarrier ring (bit-identical)
+#include "exl3_devctx.cuh"
+#include "../ptx.cuh"
+
+#ifndef XMOE_FLAT_SH_STAGES
+#define XMOE_FLAT_SH_STAGES XMOE_P_NBUF   // xmoe_ds41p: stage buffers of the flat GEMM ring (2 * XMOE_P_G, or XMOE_P_NBUF)
+#endif
+#ifndef XMOE_FLAT_TK
+#define XMOE_FLAT_TK 128     // xmoe_k64: flat GEMM k-tile (block size stays 256 * MOE_TILESIZE_K / 16 = 512)
+#endif
+#ifndef XMOE_FLAT_MAX_JOBS
+#define XMOE_FLAT_MAX_JOBS 640    // 8x profile build (xmoe_p8k): 1536
+#endif
+#ifndef XMOE_FLAT_MAX_PAIRS
+#define XMOE_FLAT_MAX_PAIRS 1024  // 8x profile build (xmoe_p8k): 8192, so k7 x 128 seqs (1,152 rows) stays on the flat kernel
+#endif
+#define XMOE_FLAT_MAX_EXPERTS 512
+#define XMOE_FLAT_BARRIER_ID 200  // group_barrier slot; the group kernel uses ids < MOE_MAX_GROUPS
+
+template<int t_bits, int MOE_TILESIZE_N, int cb>
+__global__ __launch_bounds__(EXL3_GEMM_BASE_THREADS * MOE_TILESIZE_K / 16)
+void exl3_moe_flat_kernel(EXL3_MOE_KERNEL_ARGS)
+{
+    static_assert(t_bits > 0, "xmoe flat: fixed bitrate only");
+    __shared__ int job_start[XMOE_FLAT_MAX_JOBS];
+    __shared__ int job_rows[XMOE_FLAT_MAX_JOBS];
+    __shared__ int job_expert[XMOE_FLAT_MAX_JOBS];
+    __shared__ short pair_expert[XMOE_FLAT_MAX_PAIRS];
+    __shared__ int warp_tot[2][32];
+    __shared__ int s_tot[2];
+
+    int* barrier_counters_sense = locks + BARRIER_LOCKS_OFFSET;
+    auto grid_sync = [&] () { group_barrier(XMOE_FLAT_BARRIER_ID, gridDim.x, barrier_counters_sense); };
+
+    const int t = threadIdx.x;
+    const int lane = t % 32;
+    const int warp_id = t / 32;
+    const int warps_per_block = blockDim.x / 32;
+
+    // Job table, built redundantly by every block from expert_count (no inter-block dependency).
+    // Exclusive scans over experts of (row count, 16-row job count); invalid experts (0 rows, or more than
+    // max_tokens_per_expert, which the caller runs on its fat path) contribute rows but no jobs.
+    int c = 0, nj = 0;
+    if (t < num_experts)
+    {
+        c = (int) expert_count[t];
+        bool skip = c < 0;   // split launch: negative count = rows kept for offsets, expert handled by the other launch
+        if (skip) c = -c;
+        bool valid = !skip && c > 0 && c <= max_tokens_per_expert;
+        nj = valid ? (c + 15) / 16 : 0;
+    }
+    int ic = c, inj = nj;
+    #pragma unroll
+    for (int o = 1; o < 32; o <<= 1)
+    {
+        int a = __shfl_up_sync(0xffffffff, ic, o);
+        int b = __shfl_up_sync(0xffffffff, inj, o);
+        if (lane >= o) { ic += a; inj += b; }
+    }
+    if (lane == 31) { warp_tot[0][warp_id] = ic; warp_tot[1][warp_id] = inj; }
+    __syncthreads();
+    if (warp_id == 0)
+    {
+        int a = lane < warps_per_block ? warp_tot[0][lane] : 0;
+        int b = lane < warps_per_block ? warp_tot[1][lane] : 0;
+        #pragma unroll
+        for (int o = 1; o < 32; o <<= 1)
+        {
+            int x = __shfl_up_sync(0xffffffff, a, o);
+            int y = __shfl_up_sync(0xffffffff, b, o);
+            if (lane >= o) { a += x; b += y; }
+        }
+        if (lane < warps_per_block) { warp_tot[0][lane] = a; warp_tot[1][lane] = b; }
+        if (lane == 31) { s_tot[0] = a; s_tot[1] = b; }
+    }
+    __syncthreads();
+    const int pos = ic - c + (warp_id ? warp_tot[0][warp_id - 1] : 0);
+    const int jpos = inj - nj + (warp_id ? warp_tot[1][warp_id - 1] : 0);
+    const int num_pairs = s_tot[0];   // rows over real experts; sentinel rows (expert == num_experts) come after
+    const int num_jobs = s_tot[1];
+    if (t < num_experts)
+    {
+        for (int i = 0; i < nj; ++i)
+        {
+            job_start[jpos + i] = pos + 16 * i;
+            job_rows[jpos + i] = MIN(16, c - 16 * i);
+            job_expert[jpos + i] = t;
+        }
+        short pe = nj ? (short) t : (short) -1;
+        for (int p = pos; p < pos + c; ++p) pair_expert[p] = pe;
+    }
+    __syncthreads();
+    if (num_jobs == 0) return;  // uniform across the grid: no barrier is entered
+
+    const int gwarp = blockIdx.x * warps_per_block + warp_id;
+    const int gwarps = gridDim.x * warps_per_block;
+
+    // 1. Gather + input Hadamard for g, u
+    {
+        const int wpt = hidden_dim / 128;
+        for (int w = gwarp; w < num_pairs * wpt; w += gwarps)
+        {
+            int p = w / wpt;
+            int off = w % wpt;
+            int e = pair_expert[p];
+            if (e < 0) continue;
+            const half* in_ptr = hidden_state + token_sorted[p] * hidden_dim + off * 128;
+            had_hf_r_128_inner<true, false>(in_ptr, temp_state_g + (size_t) p * hidden_dim + off * 128,
+                                            gate_suh[e] + off * 128, 0.088388347648f);
+            had_hf_r_128_inner<true, false>(in_ptr, temp_state_u + (size_t) p * hidden_dim + off * 128,
+                                            up_suh[e] + off * 128, 0.088388347648f);
+        }
+    }
+    grid_sync();
+
+    // 2. Gate + up GEMM over all jobs
+    {
+        FlatGemmJobs J;
+        J.start = job_start; J.rows = job_rows; J.expert = job_expert;
+        J.num_jobs = num_jobs; J.num_mats = 2;
+        J.A[0] = temp_state_g; J.A[1] = temp_state_u;
+        J.C[0] = temp_intermediate_g; J.C[1] = temp_intermediate_u;
+        J.B[0] = gate_trellis; J.B[1] = up_trellis;
+        exl3_gemm_kernel_inner_flat_p<t_bits, false, cb, MOE_TILESIZE_M, XMOE_FLAT_TK, MOE_TILESIZE_N,
+                                      XMOE_FLAT_SH_STAGES, 1>(J, hidden_dim, intermediate_dim, locks);
+    }
+    grid_sync();
+
+    // 3. Output Hadamard for g, u + activation + input Hadamard for d (in place into intermediate_g)
+    {
+        const int wpt = intermediate_dim / 128;
+        for (int w = gwarp; w < num_pairs * wpt; w += gwarps)
+        {
+            int p = w / wpt;
+            int off = w % wpt;
+            int e = pair_expert[p];
+            if (e < 0) continue;
+            half* ig = temp_intermediate_g + (size_t) p * intermediate_dim + off * 128;
+            half* iu = temp_intermediate_u + (size_t) p * intermediate_dim + off * 128;
+            had_hf_r_128_guad_inner(ig, iu, ig, gate_svh[e] + off * 128, up_svh[e] + off * 128,
+                                    down_suh[e] + off * 128, 0.088388347648f, act_limit, act_function);
+        }
+    }
+    grid_sync();
+
+    // 4. Down GEMM over all jobs, output into temp_state_g (free after phase 2)
+    {
+        FlatGemmJobs J;
+        J.start = job_start; J.rows = job_rows; J.expert = job_expert;
+        J.num_jobs = num_jobs; J.num_mats = 1;
+        J.A[0] = temp_intermediate_g; J.A[1] = nullptr;
+        J.C[0] = temp_state_g; J.C[1] = nullptr;
+        J.B[0] = down_trellis; J.B[1] = nullptr;
+        exl3_gemm_kernel_inner_flat_p<t_bits, false, cb, MOE_TILESIZE_M, XMOE_FLAT_TK, MOE_TILESIZE_N,
+                                      XMOE_FLAT_SH_STAGES, 1>(J, intermediate_dim, hidden_dim, locks);
+    }
+    grid_sync();
+
+    // 5. Output Hadamard for d + weighted scatter-add into the fp32 output
+    {
+        const int wpt = hidden_dim / 128;
+        for (int w = gwarp; w < num_pairs * wpt; w += gwarps)
+        {
+            int p = w / wpt;
+            int off = w % wpt;
+            int e = pair_expert[p];
+            if (e < 0) continue;
+            float* out_ptr = output_state + token_sorted[p] * hidden_dim + off * 128;
+            had_hf_r_128_d_inner(temp_state_g + (size_t) p * hidden_dim + off * 128, out_ptr,
+                                 down_svh[e] + off * 128, 0.088388347648f * __half2float(weight_sorted[p]));
+        }
+    }
+}
+
+// Dynamic shared memory for the flat kernel: GEMM stages + reduction buffer; phase 5 needs 128 floats per warp
+template<int t_bits, int MOE_TILESIZE_N>
+constexpr int exl3_moe_flat_dyn_smem()
+{
+    constexpr int a = 16 * XMOE_FLAT_TK * 2;
+    constexpr int b = (XMOE_FLAT_TK / 16) * (MOE_TILESIZE_N / 16) * 256 / 16 * t_bits * 2;
+    constexpr int frags_n = 2 * (MOE_TILESIZE_N / 16) / (EXL3_GEMM_BASE_THREADS / 32);
+    constexpr int cbuf = 4 * EXL3_GEMM_BASE_THREADS * frags_n * 4;
+    constexpr int gemm = XMOE_FLAT_SH_STAGES * (a + b) + cbuf;
+    constexpr int had = (EXL3_GEMM_BASE_THREADS * MOE_TILESIZE_K / 16 / 32) * 128 * 4;
+    return gemm > had ? gemm : had;
+}
diff --git a/ignition/recipes/deepseek41/exl3/kernels/xmoe/quant/exl3_moe_kernel.cuh b/ignition/recipes/deepseek41/exl3/kernels/xmoe/quant/exl3_moe_kernel.cuh
new file mode 100644
index 00000000..591252a0
--- /dev/null
+++ b/ignition/recipes/deepseek41/exl3/kernels/xmoe/quant/exl3_moe_kernel.cuh
@@ -0,0 +1,321 @@
+#pragma once
+
+#include <cuda_bf16.h>
+#include <cublas_v2.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#include "exl3_moe_common.cuh"
+#include "../util.h"
+#include "../util.cuh"
+#include "exl3_kernel_map.cuh"
+#include "hadamard_inner.cuh"
+#include "exl3_gemm_inner.cuh"
+#include "exl3_gemm_inner_mt.cuh"
+#ifndef XMOE_MT
+#define XMOE_MT 2
+#endif
+#ifndef XMOE_MT_FRAG_STAGES
+#define XMOE_MT_FRAG_STAGES 2
+#endif
+#include "exl3_devctx.cuh"
+#include "../ptx.cuh"
+
+template<int t_bits, int MOE_TILESIZE_N, int cb, bool USE_MT = false>
+__global__ __launch_bounds__(EXL3_GEMM_BASE_THREADS * MOE_TILESIZE_K / 16)
+void exl3_moe_kernel(EXL3_MOE_KERNEL_ARGS)
+{
+    const int group_idx = blockIdx.z;
+    const int block_idx = blockIdx.x;
+    const int group_size = gridDim.x;  // SMs per expert, set at launch
+    const int num_groups = gridDim.z;
+    const int block_threads = EXL3_GEMM_BASE_THREADS * MOE_TILESIZE_K / 16;  // blockDim.x
+    const int group_threads = group_size * block_threads;
+    const int warp_id = threadIdx.x / 32;
+    const int warps_per_group = group_threads / 32;
+    const int warps_per_block = block_threads / 32;
+    const int warp_idx0 = block_idx * warps_per_block + warp_id;
+
+    // Buffers for group
+    temp_state_g += group_idx * max_tokens_per_expert * hidden_dim;
+    temp_state_u += group_idx * max_tokens_per_expert * hidden_dim;
+    temp_intermediate_g += group_idx * max_tokens_per_expert * intermediate_dim;
+    temp_intermediate_u += group_idx * max_tokens_per_expert * intermediate_dim;
+
+    // Barriers for group sync
+    int* barrier_counters_sense = locks + BARRIER_LOCKS_OFFSET;
+
+    // Expert scheduler state, self-resetting: [0] next ticket, [1] retired groups, [2 + g] ticket for group g
+    int* sched = locks + MOE_SCHED_OFFSET;
+
+    // Individual GEMM barriers per group
+    locks += group_idx * MAX(hidden_dim, intermediate_dim) / 128;
+
+    // Dynamic expert assignment: active experts are numbered in scan order, and each group processes the active
+    // expert matching its current ticket. Initial tickets are the group indices; after finishing an expert, a group
+    // draws the next unclaimed ticket, so load balances greedily without assuming uniform cost per expert
+    int ticket = group_idx;
+
+    // Loop over experts
+    int start = 0;
+    int end = 0;
+    int expert_idx = 0;
+    int expert_idx_assign = 0;
+    for (; expert_idx < num_experts; ++expert_idx)
+    {
+        // Token span for current expert
+        start = end;
+        int64_t cnt = expert_count[expert_idx];
+        bool skip_split = cnt < 0;   // split launch: negative count = offsets only, expert handled by the other launch
+        if (skip_split) cnt = -cnt;
+        end += cnt;
+        int token_count = end - start;
+
+        // Skip if no tokens or too many tokens for fused kernel (batch is handled by reconstruct path outside kernel)
+        if (token_count == 0 || skip_split) continue;
+        if (token_count > max_tokens_per_expert) continue;
+
+        // Skip if expert is claimed by a different group
+        if (expert_idx_assign++ != ticket) continue;
+
+        // EXL3 weights for g, u, d
+        const uint16_t* exp_gate_trellis = gate_trellis[expert_idx];
+        const half* exp_gate_suh = gate_suh[expert_idx];
+        const half* exp_gate_svh = gate_svh[expert_idx];
+        const uint16_t* exp_up_trellis = up_trellis[expert_idx];
+        const half* exp_up_suh = up_suh[expert_idx];
+        const half* exp_up_svh = up_svh[expert_idx];
+        const uint16_t* exp_down_trellis = down_trellis[expert_idx];
+        const half* exp_down_suh = down_suh[expert_idx];
+        const half* exp_down_svh = down_svh[expert_idx];
+
+        // Gather + input hadamard for g, u. Non-gated mode skips the g staging (and the g GEMM
+        // below); the activation synthesizes the gate lane from u
+        const bool gated = act_function != MOE_ACT_RELU2_NOGATE;
+        auto had_gather_gu_in = [&]()
+        {
+            const int warps_per_token = hidden_dim / 128;
+            const int total_warps = token_count * warps_per_token;
+            const int64_t* top_x = token_sorted + start;
+            for (int warp_idx = warp_idx0; warp_idx < total_warps; warp_idx += warps_per_group)
+            {
+                int token_idx = top_x[warp_idx / warps_per_token];
+                int token_off = warp_idx % warps_per_token;
+                const half* in_ptr = hidden_state + token_idx * hidden_dim + token_off * 128;
+                if (gated)
+                    had_hf_r_128_inner<true, false>
+                    (
+                        in_ptr,
+                        temp_state_g + 128 * warp_idx,
+                        exp_gate_suh + 128 * token_off,
+                        0.088388347648f
+                    );
+                had_hf_r_128_inner<true, false>
+                (
+                    in_ptr,
+                    temp_state_u + 128 * warp_idx,
+                    exp_up_suh + 128 * token_off,
+                    0.088388347648f
+                );
+            }
+            group_barrier(group_idx, group_size, barrier_counters_sense);
+        };
+
+        had_gather_gu_in();
+
+        // g, u GEMM
+        auto gemm_up = [&](const half* in_addr, half* out_addr, const uint16_t* trellis, const int K)
+        {
+            int size_m = token_count;
+            while (size_m > 0)
+            {
+                if constexpr (USE_MT && t_bits && XMOE_MT > 1)
+                {
+                    if (size_m > 16)
+                    {
+                        const int mc = MIN(size_m, XMOE_MT * 16);
+                        exl3_gemm_kernel_inner_mt<t_bits, false, cb, MOE_TILESIZE_M, MOE_TILESIZE_K, MOE_TILESIZE_N,
+                                                  MOE_SH_STAGES, XMOE_MT_FRAG_STAGES, false, XMOE_MT>
+                            (in_addr, trellis, out_addr, mc, hidden_dim, intermediate_dim, locks, nullptr);
+                        in_addr += mc * hidden_dim;
+                        out_addr += mc * intermediate_dim;
+                        size_m -= mc;
+                        continue;
+                    }
+                }
+                #define ARGS            \
+                    in_addr,            \
+                    trellis,            \
+                    out_addr,           \
+                    MIN(size_m, 16),    \
+                    hidden_dim,         \
+                    intermediate_dim,   \
+                    locks,              \
+                    nullptr
+                #define SHAPE_ARGS      \
+                    MOE_TILESIZE_M,     \
+                    MOE_TILESIZE_K,     \
+                    MOE_TILESIZE_N,     \
+                    MOE_SH_STAGES,      \
+                    MOE_FRAG_STAGES
+                if constexpr (t_bits)
+                    exl3_gemm_kernel_inner<t_bits, false, cb, SHAPE_ARGS, false>(ARGS);
+                else switch(K)
+                {
+                    case 1: exl3_gemm_kernel_inner<1, false, cb, SHAPE_ARGS, false>(ARGS); break;
+                    case 2: exl3_gemm_kernel_inner<2, false, cb, SHAPE_ARGS, false>(ARGS); break;
+                    case 3: exl3_gemm_kernel_inner<3, false, cb, SHAPE_ARGS, false>(ARGS); break;
+                    case 4: exl3_gemm_kernel_inner<4, false, cb, SHAPE_ARGS, false>(ARGS); break;
+                    case 5: exl3_gemm_kernel_inner<5, false, cb, SHAPE_ARGS, false>(ARGS); break;
+                    case 6: exl3_gemm_kernel_inner<6, false, cb, SHAPE_ARGS, false>(ARGS); break;
+                    case 7: exl3_gemm_kernel_inner<7, false, cb, SHAPE_ARGS, false>(ARGS); break;
+                    case 8: exl3_gemm_kernel_inner<8, false, cb, SHAPE_ARGS, false>(ARGS); break;
+                };
+                #undef ARGS
+                #undef SHAPE_ARGS
+
+                in_addr += 16 * hidden_dim;
+                out_addr += 16 * intermediate_dim;
+                size_m -= 16;
+            }
+        };
+
+        if (gated)
+            gemm_up(temp_state_g, temp_intermediate_g, exp_gate_trellis, K_gate);
+        gemm_up(temp_state_u, temp_intermediate_u, exp_up_trellis, K_up);
+        group_barrier(group_idx, group_size, barrier_counters_sense);
+
+        // Output hadamard for g, u + activation+gate + input hadamard for d
+        auto had_guad = [&]()
+        {
+            const int warps_per_token = intermediate_dim / 128;
+            const int total_warps = token_count * warps_per_token;
+            for (int warp_idx = warp_idx0; warp_idx < total_warps; warp_idx += warps_per_group)
+            {
+                int token_off = warp_idx % warps_per_token;
+                had_hf_r_128_guad_inner
+                (
+                    temp_intermediate_g + 128 * warp_idx,
+                    temp_intermediate_u + 128 * warp_idx,
+                    temp_intermediate_g + 128 * warp_idx,
+                    exp_gate_svh + 128 * token_off,
+                    exp_up_svh + 128 * token_off,
+                    exp_down_suh + 128 * token_off,
+                    0.088388347648f,
+                    act_limit,
+                    act_function
+                );
+            }
+            group_barrier(group_idx, group_size, barrier_counters_sense);
+        };
+
+        had_guad();
+
+        // d GEMM
+        auto gemm_down = [&](const half* in_addr, half* out_addr, const uint16_t* trellis, const int K)
+        {
+            int size_m = token_count;
+            while (size_m > 0)
+            {
+                if constexpr (USE_MT && t_bits && XMOE_MT > 1)
+                {
+                    if (size_m > 16)
+                    {
+                        const int mc = MIN(size_m, XMOE_MT * 16);
+                        exl3_gemm_kernel_inner_mt<t_bits, false, cb, MOE_TILESIZE_M, MOE_TILESIZE_K, MOE_TILESIZE_N,
+                                                  MOE_SH_STAGES, XMOE_MT_FRAG_STAGES, false, XMOE_MT>
+                            (in_addr, trellis, out_addr, mc, intermediate_dim, hidden_dim, locks, nullptr);
+                        in_addr += mc * intermediate_dim;
+                        out_addr += mc * hidden_dim;
+                        size_m -= mc;
+                        continue;
+                    }
+                }
+                #define ARGS            \
+                    in_addr,            \
+                    trellis,            \
+                    out_addr,           \
+                    MIN(size_m, 16),    \
+                    intermediate_dim,   \
+                    hidden_dim,         \
+                    locks,              \
+                    nullptr
+                #define SHAPE_ARGS      \
+                    MOE_TILESIZE_M,     \
+                    MOE_TILESIZE_K,     \
+                    MOE_TILESIZE_N,     \
+                    MOE_SH_STAGES,      \
+                    MOE_FRAG_STAGES
+                if constexpr (t_bits)
+                    exl3_gemm_kernel_inner<t_bits, false, cb, SHAPE_ARGS, false>(ARGS);
+                else switch(K)
+                {
+                    case 1: exl3_gemm_kernel_inner<1, false, cb, SHAPE_ARGS, false>(ARGS); break;
+                    case 2: exl3_gemm_kernel_inner<2, false, cb, SHAPE_ARGS, false>(ARGS); break;
+                    case 3: exl3_gemm_kernel_inner<3, false, cb, SHAPE_ARGS, false>(ARGS); break;
+                    case 4: exl3_gemm_kernel_inner<4, false, cb, SHAPE_ARGS, false>(ARGS); break;
+                    case 5: exl3_gemm_kernel_inner<5, false, cb, SHAPE_ARGS, false>(ARGS); break;
+                    case 6: exl3_gemm_kernel_inner<6, false, cb, SHAPE_ARGS, false>(ARGS); break;
+                    case 7: exl3_gemm_kernel_inner<7, false, cb, SHAPE_ARGS, false>(ARGS); break;
+                    case 8: exl3_gemm_kernel_inner<8, false, cb, SHAPE_ARGS, false>(ARGS); break;
+                };
+                #undef ARGS
+                #undef SHAPE_ARGS
+
+                in_addr += 16 * intermediate_dim;
+                out_addr += 16 * hidden_dim;
+                size_m -= 16;
+            }
+        };
+
+        gemm_down(temp_intermediate_g, temp_state_g, exp_down_trellis, K_down);
+        group_barrier(group_idx, group_size, barrier_counters_sense);
+
+        // Output hadamard for d + scatter add
+        auto had_d_out = [&]()
+        {
+            const int warps_per_token = hidden_dim / 128;
+            const int total_warps = token_count * warps_per_token;
+            const int64_t* top_x = token_sorted + start;
+            const half* weights = weight_sorted + start;
+            for (int warp_idx = warp_idx0; warp_idx < total_warps; warp_idx += warps_per_group)
+            {
+                int token_idx = top_x[warp_idx / warps_per_token];
+                half weight = weights[warp_idx / warps_per_token];
+                int token_off = warp_idx % warps_per_token;
+                float* out_ptr = output_state + token_idx * hidden_dim + token_off * 128;
+                had_hf_r_128_d_inner
+                (
+                    temp_state_g + 128 * warp_idx,
+                    out_ptr,
+                    exp_down_svh + 128 * token_off,
+                    0.088388347648f * __half2float(weight)
+                );
+            }
+        };
+
+        had_d_out();
+
+        // Draw the next ticket and publish it to the group through the end-of-expert barrier, which also protects
+        // the temp buffers for reuse. Grabbed tickets continue from num_groups since 0..num_groups-1 are implicit
+        if (block_idx == 0 && threadIdx.x == 0)
+            sched[2 + group_idx] = num_groups + atomicAdd(&sched[0], 1);
+        group_barrier(group_idx, group_size, barrier_counters_sense);
+        ticket = sched[2 + group_idx];
+    }
+
+    // Retire group; last group out resets the scheduler for the next launch. The acq_rel increment orders each
+    // group's earlier ticket grabs before the last group's reset (plain atomics are relaxed, so without this a
+    // straggler's in-flight grab could land after the reset and leak into the next launch)
+    if (block_idx == 0 && threadIdx.x == 0)
+    {
+        cuda::atomic_ref<int, cuda::thread_scope_device> next_ticket(sched[0]);
+        cuda::atomic_ref<int, cuda::thread_scope_device> retired_groups(sched[1]);
+        int retired = retired_groups.fetch_add(1, cuda::memory_order_acq_rel);
+        if (retired == num_groups - 1)
+        {
+            next_ticket.store(0, cuda::memory_order_relaxed);
+            retired_groups.store(0, cuda::memory_order_relaxed);
+        }
+    }
+}
diff --git a/ignition/recipes/deepseek41/exl3/kernels/xmoe/quant/exl3_moe_kernel_pb.cuh b/ignition/recipes/deepseek41/exl3/kernels/xmoe/quant/exl3_moe_kernel_pb.cuh
new file mode 100644
index 00000000..b2dd31cf
--- /dev/null
+++ b/ignition/recipes/deepseek41/exl3/kernels/xmoe/quant/exl3_moe_kernel_pb.cuh
@@ -0,0 +1,250 @@
+#pragma once
+// prefillbw (2026-10-20): prefill (bsz > XMOE_MT_MIN_BSZ) group kernel for host-RAM (cold) experts, xmoe_ds41pb.
+//
+// = exl3_moe_kernel<t_bits, N, cb, USE_MT = true> (exl3_moe_kernel.cuh, unchanged there) with two value-neutral changes to the
+//   g/u/d GEMM calls; every other phase (gather + hadamard, activation, scatter, scheduler, barriers) is a verbatim copy:
+//   * PB_ST: shared-memory pipeline depth of the 32-row (MT) GEMM loop (ds41a: MOE_SH_STAGES = 3, i.e. 2 x 1.5 KB B tiles in
+//     flight per SM; here 3..8). The <= 16-row tail chunk keeps the stock 3-stage exl3_gemm_kernel_inner.
+//   * PB_STAGE: an expert with more than XMOE_MT * 16 rows needs ceil(rows / 32) passes over each weight matrix. ds41a reads B
+//     from host RAM in every pass (zero-copy reads are not cached on the GPU). Here the first pass also writes each landed B
+//     tile to a VRAM stage copy and the later passes (incl. the <= 16-row tail) read B from that copy: PCIe bytes per expert
+//     drop from passes x 6.6 MB to 6.6 MB (TP2 rank of DS4.1-1017). The stage copy lives in this group's own temp_state_u
+//     slice, in the rows above the expert's token rows (temp_state_u is only read by the up GEMM, rows < token_count; the
+//     stage copy starts at row roundup(token_count, 16)), so it needs no extra VRAM and is CUDA-graph safe. Skipped (plain
+//     reads) when the matrix does not fit there, i.e. token_count > max_tokens_per_expert - ~216 for K=3 at 5120 x 1152.
+//   Within a group every block re-reads only the tiles it wrote itself (same slice of the same matrix shape); gate -> up reuse
+//   the same block-private positions, and up -> down are separated by group barriers.
+// Bit-exactness: B bytes are identical in every pass, and the MMA / k-reduction / split-K lock order does not depend on PB_ST.
+
+#include "exl3_moe_kernel.cuh"
+#include "exl3_gemm_inner_mt_pb.cuh"
+
+template<int t_bits, int MOE_TILESIZE_N, int cb, int PB_ST, bool PB_STAGE>
+__global__ __launch_bounds__(EXL3_GEMM_BASE_THREADS * MOE_TILESIZE_K / 16)
+void exl3_moe_kernel_pb(EXL3_MOE_KERNEL_ARGS)
+{
+    static_assert(t_bits >= 1 && t_bits <= 8, "xmoe_ds41pb: fixed-K instances only");
+    static_assert(XMOE_MT > 1, "xmoe_ds41pb: needs the multi-M GEMM (XMOE_MT >= 2)");
+    const int group_idx = blockIdx.z;
+    const int block_idx = blockIdx.x;
+    const int group_size = gridDim.x;  // SMs per expert, set at launch
+    const int num_groups = gridDim.z;
+    const int block_threads = EXL3_GEMM_BASE_THREADS * MOE_TILESIZE_K / 16;  // blockDim.x
+    const int group_threads = group_size * block_threads;
+    const int warp_id = threadIdx.x / 32;
+    const int warps_per_group = group_threads / 32;
+    const int warps_per_block = block_threads / 32;
+    const int warp_idx0 = block_idx * warps_per_block + warp_id;
+
+    // Buffers for group
+    temp_state_g += group_idx * max_tokens_per_expert * hidden_dim;
+    temp_state_u += group_idx * max_tokens_per_expert * hidden_dim;
+    temp_intermediate_g += group_idx * max_tokens_per_expert * intermediate_dim;
+    temp_intermediate_u += group_idx * max_tokens_per_expert * intermediate_dim;
+
+    // Barriers for group sync
+    int* barrier_counters_sense = locks + BARRIER_LOCKS_OFFSET;
+
+    // Expert scheduler state, self-resetting: [0] next ticket, [1] retired groups, [2 + g] ticket for group g
+    int* sched = locks + MOE_SCHED_OFFSET;
+
+    // Individual GEMM barriers per group
+    locks += group_idx * MAX(hidden_dim, intermediate_dim) / 128;
+
+    // Stage copy capacity (uint16 elements) per weight matrix: K x N x bits / 16 (trellis [K/16, N/16, 16 * bits])
+    const int64_t stage_need = (int64_t) hidden_dim * intermediate_dim * t_bits / 16;
+
+    int ticket = group_idx;
+
+    // Loop over experts
+    int start = 0;
+    int end = 0;
+    int expert_idx = 0;
+    int expert_idx_assign = 0;
+    for (; expert_idx < num_experts; ++expert_idx)
+    {
+        // Token span for current expert
+        start = end;
+        int64_t cnt = expert_count[expert_idx];
+        bool skip_split = cnt < 0;   // split launch: negative count = offsets only, expert handled by the other launch
+        if (skip_split) cnt = -cnt;
+        end += cnt;
+        int token_count = end - start;
+
+        // Skip if no tokens or too many tokens for fused kernel (batch is handled by reconstruct path outside kernel)
+        if (token_count == 0 || skip_split) continue;
+        if (token_count > max_tokens_per_expert) continue;
+
+        // Skip if expert is claimed by a different group
+        if (expert_idx_assign++ != ticket) continue;
+
+        // EXL3 weights for g, u, d
+        const uint16_t* exp_gate_trellis = gate_trellis[expert_idx];
+        const half* exp_gate_suh = gate_suh[expert_idx];
+        const half* exp_gate_svh = gate_svh[expert_idx];
+        const uint16_t* exp_up_trellis = up_trellis[expert_idx];
+        const half* exp_up_suh = up_suh[expert_idx];
+        const half* exp_up_svh = up_svh[expert_idx];
+        const uint16_t* exp_down_trellis = down_trellis[expert_idx];
+        const half* exp_down_suh = down_suh[expert_idx];
+        const half* exp_down_svh = down_svh[expert_idx];
+
+        // prefillbw: stage copy for this expert (uniform per group: every block sees the same token_count)
+        const int stage_row0 = (token_count + 15) & ~15;
+        const bool stage_on = PB_STAGE && token_count > XMOE_MT * 16 &&
+                              (int64_t) (max_tokens_per_expert - stage_row0) * hidden_dim >= stage_need;
+        uint16_t* stage_buf = stage_on ? (uint16_t*) (temp_state_u + (int64_t) stage_row0 * hidden_dim) : nullptr;
+
+        // Gather + input hadamard for g, u. Non-gated mode skips the g staging (and the g GEMM
+        // below); the activation synthesizes the gate lane from u
+        const bool gated = act_function != MOE_ACT_RELU2_NOGATE;
+        auto had_gather_gu_in = [&]()
+        {
+            const int warps_per_token = hidden_dim / 128;
+            const int total_warps = token_count * warps_per_token;
+            const int64_t* top_x = token_sorted + start;
+            for (int warp_idx = warp_idx0; warp_idx < total_warps; warp_idx += warps_per_group)
+            {
+                int token_idx = top_x[warp_idx / warps_per_token];
+                int token_off = warp_idx % warps_per_token;
+                const half* in_ptr = hidden_state + token_idx * hidden_dim + token_off * 128;
+                if (gated)
+                    had_hf_r_128_inner<true, false>
+                    (
+                        in_ptr,
+                        temp_state_g + 128 * warp_idx,
+                        exp_gate_suh + 128 * token_off,
+                        0.088388347648f
+                    );
+                had_hf_r_128_inner<true, false>
+                (
+                    in_ptr,
+                    temp_state_u + 128 * warp_idx,
+                    exp_up_suh + 128 * token_off,
+                    0.088388347648f
+                );
+            }
+            group_barrier(group_idx, group_size, barrier_counters_sense);
+        };
+
+        had_gather_gu_in();
+
+        // One GEMM over all row chunks of the expert: MT (32-row) chunks with PB_ST stages, <= 16-row tail with the stock
+        // inner. With stage_on, chunk 0 writes the stage copy and every later chunk reads B from it.
+        auto gemm_rows = [&](const half* in_addr, half* out_addr, const uint16_t* trellis, const int size_k, const int size_n)
+        {
+            int size_m = token_count;
+            const uint16_t* b_src = trellis;
+            bool first = true;
+            while (size_m > 0)
+            {
+                if (size_m > 16)
+                {
+                    const int mc = MIN(size_m, XMOE_MT * 16);
+                    // one inlined MT body per GEMM (two template copies made ptxas drop to 64 registers + 544 B of stack)
+                    uint16_t* st_out = (stage_on && first) ? stage_buf : nullptr;
+                    exl3_gemm_kernel_inner_mt_pb<t_bits, false, cb, MOE_TILESIZE_M, MOE_TILESIZE_K, MOE_TILESIZE_N,
+                                                 PB_ST, XMOE_MT_FRAG_STAGES, false, XMOE_MT>
+                        (in_addr, b_src, out_addr, mc, size_k, size_n, locks, nullptr, 0, st_out);
+                    if (st_out != nullptr)
+                    {
+                        __threadfence_block();   // stage writes before this block's own later cp.async reads of them
+                        b_src = stage_buf;
+                    }
+                    first = false;
+                    in_addr += mc * size_k;
+                    out_addr += mc * size_n;
+                    size_m -= mc;
+                    continue;
+                }
+                exl3_gemm_kernel_inner<t_bits, false, cb, MOE_TILESIZE_M, MOE_TILESIZE_K, MOE_TILESIZE_N,
+                                       MOE_SH_STAGES, MOE_FRAG_STAGES, false>
+                    (in_addr, b_src, out_addr, MIN(size_m, 16), size_k, size_n, locks, nullptr);
+                first = false;
+                in_addr += 16 * size_k;
+                out_addr += 16 * size_n;
+                size_m -= 16;
+            }
+        };
+
+        if (gated)
+            gemm_rows(temp_state_g, temp_intermediate_g, exp_gate_trellis, hidden_dim, intermediate_dim);
+        gemm_rows(temp_state_u, temp_intermediate_u, exp_up_trellis, hidden_dim, intermediate_dim);
+        group_barrier(group_idx, group_size, barrier_counters_sense);
+
+        // Output hadamard for g, u + activation+gate + input hadamard for d
+        auto had_guad = [&]()
+        {
+            const int warps_per_token = intermediate_dim / 128;
+            const int total_warps = token_count * warps_per_token;
+            for (int warp_idx = warp_idx0; warp_idx < total_warps; warp_idx += warps_per_group)
+            {
+                int token_off = warp_idx % warps_per_token;
+                had_hf_r_128_guad_inner
+                (
+                    temp_intermediate_g + 128 * warp_idx,
+                    temp_intermediate_u + 128 * warp_idx,
+                    temp_intermediate_g + 128 * warp_idx,
+                    exp_gate_svh + 128 * token_off,
+                    exp_up_svh + 128 * token_off,
+                    exp_down_suh + 128 * token_off,
+                    0.088388347648f,
+                    act_limit,
+                    act_function
+                );
+            }
+            group_barrier(group_idx, group_size, barrier_counters_sense);
+        };
+
+        had_guad();
+
+        // d GEMM
+        gemm_rows(temp_intermediate_g, temp_state_g, exp_down_trellis, intermediate_dim, hidden_dim);
+        group_barrier(group_idx, group_size, barrier_counters_sense);
+
+        // Output hadamard for d + scatter add
+        auto had_d_out = [&]()
+        {
+            const int warps_per_token = hidden_dim / 128;
+            const int total_warps = token_count * warps_per_token;
+            const int64_t* top_x = token_sorted + start;
+            const half* weights = weight_sorted + start;
+            for (int warp_idx = warp_idx0; warp_idx < total_warps; warp_idx += warps_per_group)
+            {
+                int token_idx = top_x[warp_idx / warps_per_token];
+                half weight = weights[warp_idx / warps_per_token];
+                int token_off = warp_idx % warps_per_token;
+                float* out_ptr = output_state + token_idx * hidden_dim + token_off * 128;
+                had_hf_r_128_d_inner
+                (
+                    temp_state_g + 128 * warp_idx,
+                    out_ptr,
+                    exp_down_svh + 128 * token_off,
+                    0.088388347648f * __half2float(weight)
+                );
+            }
+        };
+
+        had_d_out();
+
+        // Draw the next ticket and publish it to the group through the end-of-expert barrier, which also protects
+        // the temp buffers (and the stage copy) for reuse. Grabbed tickets continue from num_groups
+        if (block_idx == 0 && threadIdx.x == 0)
+            sched[2 + group_idx] = num_groups + atomicAdd(&sched[0], 1);
+        group_barrier(group_idx, group_size, barrier_counters_sense);
+        ticket = sched[2 + group_idx];
+    }
+
+    // Retire group; last group out resets the scheduler for the next launch (see exl3_moe_kernel)
+    if (block_idx == 0 && threadIdx.x == 0)
+    {
+        cuda::atomic_ref<int, cuda::thread_scope_device> next_ticket(sched[0]);
+        cuda::atomic_ref<int, cuda::thread_scope_device> retired_groups(sched[1]);
+        int retired = retired_groups.fetch_add(1, cuda::memory_order_acq_rel);
+        if (retired == num_groups - 1)
+        {
+            next_ticket.store(0, cuda::memory_order_relaxed);
+            retired_groups.store(0, cuda::memory_order_relaxed);
+        }
+    }
+}
diff --git a/ignition/recipes/deepseek41/exl3/kernels/xmoe/quant/exl3_prep.cu b/ignition/recipes/deepseek41/exl3/kernels/xmoe/quant/exl3_prep.cu
new file mode 100644
index 00000000..8484175d
--- /dev/null
+++ b/ignition/recipes/deepseek41/exl3/kernels/xmoe/quant/exl3_prep.cu
@@ -0,0 +1,134 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 Flare community contributors
+// SPDX-License-Identifier: Apache-2.0
+//
+// exp/ds41-exl3-next (2026-11-16): fused decode routing prep for flare::ds41_exl3_moe (FLARE_DS41_EXL3_FUSED_PREP=1).
+// One launch replaces the op's torch glue at decode (~18 launches, ~20 us per layer in the seq229 profile):
+//   flat = ids.reshape(-1); order = argsort(flat, stable=True); token_sorted = order // top_k
+//   weight_sorted = weights.reshape(-1)[order].half(); counts = bincount(flat, minlength=E1)
+//   hot = where(slot < hot_rows, counts, -counts); cold = -hot; x16 = hidden.half(); acc = 0 (fp32)
+// Block 0 does the routing (counting sort; a route's position = its expert's offset + the number of earlier routes to
+// the same expert, which is exactly the stable argsort order); blocks 1.. convert the activations and zero the
+// accumulator. Every output is integer or a single round-to-nearest conversion, so it is bit-identical to the torch path.
+#include <cuda_fp16.h>
+#include <cuda_bf16.h>
+#include <cub/block/block_scan.cuh>
+#include <torch/extension.h>
+#include <c10/cuda/CUDAStream.h>
+#include <c10/cuda/CUDAGuard.h>
+
+namespace {
+
+constexpr int PREP_THREADS = 512;
+
+// explicit conversions (the extension builds with __CUDA_NO_HALF_CONVERSIONS__ / __CUDA_NO_BFLOAT16_CONVERSIONS__)
+__device__ __forceinline__ float to_f(float v) { return v; }
+__device__ __forceinline__ float to_f(half v) { return __half2float(v); }
+__device__ __forceinline__ float to_f(__nv_bfloat16 v) { return __bfloat162float(v); }     // max routes (rows * top_k) and max bins (num_experts + 1) per launch
+
+template <typename IdT, typename WT, typename HT>
+__global__ __launch_bounds__(PREP_THREADS)
+void xmoe_decode_prep_kernel(const IdT* __restrict__ ids, const WT* __restrict__ weights, const HT* __restrict__ hidden,
+                             int routes, int top_k, int bins, int hot_rows, int64_t elements,
+                             int64_t* __restrict__ token_sorted, half* __restrict__ weight_sorted,
+                             int64_t* __restrict__ counts_hot, int64_t* __restrict__ counts_cold,
+                             half* __restrict__ x16, float* __restrict__ acc)
+{
+    if (blockIdx.x > 0)
+    {
+        const int64_t stride = (int64_t) (gridDim.x - 1) * blockDim.x;
+        for (int64_t k = (int64_t) (blockIdx.x - 1) * blockDim.x + threadIdx.x; k < elements; k += stride)
+        {
+            x16[k] = __float2half_rn(to_f(hidden[k]));
+            acc[k] = 0.0f;
+        }
+        return;
+    }
+    using Scan = cub::BlockScan<int, PREP_THREADS>;
+    __shared__ typename Scan::TempStorage scan_tmp;
+    __shared__ int s_hist[PREP_THREADS];
+    __shared__ int s_off[PREP_THREADS];
+    __shared__ int s_flat[PREP_THREADS];
+    const int t = threadIdx.x;
+    s_hist[t] = 0;
+    __syncthreads();
+    int e = -1;
+    if (t < routes)
+    {
+        e = (int) ids[t];
+        if (e < 0 || e >= bins) __trap();       // the torch path's scatter_add device-asserts on the same input
+        s_flat[t] = e;
+        atomicAdd(&s_hist[e], 1);
+    }
+    __syncthreads();
+    const int c = s_hist[t];
+    int off;
+    Scan(scan_tmp).ExclusiveSum(c, off);
+    s_off[t] = off;
+    if (t < bins)
+    {
+        counts_hot[t] = t < hot_rows ? c : -c;
+        counts_cold[t] = t < hot_rows ? -c : c;
+    }
+    __syncthreads();
+    if (t < routes)
+    {
+        int rank = 0;
+        for (int j = 0; j < t; ++j) rank += s_flat[j] == e;
+        const int pos = s_off[e] + rank;
+        token_sorted[pos] = t / top_k;
+        weight_sorted[pos] = __float2half_rn(to_f(weights[t]));
+    }
+}
+
+}  // namespace
+
+// ids [R, K] int32/int64 in [0, bins); weights [R, K] fp32/bf16; hidden [R, H] bf16/fp16 contiguous. hot_rows = the
+// bank's VRAM rows (bins for an unparked bank, so hot == counts). Outputs as the torch path: token_sorted [R*K] int64,
+// weight_sorted [R*K] fp16, counts_hot/counts_cold [bins] int64, x16 [R, H] fp16, acc [R, H] fp32 (zeroed).
+void xmoe_decode_prep(at::Tensor ids, at::Tensor weights, at::Tensor hidden, int64_t hot_rows,
+                      at::Tensor token_sorted, at::Tensor weight_sorted, at::Tensor counts_hot, at::Tensor counts_cold,
+                      at::Tensor x16, at::Tensor acc)
+{
+    const at::cuda::OptionalCUDAGuard guard(device_of(hidden));
+    auto stream = at::cuda::getCurrentCUDAStream().stream();
+    TORCH_CHECK(ids.dim() == 2 && weights.sizes() == ids.sizes() && hidden.dim() == 2 && hidden.size(0) == ids.size(0),
+                "xmoe_decode_prep: ids/weights [R, K], hidden [R, H]");
+    TORCH_CHECK(ids.is_contiguous() && weights.is_contiguous() && hidden.is_contiguous(), "xmoe_decode_prep: contiguous inputs");
+    const int routes = (int) ids.numel(), top_k = (int) ids.size(1), bins = (int) counts_hot.numel();
+    TORCH_CHECK(routes <= PREP_THREADS && bins <= PREP_THREADS, "xmoe_decode_prep: at most 512 routes and 512 bins");
+    TORCH_CHECK(token_sorted.numel() == routes && token_sorted.scalar_type() == at::kLong
+                && weight_sorted.numel() == routes && weight_sorted.scalar_type() == at::kHalf
+                && counts_cold.numel() == bins && counts_hot.scalar_type() == at::kLong && counts_cold.scalar_type() == at::kLong,
+                "xmoe_decode_prep: token_sorted int64 [R*K], weight_sorted fp16 [R*K], counts int64 [bins]");
+    TORCH_CHECK(x16.sizes() == hidden.sizes() && x16.scalar_type() == at::kHalf && acc.sizes() == hidden.sizes()
+                && acc.scalar_type() == at::kFloat && x16.is_contiguous() && acc.is_contiguous(),
+                "xmoe_decode_prep: x16 fp16 and acc fp32 shaped like hidden");
+    const int64_t elements = hidden.numel();
+    const int extra = (int) std::min<int64_t>(64, std::max<int64_t>(1, (elements + PREP_THREADS * 8 - 1) / (PREP_THREADS * 8)));
+    const int hot = (int) std::min<int64_t>(hot_rows, bins);
+
+#define PREP_LAUNCH(IDT, WT, HT)                                                                                        \
+    xmoe_decode_prep_kernel<IDT, WT, HT><<<1 + extra, PREP_THREADS, 0, stream>>>(                                       \
+        ids.data_ptr<IDT>(), reinterpret_cast<const WT*>(weights.data_ptr()), reinterpret_cast<const HT*>(hidden.data_ptr()), \
+        routes, top_k, bins, hot, elements, token_sorted.data_ptr<int64_t>(),                                          \
+        reinterpret_cast<half*>(weight_sorted.data_ptr()), counts_hot.data_ptr<int64_t>(), counts_cold.data_ptr<int64_t>(), \
+        reinterpret_cast<half*>(x16.data_ptr()), acc.data_ptr<float>())
+
+#define PREP_H(IDT, WT)                                                                                                 \
+    if (hidden.scalar_type() == at::kBFloat16) PREP_LAUNCH(IDT, WT, __nv_bfloat16);                                     \
+    else if (hidden.scalar_type() == at::kHalf) PREP_LAUNCH(IDT, WT, half);                                             \
+    else TORCH_CHECK(false, "xmoe_decode_prep: hidden must be bf16 or fp16")
+
+#define PREP_W(IDT)                                                                                                     \
+    if (weights.scalar_type() == at::kFloat) { PREP_H(IDT, float); }                                                    \
+    else if (weights.scalar_type() == at::kBFloat16) { PREP_H(IDT, __nv_bfloat16); }                                   \
+    else TORCH_CHECK(false, "xmoe_decode_prep: weights must be fp32 or bf16")
+
+    if (ids.scalar_type() == at::kLong) { PREP_W(int64_t); }
+    else if (ids.scalar_type() == at::kInt) { PREP_W(int32_t); }
+    else TORCH_CHECK(false, "xmoe_decode_prep: ids must be int32 or int64");
+#undef PREP_W
+#undef PREP_H
+#undef PREP_LAUNCH
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
diff --git a/ignition/recipes/deepseek41/exl3/kernels/xmoe/quant/hadamard_inner.cuh b/ignition/recipes/deepseek41/exl3/kernels/xmoe/quant/hadamard_inner.cuh
new file mode 100644
index 00000000..9f85c256
--- /dev/null
+++ b/ignition/recipes/deepseek41/exl3/kernels/xmoe/quant/hadamard_inner.cuh
@@ -0,0 +1,473 @@
+#pragma once
+#include "../compat.cuh"
+
+#define ACT_SILU 0
+#define ACT_GELU 1
+// Non-gated relu2 (NemotronH): the g input is unused (its GEMM is skipped by the caller); the
+// gate lane is set to relu(u) so the gate multiply below yields relu(u) * u = relu^2(u) exactly
+#define ACT_RELU2_NOGATE 2
+
+// Hadamard transform 128-element vector across one warp, with optional pre and post scales
+
+__device__ inline half hreduce(half2 x)
+{
+    return __hadd(__low2half(x), __high2half(x));
+}
+
+__device__ inline void shuffle_had_f4x32(float& h0, float& h1, float& h2, float& h3, const int lane_id)
+{
+    #pragma unroll
+    for (int i = 1; i < 32; i <<= 1)
+    {
+        uint32_t i0 = __float_as_uint(h0);
+        uint32_t i1 = __float_as_uint(h1);
+        uint32_t i2 = __float_as_uint(h2);
+        uint32_t i3 = __float_as_uint(h3);
+        uint64_t h01 =  (uint64_t) i0 | (((uint64_t) i1) << 32);
+        uint64_t h23 =  (uint64_t) i2 | (((uint64_t) i3) << 32);
+        uint64_t ph01 = __shfl_xor_sync(0xffffffff, h01, i);
+        uint64_t ph23 = __shfl_xor_sync(0xffffffff, h23, i);
+        float ph0 = __uint_as_float((uint32_t) (ph01 & 0xffffffff));
+        float ph1 = __uint_as_float((uint32_t) (ph01 >> 32));
+        float ph2 = __uint_as_float((uint32_t) (ph23 & 0xffffffff));
+        float ph3 = __uint_as_float((uint32_t) (ph23 >> 32));
+        int32_t sfm = -static_cast<int32_t>(lane_id & i) >> 31;
+        i0 ^= sfm & 0x80000000;
+        i1 ^= sfm & 0x80000000;
+        i2 ^= sfm & 0x80000000;
+        i3 ^= sfm & 0x80000000;
+        h0 = __uint_as_float(i0) + ph0;
+        h1 = __uint_as_float(i1) + ph1;
+        h2 = __uint_as_float(i2) + ph2;
+        h3 = __uint_as_float(i3) + ph3;
+    }
+}
+
+__device__ inline void shuffle_had_f2x32(float& v, float& w, const int lane_id)
+{
+    #pragma unroll
+    for (int i = 1; i < 32; i <<= 1)
+    {
+        uint64_t vw = ((uint64_t) __float_as_uint(v)) | (((uint64_t) __float_as_uint(w)) << 32);
+        uint64_t pvw = __shfl_xor_sync(0xffffffff, vw, i);
+        float pv = __uint_as_float((uint32_t) (pvw & 0xffffffff));
+        float pw = __uint_as_float((uint32_t) (pvw >> 32));
+        uint32_t vi = __float_as_uint(v);
+        uint32_t wi = __float_as_uint(w);
+        int32_t sfm = -static_cast<int16_t>(lane_id & i) >> 31;
+        vi ^= (sfm & 0x80000000);
+        wi ^= (sfm & 0x80000000);
+        v = __uint_as_float(vi) + pv;
+        w = __uint_as_float(wi) + pw;
+    }
+}
+
+__device__ inline float shuffle_had_fx32(float v, const int lane_id)
+{
+    for (int i = 1; i < 32; i <<= 1)
+    {
+        float pv = __shfl_xor_sync(0xffffffff, v, i);
+        uint32_t* vi = reinterpret_cast<uint32_t*>(&v);
+        int32_t sfm = -static_cast<int16_t>(lane_id & i) >> 31;
+        *vi ^= (sfm & 0x80000000);
+        v = v + pv;
+    }
+    return v;
+}
+
+__device__ inline half2 shuffle_had_h2x32(half2 v, int lane_id)
+{
+    for (int i = 1; i < 32; i <<= 1)
+    {
+        half2 pv = __shfl_xor_sync(0xffffffff, v, i);
+        uint32_t* vi = reinterpret_cast<uint32_t*>(&v);
+        int32_t sfm = -static_cast<int16_t>(lane_id & i) >> 31;
+        *vi ^= (sfm & 0x80008000);
+        v = __hadd2(v, pv);
+    }
+    return v;
+}
+
+// Half vector, half scales
+
+template <bool pre_scale, bool post_scale>
+inline __device__
+void had_hf_r_128_inner
+(
+    const half* __restrict__ input_ptr,
+    half* __restrict__ output_ptr,
+    const half* __restrict__ scale,
+    const float r_scale
+)
+{
+    int t = threadIdx.x & 31;
+
+    // Load
+    half4 v = ((half4*) input_ptr)[t];
+
+    // Pre scale
+    if constexpr (pre_scale)
+    {
+        int i = blockIdx.y * 32 + t;
+        half4 scales = ((half4*) scale)[i];
+        v.x = __hmul2(v.x, scales.x);
+        v.y = __hmul2(v.y, scales.y);
+    }
+
+    // 4 element had
+    float v0 = __half2float(__low2half(v.x));
+    float v1 = __half2float(__high2half(v.x));
+    float v2 = __half2float(__low2half(v.y));
+    float v3 = __half2float(__high2half(v.y));
+    float s0 = v0 + v1;
+    float d0 = v0 - v1;
+    float s1 = v2 + v3;
+    float d1 = v2 - v3;
+    float h0 = s0 + s1;
+    float h1 = d0 + d1;
+    float h2 = s0 - s1;
+    float h3 = d0 - d1;
+
+    // 32 element had, warp shuffle
+    shuffle_had_f4x32(h0, h1, h2, h3, t);
+    v.x = __floats2half2_rn(h0 * r_scale, h1 * r_scale);
+    v.y = __floats2half2_rn(h2 * r_scale, h3 * r_scale);
+
+    // Post scale
+    if constexpr (post_scale)
+    {
+        int i = blockIdx.y * 32 + t;
+        half4 scales = ((half4*) scale)[i];
+        v.x = __hmul2(v.x, scales.x);
+        v.y = __hmul2(v.y, scales.y);
+    }
+
+    // Store
+    ((half4*) output_ptr)[t] = v;
+}
+
+// Float vector, half scales
+
+template <bool pre_scale, bool post_scale>
+inline __device__
+void had_ff_r_128_inner
+(
+    const float* __restrict__ input_ptr,
+    float* __restrict__ output_ptr,
+    const half* __restrict__ scale,
+    const float r_scale
+)
+{
+    int t = threadIdx.x & 31;
+
+    // Load
+    float4 v = ((float4*) input_ptr)[t];
+
+    // Pre scale
+    if constexpr (pre_scale)
+    {
+        int i = blockIdx.y * 32 + t;
+        half4 scales = ((half4*) scale)[i];
+        v.x *= __low2float(scales.x);
+        v.y *= __high2float(scales.x);
+        v.z *= __low2float(scales.y);
+        v.w *= __high2float(scales.y);
+    }
+
+    // 4 element had
+    float v0 = v.x;
+    float v1 = v.y;
+    float v2 = v.z;
+    float v3 = v.w;
+    float s0 = v0 + v1;
+    float d0 = v0 - v1;
+    float s1 = v2 + v3;
+    float d1 = v2 - v3;
+    v.x = s0 + s1;
+    v.y = d0 + d1;
+    v.z = s0 - s1;
+    v.w = d0 - d1;
+
+    // 32 element had, warp shuffle
+    shuffle_had_f2x32(v.x, v.y, t);
+    shuffle_had_f2x32(v.z, v.w, t);
+    v.x *= r_scale;
+    v.y *= r_scale;
+    v.z *= r_scale;
+    v.w *= r_scale;
+
+    // Post scale
+    if constexpr (post_scale)
+    {
+        int i = blockIdx.y * 32 + t;
+        half4 scales = ((half4*) scale)[i];
+        v.x *= __low2float(scales.x);
+        v.y *= __high2float(scales.x);
+        v.z *= __low2float(scales.y);
+        v.w *= __high2float(scales.y);
+    }
+
+    // Store
+    ((float4*) output_ptr)[t] = v;
+}
+
+// Float vector, half scales, half output
+
+template <bool pre_scale, bool post_scale>
+inline __device__
+void had_fh_r_128_inner
+(
+    const float* __restrict__ input_ptr,
+    half* __restrict__ output_ptr,
+    const half* __restrict__ scale,
+    const float r_scale
+)
+{
+    int t = threadIdx.x & 31;
+
+    // Load
+    float4 v = ((float4*) input_ptr)[t];
+
+    // Pre scale
+    if constexpr (pre_scale)
+    {
+        int i = blockIdx.y * 32 + t;
+        half4 scales = ((half4*) scale)[i];
+        v.x *= __low2float(scales.x);
+        v.y *= __high2float(scales.x);
+        v.z *= __low2float(scales.y);
+        v.w *= __high2float(scales.y);
+    }
+
+    // 4 element had
+    float v0 = v.x;
+    float v1 = v.y;
+    float v2 = v.z;
+    float v3 = v.w;
+    float s0 = v0 + v1;
+    float d0 = v0 - v1;
+    float s1 = v2 + v3;
+    float d1 = v2 - v3;
+    v.x = s0 + s1;
+    v.y = d0 + d1;
+    v.z = s0 - s1;
+    v.w = d0 - d1;
+
+    // 32 element had, warp shuffle
+    shuffle_had_f2x32(v.x, v.y, t);
+    shuffle_had_f2x32(v.z, v.w, t);
+    v.x *= r_scale;
+    v.y *= r_scale;
+    v.z *= r_scale;
+    v.w *= r_scale;
+
+    half4 o;
+    o.x = __floats2half2_rn(v.x, v.y);
+    o.y = __floats2half2_rn(v.z, v.w);
+
+    // Post scale
+    if constexpr (post_scale)
+    {
+        int i = blockIdx.y * 32 + t;
+        half4 scales = ((half4*) scale)[i];
+        o.x = __hmul2(o.x, scales.x);
+        o.y = __hmul2(o.y, scales.y);
+    }
+
+    // Store
+    ((half4*) output_ptr)[t] = o;
+}
+
+// Fused op: o <- in_had(silu(out_had(g)) * out_had(u))
+
+inline __device__
+void had_hf_r_128_guad_inner
+(
+    const half* __restrict__ input_ptr_g,
+    const half* __restrict__ input_ptr_u,
+    half* __restrict__ output_ptr,
+    const half* __restrict__ post_scale_g,
+    const half* __restrict__ post_scale_u,
+    const half* __restrict__ pre_scale_d,
+    const float r_scale,
+    const float act_limit,
+    const int act_function
+)
+{
+    int t = threadIdx.x & 31;
+
+    auto had = [&](half4& v)
+    {
+        // 4 element had
+        float v0 = __half2float(__low2half(v.x));
+        float v1 = __half2float(__high2half(v.x));
+        float v2 = __half2float(__low2half(v.y));
+        float v3 = __half2float(__high2half(v.y));
+        float s0 = v0 + v1;
+        float d0 = v0 - v1;
+        float s1 = v2 + v3;
+        float d1 = v2 - v3;
+        float h0 = s0 + s1;
+        float h1 = d0 + d1;
+        float h2 = s0 - s1;
+        float h3 = d0 - d1;
+
+        // 32 element had, warp shuffle
+        shuffle_had_f4x32(h0, h1, h2, h3, t);
+        v.x = __floats2half2_rn(h0 * r_scale, h1 * r_scale);
+        v.y = __floats2half2_rn(h2 * r_scale, h3 * r_scale);
+
+        return v;
+    };
+
+    auto _silu = [&](const half2& x)
+    {
+        half2 one = __float2half2_rn(1.0f);
+        half2 neg_x = __hneg2(x);
+        half2 e = h2exp(neg_x);
+        half2 sum = __hadd2(one, e);
+        half2 r = h2rcp(sum);
+        half2 result = __hmul2(x, r);
+        return result;
+    };
+
+    auto _gelu = [&](const half2& x)
+    {
+        float2 xf = __half22float2(x);
+        const float c = 0.797884560803f;  // sqrt(2/Pi)
+        xf.x = 0.5f * xf.x * (1.0f + tanh_opt(c * (xf.x + 0.044715f * xf.x * xf.x * xf.x)));
+        xf.y = 0.5f * xf.y * (1.0f + tanh_opt(c * (xf.y + 0.044715f * xf.y * xf.y * xf.y)));
+        return __float22half2_rn(xf);
+    };
+
+    // Load. In non-gated mode the g buffer holds no data (its GEMM is skipped); the gate lane
+    // is synthesized from u in the activation switch below
+    half4 vg = {};
+    half4 vu = ((half4*) input_ptr_u)[t];
+
+    // Hadamard
+    vu = had(vu);
+
+    // Post scale
+    int i = blockIdx.y * 32 + t;
+    half4 scales_u = ((half4*) post_scale_u)[i];
+    vu.x = __hmul2(vu.x, scales_u.x);
+    vu.y = __hmul2(vu.y, scales_u.y);
+
+    if (act_function != ACT_RELU2_NOGATE)
+    {
+        vg = ((half4*) input_ptr_g)[t];
+        vg = had(vg);
+        half4 scales_g = ((half4*) post_scale_g)[i];
+        vg.x = __hmul2(vg.x, scales_g.x);
+        vg.y = __hmul2(vg.y, scales_g.y);
+    }
+
+    // Activation
+    switch (act_function)
+    {
+        case ACT_SILU:
+            vg.x = _silu(vg.x);
+            vg.y = _silu(vg.y);
+            break;
+
+        case ACT_GELU:
+            vg.x = _gelu(vg.x);
+            vg.y = _gelu(vg.y);
+            break;
+
+        case ACT_RELU2_NOGATE:
+            vg.x = __hmax2(vu.x, __float2half2_rn(0.0f));
+            vg.y = __hmax2(vu.y, __float2half2_rn(0.0f));
+            break;
+
+        default:
+            break;
+    }
+
+    // Optional activation limits
+    if (act_limit != 0.0f)
+    {
+        vu.x = __hmax2(vu.x, __float2half2_rn(-act_limit));
+        vu.y = __hmax2(vu.y, __float2half2_rn(-act_limit));
+        vu.x = __hmin2(vu.x, __float2half2_rn(act_limit));
+        vu.y = __hmin2(vu.y, __float2half2_rn(act_limit));
+        vg.x = __hmin2(vg.x, __float2half2_rn(act_limit));
+        vg.y = __hmin2(vg.y, __float2half2_rn(act_limit));
+    }
+
+    // Gate
+    vg.x = __hmul2(vg.x, vu.x);
+    vg.y = __hmul2(vg.y, vu.y);
+
+    // Pre scale (d)
+    half4 scales_d = ((half4*) pre_scale_d)[i];
+    vg.x = __hmul2(vg.x, scales_d.x);
+    vg.y = __hmul2(vg.y, scales_d.y);
+
+    // Hadamard
+    vg = had(vg);
+
+    // Store
+    ((half4*) output_ptr)[t] = vg;
+}
+
+// Fused op: o += float(out_had(i)), atomic
+
+inline __device__
+void had_hf_r_128_d_inner
+(
+    const half* __restrict__ input_ptr,
+    float* __restrict__ output_ptr,
+    const half* __restrict__ post_scale,
+    const float r_scale
+)
+{
+    int t = threadIdx.x & 31;
+
+    // Load
+    half4 v = ((half4*) input_ptr)[t];
+
+    // 4 element had
+    float v0 = __half2float(__low2half(v.x));
+    float v1 = __half2float(__high2half(v.x));
+    float v2 = __half2float(__low2half(v.y));
+    float v3 = __half2float(__high2half(v.y));
+    float s0 = v0 + v1;
+    float d0 = v0 - v1;
+    float s1 = v2 + v3;
+    float d1 = v2 - v3;
+    float h0 = s0 + s1;
+    float h1 = d0 + d1;
+    float h2 = s0 - s1;
+    float h3 = d0 - d1;
+
+    // 32 element had, warp shuffle
+    shuffle_had_f4x32(h0, h1, h2, h3, t);
+    h0 *= r_scale;
+    h1 *= r_scale;
+    h2 *= r_scale;
+    h3 *= r_scale;
+
+    // Post scale
+    int i = blockIdx.y * 32 + t;
+    half4 scales = ((half4*) post_scale)[i];
+    h0 *= __low2float(scales.x);
+    h1 *= __high2float(scales.x);
+    h2 *= __low2float(scales.y);
+    h3 *= __high2float(scales.y);
+
+    // Reshuffle in shmem for coalesced store with atomicAdd
+    extern __shared__ float temp_shared[];
+    int warp_id = threadIdx.x / 32;
+    float* sh = temp_shared + warp_id * 128;
+    sh[t * 4 + 0] = h0;
+    sh[t * 4 + 1] = h1;
+    sh[t * 4 + 2] = h2;
+    sh[t * 4 + 3] = h3;
+    __syncwarp();
+    atomicAdd(output_ptr +  0 + t, sh[ 0 + t]);
+    atomicAdd(output_ptr + 32 + t, sh[32 + t]);
+    atomicAdd(output_ptr + 64 + t, sh[64 + t]);
+    atomicAdd(output_ptr + 96 + t, sh[96 + t]);
+}
