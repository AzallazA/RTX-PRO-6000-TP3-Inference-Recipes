++                       (const half*) suh[s] + off * 128, 0.088388347648f);
++    }
++    grid_sync();
++
++    exl3_gemm_kernel_inner_flat_dense<bits, false, cb, 16, XDENSE_TK, XDENSE_TN, XDENSE_SH, 1>(jobs, K, W, locks);
++    grid_sync();
