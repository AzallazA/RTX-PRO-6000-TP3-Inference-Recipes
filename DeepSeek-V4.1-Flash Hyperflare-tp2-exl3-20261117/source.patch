+                for row in execution..rows {
+                    let range = &layout.aliases[(row - execution) as usize];
+                    let pages = conflicts(&layout, &geometry, row);
+                    if pages.is_empty() {
+                        padded += u64::from(range.is_empty());
+                        assert_eq!(*range, 0..0, "row {row}");
