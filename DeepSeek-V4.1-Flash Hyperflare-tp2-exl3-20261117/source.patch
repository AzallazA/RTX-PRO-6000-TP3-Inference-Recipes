+        mats[e] = {name: (rng.standard_normal((i, o)) / np.sqrt(i), rng.choice([-1.0, 1.0], i) * rng.uniform(0.5, 1.5, i),
+                          rng.uniform(0.5, 1.5, o))
+                   for name, (i, o) in (("w1", (hidden, inter)), ("w3", (hidden, inter)), ("w2", (inter, hidden)))}
