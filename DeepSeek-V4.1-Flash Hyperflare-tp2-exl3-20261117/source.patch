++    TORCH_CHECK(x.dtype() == out.dtype() && (x.dtype() == torch::kHalf || x.dtype() == torch::kBFloat16), "xdense: x/out fp16 or bf16, same dtype");
++    if (x.dtype() == torch::kBFloat16)
