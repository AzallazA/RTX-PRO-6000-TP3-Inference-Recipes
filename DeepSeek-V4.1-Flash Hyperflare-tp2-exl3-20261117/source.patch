+        if summed:
+            ex.ds41_exl3_moe_after_sum(0, x, ids.long(), w, shared, out, 10.0)
+            outs[summed] = out
+        else:
+            ex.ds41_exl3_moe_after(0, x, ids.long(), w, shared, out, 10.0)
+            outs[summed] = out + shared
