+        extra_chunk_end = split_last_chunk
+        extra_valid_end = num_main_chunks + extra_valid_chunks
+        if extra_chunk_end > extra_valid_end:
+            extra_chunk_end = extra_valid_end
+        extra_chunk_count = extra_chunk_end - extra_first_chunk
