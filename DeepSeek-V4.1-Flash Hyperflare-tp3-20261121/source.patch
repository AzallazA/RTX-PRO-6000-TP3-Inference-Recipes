+    assert np.array_equal(s["early"][0, 7, :6].numpy(), _numpy_predict(attn_in, *own))
+    assert (s["nxt"][0, 39] == -1).all() and np.array_equal(s["early"][0, 39, :6].numpy(), _numpy_predict(attn_in, *own))
