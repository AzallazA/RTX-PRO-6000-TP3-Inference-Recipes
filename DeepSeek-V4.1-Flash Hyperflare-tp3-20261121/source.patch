+@pytest.mark.parametrize("name,reader", [("FLARE_DS41_EXL3_MERGE_TOPK", merges.merge_topk),
+                                         ("FLARE_DS41_EXL3_MERGE_ROPEQ", merges.merge_ropeq),
+                                         ("FLARE_DS41_EXL3_MERGE_EPILOGUE", merges.merge_epilogue)])
