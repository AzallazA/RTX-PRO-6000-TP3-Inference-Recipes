+    with pytest.raises(ValueError, match="expected one of 768, 704"):
+        _expert_columns(3)
+    monkeypatch.setenv("FLARE_GLM53_EXPERT_COLUMNS", "704")
+    for world in (1, 2, 4):
+        with pytest.raises(ValueError, match="three ranks only"):
+            _expert_columns(world)
+
