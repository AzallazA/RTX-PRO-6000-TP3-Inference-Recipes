+        case 6: return stage ? exl3_moe_kernel_pb_k3_n128_cb2_s6_st1() : exl3_moe_kernel_pb_k3_n128_cb2_s6_st0();
+        case 8: return stage ? exl3_moe_kernel_pb_k3_n128_cb2_s8_st1() : exl3_moe_kernel_pb_k3_n128_cb2_s8_st0();
