+        metadata = SimpleNamespace(token_ids=torch.zeros(residual.shape[0], dtype=torch.int64))
+        incoming, pre_mix, _, _ = layer((residual,), pre_mix, metadata, indices, (None, None, None), token_scale=scale)
+        return (*incoming, pre_mix)
