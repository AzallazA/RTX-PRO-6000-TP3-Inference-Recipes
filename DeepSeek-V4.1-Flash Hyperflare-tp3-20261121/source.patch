+        if a.dtype in (torch.float16, torch.float32):
+            assert np.array_equal(a.numpy().view(np.uint16 if a.dtype == torch.float16 else np.uint32),
+                                  b.view(np.uint16 if b.dtype == np.float16 else np.uint32)), name
