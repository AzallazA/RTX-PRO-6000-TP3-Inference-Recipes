+def _draft_vocab_tool():
+    import importlib.util
+    path = Path(__file__).resolve().parents[2] / "tp3-tools" / "ds41_draft_vocab.py"
+    spec = importlib.util.spec_from_file_location("ds41_draft_vocab", path)
