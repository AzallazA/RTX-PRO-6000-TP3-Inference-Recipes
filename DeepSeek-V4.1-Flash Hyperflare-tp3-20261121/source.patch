+            meta.convolution_slots.copy_(torch.tensor([1, -1]))
+            meta.state_indices.zero_()
+            meta.state_indices[0, 0] = 1
+            meta.num_seqs.fill_(2)
+            meta.num_tokens.fill_(length)
