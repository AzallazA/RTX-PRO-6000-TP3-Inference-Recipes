+        acc[vc][1] = acc[vc][1] + xv1
+        acc[vc][2] = acc[vc][2] + xv2
+        acc[vc][3] = acc[vc][3] + xv3
+        acc2[vc][0] = acc2[vc][0] + yv0
+        acc2[vc][1] = acc2[vc][1] + yv1
+        acc2[vc][2] = acc2[vc][2] + yv2
+        acc2[vc][3] = acc2[vc][3] + yv3
