+"""Print steps/s and tokens/step per cell from llm_decode_bench (>=0.9) JSON results for a Flare server."""
+import json, sys
+for path in sys.argv[1:]:
+    d = json.load(open(path))
+    print(path.rsplit("/", 1)[-1])
+    print(f"  {'ctx':>6} {'conc':>4} {'tok/s':>7} {'steps/s':>8} {'tok/step':>8} {'accept':>6} {'GPU busy':>8} {'engram wait':>11}")
+    for r in d["results"]:
+        f = r.get("server_flare_metrics") or {}
+        if not f.get("valid"):
+            continue
+        c, s = f["counter_delta"], f["measurement_seconds"]
+        steps = f["verification_graphs_per_second"]
+        tps = r.get("aggregate_tps", 0)
+        print(f"  {r.get('context_label', r.get('context', '?')):>6} {r.get('concurrency', '?'):>4} {tps:7.1f} {steps:8.1f} "
+              f"{c['raw_emitted_tokens'] / c['verification_graphs']:8.2f} {f['raw_draft_acceptance']:6.2f} "
+              f"{c['verification_gpu_nanoseconds'] / 1e9 / s * 100:7.0f}% {c['embedding_readiness_nanoseconds'] / 1e9 / s * 100:10.1f}%")
diff --git a/tp3-tools/consistency.py b/tp3-tools/consistency.py
new file mode 100644
index 00000000..af53f176
--- /dev/null
+++ b/tp3-tools/consistency.py
@@ -0,0 +1,78 @@
+#!/usr/bin/env python3
+"""Decode-vs-prefill consistency for any model, including meaningless truncated ones.
+
+Each prompt is sent as token IDs; generated tokens are mapped back to IDs with the local tokenizer (a sequence stops at
+the first token string that maps to several IDs), so every teacher-forced prefill sees exactly the decoded IDs - no
+re-tokenization drift. Prefill always runs Flare's own path, so a decode-only change (BRRR layers) must stay within the
+floor measured on a build without it. Reports |delta logprob| of the decode top-1 token and top-1 agreement.
+  .venv/bin/python consistency.py [tokens=48] [prompts=4] [tokenizer dir]   (tokenizer dir default: $CKPT, the checkpoint view)
+
+The one-token prefill reply can be empty: Flare samples at temperature 1.0 and returns no logprob record for a
+terminating end-of-sequence token (helios/src/server/runtime.rs, `terminating_eos`), so the reply's top_logprobs list
+is empty when the single sampled token is EOS. The top-5 distribution does not depend on the sample, so such a request
+is retried (RETRIES extra attempts); a position still empty after that is skipped and counted. The counts are appended
+at the end of the summary line, which otherwise keeps its format.
+"""
+import json
+import os
+import statistics
+import sys
+import urllib.request
+
+from transformers import PreTrainedTokenizerFast
+
+URL = os.environ.get("CONSISTENCY_URL", "http://localhost:15015/v1/completions")
+RETRIES = 4
+PROMPTS = ["def fibonacci(n):\n    ", "The capital of France is", "for (int i = 0; i < n; ++i) {\n    ",
+           "Once upon a time, in a small village,", "import numpy as np\nx = np.", "SELECT name, age FROM users WHERE"]
+
+n = int(sys.argv[1]) if len(sys.argv) > 1 else 48
+k = int(sys.argv[2]) if len(sys.argv) > 2 else 4
+root = sys.argv[3] if len(sys.argv) > 3 else os.environ.get("CKPT") or sys.exit("pass the checkpoint view (tokenizer.json) as the third argument or set CKPT")
+tok = PreTrainedTokenizerFast(tokenizer_file=f"{root}/tokenizer.json")
+pieces = {}
+for i in range(len(tok)):
+    pieces.setdefault(tok.decode([i]), []).append(i)
+
+
+def post(body):
+    req = urllib.request.Request(URL, json.dumps({"model": "DeepSeek-V4.1-Flash", **body}).encode(),
+                                 {"Content-Type": "application/json"})
+    return json.load(urllib.request.urlopen(req, timeout=600))["choices"][0]["logprobs"]
+
+
+deltas, agree, total, stopped, retried, skipped = [], 0, 0, 0, 0, 0
+for prompt in PROMPTS[:k]:
+    ids = [tok.bos_token_id or 0] + tok.encode(prompt, add_special_tokens=False)
+    lp = post({"prompt": ids, "max_tokens": n, "top_p": 1.0, "logprobs": 5})
+    generated = []
+    for text in lp["tokens"]:
+        match = pieces.get(text, [])
+        if len(match) != 1:
+            stopped += 1
+            break
+        generated.append(match[0])
+    for i in range(len(generated)):
+        ref = None
+        for attempt in range(1 + RETRIES):
+            top = (post({"prompt": ids + generated[:i], "max_tokens": 1, "top_p": 1.0, "logprobs": 5}) or {}).get("top_logprobs")
+            if top:
+                ref = top[0]
+                break
+            if attempt < RETRIES:
+                retried += 1
+        if ref is None:
+            skipped += 1
+            continue
+        dec = lp["top_logprobs"][i]
+        best = max(dec, key=dec.get)
+        total += 1
+        agree += best == max(ref, key=ref.get)
+        deltas.append(abs(dec[best] - ref[best]) if best in ref else float("inf"))
+finite = sorted(d for d in deltas if d != float("inf"))
+q = lambda p: finite[min(len(finite) - 1, int(p * len(finite)))] if finite else float("nan")
+print(f"{total} positions ({stopped} sequences cut at ambiguous tokens): top-1 agree {agree / max(total, 1):.3f}, "
+      f"decode top-1 missing from prefill top-5 {len(deltas) - len(finite)}, |dlogprob| median "
+      f"{statistics.median(finite) if finite else float('nan'):.4f} p90 {q(0.9):.4f} p99 {q(0.99):.4f} "
+      f"max {finite[-1] if finite else float('nan'):.4f}, empty one-token replies retried {retried}, "
+      f"positions skipped {skipped}")
