+#include "exl3_gemm_inner_flat.cuh"
+
+struct FlatDenseJobs
+{
+    int num_jobs;
+    const int64_t* a_ptr;   // [num_jobs] fp16 A, row stride size_k
+    const int64_t* b_ptr;   // [num_jobs] trellis of the slice's first n-block
