+                    same = a.shape == b.shape and bool(torch.equal(a, b))
+                    print(f"[brrr] rank {r} layer {index} native {name} {tuple(t.shape)} {t.dtype} "
+                          f"stride {tuple(t.stride())}: {'identical' if same else f'MISMATCH vs {tuple(b.shape)}'}", flush=True)
