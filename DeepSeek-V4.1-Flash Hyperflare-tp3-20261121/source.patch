+struct Scratch {
+  unsigned* epoch;
+  unsigned* counters;
+  Table* table;
+  float* zacc;
+  uint8_t* zq;
+  uint8_t* zse;
+  float* yacc;
+  __nv_bfloat16* yattn;
+  float* mixp;
+  __nv_bfloat16* xc;
+  float* xsq;
+  __nv_bfloat16* xbf;
+  uint8_t* xq;
+  uint8_t* xse;
+  long long* gacc;
+  float* topk_w;
+  float* sacc;
+  uint8_t* hsq;
+  uint8_t* hse;
+  float* shacc;
+  float* hacc;
+  uint8_t* hq;
+  uint8_t* hqe;
+  float* yracc;
+#if BRRR_STEER
+  // Per-token steering dots in fixed point (x 2^32, like gacc: integer adds, so the sum is independent of the order
+  // of the partial contributions). adot = yattn . d (replicated rows, identical on every rank), sdot = h . (W2^T d)
