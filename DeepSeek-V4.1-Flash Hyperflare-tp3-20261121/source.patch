+#ifndef BRRR_SPIN_NS
+#define BRRR_SPIN_NS 200
+#endif
+constexpr unsigned SPIN_NS = BRRR_SPIN_NS;
+static_assert(TWO_SHOT_MIN >= 1 && TWO_SHOT_MIN <= MAXM + 1 && BRRR_SPIN_NS >= 0 && BRRR_SPIN_NS <= 1000000, "BRRR tuning switch values");
