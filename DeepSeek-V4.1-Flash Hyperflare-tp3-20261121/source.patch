+
+def test_switches_parse_and_reject_bad_values(monkeypatch):
+    monkeypatch.setenv(export_speed.FORWARD_WORKERS_ENV, "9")
+    monkeypatch.setenv(export_speed.FORWARD_WORKER_GIB_ENV, "16")
