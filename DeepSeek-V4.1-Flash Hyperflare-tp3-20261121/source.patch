+
+_ENV = (export_speed.FORWARD_WORKERS_ENV, export_speed.FORWARD_WORKER_GIB_ENV,
+        export_speed.FORWARD_WORKER_VRAM_MIB_ENV, export_speed.TUNE_ONLY_ENV)
