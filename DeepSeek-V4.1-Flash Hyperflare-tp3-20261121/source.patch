+++ b/tests/components/test_sparse_mla_functional_poison.py
@@ -0,0 +1,75 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 Flare community contributors
+# SPDX-License-Identifier: Apache-2.0
+
+"""Functional sparse MLA output and LSE are wholly copied from b12x's result, so they need no zero fill."""
+
+import pytest
+import torch
+
+from ignition.components import sparse_mla
+
+ROWS, HEADS, DIM = 3, 4, 8
+
+
+def _poisoned(empty_strided):
+    def allocate(*args, **kwargs):
+        tensor = empty_strided(*args, **kwargs)
+        tensor.view(torch.uint8).fill_(0xFF)
+        return tensor
+    return allocate
+
+
+@pytest.mark.parametrize("return_lse", [False, True])
+def test_functional_output_and_lse_are_every_element_copied(monkeypatch, return_lse):
+    result = torch.randn(ROWS, HEADS, DIM).bfloat16()
+    result[-1] = 0  # b12x writes idle rows as exact zero in its own scratch result.
+    result_lse = torch.randn(ROWS, HEADS)
+    result_lse[-1] = float("-inf")
+    owner = object.__new__(sparse_mla.PreparedSparseMLA)
+    owner.output = None
+    owner.output_layout = (ROWS, HEADS, DIM), (HEADS * DIM, DIM, 1), torch.bfloat16
+    owner.return_lse = return_lse
+    owner.lse_layout = ((ROWS, HEADS), (HEADS, 1)) if return_lse else None
+    owner.scratch_layout = (((64,), torch.uint8),)
+    owner.inputs = {"kv_cache": torch.zeros(1, 1, 1), "attention_sink": None}
+    owner.plan = type("Plan", (), {"handle": 7})()
+    seen = {}
+
+    def run(binding):
+        seen["output"] = binding["output_seen"]
+        return (result, result_lse) if return_lse else result
+
+    def bind(plan, **kwargs):
+        return {"output_seen": True}
+
+    monkeypatch.setattr(sparse_mla, "plan_from_handle", lambda handle: handle)
+    monkeypatch.setattr(sparse_mla.sparse_mla, "bind", bind)
+    monkeypatch.setattr(sparse_mla.sparse_mla, "run", run)
+    monkeypatch.setattr(torch, "empty_strided", _poisoned(torch.empty_strided))
+    returned = owner(torch.zeros(ROWS, HEADS, DIM), torch.zeros(ROWS, 1, dtype=torch.int32),
+                     torch.zeros(ROWS, dtype=torch.int32), torch.zeros(ROWS, dtype=torch.int32))
+    output, lse = returned if return_lse else (returned, None)
+    assert seen["output"]
+    assert torch.equal(output.view(torch.int16), result.view(torch.int16))
+    assert not output[-1].count_nonzero()
+    if return_lse:
+        assert torch.equal(lse.view(torch.int32), result_lse.view(torch.int32))
+
+
+def test_functional_call_hands_unfilled_storage_to_the_operator(monkeypatch):
+    owner = object.__new__(sparse_mla.PreparedSparseMLA)
+    owner.output = None
+    owner.output_layout = (ROWS, HEADS, DIM), (HEADS * DIM, DIM, 1), torch.bfloat16
+    owner.return_lse, owner.lse_layout = True, ((ROWS, HEADS), (HEADS, 1))
+    owner.scratch_layout = (((64,), torch.uint8),)
+    owner.inputs = {"kv_cache": None, "attention_sink": None}
+    owner.plan = type("Plan", (), {"handle": 7})()
+    seen = {}
+
+    def attend(*args):
+        seen["output"], seen["lse"] = args[6].view(torch.uint8).clone(), args[7].view(torch.uint8).clone()
+
+    monkeypatch.setattr(sparse_mla, "_attend", attend)
+    monkeypatch.setattr(torch, "empty_strided", _poisoned(torch.empty_strided))
+    owner(torch.zeros(ROWS, HEADS, DIM), None, None, None)
+    assert (seen["output"] == 0xFF).all() and (seen["lse"] == 0xFF).all()
diff --git a/tests/components/test_speculative_validity.py b/tests/components/test_speculative_validity.py
new file mode 100644
index 00000000..333638ad
--- /dev/null
+++ b/tests/components/test_speculative_validity.py
@@ -0,0 +1,51 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 Flare community contributors
+# SPDX-License-Identifier: Apache-2.0
+
+"""Verification validity checks used columns only, exactly as the dummy-substituted check did."""
+
+import pytest
+import torch
+
+from ignition.components.speculation import _distributions_valid, _sliced
+
+
+def _dummy_substituted(probabilities, used):
+    dummy = (torch.arange(probabilities.shape[-1]) == 0).float()
+    if used is not None:
+        probabilities = torch.where(used[:, :, None], probabilities, dummy)
+    slices = _sliced(probabilities)
+    entries = (torch.isfinite(slices) & (slices >= 0)).all(-1).all(-1)
+    mass = slices.sum(-1).sum(-1)
+    return (entries & torch.isfinite(mass) & ((mass - 1).abs() <= 1e-4)).all(-1)
+
+
+@pytest.mark.parametrize("vocab", [256, 300])  # sliced and unsliced vocabularies
+@pytest.mark.parametrize("width", [1, 3, 5])
+def test_used_column_validity_matches_dummy_substitution(vocab, width):
+    generator = torch.Generator().manual_seed(vocab * 10 + width)
+    batch = 16
+    probabilities = torch.rand((batch, width, vocab), generator=generator).softmax(-1)
+    defects = (float("nan"), float("inf"), -1e-3, 0.5)
+    for row in range(batch):
+        column, kind = row % width, row % (len(defects) + 1)
+        if kind < 2:
+            probabilities[row, column, row % vocab] = defects[kind]
+        elif kind == 2:
+            probabilities[row, column, 1] = defects[2]
+        elif kind == 3:
+            probabilities[row, column] *= 1 + defects[3]
+    limits = torch.randint(0, width + 2, (batch,), generator=generator)
+    used = torch.arange(width)[None, :] < limits[:, None]
+    for mask in (None, used, torch.zeros_like(used), torch.ones_like(used)):
+        expected = _dummy_substituted(probabilities, mask)
+        assert torch.equal(_distributions_valid(probabilities, mask), expected)
+    # A defect invalidates its row exactly when its column is used.
+    defective = ~_distributions_valid(probabilities, None)
+    unused_only = defective & ~(used & ~_column_valid(probabilities)).any(-1)
+    assert _distributions_valid(probabilities, used)[unused_only].all()
+    assert not _distributions_valid(probabilities, used)[(used & ~_column_valid(probabilities)).any(-1)].any()
+
+
+def _column_valid(probabilities):
+    return torch.stack([_distributions_valid(probabilities[:, column:column + 1], None)
+                        for column in range(probabilities.shape[1])], -1)
