++#ifndef XMOE_P_SYNC
++#define XMOE_P_SYNC 0
++#endif
++#ifndef XMOE_P_G
++#define XMOE_P_G 2
++#endif
++#if XMOE_P_SYNC == 0
++#undef XMOE_P_NBUF
++#define XMOE_P_NBUF (2 * XMOE_P_G)
