diff --git a/ignition/recipes/deepseek41/exl3/kernels/xmoe/quant/exl3_moe_transfer_kernel.cuh b/ignition/recipes/deepseek41/exl3/kernels/xmoe/quant/exl3_moe_transfer_kernel.cuh
new file mode 100644
index 00000000..6e67b711
--- /dev/null
+++ b/ignition/recipes/deepseek41/exl3/kernels/xmoe/quant/exl3_moe_transfer_kernel.cuh
@@ -0,0 +1,214 @@
+// SPDX-License-Identifier: MIT
+// Copied unchanged below this header from diffbot recipe/kernels/xmoe_bulk/quant/exl3_moe_transfer_kernel.cuh (MIT, Copyright (c) 2025 Turboderp
+// and Copyright (c) 2026 Diffbot: ../LICENSE.exllamav3, ../LICENSE.diffbot). Ported by exp/ds41-exl3-final-bulk (2026-11-17).
+#pragma once
+
+// xmoe flat scheduler for decode-sized batches. The group kernel (exl3_moe_kernel) hands each active expert to one
+// 8-SM group and processes experts in rounds, so with 36 active experts on 23 groups the second round idles 10 groups
+// and every expert pays 5 group barriers. Here the whole grid (one block per SM) runs five phases over ALL active
+// experts at once, separated by 4 grid barriers:
+//   1 gather + input Hadamard (g, u)   2 gate+up GEMM, flattened over experts   3 output Had + act + down input Had
+//   4 down GEMM, flattened              5 output Had + weighted scatter-add
+// Rows stay in token_sorted (expert-sorted) pair order in the temp buffers, so expert e's rows are contiguous.
+// Experts with more than 16 rows are split into 16-row jobs.
+
+#include <cuda_bf16.h>
+#include "exl3_moe_common.cuh"
+#include "../util.h"
+#include "../util.cuh"
+#include "exl3_kernel_map.cuh"
+#include "hadamard_inner.cuh"
+#include "exl3_gemm_inner_transfer.cuh"   // xmoe_ds41p: t stage loop with group barriers / mbarrier ring (bit-identical)
+#include "exl3_devctx.cuh"
+#include "../ptx.cuh"
+
+#ifndef XMOE_FLAT_SH_STAGES
+#define XMOE_FLAT_SH_STAGES N40_BUFFERS   // xmoe_ds41p: stage buffers of the flat GEMM ring (2 * XMOE_P_G, or XMOE_P_NBUF)
+#endif
+#ifndef XMOE_FLAT_TK
+#define XMOE_FLAT_TK 128     // xmoe_k64: flat GEMM k-tile (block size stays 256 * MOE_TILESIZE_K / 16 = 512)
+#endif
+#ifndef XMOE_FLAT_MAX_JOBS
+#define XMOE_FLAT_MAX_JOBS 640    // 8x profile build (xmoe_p8k): 1536
+#endif
+#ifndef XMOE_FLAT_MAX_PAIRS
+#define XMOE_FLAT_MAX_PAIRS 1024  // 8x profile build (xmoe_p8k): 8192, so k7 x 128 seqs (1,152 rows) stays on the flat kernel
+#endif
+#define XMOE_FLAT_MAX_EXPERTS 512
+#define XMOE_FLAT_BARRIER_ID 200  // group_barrier slot; the group kernel uses ids < MOE_MAX_GROUPS
+
+static_assert(EXL3_GEMM_BASE_THREADS == 128 || EXL3_GEMM_BASE_THREADS == 256);
+template<int t_bits, int MOE_TILESIZE_N, int cb>
+__global__ __launch_bounds__(N40_COMPUTE_THREADS + 32 * N40_PRODUCER_WARPS, N40_CTA_MULT)
+void exl3_moe_transfer_kernel(EXL3_MOE_KERNEL_ARGS)
+{
+    static_assert(t_bits > 0, "xmoe flat: fixed bitrate only");
+    __shared__ int job_start[XMOE_FLAT_MAX_JOBS];
+    __shared__ int job_rows[XMOE_FLAT_MAX_JOBS];
+    __shared__ int job_expert[XMOE_FLAT_MAX_JOBS];
+    __shared__ short pair_expert[XMOE_FLAT_MAX_PAIRS];
+    __shared__ int warp_tot[2][32];
+    __shared__ int s_tot[2];
+
+    int* barrier_counters_sense = locks + BARRIER_LOCKS_OFFSET;
+    auto grid_sync = [&] () { group_barrier(XMOE_FLAT_BARRIER_ID, gridDim.x, barrier_counters_sense); };
+
+    const int t = threadIdx.x;
+    const int lane = t % 32;
+    const int warp_id = t / 32;
+    const int warps_per_block = blockDim.x / 32;
+
+    // Job table, built redundantly by every block from expert_count (no inter-block dependency).
+    // Exclusive scans over experts of (row count, 16-row job count); invalid experts (0 rows, or more than
+    // max_tokens_per_expert, which the caller runs on its fat path) contribute rows but no jobs.
+    int cpart[2] = {}, npart[2] = {};
+    #pragma unroll
+    for (int h = 0; h < 2; ++h) {
+        int e = 2 * t + h;
+        if (e < num_experts) {
+            int count = (int) expert_count[e];
+            bool skip = count < 0;
+            cpart[h] = skip ? -count : count;
+            npart[h] = !skip && count > 0 && count <= max_tokens_per_expert ? (count + 15) / 16 : 0;
+        }
+    }
+    int c = cpart[0] + cpart[1], nj = npart[0] + npart[1];
+    int ic = c, inj = nj;
+    #pragma unroll
+    for (int o = 1; o < 32; o <<= 1)
+    {
+        int a = __shfl_up_sync(0xffffffff, ic, o);
+        int b = __shfl_up_sync(0xffffffff, inj, o);
+        if (lane >= o) { ic += a; inj += b; }
+    }
+    if (lane == 31) { warp_tot[0][warp_id] = ic; warp_tot[1][warp_id] = inj; }
+    __syncthreads();
+    if (warp_id == 0)
+    {
+        int a = lane < warps_per_block ? warp_tot[0][lane] : 0;
+        int b = lane < warps_per_block ? warp_tot[1][lane] : 0;
+        #pragma unroll
+        for (int o = 1; o < 32; o <<= 1)
+        {
+            int x = __shfl_up_sync(0xffffffff, a, o);
+            int y = __shfl_up_sync(0xffffffff, b, o);
+            if (lane >= o) { a += x; b += y; }
+        }
+        if (lane < warps_per_block) { warp_tot[0][lane] = a; warp_tot[1][lane] = b; }
+        if (lane == 31) { s_tot[0] = a; s_tot[1] = b; }
+    }
+    __syncthreads();
+    const int pos = ic - c + (warp_id ? warp_tot[0][warp_id - 1] : 0);
+    const int jpos = inj - nj + (warp_id ? warp_tot[1][warp_id - 1] : 0);
+    const int num_pairs = s_tot[0];   // rows over real experts; sentinel rows (expert == num_experts) come after
+    const int num_jobs = s_tot[1];
+    #pragma unroll
+    for (int h = 0; h < 2; ++h) {
+        int e = 2 * t + h;
+        int posh = pos + (h ? cpart[0] : 0);
+        int jposh = jpos + (h ? npart[0] : 0);
+        if (e < num_experts) {
+            for (int i = 0; i < npart[h]; ++i) {
+                job_start[jposh + i] = posh + 16 * i;
+                job_rows[jposh + i] = MIN(16, cpart[h] - 16 * i);
+                job_expert[jposh + i] = e;
+            }
+            short pe = npart[h] ? (short)e : (short)-1;
+            for (int p = posh; p < posh + cpart[h]; ++p) pair_expert[p] = pe;
+        }
+    }
+    __syncthreads();
+    if (num_jobs == 0) return;  // uniform across the grid: no barrier is entered
+
+    const int gwarp = blockIdx.x * warps_per_block + warp_id;
+    const int gwarps = gridDim.x * warps_per_block;
+
+    // 1. Gather + input Hadamard for g, u
+    {
+        const int wpt = hidden_dim / 128;
+        for (int w = gwarp; w < num_pairs * wpt; w += gwarps)
+        {
+            int p = w / wpt;
+            int off = w % wpt;
+            int e = pair_expert[p];
+            if (e < 0) continue;
+            const half* in_ptr = hidden_state + token_sorted[p] * hidden_dim + off * 128;
+            had_hf_r_128_inner<true, false>(in_ptr, temp_state_g + (size_t) p * hidden_dim + off * 128,
+                                            gate_suh[e] + off * 128, 0.088388347648f);
+            had_hf_r_128_inner<true, false>(in_ptr, temp_state_u + (size_t) p * hidden_dim + off * 128,
+                                            up_suh[e] + off * 128, 0.088388347648f);
+        }
+    }
+    grid_sync();
+
+    // 2. Gate + up GEMM over all jobs
+    {
+        FlatGemmJobs J;
+        J.start = job_start; J.rows = job_rows; J.expert = job_expert;
+        J.num_jobs = num_jobs; J.num_mats = 2;
+        J.A[0] = temp_state_g; J.A[1] = temp_state_u;
+        J.C[0] = temp_intermediate_g; J.C[1] = temp_intermediate_u;
+        J.B[0] = gate_trellis; J.B[1] = up_trellis;
+        exl3_gemm_kernel_inner_transfer<t_bits, false, cb, MOE_TILESIZE_M, XMOE_FLAT_TK, MOE_TILESIZE_N,
+                                      XMOE_FLAT_SH_STAGES, 1>(J, hidden_dim, intermediate_dim, locks);
+    }
+    grid_sync();
+
+    // 3. Output Hadamard for g, u + activation + input Hadamard for d (in place into intermediate_g)
+    {
+        const int wpt = intermediate_dim / 128;
+        for (int w = gwarp; w < num_pairs * wpt; w += gwarps)
+        {
+            int p = w / wpt;
+            int off = w % wpt;
+            int e = pair_expert[p];
+            if (e < 0) continue;
+            half* ig = temp_intermediate_g + (size_t) p * intermediate_dim + off * 128;
+            half* iu = temp_intermediate_u + (size_t) p * intermediate_dim + off * 128;
+            had_hf_r_128_guad_inner(ig, iu, ig, gate_svh[e] + off * 128, up_svh[e] + off * 128,
+                                    down_suh[e] + off * 128, 0.088388347648f, act_limit, act_function);
+        }
+    }
+    grid_sync();
+
+    // 4. Down GEMM over all jobs, output into temp_state_g (free after phase 2)
+    {
+        FlatGemmJobs J;
+        J.start = job_start; J.rows = job_rows; J.expert = job_expert;
+        J.num_jobs = num_jobs; J.num_mats = 1;
+        J.A[0] = temp_intermediate_g; J.A[1] = nullptr;
+        J.C[0] = temp_state_g; J.C[1] = nullptr;
+        J.B[0] = down_trellis; J.B[1] = nullptr;
+        exl3_gemm_kernel_inner_transfer<t_bits, false, cb, MOE_TILESIZE_M, XMOE_FLAT_TK, MOE_TILESIZE_N,
+                                      XMOE_FLAT_SH_STAGES, 1>(J, intermediate_dim, hidden_dim, locks);
+    }
+    grid_sync();
+
+    // 5. Output Hadamard for d + weighted scatter-add into the fp32 output
+    {
+        const int wpt = hidden_dim / 128;
+        for (int w = gwarp; w < num_pairs * wpt; w += gwarps)
+        {
+            int p = w / wpt;
+            int off = w % wpt;
+            int e = pair_expert[p];
+            if (e < 0) continue;
+            float* out_ptr = output_state + token_sorted[p] * hidden_dim + off * 128;
+            had_hf_r_128_d_inner(temp_state_g + (size_t) p * hidden_dim + off * 128, out_ptr,
+                                 down_svh[e] + off * 128, 0.088388347648f * __half2float(weight_sorted[p]));
+        }
+    }
+}
+
+// Dynamic shared memory for the flat kernel: GEMM stages + reduction buffer; phase 5 needs 128 floats per warp
+template<int t_bits, int MOE_TILESIZE_N>
+constexpr int exl3_moe_transfer_dyn_smem()
+{
+    constexpr int a = 16 * XMOE_FLAT_TK * 2;
+    constexpr int b = (XMOE_FLAT_TK / 16) * (MOE_TILESIZE_N / 16) * 256 / 16 * t_bits * 2;
+    constexpr int frags_n = 2 * (MOE_TILESIZE_N / 16) / (EXL3_GEMM_BASE_THREADS / 32);
+    constexpr int cbuf = 4 * EXL3_GEMM_BASE_THREADS * frags_n * 4;
+    constexpr int gemm = XMOE_FLAT_SH_STAGES * (a + b) + cbuf;
+    constexpr int had = ((N40_COMPUTE_THREADS + 32 * N40_PRODUCER_WARPS) / 32) * 128 * 4;
+    return gemm > had ? gemm : had;
+}
diff --git a/ignition/recipes/deepseek41/exl3/kernels/xmoe/quant/exl3_prep.cu b/ignition/recipes/deepseek41/exl3/kernels/xmoe/quant/exl3_prep.cu
new file mode 100644
index 00000000..8484175d
--- /dev/null
+++ b/ignition/recipes/deepseek41/exl3/kernels/xmoe/quant/exl3_prep.cu
@@ -0,0 +1,134 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 Flare community contributors
+// SPDX-License-Identifier: Apache-2.0
+//
+// exp/ds41-exl3-next (2026-11-16): fused decode routing prep for flare::ds41_exl3_moe (FLARE_DS41_EXL3_FUSED_PREP=1).
+// One launch replaces the op's torch glue at decode (~18 launches, ~20 us per layer in the seq229 profile):
+//   flat = ids.reshape(-1); order = argsort(flat, stable=True); token_sorted = order // top_k
+//   weight_sorted = weights.reshape(-1)[order].half(); counts = bincount(flat, minlength=E1)
+//   hot = where(slot < hot_rows, counts, -counts); cold = -hot; x16 = hidden.half(); acc = 0 (fp32)
+// Block 0 does the routing (counting sort; a route's position = its expert's offset + the number of earlier routes to
+// the same expert, which is exactly the stable argsort order); blocks 1.. convert the activations and zero the
+// accumulator. Every output is integer or a single round-to-nearest conversion, so it is bit-identical to the torch path.
+#include <cuda_fp16.h>
+#include <cuda_bf16.h>
+#include <cub/block/block_scan.cuh>
+#include <torch/extension.h>
+#include <c10/cuda/CUDAStream.h>
+#include <c10/cuda/CUDAGuard.h>
+
+namespace {
+
+constexpr int PREP_THREADS = 512;
+
+// explicit conversions (the extension builds with __CUDA_NO_HALF_CONVERSIONS__ / __CUDA_NO_BFLOAT16_CONVERSIONS__)
+__device__ __forceinline__ float to_f(float v) { return v; }
+__device__ __forceinline__ float to_f(half v) { return __half2float(v); }
+__device__ __forceinline__ float to_f(__nv_bfloat16 v) { return __bfloat162float(v); }     // max routes (rows * top_k) and max bins (num_experts + 1) per launch
+
+template <typename IdT, typename WT, typename HT>
+__global__ __launch_bounds__(PREP_THREADS)
+void xmoe_decode_prep_kernel(const IdT* __restrict__ ids, const WT* __restrict__ weights, const HT* __restrict__ hidden,
+                             int routes, int top_k, int bins, int hot_rows, int64_t elements,
+                             int64_t* __restrict__ token_sorted, half* __restrict__ weight_sorted,
+                             int64_t* __restrict__ counts_hot, int64_t* __restrict__ counts_cold,
+                             half* __restrict__ x16, float* __restrict__ acc)
+{
+    if (blockIdx.x > 0)
+    {
+        const int64_t stride = (int64_t) (gridDim.x - 1) * blockDim.x;
+        for (int64_t k = (int64_t) (blockIdx.x - 1) * blockDim.x + threadIdx.x; k < elements; k += stride)
+        {
+            x16[k] = __float2half_rn(to_f(hidden[k]));
+            acc[k] = 0.0f;
+        }
+        return;
+    }
+    using Scan = cub::BlockScan<int, PREP_THREADS>;
+    __shared__ typename Scan::TempStorage scan_tmp;
+    __shared__ int s_hist[PREP_THREADS];
+    __shared__ int s_off[PREP_THREADS];
+    __shared__ int s_flat[PREP_THREADS];
+    const int t = threadIdx.x;
+    s_hist[t] = 0;
+    __syncthreads();
+    int e = -1;
+    if (t < routes)
+    {
+        e = (int) ids[t];
+        if (e < 0 || e >= bins) __trap();       // the torch path's scatter_add device-asserts on the same input
+        s_flat[t] = e;
+        atomicAdd(&s_hist[e], 1);
+    }
+    __syncthreads();
+    const int c = s_hist[t];
+    int off;
+    Scan(scan_tmp).ExclusiveSum(c, off);
+    s_off[t] = off;
+    if (t < bins)
+    {
+        counts_hot[t] = t < hot_rows ? c : -c;
+        counts_cold[t] = t < hot_rows ? -c : c;
+    }
+    __syncthreads();
+    if (t < routes)
+    {
+        int rank = 0;
+        for (int j = 0; j < t; ++j) rank += s_flat[j] == e;
+        const int pos = s_off[e] + rank;
+        token_sorted[pos] = t / top_k;
+        weight_sorted[pos] = __float2half_rn(to_f(weights[t]));
+    }
+}
+
+}  // namespace
+
+// ids [R, K] int32/int64 in [0, bins); weights [R, K] fp32/bf16; hidden [R, H] bf16/fp16 contiguous. hot_rows = the
+// bank's VRAM rows (bins for an unparked bank, so hot == counts). Outputs as the torch path: token_sorted [R*K] int64,
+// weight_sorted [R*K] fp16, counts_hot/counts_cold [bins] int64, x16 [R, H] fp16, acc [R, H] fp32 (zeroed).
+void xmoe_decode_prep(at::Tensor ids, at::Tensor weights, at::Tensor hidden, int64_t hot_rows,
+                      at::Tensor token_sorted, at::Tensor weight_sorted, at::Tensor counts_hot, at::Tensor counts_cold,
+                      at::Tensor x16, at::Tensor acc)
+{
+    const at::cuda::OptionalCUDAGuard guard(device_of(hidden));
+    auto stream = at::cuda::getCurrentCUDAStream().stream();
+    TORCH_CHECK(ids.dim() == 2 && weights.sizes() == ids.sizes() && hidden.dim() == 2 && hidden.size(0) == ids.size(0),
+                "xmoe_decode_prep: ids/weights [R, K], hidden [R, H]");
+    TORCH_CHECK(ids.is_contiguous() && weights.is_contiguous() && hidden.is_contiguous(), "xmoe_decode_prep: contiguous inputs");
+    const int routes = (int) ids.numel(), top_k = (int) ids.size(1), bins = (int) counts_hot.numel();
+    TORCH_CHECK(routes <= PREP_THREADS && bins <= PREP_THREADS, "xmoe_decode_prep: at most 512 routes and 512 bins");
+    TORCH_CHECK(token_sorted.numel() == routes && token_sorted.scalar_type() == at::kLong
+                && weight_sorted.numel() == routes && weight_sorted.scalar_type() == at::kHalf
+                && counts_cold.numel() == bins && counts_hot.scalar_type() == at::kLong && counts_cold.scalar_type() == at::kLong,
+                "xmoe_decode_prep: token_sorted int64 [R*K], weight_sorted fp16 [R*K], counts int64 [bins]");
+    TORCH_CHECK(x16.sizes() == hidden.sizes() && x16.scalar_type() == at::kHalf && acc.sizes() == hidden.sizes()
+                && acc.scalar_type() == at::kFloat && x16.is_contiguous() && acc.is_contiguous(),
+                "xmoe_decode_prep: x16 fp16 and acc fp32 shaped like hidden");
+    const int64_t elements = hidden.numel();
+    const int extra = (int) std::min<int64_t>(64, std::max<int64_t>(1, (elements + PREP_THREADS * 8 - 1) / (PREP_THREADS * 8)));
+    const int hot = (int) std::min<int64_t>(hot_rows, bins);
+
+#define PREP_LAUNCH(IDT, WT, HT)                                                                                        \
+    xmoe_decode_prep_kernel<IDT, WT, HT><<<1 + extra, PREP_THREADS, 0, stream>>>(                                       \
+        ids.data_ptr<IDT>(), reinterpret_cast<const WT*>(weights.data_ptr()), reinterpret_cast<const HT*>(hidden.data_ptr()), \
+        routes, top_k, bins, hot, elements, token_sorted.data_ptr<int64_t>(),                                          \
+        reinterpret_cast<half*>(weight_sorted.data_ptr()), counts_hot.data_ptr<int64_t>(), counts_cold.data_ptr<int64_t>(), \
+        reinterpret_cast<half*>(x16.data_ptr()), acc.data_ptr<float>())
+
+#define PREP_H(IDT, WT)                                                                                                 \
+    if (hidden.scalar_type() == at::kBFloat16) PREP_LAUNCH(IDT, WT, __nv_bfloat16);                                     \
+    else if (hidden.scalar_type() == at::kHalf) PREP_LAUNCH(IDT, WT, half);                                             \
+    else TORCH_CHECK(false, "xmoe_decode_prep: hidden must be bf16 or fp16")
+
+#define PREP_W(IDT)                                                                                                     \
+    if (weights.scalar_type() == at::kFloat) { PREP_H(IDT, float); }                                                    \
+    else if (weights.scalar_type() == at::kBFloat16) { PREP_H(IDT, __nv_bfloat16); }                                   \
+    else TORCH_CHECK(false, "xmoe_decode_prep: weights must be fp32 or bf16")
+
+    if (ids.scalar_type() == at::kLong) { PREP_W(int64_t); }
+    else if (ids.scalar_type() == at::kInt) { PREP_W(int32_t); }
+    else TORCH_CHECK(false, "xmoe_decode_prep: ids must be int32 or int64");
+#undef PREP_W
+#undef PREP_H
+#undef PREP_LAUNCH
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
diff --git a/ignition/recipes/deepseek41/exl3/kernels/xmoe/quant/hadamard_inner.cuh b/ignition/recipes/deepseek41/exl3/kernels/xmoe/quant/hadamard_inner.cuh
new file mode 100644
index 00000000..9f85c256
--- /dev/null
+++ b/ignition/recipes/deepseek41/exl3/kernels/xmoe/quant/hadamard_inner.cuh
@@ -0,0 +1,473 @@
+#pragma once
+#include "../compat.cuh"
+
+#define ACT_SILU 0
+#define ACT_GELU 1
+// Non-gated relu2 (NemotronH): the g input is unused (its GEMM is skipped by the caller); the
+// gate lane is set to relu(u) so the gate multiply below yields relu(u) * u = relu^2(u) exactly
+#define ACT_RELU2_NOGATE 2
+
+// Hadamard transform 128-element vector across one warp, with optional pre and post scales
+
+__device__ inline half hreduce(half2 x)
+{
+    return __hadd(__low2half(x), __high2half(x));
+}
+
+__device__ inline void shuffle_had_f4x32(float& h0, float& h1, float& h2, float& h3, const int lane_id)
+{
+    #pragma unroll
+    for (int i = 1; i < 32; i <<= 1)
+    {
+        uint32_t i0 = __float_as_uint(h0);
+        uint32_t i1 = __float_as_uint(h1);
+        uint32_t i2 = __float_as_uint(h2);
+        uint32_t i3 = __float_as_uint(h3);
+        uint64_t h01 =  (uint64_t) i0 | (((uint64_t) i1) << 32);
+        uint64_t h23 =  (uint64_t) i2 | (((uint64_t) i3) << 32);
+        uint64_t ph01 = __shfl_xor_sync(0xffffffff, h01, i);
+        uint64_t ph23 = __shfl_xor_sync(0xffffffff, h23, i);
+        float ph0 = __uint_as_float((uint32_t) (ph01 & 0xffffffff));
+        float ph1 = __uint_as_float((uint32_t) (ph01 >> 32));
+        float ph2 = __uint_as_float((uint32_t) (ph23 & 0xffffffff));
+        float ph3 = __uint_as_float((uint32_t) (ph23 >> 32));
+        int32_t sfm = -static_cast<int32_t>(lane_id & i) >> 31;
+        i0 ^= sfm & 0x80000000;
+        i1 ^= sfm & 0x80000000;
+        i2 ^= sfm & 0x80000000;
+        i3 ^= sfm & 0x80000000;
+        h0 = __uint_as_float(i0) + ph0;
+        h1 = __uint_as_float(i1) + ph1;
+        h2 = __uint_as_float(i2) + ph2;
+        h3 = __uint_as_float(i3) + ph3;
+    }
+}
+
+__device__ inline void shuffle_had_f2x32(float& v, float& w, const int lane_id)
+{
+    #pragma unroll
+    for (int i = 1; i < 32; i <<= 1)
+    {
+        uint64_t vw = ((uint64_t) __float_as_uint(v)) | (((uint64_t) __float_as_uint(w)) << 32);
+        uint64_t pvw = __shfl_xor_sync(0xffffffff, vw, i);
+        float pv = __uint_as_float((uint32_t) (pvw & 0xffffffff));
+        float pw = __uint_as_float((uint32_t) (pvw >> 32));
+        uint32_t vi = __float_as_uint(v);
+        uint32_t wi = __float_as_uint(w);
+        int32_t sfm = -static_cast<int16_t>(lane_id & i) >> 31;
+        vi ^= (sfm & 0x80000000);
+        wi ^= (sfm & 0x80000000);
+        v = __uint_as_float(vi) + pv;
+        w = __uint_as_float(wi) + pw;
+    }
+}
+
+__device__ inline float shuffle_had_fx32(float v, const int lane_id)
+{
+    for (int i = 1; i < 32; i <<= 1)
+    {
+        float pv = __shfl_xor_sync(0xffffffff, v, i);
+        uint32_t* vi = reinterpret_cast<uint32_t*>(&v);
+        int32_t sfm = -static_cast<int16_t>(lane_id & i) >> 31;
+        *vi ^= (sfm & 0x80000000);
+        v = v + pv;
+    }
+    return v;
+}
+
+__device__ inline half2 shuffle_had_h2x32(half2 v, int lane_id)
+{
+    for (int i = 1; i < 32; i <<= 1)
+    {
+        half2 pv = __shfl_xor_sync(0xffffffff, v, i);
+        uint32_t* vi = reinterpret_cast<uint32_t*>(&v);
+        int32_t sfm = -static_cast<int16_t>(lane_id & i) >> 31;
+        *vi ^= (sfm & 0x80008000);
+        v = __hadd2(v, pv);
+    }
+    return v;
+}
+
+// Half vector, half scales
+
+template <bool pre_scale, bool post_scale>
+inline __device__
+void had_hf_r_128_inner
+(
+    const half* __restrict__ input_ptr,
+    half* __restrict__ output_ptr,
+    const half* __restrict__ scale,
+    const float r_scale
+)
+{
+    int t = threadIdx.x & 31;
+
+    // Load
+    half4 v = ((half4*) input_ptr)[t];
+
+    // Pre scale
+    if constexpr (pre_scale)
+    {
+        int i = blockIdx.y * 32 + t;
+        half4 scales = ((half4*) scale)[i];
+        v.x = __hmul2(v.x, scales.x);
+        v.y = __hmul2(v.y, scales.y);
+    }
+
+    // 4 element had
+    float v0 = __half2float(__low2half(v.x));
+    float v1 = __half2float(__high2half(v.x));
+    float v2 = __half2float(__low2half(v.y));
+    float v3 = __half2float(__high2half(v.y));
+    float s0 = v0 + v1;
+    float d0 = v0 - v1;
+    float s1 = v2 + v3;
+    float d1 = v2 - v3;
+    float h0 = s0 + s1;
+    float h1 = d0 + d1;
+    float h2 = s0 - s1;
+    float h3 = d0 - d1;
+
+    // 32 element had, warp shuffle
+    shuffle_had_f4x32(h0, h1, h2, h3, t);
+    v.x = __floats2half2_rn(h0 * r_scale, h1 * r_scale);
+    v.y = __floats2half2_rn(h2 * r_scale, h3 * r_scale);
+
+    // Post scale
+    if constexpr (post_scale)
+    {
+        int i = blockIdx.y * 32 + t;
+        half4 scales = ((half4*) scale)[i];
+        v.x = __hmul2(v.x, scales.x);
+        v.y = __hmul2(v.y, scales.y);
+    }
+
+    // Store
+    ((half4*) output_ptr)[t] = v;
+}
+
+// Float vector, half scales
+
+template <bool pre_scale, bool post_scale>
+inline __device__
+void had_ff_r_128_inner
+(
+    const float* __restrict__ input_ptr,
+    float* __restrict__ output_ptr,
+    const half* __restrict__ scale,
+    const float r_scale
+)
+{
+    int t = threadIdx.x & 31;
+
+    // Load
+    float4 v = ((float4*) input_ptr)[t];
+
+    // Pre scale
+    if constexpr (pre_scale)
+    {
+        int i = blockIdx.y * 32 + t;
+        half4 scales = ((half4*) scale)[i];
+        v.x *= __low2float(scales.x);
+        v.y *= __high2float(scales.x);
+        v.z *= __low2float(scales.y);
+        v.w *= __high2float(scales.y);
+    }
+
+    // 4 element had
+    float v0 = v.x;
+    float v1 = v.y;
+    float v2 = v.z;
+    float v3 = v.w;
+    float s0 = v0 + v1;
+    float d0 = v0 - v1;
+    float s1 = v2 + v3;
+    float d1 = v2 - v3;
+    v.x = s0 + s1;
+    v.y = d0 + d1;
+    v.z = s0 - s1;
+    v.w = d0 - d1;
+
+    // 32 element had, warp shuffle
+    shuffle_had_f2x32(v.x, v.y, t);
+    shuffle_had_f2x32(v.z, v.w, t);
+    v.x *= r_scale;
+    v.y *= r_scale;
+    v.z *= r_scale;
+    v.w *= r_scale;
+
+    // Post scale
+    if constexpr (post_scale)
+    {
+        int i = blockIdx.y * 32 + t;
+        half4 scales = ((half4*) scale)[i];
+        v.x *= __low2float(scales.x);
+        v.y *= __high2float(scales.x);
+        v.z *= __low2float(scales.y);
+        v.w *= __high2float(scales.y);
+    }
+
+    // Store
+    ((float4*) output_ptr)[t] = v;
+}
+
+// Float vector, half scales, half output
+
+template <bool pre_scale, bool post_scale>
+inline __device__
+void had_fh_r_128_inner
+(
+    const float* __restrict__ input_ptr,
+    half* __restrict__ output_ptr,
+    const half* __restrict__ scale,
+    const float r_scale
+)
+{
+    int t = threadIdx.x & 31;
+
+    // Load
+    float4 v = ((float4*) input_ptr)[t];
+
+    // Pre scale
+    if constexpr (pre_scale)
+    {
+        int i = blockIdx.y * 32 + t;
+        half4 scales = ((half4*) scale)[i];
+        v.x *= __low2float(scales.x);
+        v.y *= __high2float(scales.x);
+        v.z *= __low2float(scales.y);
+        v.w *= __high2float(scales.y);
+    }
+
+    // 4 element had
+    float v0 = v.x;
+    float v1 = v.y;
+    float v2 = v.z;
+    float v3 = v.w;
+    float s0 = v0 + v1;
+    float d0 = v0 - v1;
+    float s1 = v2 + v3;
+    float d1 = v2 - v3;
+    v.x = s0 + s1;
+    v.y = d0 + d1;
+    v.z = s0 - s1;
+    v.w = d0 - d1;
+
+    // 32 element had, warp shuffle
+    shuffle_had_f2x32(v.x, v.y, t);
+    shuffle_had_f2x32(v.z, v.w, t);
+    v.x *= r_scale;
+    v.y *= r_scale;
+    v.z *= r_scale;
+    v.w *= r_scale;
+
+    half4 o;
+    o.x = __floats2half2_rn(v.x, v.y);
+    o.y = __floats2half2_rn(v.z, v.w);
+
+    // Post scale
+    if constexpr (post_scale)
+    {
+        int i = blockIdx.y * 32 + t;
+        half4 scales = ((half4*) scale)[i];
+        o.x = __hmul2(o.x, scales.x);
+        o.y = __hmul2(o.y, scales.y);
+    }
+
+    // Store
+    ((half4*) output_ptr)[t] = o;
+}
+
+// Fused op: o <- in_had(silu(out_had(g)) * out_had(u))
+
+inline __device__
+void had_hf_r_128_guad_inner
+(
+    const half* __restrict__ input_ptr_g,
+    const half* __restrict__ input_ptr_u,
+    half* __restrict__ output_ptr,
+    const half* __restrict__ post_scale_g,
+    const half* __restrict__ post_scale_u,
+    const half* __restrict__ pre_scale_d,
+    const float r_scale,
+    const float act_limit,
+    const int act_function
+)
+{
+    int t = threadIdx.x & 31;
+
+    auto had = [&](half4& v)
+    {
+        // 4 element had
+        float v0 = __half2float(__low2half(v.x));
+        float v1 = __half2float(__high2half(v.x));
+        float v2 = __half2float(__low2half(v.y));
+        float v3 = __half2float(__high2half(v.y));
+        float s0 = v0 + v1;
+        float d0 = v0 - v1;
+        float s1 = v2 + v3;
+        float d1 = v2 - v3;
+        float h0 = s0 + s1;
+        float h1 = d0 + d1;
+        float h2 = s0 - s1;
+        float h3 = d0 - d1;
+
+        // 32 element had, warp shuffle
+        shuffle_had_f4x32(h0, h1, h2, h3, t);
+        v.x = __floats2half2_rn(h0 * r_scale, h1 * r_scale);
+        v.y = __floats2half2_rn(h2 * r_scale, h3 * r_scale);
+
+        return v;
+    };
+
+    auto _silu = [&](const half2& x)
+    {
+        half2 one = __float2half2_rn(1.0f);
+        half2 neg_x = __hneg2(x);
+        half2 e = h2exp(neg_x);
+        half2 sum = __hadd2(one, e);
+        half2 r = h2rcp(sum);
+        half2 result = __hmul2(x, r);
+        return result;
+    };
+
+    auto _gelu = [&](const half2& x)
+    {
+        float2 xf = __half22float2(x);
+        const float c = 0.797884560803f;  // sqrt(2/Pi)
+        xf.x = 0.5f * xf.x * (1.0f + tanh_opt(c * (xf.x + 0.044715f * xf.x * xf.x * xf.x)));
+        xf.y = 0.5f * xf.y * (1.0f + tanh_opt(c * (xf.y + 0.044715f * xf.y * xf.y * xf.y)));
+        return __float22half2_rn(xf);
+    };
+
+    // Load. In non-gated mode the g buffer holds no data (its GEMM is skipped); the gate lane
+    // is synthesized from u in the activation switch below
+    half4 vg = {};
+    half4 vu = ((half4*) input_ptr_u)[t];
+
+    // Hadamard
+    vu = had(vu);
+
+    // Post scale
+    int i = blockIdx.y * 32 + t;
+    half4 scales_u = ((half4*) post_scale_u)[i];
+    vu.x = __hmul2(vu.x, scales_u.x);
+    vu.y = __hmul2(vu.y, scales_u.y);
+
+    if (act_function != ACT_RELU2_NOGATE)
+    {
+        vg = ((half4*) input_ptr_g)[t];
+        vg = had(vg);
+        half4 scales_g = ((half4*) post_scale_g)[i];
+        vg.x = __hmul2(vg.x, scales_g.x);
+        vg.y = __hmul2(vg.y, scales_g.y);
+    }
+
+    // Activation
+    switch (act_function)
+    {
+        case ACT_SILU:
+            vg.x = _silu(vg.x);
+            vg.y = _silu(vg.y);
+            break;
+
+        case ACT_GELU:
+            vg.x = _gelu(vg.x);
+            vg.y = _gelu(vg.y);
+            break;
+
+        case ACT_RELU2_NOGATE:
+            vg.x = __hmax2(vu.x, __float2half2_rn(0.0f));
+            vg.y = __hmax2(vu.y, __float2half2_rn(0.0f));
+            break;
+
+        default:
+            break;
+    }
+
+    // Optional activation limits
+    if (act_limit != 0.0f)
+    {
+        vu.x = __hmax2(vu.x, __float2half2_rn(-act_limit));
+        vu.y = __hmax2(vu.y, __float2half2_rn(-act_limit));
+        vu.x = __hmin2(vu.x, __float2half2_rn(act_limit));
+        vu.y = __hmin2(vu.y, __float2half2_rn(act_limit));
+        vg.x = __hmin2(vg.x, __float2half2_rn(act_limit));
+        vg.y = __hmin2(vg.y, __float2half2_rn(act_limit));
+    }
+
+    // Gate
+    vg.x = __hmul2(vg.x, vu.x);
+    vg.y = __hmul2(vg.y, vu.y);
+
+    // Pre scale (d)
+    half4 scales_d = ((half4*) pre_scale_d)[i];
+    vg.x = __hmul2(vg.x, scales_d.x);
+    vg.y = __hmul2(vg.y, scales_d.y);
+
+    // Hadamard
+    vg = had(vg);
+
+    // Store
+    ((half4*) output_ptr)[t] = vg;
+}
+
+// Fused op: o += float(out_had(i)), atomic
+
+inline __device__
+void had_hf_r_128_d_inner
+(
+    const half* __restrict__ input_ptr,
+    float* __restrict__ output_ptr,
+    const half* __restrict__ post_scale,
+    const float r_scale
+)
+{
+    int t = threadIdx.x & 31;
+
+    // Load
+    half4 v = ((half4*) input_ptr)[t];
+
+    // 4 element had
+    float v0 = __half2float(__low2half(v.x));
+    float v1 = __half2float(__high2half(v.x));
+    float v2 = __half2float(__low2half(v.y));
+    float v3 = __half2float(__high2half(v.y));
+    float s0 = v0 + v1;
+    float d0 = v0 - v1;
+    float s1 = v2 + v3;
+    float d1 = v2 - v3;
+    float h0 = s0 + s1;
+    float h1 = d0 + d1;
+    float h2 = s0 - s1;
+    float h3 = d0 - d1;
+
+    // 32 element had, warp shuffle
+    shuffle_had_f4x32(h0, h1, h2, h3, t);
+    h0 *= r_scale;
+    h1 *= r_scale;
+    h2 *= r_scale;
+    h3 *= r_scale;
+
+    // Post scale
+    int i = blockIdx.y * 32 + t;
+    half4 scales = ((half4*) post_scale)[i];
+    h0 *= __low2float(scales.x);
+    h1 *= __high2float(scales.x);
+    h2 *= __low2float(scales.y);
+    h3 *= __high2float(scales.y);
+
+    // Reshuffle in shmem for coalesced store with atomicAdd
+    extern __shared__ float temp_shared[];
+    int warp_id = threadIdx.x / 32;
+    float* sh = temp_shared + warp_id * 128;
+    sh[t * 4 + 0] = h0;
+    sh[t * 4 + 1] = h1;
+    sh[t * 4 + 2] = h2;
+    sh[t * 4 + 3] = h3;
+    __syncwarp();
+    atomicAdd(output_ptr +  0 + t, sh[ 0 + t]);
+    atomicAdd(output_ptr + 32 + t, sh[32 + t]);
+    atomicAdd(output_ptr + 64 + t, sh[64 + t]);
+    atomicAdd(output_ptr + 96 + t, sh[96 + t]);
+}
