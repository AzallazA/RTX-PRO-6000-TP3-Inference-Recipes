+    on = TP3Config.from_environment({"FLARE_DS41_PIN_SMALL_QPROJ": "1"})
+    assert on.pin_small_qproj is True and on.to_metadata()["pin_small_qproj"] is True
+    with pytest.raises(TypeError):
+        TP3Config(pin_small_qproj="1")
