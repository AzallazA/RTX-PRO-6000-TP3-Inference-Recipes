+    let (closing, _) = text.match_indices("</arg_value>").nth(1).unwrap();
+    let (key, _) = text.match_indices("<arg_key>").nth(2).unwrap();
+    let schedules: Vec<Vec<usize>> = vec![
+        text.char_indices().map(|(at, _)| at).skip(1).collect(),
+        vec![closing + 5, key + 4],
