+// moedet-bp: slot j of an accumulator lives at base + j * stride; sums run in fixed order j = 0..n-1 (n == 1: the
+// image's single load). Loads are issued before the dependent adds (unrolled to the compile-time slot maximum).
+__device__ __forceinline__ int nslots(const Params& p, int pairs) { return p.det ? pairs : 1; }
+
+template <int MAXS>
+__device__ __forceinline__ void load_sum8(const float* src, long stride, int n, bool live, float (&v)[8]) {
+  unpack8(load8(src, live), v);
+#pragma unroll
+  for (int j = 1; j < MAXS; ++j) {
+    if (j < n) {
+      float w[8];
+      unpack8(load8(src + j * stride, live), w);
+#pragma unroll
+      for (int e = 0; e < 8; ++e) v[e] += w[e];
+    }
+  }
+}
+
+template <int MAXS>
+__device__ __forceinline__ void clear_slots8(float* dst, long stride, int n) {
+  clear8(dst);
+#pragma unroll
+  for (int j = 1; j < MAXS; ++j)
+    if (j < n) clear8(dst + j * stride);
+}
+
+template <int MAXS>
+__device__ __forceinline__ float load_sum1(const float* src, long stride, int n) {
+  float v = __ldcg(src);
+#pragma unroll
+  for (int j = 1; j < MAXS; ++j)
+    if (j < n) v += __ldcg(src + j * stride);
+  return v;
+}
+
+template <int MAXS>
+__device__ __forceinline__ void clear_slots1(float* dst, long stride, int n) {
+  __stcg(dst, 0.0f);
+#pragma unroll
+  for (int j = 1; j < MAXS; ++j)
+    if (j < n) __stcg(dst + j * stride, 0.0f);
+}
+
 __device__ __forceinline__ long chunk_off(int i, int k) { return long(i / CHUNK_VECS) * HID + k * CHUNK_COLS + (i % CHUNK_VECS) * 8; }
 
