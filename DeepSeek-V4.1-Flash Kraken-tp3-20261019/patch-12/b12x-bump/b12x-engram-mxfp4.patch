+    if PACKED_FP4:
+        # PATCH(ds41-nvfp4): rows are 128 bytes of MXFP4 E2M1 nibbles, even column
+        # in the low nibble. e = bits 2:1, m = bit 0: m*0.5 if e == 0 else (2+m)*2**(e-2).
+        byte = tl.load(
+            weight + local_row * 128 + (col // 2).to(tl.int64), local, 0
+        ).to(tl.int32)
+        nib = tl.where(col % 2 == 0, byte & 0xF, (byte >> 4) & 0xF)
+        e = (nib & 0x7) >> 1
+        m = (nib & 0x1).to(tl.float32)
+        pow2 = ((e - 2 + 127) << 23).to(tl.float32, bitcast=True)
+        mag = tl.where(e == 0, m * 0.5, (2.0 + m) * pow2)
+        quant = tl.where((nib & 0x8) != 0, -mag, mag)
+    else:
+        quant = tl.load(weight + local_row * 256 + col.to(tl.int64), local, 0.0).to(
+            tl.float32
+        )
