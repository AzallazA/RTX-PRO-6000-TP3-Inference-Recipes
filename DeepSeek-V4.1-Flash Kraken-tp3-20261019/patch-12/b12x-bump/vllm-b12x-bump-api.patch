+class _RegimePlanView:
+    """A ``plan_regimes`` composite as ``blockscaled.mm`` reads it.
+
+    PATCH(ds41-b12x-bump): b12x c82506d71 (fused rounded SwiGLU packing, in
+    pins from 2026-11-07 on) makes ``blockscaled_mm`` read
+    ``plan.query.source_activation`` to size the source row. ``plan_regimes``
+    returns a ``_CompositePlan``, which has no ``query``, so every packed
+    NVFP4/MXFP8 call raised ``AttributeError`` (the profile run's first LM-head
+    projection on the 2026-11-10 bump boot). The view exposes the capacity
+    child's query (all regime children share its source activation and K) and
+    forwards everything else, notably ``handle``, which ``blockscaled.mm``
+    passes to the custom op that resolves the prepared regime. The composite
+    itself stays the declared and prepared plan.
+    """
+
+    __slots__ = ("plan", "query")
+
+    def __init__(self, plan) -> None:
+        self.plan = plan
+        self.query = plan.variants[max(plan.token_counts)].query
+
+    def __getattr__(self, name: str):
+        # Only reached for names the view does not hold (handle, prepared, ...).
+        if name.startswith("__") or name in self.__slots__:
+            raise AttributeError(name)
+        return getattr(self.plan, name)
+
+
+def _mm_plan(plan):
+    """``plan`` as ``blockscaled.mm`` expects it: scalar plans pass through."""
+    if plan is None or hasattr(plan, "query") or not hasattr(plan, "variants"):
+        return plan
+    return _RegimePlanView(plan)
+
+
