+def _is_real_batch(input_batch: InputBatch, req_states: RequestState) -> bool:
+    """PATCH(ds41-lazy-engram): True for scheduler batches of registered requests.
+
+    Profile and warm-up dummy batches (InputBatch.make_dummy) carry fresh random
+    request ids that RequestState never registered.
+    """
+    req_ids = getattr(input_batch, "req_ids", None)
+    known = getattr(req_states, "req_id_to_index", None)
+    if not req_ids or known is None:
+        return False
+    return all(req_id in known for req_id in req_ids)
+
