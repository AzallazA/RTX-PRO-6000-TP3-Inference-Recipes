+    def self_arm_lazy_engram(self) -> None:
+        """PATCH(ds41-lazy-engram): arm promotion on the first real batch.
+
+        Called by DeepseekV41ModelState.prepare_inputs only for batches whose
+        requests are all registered (never for profile/warm-up dummy batches,
+        which use unregistered request ids). With DS41_ENGRAM_LAZY_SELF_ARM=1
+        and lazy Engram tables still unfilled, every TP rank creates the arm
+        file itself, so all ranks take the promote-and-fill branch on the same
+        step (no arm-file race against ds41-serve) and no real request ever
+        reads the zero rows an unfilled lazy table contributes.
+        """
+        if not _LAZY_SELF_ARM or not getattr(self, "_lazy_engram_pending", True):
+            return
+        arm_file = os.environ.get("B12X_DEFERRED_BANK_ARM_FILE", "")
+        if not arm_file or os.path.exists(arm_file):
+            return
+        pending = any(
+            layer.engram.embed_tokens.lazy_pending
+            for layer in islice(self.layers, self.start_layer, self.end_layer)
+            if getattr(layer, "engram", None) is not None
+        )
+        if not pending:
+            return
+        try:
+            with open(arm_file, "a"):
+                pass
+            logger.info("Lazy Engram RAM: first real batch, created arm file %s", arm_file)
+        except OSError as exc:
+            logger.warning("Lazy Engram RAM: cannot create arm file %s: %s", arm_file, exc)
+
