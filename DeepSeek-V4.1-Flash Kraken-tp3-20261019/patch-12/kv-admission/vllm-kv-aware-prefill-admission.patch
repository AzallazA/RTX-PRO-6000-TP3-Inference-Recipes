+    def _kv_admission_blocks(
+        self,
+        request: Request,
+        new_computed_blocks: tuple = (),
+        num_local_computed_tokens: int | None = None,
+        num_external_computed_tokens: int = 0,
+    ) -> int:
+        """PATCH(ds41-kv-admission): blocks `request` still needs for its
+        whole sequence (prompt + output so far + spec lookahead slots), after
+        prefix-cache hits, with the recycling-aware (SWA) admission cap."""
+        main_tokens = min(request.num_tokens, self.max_model_len)
+        num_tokens = min(main_tokens + self.num_lookahead_tokens, self.max_model_len)
+        if num_local_computed_tokens is None:
+            num_local_computed_tokens = request.num_computed_tokens
+        coordinator = self.kv_cache_manager.coordinator
+        return coordinator.get_num_blocks_to_allocate(
+            request_id=request.request_id,
+            num_tokens=num_tokens,
+            new_computed_blocks=(
+                new_computed_blocks
+                or self.kv_cache_manager.empty_kv_cache_blocks.blocks
+            ),
+            num_encoder_tokens=0,
+            total_computed_tokens=num_local_computed_tokens
+            + num_external_computed_tokens,
+            num_local_computed_tokens=num_local_computed_tokens,
+            num_tokens_main_model=main_tokens,
+            apply_admission_cap=True,
+        )
+
+    def _kv_admission_gate(
+        self,
+        request: Request,
+        new_computed_blocks: KVCacheBlocks,
+        num_new_local_computed_tokens: int,
+        num_external_computed_tokens: int,
+    ) -> int:
+        """PATCH(ds41-kv-admission): 0 if `request` may start its prefill,
+        else the blocks it needs (it stays waiting).
+
+        Admit only if free blocks cover its remaining prompt, the remaining
+        prompt of every in-flight prefill, the need of the oldest held request
+        that arrived before it and has waited DS41_KV_ADMISSION_HOL_S (aging,
+        no starvation), and the decode-growth headroom."""
+        need = self._kv_admission_blocks(
+            request,
+            new_computed_blocks.blocks,
+            num_new_local_computed_tokens,
+            num_external_computed_tokens,
+        )
+        committed = sum(
+            self._kv_admission_blocks(inflight)
+            for inflight in self._inflight_prefills
+            if inflight is not request
+        )
+        hol_reserve_blocks = 0
+        oldest_arrival = request.arrival_time
+        aged = time.time() - self.kv_admission_hol_s
+        for held_id, held_need in self._kv_admission_held.items():
+            held = self.requests.get(held_id)
+            if (
+                held is not None
+                and held is not request
+                and held.status in (RequestStatus.WAITING, RequestStatus.PREEMPTED)
+                and held.arrival_time < oldest_arrival
+                and held.arrival_time <= aged
+            ):
+                oldest_arrival, hol_reserve_blocks = held.arrival_time, held_need
+        free = self.kv_cache_manager.block_pool.get_num_free_blocks()
+        if (
+            need + committed + hol_reserve_blocks + self.kv_admission_headroom_blocks
+            <= free
+        ):
+            self._kv_admission_held.pop(request.request_id, None)
+            return 0
+        self.kv_admission_stats["gated"] += 1
+        self._kv_admission_held[request.request_id] = max(need, 1)
+        now = time.monotonic()
+        if now - self._kv_admission_last_log > 30.0:
+            self._kv_admission_last_log = now
+            logger.info(
+                "KV admission: holding %s (needs %d blocks; free %d, in-flight "
+                "prefills need %d, headroom %d; %d held so far)",
+                request.request_id,
+                need,
+                free,
+                committed + hol_reserve_blocks,
+                self.kv_admission_headroom_blocks,
+                self.kv_admission_stats["gated"],
+            )
+        return max(need, 1)
+
+    def _kv_admission_lane_filter(self, queue: Iterable[Request]) -> Iterable[Request]:
+        """PATCH(ds41-kv-admission): drop held waiting requests from the lane
+        candidates while their last measured need still does not fit, so the
+        lanes (and the step budget) go to prefills that can run. Without this a
+        held request ranks first (never served) and pushes the running
+        prefills into the non-preempting leftover pass every step."""
+        held = self._kv_admission_held
+        if not held:
+            return queue
+        for request_id in [r for r in held if r not in self.requests]:
+            del held[request_id]
+        if not held:
+            return queue
+        free = self.kv_cache_manager.block_pool.get_num_free_blocks()
+        spare = (
+            free
+            - self.kv_admission_headroom_blocks
+            - sum(self._kv_admission_blocks(r) for r in self._inflight_prefills)
+        )
+        return [
+            request
+            for request in queue
+            if request.request_id not in held or held[request.request_id] <= spare
+        ]
+
+    def _kv_admission_guard_victim(
+        self,
+        running_at_start: set[str] | None,
+        num_scheduled_tokens: dict[str, int],
+        blocked: bool,
+    ) -> Request | None:
+        """PATCH(ds41-kv-admission): the partial prefill to preempt, or None.
+
+        `blocked`: a running prefill failed to get blocks this step. The stuck
+        counter resets when a running prefill advances, counts blocked steps,
+        and ignores steps that tried no running prefill (decode turns).
+        Candidates are partial prefills that were running at step start and got
+        nothing this step. At least two are needed (one keeps going). The
+        newest (lowest priority, then latest arrival) is chosen."""
+        assert running_at_start is not None
+        stuck = []
+        for request in self.running:
+            if request.request_id not in running_at_start:
+                continue
+            if not (request.is_prefill_chunk and request in self._inflight_prefills):
+                continue
+            if request.request_id in num_scheduled_tokens:
+                self._kv_stuck_steps = 0  # a running prefill advanced
+                return None
+            stuck.append(request)
+        if not blocked:
+            return None
+        self._kv_stuck_steps += 1
+        if self._kv_stuck_steps < self.kv_admission_guard_steps or len(stuck) < 2:
+            return None
+        if self.policy == SchedulingPolicy.PRIORITY:
+            victim = max(stuck, key=lambda r: (r.priority, r.arrival_time))
+        else:
+            victim = max(stuck, key=lambda r: r.arrival_time)
+        if not self._request_blocks_can_be_freed(victim):
+            return None
+        self._kv_stuck_steps = 0
+        return victim
+
     def _inflight_prefill_reserved_blocks(self) -> int:
         """Num blocks in-flight prefills still need to finish (their reservation)."""
 
