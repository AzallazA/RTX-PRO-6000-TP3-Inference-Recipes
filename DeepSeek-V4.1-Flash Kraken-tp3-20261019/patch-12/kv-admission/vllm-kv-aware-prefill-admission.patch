+def _env_flag(name: str, default: bool) -> bool:
+    """PATCH(ds41-kv-admission): boolean environment switch."""
+    value = os.environ.get(name)
+    if value is None or value.strip() == "":
+        return default
+    return value.strip().lower() not in ("0", "false", "no", "off")
