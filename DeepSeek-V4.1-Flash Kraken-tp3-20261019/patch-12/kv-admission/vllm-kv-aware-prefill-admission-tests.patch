+@pytest.mark.parametrize("max_parallel_prefills", ["auto", 1])
+def test_identical_schedule_when_kv_is_not_near_full(
+    monkeypatch, opt_model_path, max_parallel_prefills
+):
+    """Big pool: every step's schedule is the same with and without the patch."""
+
+    def trace(kv_admission: bool):
+        global _tokens
+        _tokens = itertools.count(1000)
+        scheduler = _scheduler(
+            monkeypatch,
+            opt_model_path,
+            kv_admission=kv_admission,
+            max_parallel_prefills=max_parallel_prefills,
+            num_blocks=20000,
+        )
+        arrivals = {0: [600, 40, 300], 3: [8, 500], 9: [700, 16], 20: [64] * 4}
+        steps = []
+        for step in range(400):
+            for i, blocks in enumerate(arrivals.get(step, ())):
+                scheduler.add_request(
+                    _request(f"r{step}-{i}", blocks * BS // 4 + 3, max_tokens=12)
+                )
+            output = _step(scheduler)
+            steps.append(sorted(output.num_scheduled_tokens.items()))
+        assert scheduler.kv_admission_stats["gated"] == 0
+        return steps
+
+    assert trace(False) == trace(True)
+
+
+def test_short_prompts_keep_lanes_while_the_pool_is_overcommitted(
+    monkeypatch, opt_model_path
+):
+    """Held long prompts leave the lanes; short ones keep them even when the
+    in-flight prefills plus headroom already exceed the free blocks (long_a is
+    below the short threshold, so it was admitted without the gate)."""
+    scheduler = _scheduler(
+        monkeypatch,
+        opt_model_path,
+        kv_admission=True,
+        num_blocks=1000,
+        DS41_KV_ADMISSION_HEADROOM=0.6,
+        DS41_KV_ADMISSION_SHORT_TOKENS=8100,
+    )
+    long_a = _request("long_a", 500 * BS)
+    long_b = _request("long_b", 600 * BS)
+    scheduler.add_request(long_a)
+    _step(scheduler)
+    scheduler.add_request(long_b)
+    _step(scheduler)
+    _step(scheduler)
+    assert "long_b" in scheduler._kv_admission_held
+    free = scheduler.kv_cache_manager.block_pool.get_num_free_blocks()
+    assert free - scheduler.kv_admission_headroom_blocks - (
+        scheduler._kv_admission_blocks(long_a)
+    ) < 0  # overcommitted
+    for i in range(3):
+        short = _request(f"short{i}", 40)
+        scheduler.add_request(short)
+        output = _step(scheduler)
+        assert f"short{i}" in output.num_scheduled_tokens
+        while not short.is_finished():
+            _step(scheduler)
+    assert long_b.status == RequestStatus.WAITING
