+      [&](int tok) { return p.s.hse + (sp.first + tok) * HQ_LD + kh.k0; });
+  dense_q(c, sp, kh.ks, kh.kw, [&](int rt, int tt, const float (&a)[4]) { scatter(p.s.shacc, HID, rb * 64 + rt * 16, sp, tt, a, c.lane); });
