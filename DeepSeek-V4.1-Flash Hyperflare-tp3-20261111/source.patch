+fn ds41_decoders(s: &mut RequestScheduler, count: usize) -> Vec<RequestHandle> {
+    let handles: Vec<_> = (0..count).map(|i| add(s, i as u32 + 1, 64, 60_000)).collect();
+    ready(s, &handles);
+    for _ in 0..64 {
+        ds41_step(s, 3);
+    }
+    handles
+}
