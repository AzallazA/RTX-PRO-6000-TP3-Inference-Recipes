new file mode 100755
index 00000000..b9847cd1
--- /dev/null
+++ b/tp3-tools/mini-export.sh
@@ -0,0 +1,56 @@
+#!/bin/bash
+# Mini export: export a truncated DeepSeek-V4.1-Flash checkpoint view (6 or 8 layers; no parking, no Engram) at TP3,
+# serve it, run tp3-tools/consistency.py (decode vs prefill), stop the server. About 10 minutes. It catches compile,
+# trace and wiring faults in risky kernel or wiring changes; it says nothing about speed (handbook D.2 rule 1).
+#   SNAP    truncated checkpoint view directory (required; 8-layer views carry native scales for parking/BRRR tests)
+#   LAYERS  BRRR layers, e.g. 0-5 (default: none)
+#   LABEL   label for the log directory (default: mini)
+#   OUT     log directory (default: ./mini-<label>-<MMDD-HHMM>)
+#   GPUS    default 0,1,2; PORT is fixed at 15015 (consistency.py's URL)
+#   FLARE_BIN  server binary (default: this checkout's flare/target/release/flare; worktrees without a Rust build
+#              point it at the serving checkout's binary)
+# Further FLARE_DS41_* settings pass through from the environment (e.g. FLARE_DS41_FUSED_QKV_NORM=1). Run from any
+# worktree: the export imports this checkout (PYTHONPATH), and the log records which ignition it imported.
+# The GPUs must be idle: stop any server first; this script refuses to start next to one and starts none afterwards.
+set -euo pipefail
+ROOT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
+cd "$ROOT"
+: "${SNAP:?set SNAP to a truncated checkpoint view}"
+LABEL=${LABEL:-mini}
+OUT=${OUT:-$PWD/mini-$LABEL-$(date +%m%d-%H%M)}
+mkdir -p "$OUT"
+pids(){ ps -eo pid,args | awk '$2 ~ /(^|\/)flare$/ && $3=="run"{print $1}'; }
+[ -z "$(pids)" ] || { echo "a flare server is running: stop it first (export and serving cannot share the GPUs)" >&2; exit 2; }
+export PYTHONPATH="$ROOT" CUDA_HOME="${CUDA_HOME:-/usr/local/cuda-13.1}" HF_HUB_OFFLINE=1 \
+       TORCH_EXTENSIONS_DIR="$ROOT/.brrr-ext" FLARE_DS41_TP3_GRAPH_GIB=1 FLARE_DS41_TP3_VOCAB_PARALLEL=1 \
+       FLARE_DS41_MINI=1 FLARE_DS41_BRRR_LAYERS="${LAYERS:-}" FLARE_DS41_BRRR_LOG=1 FLARE_DS41_BRRR_CKPT="$SNAP"
+export PATH="$CUDA_HOME/bin:$PATH"
+.venv/bin/python -c 'import ignition; print("ignition imported from", ignition.__file__)' | tee "$OUT/export.log"
+start=$(date +%s)
+rc=0; timeout 3600 .venv/bin/ignition export "$SNAP" --gpus "${GPUS:-0,1,2}" --max-concurrency 8 \
+  --prefill-chunk-size 4096 --mtp-draft-tokens 5 --draft-head-quantization nvfp4 --markov-head-quantization fp8 \
+  --vocabulary-parallel-sampling --verbose >> "$OUT/export.log" 2>&1 || rc=$?
+echo "export exit $rc after $(( ($(date +%s) - start) / 60 )) min" | tee "$OUT/SUMMARY.txt"
+if [ "$rc" != 0 ]; then
+  tr '\r' '\n' < "$OUT/export.log" | grep -E "Error|Traceback" | grep -v "^b12x" | tail -4 | cut -c1-300 | tee -a "$OUT/SUMMARY.txt"
+  exit "$rc"
+fi
+P=$(grep -o "[^ ]*/packages/models/[^ ]*" "$OUT/export.log" | tail -1)
+echo "package $P" | tee -a "$OUT/SUMMARY.txt"
+"${FLARE_BIN:-$ROOT/flare/target/release/flare}" run "$P" --gpus "${GPUS:-0,1,2}" --port 15015 --host 127.0.0.1 \
+  --served-model-name DeepSeek-V4.1-Flash --mtp-draft-tokens 5 > "$OUT/serve.log" 2>&1 &
+ready=0
+for _ in $(seq 1 120); do
+  sleep 5
+  curl -s -m 2 localhost:15015/v1/models | grep -q '"id"' && { ready=1; break; }
+  [ -n "$(pids)" ] || break
+done
+if [ "$ready" = 1 ]; then
+  grep -E "OK.*Allocate cache" "$OUT/serve.log" | cut -c1-120 | tee -a "$OUT/SUMMARY.txt" || true
+  .venv/bin/python tp3-tools/consistency.py 48 6 "$SNAP" | tee "$OUT/consistency.txt" | tail -3 | tee -a "$OUT/SUMMARY.txt"
+else
+  echo "server did not come up; see $OUT/serve.log" | tee -a "$OUT/SUMMARY.txt"
+fi
+for p in $(pids); do kill -INT "$p"; done
+for _ in $(seq 1 60); do [ -z "$(pids)" ] && break; sleep 3; done
+[ "$ready" = 1 ]
diff --git a/tp3-tools/mixed_bank.py b/tp3-tools/mixed_bank.py
new file mode 100644
index 00000000..1627ffbf
--- /dev/null
+++ b/tp3-tools/mixed_bank.py
@@ -0,0 +1,61 @@
+"""One expert bank in one virtual range: the first `split` experts in VRAM, the rest in pinned host memory (CUDA VMM)."""
+import torch
+from cuda.bindings import driver as d
+from b12x.sequence._shared.disk_table import _tensor_from_pointer
+
+_keep = []
+
+
+def _ok(result):
+    err = result[0] if isinstance(result, tuple) else result
+    if err != d.CUresult.CUDA_SUCCESS:
+        raise RuntimeError(f"CUDA driver error {err}")
+    return result[1] if isinstance(result, tuple) and len(result) == 2 else (result[1:] if isinstance(result, tuple) else None)
+
+
+def _prop(kind, device):
+    p = d.CUmemAllocationProp()
+    p.type = d.CUmemAllocationType.CU_MEM_ALLOCATION_TYPE_PINNED
+    p.location.type = kind
+    p.location.id = device if kind == d.CUmemLocationType.CU_MEM_LOCATION_TYPE_DEVICE else 0
+    return p
+
+
+def mixed_tensor(shape, dtype, split, device):
+    """Tensor whose rows [0, split) are device-backed and rows [split, shape[0]) host-backed."""
+    dev = torch.device(device).index
+    torch.cuda.init(); torch.empty(1, device=device)  # make the primary context current
+    row = torch.Size(shape[1:]).numel() * dtype.itemsize
+    total = shape[0] * row
+    pd = _prop(d.CUmemLocationType.CU_MEM_LOCATION_TYPE_DEVICE, dev)
+    ph = _prop(d.CUmemLocationType.CU_MEM_LOCATION_TYPE_HOST_NUMA, 0)
+    flag = d.CUmemAllocationGranularity_flags.CU_MEM_ALLOC_GRANULARITY_MINIMUM
+    gran = max(_ok(d.cuMemGetAllocationGranularity(pd, flag)), _ok(d.cuMemGetAllocationGranularity(ph, flag)))
+    up = lambda n: -(-n // gran) * gran
+    dev_bytes = up(split * row)          # the boundary page goes to the device side
+    size = up(total)
+    host_bytes = max(size - dev_bytes, 0)
+    va = _ok(d.cuMemAddressReserve(size, gran, 0, 0))
+    handles = []
+    for nbytes, prop, offset in ((dev_bytes, pd, 0), (host_bytes, ph, dev_bytes)):
+        if nbytes:
+            h = _ok(d.cuMemCreate(nbytes, prop, 0))
+            _ok(d.cuMemMap(int(va) + offset, nbytes, 0, h, 0))
+            handles.append(h)
+    access = d.CUmemAccessDesc()
+    access.location.type = d.CUmemLocationType.CU_MEM_LOCATION_TYPE_DEVICE
+    access.location.id = dev
+    access.flags = d.CUmemAccess_flags.CU_MEM_ACCESS_FLAGS_PROT_READWRITE
+    _ok(d.cuMemSetAccess(va, size, [access], 1))
+    _keep.append((va, size, handles))
+    return _tensor_from_pointer(int(va), shape=tuple(shape), dtype=dtype, device=torch.device("cuda", dev), nbytes=total)
+
+
+def allocator(split, device):
+    def host_alloc(name, shape, dtype):
+        view = mixed_tensor(shape, dtype, split, device)
+
+        class Region:
+            device_view = view
+        return Region
+    return host_alloc
diff --git a/tp3-tools/overlap_bench.py b/tp3-tools/overlap_bench.py
new file mode 100644
index 00000000..519d2fd6
--- /dev/null
+++ b/tp3-tools/overlap_bench.py
@@ -0,0 +1,152 @@
+"""Microbenchmark for TP3 hot/cold expert overlap on one parked layer.
+
+Cold experts live in real pinned, device-mapped host memory. Routes are sampled from the
+vLLM route counts. Each case is captured as a CUDA graph two ways: serial (hot then cold
+on one stream) and forked (cold on a second stream, joined before the sum).
+usage: overlap_bench.py SNAPSHOT LAYER [HOT=326]
+"""
+import json, os, sys
+import torch
+
+from b12x.preparation import PreparationSession
+from b12x.sequence._shared.disk_table import _tensor_from_pointer
+from ignition.components.moe import PreparedRoutedExperts
+from ignition.components.parallel import TensorParallelShard
+from ignition.preparation.checkpoint import inspect_indexed_checkpoint
+from ignition.recipes.deepseek41.tp3_config import TP3Config
+from ignition.recipes.deepseek41.weights import DeepSeekWeightLoader
+
+snap, L = sys.argv[1], int(sys.argv[2])
+H = int(sys.argv[3]) if len(sys.argv) > 3 else 326
+dev = torch.device("cuda", 0); torch.cuda.set_device(dev)
+shard = TensorParallelShard(0, 3)
+ffn = f"layers.{L}.ffn"
+counts_dir = os.path.expanduser("~/ds41-tp3/release/ds41-kraken-tp3-20261019/expert-order-blend")  # site-specific
+raw = json.load(open(f"{counts_dir}/expert-routes-rank0-layer{L}.json"))
+counts = raw.get("counts", raw) if isinstance(raw, dict) else raw
+if isinstance(counts, dict):
+    counts = [counts[k] for k in sorted(counts, key=int)]
+counts = torch.tensor(counts, dtype=torch.float64)
+order = torch.argsort(counts, descending=True)
+hot, cold = sorted(order[:H].tolist()), sorted(order[H:].tolist())
+pinned = []
+
+
+def host_alloc(name, shape, dtype):
+    if os.environ.get("COLD_ON_DEVICE"):
+        view = torch.empty(shape, dtype=dtype, device=dev); pinned.append(view)
+
+        class Region:
+            device_view = view
+        return Region
+    # Real mapped host memory: pinned allocation, device view at the same UVA address.
+    host = torch.empty(shape, dtype=dtype, pin_memory=True)
+    pinned.append(host)
+    view = _tensor_from_pointer(host.data_ptr(), shape=tuple(shape), dtype=dtype, device=dev, nbytes=host.nbytes)
+
+    class Region:
+        device_view = view
+    return Region
+
+
+with torch.no_grad(), DeepSeekWeightLoader(inspect_indexed_checkpoint(snap), dev, shard=shard,
+                                           expert_scale_compression="csf", prefixes=(f"{ffn}.experts.",),
+                                           tp3=TP3Config.from_environment()) as loader:
+    text = loader.config.text
+    E = text["n_routed_experts"]
+    interval = shard.partition(text["moe_intermediate_size"], alignment=32)
+    hot_bank = loader.load_experts([f"{ffn}.experts.{i}" for i in hot], interval)
+    loader._host_allocator = host_alloc
+    cold_bank = loader.load_experts([f"{ffn}.experts.{i}" for i in cold], interval, host=True)
+    sys.path.insert(0, os.path.expanduser("~/flare-tp3-tools"))
+    import mixed_bank
+    loader._host_allocator = mixed_bank.allocator(H, dev)
+    merged_bank = loader.load_experts([f"{ffn}.experts.{i}" for i in hot + cold], interval, host=True)
+    loader._host_allocator = None
+    device_bank = loader.load_experts([f"{ffn}.experts.{i}" for i in hot + cold], interval)
+hot_map = torch.full((E,), -1, dtype=torch.int32); hot_map[hot] = torch.arange(len(hot), dtype=torch.int32)
+cold_map = torch.full((E,), -1, dtype=torch.int32); cold_map[cold] = torch.arange(len(cold), dtype=torch.int32)
+perm = torch.empty(E, dtype=torch.int32); perm[torch.tensor(hot + cold)] = torch.arange(E, dtype=torch.int32)
+hot_map, cold_map, perm = hot_map.to(dev), cold_map.to(dev), perm.to(dev)
+prob = counts / counts.sum()
+print(f"layer {L}: {H} hot / {E - H} cold (host), cold route share {prob[cold].sum() * 100:.2f}%")
+
+hidden = text["hidden_size"]
+aux = torch.cuda.Stream()
+flush = torch.empty(512 << 20, dtype=torch.uint8, device=dev)
+with torch.no_grad(), PreparationSession(device=dev, autotune=False, compile_workers=0) as session:
+    for rows in (6, 24, 48):
+        x = torch.randn((rows, hidden), dtype=torch.bfloat16, device=dev)
+        ids = torch.multinomial(prob, rows * 6, replacement=True).view(rows, 6).int().to(dev)
+        w = torch.rand((rows, 6), dtype=torch.float32, device=dev)
+        hid, cid = torch.empty_like(ids), torch.empty_like(ids)
+        torch.index_select(hot_map, 0, ids.view(-1), out=hid.view(-1))
+        torch.index_select(cold_map, 0, ids.view(-1), out=cid.view(-1))
+        out_hot, out_cold, out_merged = torch.zeros_like(x), torch.zeros_like(x), torch.zeros_like(x)
+        mid = torch.empty_like(ids); torch.index_select(perm, 0, ids.view(-1), out=mid.view(-1))
+        op_hot = PreparedRoutedExperts(x, hot_bank, hid, w, out_hot, session=session, name=f"hot{rows}")
+        op_cold = PreparedRoutedExperts(x, cold_bank, cid, w, out_cold, session=session, name=f"cold{rows}")
+        op_merged = PreparedRoutedExperts(x, merged_bank, mid, w, out_merged, session=session, name=f"merged{rows}")
+        out_device = torch.zeros_like(x)
+        op_device = PreparedRoutedExperts(x, device_bank, mid, w, out_device, session=session, name=f"device{rows}")
+        n_cold = int((cid >= 0).sum()); n_cold_experts = int(torch.unique(cid[cid >= 0]).numel())
+
+        def serial():
+            op_hot(); op_cold(); out_hot.add_(out_cold)
+
+        def forked():
+            aux.wait_stream(torch.cuda.current_stream())
+            with torch.cuda.stream(aux):
+                op_cold()
+            op_hot()
+            torch.cuda.current_stream().wait_stream(aux)
+            out_hot.add_(out_cold)
+
+        def hot_only():
+            op_hot()
+
+        def merged():
+            op_merged()
+
+        results = {}
+        for label, fn in (("hot only", hot_only), ("serial", serial), ("forked", forked), ("merged", merged)):
+            for _ in range(3):
+                fn()
+            torch.cuda.synchronize()
+            g = torch.cuda.CUDAGraph()
+            s = torch.cuda.Stream()
+            s.wait_stream(torch.cuda.current_stream())
+            with torch.cuda.graph(g, stream=s):
+                fn()
+            torch.cuda.synchronize()
+            for _ in range(20):
+                g.replay()
+            # Flush the 128 MB L2 between replays (real decode streams ~40 layers through L2 between visits).
+            times = []
+            for _ in range(100):
+                flush.fill_(1)
+                start, end = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+                start.record(); g.replay(); end.record()
+                torch.cuda.synchronize(); times.append(start.elapsed_time(end) * 1000)
+            times.sort(); results[label] = times[len(times) // 2]
+        serial()
+        merged(); torch.cuda.synchronize()
+        err = float((out_merged.float() - out_hot.float()).norm() / out_hot.float().norm().clamp_min(1e-9))
+        op_device(); torch.cuda.synchronize()
+        exact = torch.equal(out_merged, out_device)
+        rel = lambda a, b: float((a.float() - b.float()).norm() / b.float().norm().clamp_min(1e-9))
+        cold_rows = (cid >= 0).any(-1)
+        print(f"    merged vs all-VRAM: {'bit-identical' if exact else 'DIFFERS'} rel {rel(out_merged, out_device):.5f}"
+              f" | all-VRAM vs serial rel {rel(out_device, out_hot):.5f}"
+              f" | rows with a cold route: merged-vs-VRAM rel {rel(out_merged[cold_rows], out_device[cold_rows]) if cold_rows.any() else float('nan'):.5f}"
+              f" | other rows {rel(out_merged[~cold_rows], out_device[~cold_rows]):.5f}")
+        first = out_device.clone(); op_device(); torch.cuda.synchronize()
+        print(f"    all-VRAM vs itself (rerun): rel {rel(out_device, first):.5f}")
+        out_device.copy_(first); out_merged.zero_()
+        for k in range(rows):   # zero all but one cold route to see whether host-backed weights contribute
+            pass
+        a = merged_bank.w13 if hasattr(merged_bank, "w13") else None
+        saved = results["serial"] - results["merged"]
+        print(f"  rows {rows:2d} ({n_cold} cold routes, {n_cold_experts} cold experts): hot only {results['hot only']:6.1f} us"
+              f" | serial {results['serial']:6.1f} us | forked {results['forked']:6.1f} us"
+              f" | merged {results['merged']:6.1f} us | merged saves {saved:5.1f} us/layer ({saved / results['serial'] * 100:4.1f}%) | rel err {err:.4f}")
diff --git a/tp3-tools/release/check_env.sh b/tp3-tools/release/check_env.sh
new file mode 100755
index 00000000..cb1a8549
--- /dev/null
+++ b/tp3-tools/release/check_env.sh
@@ -0,0 +1,129 @@
+#!/bin/bash
+# Preflight for building and serving this release. Read-only: it changes nothing and starts nothing on the GPUs.
+#   usage: ./check_env.sh <fork checkout dir>    the Flare clone at 972e28e4 (EXPORT.md step 2), before or after source.patch
+#   env:   CUDA_HOME     CUDA toolkit root (default /usr/local/cuda-13.1 if present, else the nvcc on PATH)
+#          FLARE_CACHE   where packages and the kernel tuning cache go (default ~/.cache/flare)
+#          MIN_FREE_GB   free space required on the drive holding FLARE_CACHE (default 900: checkpoints ~412 GB,
+#                        package ~380 GB, tuning cache 60-80 GB; lower it if the checkpoints live on another drive)
+#          GPUS          GPU indices you will export and serve on (default 0,1,2)
+# Prints one PASS / WARN / FAIL line per check and exits 1 if anything FAILed. WARN lines are steps not done yet.
+set -uo pipefail
+FORK=${1:?usage: check_env.sh <fork checkout dir>}
+HERE=$(dirname "$(readlink -f "$0")")
+FLARE_CACHE=${FLARE_CACHE:-$HOME/.cache/flare}; MIN_FREE_GB=${MIN_FREE_GB:-900}; GPUS=${GPUS:-0,1,2}
+BASE=972e28e44781d8d0c84d70ae434db92c36076a43
+fails=0
+pass(){ echo "PASS  $*"; }; warn(){ echo "WARN  $*"; }; fail(){ echo "FAIL  $*"; fails=$((fails+1)); }
+vge(){ [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -1)" = "$2" ]; }   # vge A B: version A >= B
+
+# --- CUDA toolkit: 13.1+ with nvcc that targets SM120 (sm_120a). The export compiles the BRRR layer kernel with it.
+if [ -z "${CUDA_HOME:-}" ] && [ -x /usr/local/cuda-13.1/bin/nvcc ]; then CUDA_HOME=/usr/local/cuda-13.1; fi
+NVCC=${CUDA_HOME:+$CUDA_HOME/bin/nvcc}
+[ -n "$NVCC" ] && [ -x "$NVCC" ] || NVCC=$(command -v nvcc || true)
+if [ -z "$NVCC" ]; then
+  fail "nvcc not found: install CUDA 13.1 and export CUDA_HOME=/usr/local/cuda-13.1 PATH=\$CUDA_HOME/bin:\$PATH"
+else
+  v=$("$NVCC" --version | grep -oE 'release [0-9]+\.[0-9]+' | cut -d' ' -f2)
+  if vge "$v" 13.1; then pass "CUDA toolkit $v ($NVCC)"; else fail "CUDA toolkit $v at $NVCC; 13.1 or newer is required (12.x cannot target SM120)"; fi
+  if "$NVCC" --list-gpu-code 2>/dev/null | grep -q '^sm_120'; then pass "nvcc accepts sm_120 (sm_120a)"; else fail "nvcc at $NVCC does not list sm_120"; fi
+  if [ "${CUDA_HOME:-}" != "$(dirname "$(dirname "$NVCC")")" ]; then
+    warn "CUDA_HOME is not set to this toolkit; before exporting: export CUDA_HOME=$(dirname "$(dirname "$NVCC")") PATH=\$CUDA_HOME/bin:\$PATH"
+  fi
+fi
+
+# --- locked memory: Flare pins host memory (cold experts, Engram tables, prefix cache)
+if [ "$(ulimit -l)" = unlimited ]; then pass "memlock unlimited"
+else fail "ulimit -l is $(ulimit -l); add '<user> - memlock unlimited' in /etc/security/limits.d/90-memlock.conf and log in again"; fi
+
+# --- toolchain
+if command -v rustc >/dev/null; then
+  v=$(rustc --version | awk '{print $2}')
+  if vge "$v" 1.88; then pass "rustc $v (fork requires >= 1.88)"; else fail "rustc $v; the fork requires 1.88 or newer (rustup update)"; fi
+else fail "rustc not found (install rustup)"; fi
+if command -v cargo >/dev/null; then pass "cargo $(cargo --version | awk '{print $2}')"; else fail "cargo not found"; fi
+if command -v uv >/dev/null; then pass "uv $(uv --version | awk '{print $2}')"; else fail "uv not found (https://docs.astral.sh/uv/)"; fi
+if command -v patch >/dev/null; then pass "patch present (applies tp3-patches/)"; else fail "patch not found (install the patch package)"; fi
+command -v git >/dev/null || fail "git not found"
+
+# --- fork checkout and source.patch
+if ! git -C "$FORK" rev-parse --git-dir >/dev/null 2>&1; then
+  fail "$FORK is not a git checkout (EXPORT.md step 2)"
+else
+  head=$(git -C "$FORK" rev-parse HEAD)
+  if [ "$head" = "$BASE" ]; then pass "fork checkout at upstream Flare ${BASE:0:8}"
+  elif git -C "$FORK" merge-base --is-ancestor "$BASE" "$head" 2>/dev/null; then warn "fork HEAD ${head:0:8} is ahead of ${BASE:0:8} (fine if you committed source.patch on top of it)"
+  else fail "fork HEAD ${head:0:8} is not ${BASE:0:8}: git checkout $BASE (fresh clone if coming from 20261105)"; fi
+  if git -C "$FORK" apply --check --reverse "$HERE/source.patch" 2>/dev/null; then pass "source.patch applied"
+  elif git -C "$FORK" apply --check "$HERE/source.patch" 2>/dev/null; then warn "source.patch not applied yet (it applies cleanly): git -C $FORK apply $HERE/source.patch"
+  else fail "source.patch neither applied nor applicable: wrong base commit or local changes (git -C $FORK status)"; fi
+fi
+
+# --- Python environment: uv-managed Python 3.12, FlashInfer patches, ignition.patches
+VENV=$FORK/.venv
+if [ -x "$VENV/bin/python" ]; then
+  pv=$("$VENV/bin/python" -c 'import sys; print("%d.%d.%d" % sys.version_info[:3])')
+  case $pv in 3.12.*) pass "fork .venv Python $pv" ;; *) fail ".venv Python is $pv; Flare pins 3.12 (uv sync --locked --extra prepare --extra test)" ;; esac
+  SP=$("$VENV/bin/python" -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')
+  IMPL=$SP/flashinfer/experimental/b12x/moe/fused_moe/_impl.py
+  if [ ! -f "$IMPL" ]; then
+    fail "FlashInfer is not installed in .venv (uv sync --locked --extra prepare --extra test)"
+  else
+    # The swiglu patch adds a guard to the tiny_decode selection in _impl.py; without it replies corrupt mid-way at TP3.
+    if grep -q 'tiny_decode implements plain SiLU-GLU only' "$IMPL"; then pass "tiny_decode honors swiglu_limit (flashinfer-tiny-decode-swiglu.patch content present)"
+    else fail "flashinfer-tiny-decode-swiglu.patch content missing in $IMPL (replies corrupt at TP3 without it)"; fi
+    for p in "$HERE"/tp3-patches/*.patch; do
+      b=$(basename "$p")
+      if patch -R --dry-run -f -s -p1 -d "$SP" < "$p" >/dev/null 2>&1; then pass "$b applied"
+      elif patch --dry-run -f -s -p1 -d "$SP" < "$p" >/dev/null 2>&1; then fail "$b not applied (applies cleanly): patch -p1 -d $SP < $p"
+      else fail "$b neither applied nor applicable to the installed FlashInfer (wrong version? re-run uv sync --locked, then re-apply)"; fi
+    done
+  fi
+  # python -m ignition.patches rewrites three files in place; these two added fragments are present once it ran.
+  tb=$SP/triton/runtime/build.py; tl=$SP/torch/_inductor/runtime/static_triton_launcher.py
+  if [ -f "$tb" ] && [ -f "$tl" ]; then
+    if grep -q "calcsize('P')" "$tb" && grep -q '_run_cooperative' "$tl"; then pass "ignition.patches applied (torch Inductor and Triton fixes)"
+    else fail "ignition.patches not applied: (cd $FORK && uv run --locked --extra prepare python -m ignition.patches); re-run after every uv sync"; fi
+  else fail "torch/triton missing in .venv (uv sync --locked --extra prepare --extra test)"; fi
+  if [ -x "$VENV/bin/ignition" ]; then pass "ignition CLI present"; else warn ".venv/bin/ignition missing (uv sync --locked --extra prepare --extra test)"; fi
+  if [ -x "$VENV/bin/ninja" ]; then pass "ninja present (BRRR kernel compile)"; else warn ".venv/bin/ninja missing; the BRRR kernel compile needs it (uv sync --locked --extra prepare --extra test)"; fi
+  tv=$("$VENV/bin/python" -c 'import importlib.metadata as m; print(m.version("torch"))' 2>/dev/null || echo missing)
+  fv=$("$VENV/bin/python" -c 'import importlib.metadata as m; print(m.version("flashinfer-python"))' 2>/dev/null || echo missing)
+  echo "      torch $tv, flashinfer-python $fv (release: 2.14.1+cu132, 0.7.1; see versions.txt). A cu132 torch wheel next to the"
+  echo "      13.1 toolkit is expected: the wheel ships its own CUDA libraries, nvcc 13.1 only compiles the BRRR kernel."
+else
+  warn "no .venv in $FORK yet: uv sync --locked --extra prepare --extra test, then ignition.patches and the FlashInfer patches (EXPORT.md step 2); re-run this check afterwards"
+fi
+if [ -x "$FORK/flare/target/release/flare" ]; then pass "flare binary built: $FORK/flare/target/release/flare"
+else warn "flare binary not built yet: cargo build --release --manifest-path $FORK/flare/Cargo.toml"; fi
+
+# --- disk
+d=$FLARE_CACHE; while [ ! -d "$d" ]; do d=$(dirname "$d"); done
+free=$(df -BG --output=avail "$d" | tail -1 | tr -dc 0-9)
+if [ "$free" -ge "$MIN_FREE_GB" ]; then pass "$free GB free on the drive holding $FLARE_CACHE (need $MIN_FREE_GB)"
+else fail "$free GB free on the drive holding $FLARE_CACHE; $MIN_FREE_GB GB needed (set MIN_FREE_GB if the checkpoints are on another drive)"; fi
+
+# --- GPUs: 3 visible SM120 cards, idle. Kernel tuning captures the power limit and clocks in effect during the export.
+if ! command -v nvidia-smi >/dev/null; then
+  fail "nvidia-smi not found (NVIDIA driver 615.71.09 or any driver supporting CUDA 13.1)"
+else
+  drv=$(nvidia-smi --query-gpu=driver_version --format=csv,noheader | head -1 | tr -d ' ')
+  n=0; bad=0
+  IFS=, read -ra want <<< "$GPUS"
+  while IFS=, read -r idx name cc used plim smmax memmax; do
+    idx=${idx// /}; cc=${cc// /}; used=${used// /}; plim=${plim// /}; smmax=${smmax// /}; memmax=${memmax// /}; name=${name# }
+    for w in "${want[@]}"; do
+      [ "$w" = "$idx" ] || continue
+      n=$((n+1))
+      [ "$cc" = "12.0" ] || { fail "GPU $idx: compute capability $cc, need 12.0 (SM120, RTX PRO 6000 Blackwell)"; bad=1; }
+      [ "$used" -lt 1024 ] || { fail "GPU $idx: $used MiB in use; stop the server and other GPU processes before exporting"; bad=1; }
+      echo "      GPU $idx: $name · power limit $plim W · max clocks SM $smmax MHz, memory $memmax MHz · $used MiB used"
+    done
+  done < <(nvidia-smi --query-gpu=index,name,compute_cap,memory.used,power.limit,clocks.max.sm,clocks.max.memory --format=csv,noheader,nounits)
+  if [ "$n" -ne 3 ]; then fail "$n of the GPUs in GPUS=$GPUS are visible; this release needs exactly 3"
+  elif [ "$bad" = 0 ]; then pass "3 SM120 GPUs ($GPUS) visible and idle, driver $drv"; fi
+  echo "      Export with the power limit and clock offsets you will serve with: the tuning cache records kernels measured"
+  echo "      at those settings. The release numbers were taken at 450 W, +75 MHz core, +6000 MHz memory offset; 350 W is 10-14% slower."
+fi
+
+echo
+if [ "$fails" = 0 ]; then echo "All checks passed."; else echo "$fails check(s) FAILED."; exit 1; fi
