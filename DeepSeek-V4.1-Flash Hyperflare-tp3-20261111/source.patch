+        Allocation {
+            name: name.into(),
+            nbytes,
+            alignment: 65536,
+            file: None,
+            data_spans: if sizing.is_none() && nbytes > 0 {
+                vec![[0, nbytes]]
+            } else {
+                vec![]
+            },
+            sources: vec![],
+            relocations: vec![],
