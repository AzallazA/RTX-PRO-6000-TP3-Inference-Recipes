+def _park_weights(weights, device):
+    """Move vision/aligner tensors into mapped host regions; returns (parked weights, regions to close)."""
+    import math
+    import mmap
+
+    cuda, cursor, regions = _Cuda(), PackageStorage.HOST_BASE, []
+
