+#[derive(Debug, Default)]
+struct ProbeLoad {
+    ttft_ms: Vec<f64>,
+    decoder_gap_ms: f64,
+    decoder_tokens_per_s: f64,
+}
+
+impl ProbeLoad {
+    fn percentile(&self, p: f64) -> f64 {
+        let mut sorted = self.ttft_ms.clone();
+        sorted.sort_by(f64::total_cmp);
+        sorted[((p * sorted.len() as f64).ceil() as usize).clamp(1, sorted.len()) - 1]
+    }
+}
