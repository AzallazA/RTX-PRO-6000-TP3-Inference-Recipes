@@ -0,0 +1,14 @@
+# Engram precision evaluation (FP8 vs MXFP4 tables)
+
+Tooling behind `docs/tp3/ENGRAM-PRECISION.md`: teacher-forced perplexity on Wikipedia, code (this repository's own
+`ignition/` and `helios/` trees) and TriviaQA/MMLU-Pro answer sets, run against a vLLM server (FP8 tables) and a
+Flare server (MXFP4 tables), then compared.
+
+| File | Role |
+| --- | --- |
+| `build_sets.py` | builds the passage and question sets (`passages.jsonl`, `triviaqa.jsonl`, `mmlupro.jsonl`) |
+| `run_eval.py` | one server, one set: prompt logprobs one passage at a time (several at once OOM a vLLM engine), answers with up to 2,048 output tokens |
+| `compare.py` | side-by-side perplexity and accuracy tables |
+| `run_all.sh`, `run_flare.sh`, `prefix_chain.sh` | site-specific drivers (server start/stop, paths under `$HOME`); edit before use |
+
+Results and method: `docs/tp3/ENGRAM-PRECISION.md`.
diff --git a/tp3-tools/engram-eval/build_sets.py b/tp3-tools/engram-eval/build_sets.py
new file mode 100644
index 00000000..45d27d6b
--- /dev/null
+++ b/tp3-tools/engram-eval/build_sets.py
@@ -0,0 +1,72 @@
+"""Build the fixed inputs for the FP8 vs MXFP4 Engram comparison.
+
+passages.jsonl  : 120 WikiText-103 test + validation articles + 80 source files, each cut to 1024 tokens (BOS + 1023), as token IDs
+triviaqa.jsonl  : 1000 TriviaQA rc.nocontext validation questions (seed 0) with normalized answer aliases
+mmlupro.jsonl   : 1000 MMLU-Pro test questions, stratified over the 14 categories (seed 0)
+"""
+import json, random, re
+from pathlib import Path
+
+from pathlib import Path
+REPO = Path(__file__).resolve().parents[2]  # the fork checkout: the code corpus is its ignition/ and helios/ trees
+import pandas as pd
+from tokenizers import Tokenizer
+
+HERE = Path(__file__).resolve().parent
+TOK = Tokenizer.from_file("/m2-2/flare-ckpt/ds41-1017-engram-mxfp4/tokenizer.json")
+BOS = TOK.token_to_id("<｜begin▁of▁sentence｜>")
+LEN = 1024
+rng = random.Random(0)
+
+
+def cut(text):
+    ids = TOK.encode(text, add_special_tokens=False).ids
+    return [BOS] + ids[: LEN - 1] if len(ids) >= LEN - 1 else None
+
+
+passages = []
+wiki = [t for split in ("test", "validation") for t in pd.read_parquet(
+    HERE / f"data/wikitext/wikitext-103-raw-v1/{split}-00000-of-00001.parquet")["text"].tolist()]
+articles, cur = [], []
+for line in wiki:
+    if re.match(r"^ = [^=].* = \n$", line) and cur:
+        articles.append("".join(cur)); cur = []
+    cur.append(line)
+articles.append("".join(cur))
+for text in articles:
+    ids = cut(text.replace(" @-@ ", "-").replace(" @,@ ", ",").replace(" @.@ ", "."))
+    if ids:
+        passages.append({"kind": "wiki", "ids": ids})
+    if sum(p["kind"] == "wiki" for p in passages) == 120:
+        break
+
+code_files = sorted(p for root in (str(REPO / "ignition"), str(REPO / "helios" / "src"))
+                    for p in Path(root).rglob("*") if p.suffix in (".py", ".rs") and p.stat().st_size > 8000)
+rng.shuffle(code_files)
+for path in code_files:
+    ids = cut(path.read_text(errors="ignore"))
+    if ids:
+        passages.append({"kind": "code", "ids": ids, "source": path.name})
+    if sum(p["kind"] == "code" for p in passages) == 80:
+        break
+with open(HERE / "passages.jsonl", "w") as f:
+    for i, p in enumerate(passages):
+        f.write(json.dumps({"id": i, **p}) + "\n")
+
+tq = pd.read_parquet(HERE / "data/trivia_qa/rc.nocontext/validation-00000-of-00001.parquet")
+rows = tq.sample(n=1000, random_state=0)
+with open(HERE / "triviaqa.jsonl", "w") as f:
+    for _, r in rows.iterrows():
+        ans = r["answer"]
+        f.write(json.dumps({"id": r["question_id"], "question": r["question"],
+                            "aliases": sorted(set(ans["normalized_aliases"].tolist()) | {ans["normalized_value"]})}) + "\n")
+
+mp = pd.read_parquet(HERE / "data/MMLU-Pro/data/test-00000-of-00001.parquet")
+cats = sorted(mp["category"].unique())
+per = {c: 1000 // len(cats) + (1 if i < 1000 % len(cats) else 0) for i, c in enumerate(cats)}
+with open(HERE / "mmlupro.jsonl", "w") as f:
+    for c in cats:
+        for _, r in mp[mp["category"] == c].sample(n=per[c], random_state=0).iterrows():
+            f.write(json.dumps({"id": int(r["question_id"]), "category": c, "question": r["question"],
+                                "options": list(r["options"]), "answer": r["answer"]}) + "\n")
+print(len(passages), "passages,", len(rows), "trivia,", sum(per.values()), "mmlu-pro over", len(cats), "categories")
diff --git a/tp3-tools/engram-eval/compare.py b/tp3-tools/engram-eval/compare.py
new file mode 100644
index 00000000..f01ed06c
--- /dev/null
+++ b/tp3-tools/engram-eval/compare.py
@@ -0,0 +1,65 @@
+"""Compare teacher-forced logprobs and benchmark answers between two runs.
+
+  compare.py <ref label> <test label>
+KL is estimated on the reference run's top-20 tokens: p from the reference, q from the test run's top-20, with
+tokens missing from the test top-20 given the test run's 20th logprob (an upper bound on q, so KL is slightly
+underestimated for those tokens). Both distributions are renormalized over the reference top-20 plus a residual bucket.
+"""
+import gzip, json, math, sys
+from pathlib import Path
+
+OUT = Path(__file__).resolve().parent / "out"
+
+
+def load(label):
+    with gzip.open(OUT / f"{label}-logprobs.json.gz", "rt") as f:
+        return {p["id"]: p for p in json.load(f)}
+
+
+def stats(ref, test):
+    agg = {}
+    for pid, rp in ref.items():
+        tp = test[pid]
+        for (act, ra, rtop), (_, ta, ttop) in zip(rp["rows"], tp["rows"]):
+            s = agg.setdefault(rp["kind"], {"n": 0, "top1": 0, "kl": 0.0, "nll_r": 0.0, "nll_t": 0.0, "dlp": 0.0, "miss": 0})
+            s["n"] += 1
+            s["top1"] += rtop[0][0] == ttop[0][0]
+            if ra is None or ta is None:
+                s["miss"] += 1
+            else:
+                s["nll_r"] -= ra; s["nll_t"] -= ta; s["dlp"] += abs(ra - ta)
+            tmap = dict((int(t), v) for t, v in ttop)
+            floor = ttop[-1][1]
+            p = [math.exp(v) for _, v in rtop]
+            q = [math.exp(tmap.get(int(t), floor)) for t, _ in rtop]
+            p.append(max(1e-12, 1 - sum(p))); q.append(max(1e-12, 1 - sum(q)))
+            zp, zq = sum(p), sum(q)
+            s["kl"] += sum((a / zp) * math.log((a / zp) / (b / zq)) for a, b in zip(p, q) if a > 0)
+    return agg
+
+
+def report(ref_l, test_l):
+    agg = stats(load(ref_l), load(test_l))
+    print(f"teacher-forced {ref_l} -> {test_l}")
+    tot = {k: sum(a[k] for a in agg.values()) for k in ("n", "top1", "kl", "nll_r", "nll_t", "dlp", "miss")}
+    for kind, s in [*sorted(agg.items()), ("all", tot)]:
+        m = s["n"] - s["miss"]
+        print(f"  {kind:5s} tokens {s['n']:7d}  top-1 agree {100 * s['top1'] / s['n']:6.2f}%  mean KL {s['kl'] / s['n']:.5f} nats"
+              f"  ppl {math.exp(s['nll_r'] / m):.4f} -> {math.exp(s['nll_t'] / m):.4f}  mean |dlogp| {s['dlp'] / m:.4f}")
+    for bench in ("triviaqa", "mmlupro"):
+        a, b = OUT / f"{ref_l}-{bench}.jsonl", OUT / f"{test_l}-{bench}.jsonl"
+        if not (a.exists() and b.exists()):
+            continue
+        ra = {r["id"]: r for r in map(json.loads, open(a))}; rb = {r["id"]: r for r in map(json.loads, open(b))}
+        key = "exact" if bench == "triviaqa" else "correct"
+        same = sum(ra[i]["answer"].strip() == rb[i]["answer"].strip() for i in ra)
+        only_a = sum(ra[i][key] and not rb[i][key] for i in ra); only_b = sum(rb[i][key] and not ra[i][key] for i in ra)
+        extra = ""
+        if bench == "triviaqa":
+            extra = f"  contains {sum(r['contains'] for r in ra.values())} vs {sum(r['contains'] for r in rb.values())}"
+        print(f"  {bench}: {sum(r[key] for r in ra.values())} vs {sum(r[key] for r in rb.values())} / {len(ra)}{extra}"
+              f"  identical answers {same}  right only in {ref_l} {only_a}, only in {test_l} {only_b}")
+
+
+if __name__ == "__main__":
+    report(sys.argv[1], sys.argv[2])
