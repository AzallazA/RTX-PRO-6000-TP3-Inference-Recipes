+  const int* hot_map;      // Flare merged bank: global expert ID -> slot in the hot-first bank (null = identity)
+  int hot_rows;            // Flare merged bank: slots < hot_rows live in VRAM, the rest in pinned host RAM (EXPERTS = all hot)
+  const uint8_t* woa;
+  const uint8_t* woa_s;
+  const uint8_t* wob;
+  const uint8_t* wob_s;
+  const uint8_t* gate;
