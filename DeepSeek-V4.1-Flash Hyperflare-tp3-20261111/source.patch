+    let legacy_set = !matches!(legacy, Ok(None));
+    if tables_per_group.is_empty() && legacy_set {
+        return Ok(Vec::new());
+    }
+    if let Err(error) = legacy {
+        return Err(invalid(error.to_string()));
+    }
+    options.embedding_table_storage(tables_per_group)
