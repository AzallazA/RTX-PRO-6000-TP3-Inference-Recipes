+import torch
+
+from b12x.preparation import DeviceIdentity, FrozenMapping
+
+RTX = DeviceIdentity("nvidia", (12, 0), 188, "RTX PRO 6000 Blackwell")
+GB10 = DeviceIdentity("nvidia", (12, 1), 48, "NVIDIA GB10")
