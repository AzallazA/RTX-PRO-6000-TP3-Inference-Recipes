+def _requires_multiquery_dense(query: DsaIndexerQuery) -> bool:
+    """Return True when a dense MXFP4 query requires the multi-query path.
+
+    Explicit ``request_ids`` / ``query_start_loc`` mappings or compact
+    request-indexed page tables (``1 < pt_rows != max_q_rows``) cannot run on
+    the single-query ``DSAFusedIndexerKernel``; tuning and validation must stay
+    within the canonical ``default_fused_config(..., ctas_per_row=...)`` space
+    that dispatches to ``MultiQueryFusedMXFP4``.
+    """
+    if (
+        query.cache_format != "mxfp4"
+        or query.candidate_topk_blocks
+        or query.max_candidates
+    ):
+        return False
+    if query.max_q_rows < 2 or query.max_page_table_width * query.page_size <= 512:
+        return False
+    if (
+        query.operands.get("request_ids") is not None
+        or query.operands.get("query_start_loc") is not None
+    ):
+        return True
+    pt = query.operands.get("page_table")
+    if pt is not None:
+        pt_rows = int(pt["shape"][0])
+        pt_row_stride = int(pt["strides"][0])
+        if pt_rows != 1 and pt_row_stride != 0 and pt_rows != query.max_q_rows:
+            return True
+    return False
