+            heads=heads,
+            width=width,
+            page_size=page_size,
+            pool_pages=pool_pages,
+            seed=9999,
+            device=device,
+        )
+        q_mxfp4.copy_(q2)
+        q_scales.copy_(qs2)
+        query_weights.copy_(w2)
+        page_table.copy_(
+            torch.randint(
+                0,
+                pool_pages,
+                page_table.shape,
+                dtype=torch.int32,
+                device=device,
+                generator=gen,
+            )
+        )
+        page_table[0, 0] = -1
+        if request_ids is not None:
+            request_ids.copy_(
+                torch.tensor(
+                    [3, 2, 1, 0, 3, 3, 2, 2, 1, 1, 0, 0, 2, 1, 3, 0],
+                    dtype=torch.int32,
+                    device=device,
+                )
+            )
+        cache_lengths.copy_(
+            torch.tensor(
+                [
+                    0,
+                    1,
+                    8,
+                    17,
+                    511,
+                    512,
+                    513,
+                    1000,
+                    1200,
+                    1500,
+                    1800,
+                    2000,
+                    2048,
+                    2500,
+                    2900,
+                    3072,
+                ],
+                dtype=torch.int32,
+                device=device,
+            )
+        )
+        active_width.fill_(2400)
+        graph.replay()
+        torch.cuda.synchronize()
+
+        ref2 = _reference_scores(
+            q_mxfp4,
+            q_scales,
+            query_weights,
+            pool,
+            page_table,
+            cache_lengths,
+            int(active_width.item()),
+            page_size,
+            width=width,
+            row_to_req=request_ids,
+        )
+        _assert_topk512_exact(out_i, out_v, ref2)
+        if hierarchical:
+            _assert_hierarchical_exact(
+                extra["candidate_output"],
+                extra["candidate_output_lengths"],
+                ref2,
+                cache_lengths,
+                int(active_width.item()),
+            )
