+"""CPU unit tests for PCIeOneshotAllReduce rank_data default sizing."""
+
+from __future__ import annotations
+
+from types import SimpleNamespace
+from unittest.mock import MagicMock
+
+import torch
+
+from b12x.comm.pcie import pcie_allreduce, pcie_oneshot
+
+
+def test_default_rank_data_bytes_fits_small_pool_and_512_pointer_tables():
+    assert pcie_oneshot.DEFAULT_RANK_DATA_BYTES == 64 * 1024
+    table_bytes = pcie_oneshot._POINTER_TABLE_BYTES
+    assert table_bytes == 128
+    assert pcie_oneshot.DEFAULT_RANK_DATA_BYTES // table_bytes == 512
+    assert pcie_oneshot.DEFAULT_RANK_DATA_BYTES % table_bytes == 0
+    # Must stay strictly below PyTorch's 1 MiB small-block allocator threshold.
+    assert pcie_oneshot.DEFAULT_RANK_DATA_BYTES < 1024 * 1024
+
+
+def test_allreduce_factory_forwards_shrunk_default_rank_data_bytes(monkeypatch):
+    runtime = SimpleNamespace(rank=0, world_size=3, device=torch.device("cpu"))
+    oneshot_factory = MagicMock(return_value=runtime)
+    exchange_group = object()
+    monkeypatch.setattr(pcie_allreduce.dist, "get_world_size", lambda group: 3)
+    monkeypatch.setattr(
+        pcie_allreduce.PCIeOneshotAllReducePool,
+        "from_exchange_group",
+        oneshot_factory,
+    )
+    monkeypatch.setattr(
+        pcie_allreduce.PCIeAllReduce, "_maybe_island_rs", lambda **kwargs: None
+    )
+    monkeypatch.setattr(
+        pcie_allreduce, "_bf16_twoshot_supported", lambda **kwargs: False
+    )
+
+    pcie_allreduce.PCIeAllReduce.from_exchange_group(
+        exchange_group=exchange_group,  # type: ignore[arg-type]
+        device="cpu",
+        single_channel=True,
+    )
+    assert oneshot_factory.call_args.kwargs["rank_data_bytes"] == 65536
diff --git a/tests/experimental/b12x/comm/test_pcie_oneshot_rank_identity_gpu.py b/tests/experimental/b12x/comm/test_pcie_oneshot_rank_identity_gpu.py
