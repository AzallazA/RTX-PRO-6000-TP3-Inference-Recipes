+"""CPU unit tests for PCIe one-shot wait-loop nanosleep configuration."""
+
+from __future__ import annotations
+
+import pytest
+
+from b12x.comm.pcie import _cute_intrinsics as intrinsics
+from b12x.comm.pcie import _oneshot_cute as oneshot_cute
+
+
+def test_oneshot_nanosleep_env_default_and_overrides(monkeypatch):
+    monkeypatch.delenv("B12X_PCIE_ONESHOT_NANOSLEEP_NS", raising=False)
+    assert oneshot_cute._oneshot_nanosleep_ns_from_env() == 0
+
+    monkeypatch.setenv("B12X_PCIE_ONESHOT_NANOSLEEP_NS", "")
+    assert oneshot_cute._oneshot_nanosleep_ns_from_env() == 0
+
+    monkeypatch.setenv("B12X_PCIE_ONESHOT_NANOSLEEP_NS", "64")
+    assert oneshot_cute._oneshot_nanosleep_ns_from_env() == 64
+
+    monkeypatch.setenv("B12X_PCIE_ONESHOT_NANOSLEEP_NS", "128")
+    assert oneshot_cute._oneshot_nanosleep_ns_from_env() == 128
+
+
+@pytest.mark.parametrize("raw", ["-1", "1000001", "not-a-number"])
+def test_oneshot_nanosleep_env_rejects_invalid_values(monkeypatch, raw):
+    monkeypatch.setenv("B12X_PCIE_ONESHOT_NANOSLEEP_NS", raw)
+    with pytest.raises(ValueError):
+        oneshot_cute._oneshot_nanosleep_ns_from_env()
+
+
+def test_oneshot_process_keys_include_nanosleep_setting(monkeypatch):
+    monkeypatch.setenv("B12X_PCIE_ONESHOT_NANOSLEEP_NS", "64")
+    key_default = oneshot_cute._oneshot_process_key(
+        "bfloat16", 3, 0, True, True, 0, "remote_push_full", 256, 0
+    )
+    key_disabled = oneshot_cute._oneshot_process_key(
+        "bfloat16",
+        3,
+        0,
+        True,
+        True,
+        0,
+        "remote_push_full",
+        256,
+        0,
+        wait_nanosleep_ns=0,
+    )
+    assert key_default != key_disabled
+    assert key_default[-1] == 64
+    assert key_disabled[-1] == 0
+
+    fused_default = oneshot_cute._fused_oneshot_process_key(
+        "bfloat16", 3, 0, "stage_pull", False, True, True, 0, 256, 0
+    )
+    fused_disabled = oneshot_cute._fused_oneshot_process_key(
+        "bfloat16",
+        3,
+        0,
+        "stage_pull",
+        False,
+        True,
+        True,
+        0,
+        256,
+        0,
+        wait_nanosleep_ns=0,
+    )
+    assert fused_default != fused_disabled
+    assert fused_default[-1] == 64
+    assert fused_disabled[-1] == 0
+
+
+def test_oneshot_launch_objects_validate_nanosleep():
+    launch = oneshot_cute._OneshotLaunch(
+        "bfloat16", 3, 0, True, True, 0, "remote_push_full", 256, wait_nanosleep_ns=0
+    )
+    assert launch._wait_nanosleep_ns == 0
+
+    fused = oneshot_cute._FusedOneshotLaunch(
+        "bfloat16", 3, 0, "stage_pull", False, True, True, 0, 256, wait_nanosleep_ns=32
+    )
+    assert fused._wait_nanosleep_ns == 32
+
+    with pytest.raises(ValueError, match="B12X_PCIE_ONESHOT_NANOSLEEP_NS"):
+        oneshot_cute._OneshotLaunch(
+            "bfloat16",
+            3,
+            0,
+            True,
+            True,
+            0,
+            "remote_push_full",
+            256,
+            wait_nanosleep_ns=-5,
+        )
+
+
+def test_pcie_arrive_and_wait_validates_nanosleep_bounds():
+    with pytest.raises(ValueError, match="nanosleep_ns"):
+        intrinsics.pcie_arrive_and_wait(0, 0, 0, 0, nanosleep_ns=-1)
+    with pytest.raises(ValueError, match="nanosleep_ns"):
+        intrinsics.pcie_arrive_and_wait(0, 0, 0, 0, nanosleep_ns=1_000_001)
