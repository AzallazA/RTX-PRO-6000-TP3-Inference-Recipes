+    )
+    key = (
+        int(n),
+        int(in_features),
+        int(padded_k),
+        max_m_tiles,
+        int(split_k),
+        chunk_k,
+        eff_warps,
+        n_per_cta,
+        alpha_reciprocal,
+    )
