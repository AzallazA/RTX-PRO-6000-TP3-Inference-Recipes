+            sbase = (Int64(n_tile) * self.split_k + Int64(k_split)) * tile_elems
+            for mt in cutlass.range_constexpr(self.max_m_tiles):
+                slot_idx = warp * Int32(self.max_m_tiles) + Int32(mt)
+                vaddr = scratch_base + (
+                    sbase + Int64((slot_idx * _LANES + lane) * 4)
+                ) * Int64(4)
