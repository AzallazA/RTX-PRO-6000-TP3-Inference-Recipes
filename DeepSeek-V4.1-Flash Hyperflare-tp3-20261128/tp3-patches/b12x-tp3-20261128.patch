+    args = dict(
+        q_mxfp4=q_mxfp4,
+        q_scales=q_scales,
+        query_weights=query_weights,
+        index_k_cache=pool,
+        page_table=page_table,
+        cache_lengths=cache_lengths,
+        active_width=active_width,
+        output_indices=out_i,
+        output_scores=out_v,
+        candidate_output=cand_i,
+        candidate_output_lengths=cand_n,
+    )
+    with PreparationSession(
+        device=device, autotune=False, compile_workers=1
+    ) as session:
+        plan = api.plan(caps, invocation=api.invocation_from_tensors(caps, **args))
+        retained = []
+
+        def prepare(state):
+            (spec,) = state.layout.scratch_specs()
+            scratch = torch.full(spec.shape, 0xA5, dtype=spec.dtype, device=device)
+            binding = state.bind(scratch=scratch, **args)
+            retained.append((state, binding, scratch))
+            return PreparedCall(
+                run=lambda: state.run(binding), owners=(binding, scratch)
+            )
+
+        session.prepare((plan.request(name="mq_hier_1m", prepare_call=prepare),))
+        state, binding, scratch = retained[0]
+        assert state.multiquery_hierarchical is not None
+        assert state.multiquery_hierarchical[2] == 131072
+        session.freeze()
+
+        state.run(binding)
+        torch.cuda.synchronize()
+        graph = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(graph):
+            state.run(binding)
+
+        base_pt = page_table.clone()
+        snapshots = []
+        try:
+            for aw in (32768, 131072, 262144, 300003, 0):
+                page_table.copy_(base_pt)
+                if aw == 0:
+                    live_lens = [0] * rows
+                else:
+                    live_lens = [
+                        aw - 3,
+                        0,
+                        1,
+                        513,
+                        min(aw, 16385),
+                        aw // 2 + 7,
+                        aw,
+                        aw + 128,
+                    ]
+                    # Force row 0's newest block onto an invalid page (-inf) to test
+                    # mandatory newest-block priority above 256K too.
