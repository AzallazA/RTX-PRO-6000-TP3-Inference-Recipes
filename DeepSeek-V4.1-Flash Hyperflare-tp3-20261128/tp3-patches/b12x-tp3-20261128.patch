+    @cute.kernel
+    def kernel_kwarp(
+        self,
+        x: cute.Tensor,
+        w_u8: cute.Pointer,
+        s_u8: cute.Pointer,
+        global_scale: cute.Pointer,
+        out: cute.Tensor,
+        scratch: cute.Pointer,
+        flags: cute.Pointer,
+        rows: Int32,
+        x_stride_elems: Int64,
