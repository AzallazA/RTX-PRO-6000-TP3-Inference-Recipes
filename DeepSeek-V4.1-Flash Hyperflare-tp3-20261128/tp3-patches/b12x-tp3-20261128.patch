+        limit=7.0,
+        round_silu=False,
+        expected_m=m,
+        min_amax=min_amax,
+    )
+    torch.cuda.synchronize()
+
+    assert torch.equal(fused_v.view(torch.uint8), ref_v.view(torch.uint8))
