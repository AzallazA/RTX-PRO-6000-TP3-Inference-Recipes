+        if cutlass.const_expr(self.split_k == 1):
+            for mt in cutlass.range_constexpr(self.max_m_tiles):
+                for e in cutlass.range_constexpr(4):
+                    feature = first_n + warp * Int32(16) + group + (8 if e >= 2 else 0)
+                    row = Int32(mt * 8) + quad * 2 + (e % 2)
