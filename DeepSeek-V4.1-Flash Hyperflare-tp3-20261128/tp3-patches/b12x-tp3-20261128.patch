+                            Uint32(0),
+                            Uint32(0),
+                            Uint32(0),
+                        )
+                        wb0, wb1, wb2, wb3 = (
+                            Uint32(0),
+                            Uint32(0),
+                            Uint32(0),
+                            Uint32(0),
+                        )
