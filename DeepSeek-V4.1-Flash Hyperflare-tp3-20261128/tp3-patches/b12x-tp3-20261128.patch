+        self.local_kernel(
+            _flat(q),
+            _flat(qs),
+            _flat(weights),
+            _flat(pool),
+            _flat(pages),
+            _flat(request_meta),
+            _flat(lengths),
+            _flat(active),
+            _flat(out_indices),
+            _flat(out_values),
+            _flat(partial_indices),
+            _flat(partial_values),
+            _flat(partial_counts),
+            _flat(block_values_u16),
+            _flat(state),
