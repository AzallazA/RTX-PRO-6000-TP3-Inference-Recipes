+def test_multiquery_hierarchical_1m_capacity_parity_against_streaming():
+    """Verify Layer-20 MultiQueryHierarchicalMXFP4 at 1M static capacity (max_blocks=131072).
+
+    Exercises dynamic active_width <= 256K (32K, 128K, 256K) and > 256K (300,003),
+    plus empty replay (0), under CUDA graph capture with poisoned scratch, asserting
+    0-ULP bit-exact parity against streaming HierarchicalFusedMXFP4.
+    """
+    device = torch.device("cuda:0")
+    rows = 8
+    heads = 32
+    page_size = 128
+    page_width = 8192  # 1,048,576 static token capacity -> 131,072 blocks!
+    width = page_width * page_size
+    pool_pages = 64
+
+    q_mxfp4, q_scales, query_weights, pool = _make_mxfp4_inputs(
+        rows=rows,
+        heads=heads,
+        width=width,
+        page_size=page_size,
+        pool_pages=pool_pages,
+        seed=41201,
+        device=device,
+    )
+    gen = torch.Generator(device=device).manual_seed(41202)
+    req_pages = torch.randint(
+        0, pool_pages, (2, page_width), dtype=torch.int32, device=device, generator=gen
+    )
+    page_table = req_pages.repeat_interleave(4, dim=0).contiguous()
+    cache_lengths = torch.full((rows,), 32768, dtype=torch.int32, device=device)
+    active_width = torch.tensor([32768], dtype=torch.int32, device=device)
+    out_i = torch.empty((rows, 512), dtype=torch.int32, device=device)
+    out_v = torch.empty((rows, 512), dtype=torch.float32, device=device)
+    cand_i = torch.empty((rows, 16384), dtype=torch.int32, device=device)
+    cand_n = torch.empty((rows,), dtype=torch.int32, device=device)
+
+    caps = api.Caps(
+        device=device,
+        num_q_heads=heads,
+        max_q_rows=rows,
+        max_page_table_width=page_width,
+        topk=512,
