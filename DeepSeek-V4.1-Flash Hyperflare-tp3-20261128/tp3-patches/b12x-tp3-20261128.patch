+"""CPU unit tests for the consolidated bf16_gemv split-K scratch/flags pool."""
+
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from b12x.gemm.bf16_gemv import _preparation as gemv_prep
+from b12x.gemm.bf16_gemv import _tensor_core as tc
+from b12x.gemm.bf16_gemv._tuning import GemvConfig, GemvQuery
+
+
+@pytest.fixture(autouse=True)
+def _clean_tc_pools(monkeypatch):
+    monkeypatch.setattr(tc, "_TC_SPLITK_SCRATCH_POOLS", {})
+    monkeypatch.setattr(tc, "_TC_SPLITK_FLAGS_POOLS", {})
+    monkeypatch.setattr(tc, "_TC_SPLITK_BUFFERS", {})
+
+
+def test_many_shapes_share_single_2mib_scratch_pool_and_16kib_flags_pool():
+    shapes = (
+        (1, 32, 5120, 16),
+        (1, 128, 5120, 8),
+        (1, 256, 5120, 8),
+        (1, 384, 5120, 8),
+        (1, 512, 5120, 8),
+        (1, 1024, 5120, 8),
+        (4, 1536, 5120, 8),
+        (8, 2048, 5120, 8),  # 128 * 8 * 1 * 512 = exact 512 KiB slot boundary
+        (16, 1024, 5120, 8),  # 64 * 8 * 2 * 512 = exact 512 KiB slot boundary
+    )
+    device = torch.device("cpu")
+    scratch_storages = set()
+    flags_storages = set()
+    slot0_scratch_ptrs = []
+    slot0_flags_ptrs = []
+
+    with torch.inference_mode():
+        for max_rows, n, k, split_k in shapes:
+            scratches, flags = tc.tc_splitk_buffers(device, max_rows, n, k, split_k)
+            assert len(scratches) == tc._TC_SPLITK_MAX_STREAMS == 4
+            assert len(flags) == tc._TC_SPLITK_MAX_STREAMS == 4
+
+            n_blocks = (n + 15) // 16
+            m_tiles = (max_rows + 7) // 8
+            expected_scratch_elems = n_blocks * split_k * m_tiles * 128
+            for slot in range(4):
+                sc = scratches[slot]
+                fl = flags[slot]
+                assert sc.shape == (expected_scratch_elems,)
+                assert sc.dtype == torch.float32
+                assert sc.is_contiguous()
+                assert not sc.is_inference()
+                assert sc.data_ptr() % 16 == 0
+                assert fl.shape == (n_blocks,)
+                assert fl.dtype == torch.uint32
+                assert fl.is_contiguous()
+                assert not fl.is_inference()
+                assert fl.data_ptr() % 4 == 0
+                assert torch.all(fl == 0)
+                scratch_storages.add(sc.untyped_storage().data_ptr())
+                flags_storages.add(fl.untyped_storage().data_ptr())
+
+            # All 4 stream slots must occupy strictly disjoint byte ranges.
+            sc_intervals = sorted(
+                (s.data_ptr(), s.data_ptr() + s.numel() * s.element_size())
+                for s in scratches
+            )
+            fl_intervals = sorted(
+                (f.data_ptr(), f.data_ptr() + f.numel() * f.element_size())
+                for f in flags
+            )
+            for (_, end), (start, _) in zip(sc_intervals, sc_intervals[1:]):
+                assert end <= start
+            for (_, end), (start, _) in zip(fl_intervals, fl_intervals[1:]):
+                assert end <= start
+
+            slot0_scratch_ptrs.append(scratches[0].data_ptr())
+            slot0_flags_ptrs.append(flags[0].data_ptr())
+
+    # Every one of the 9 shapes must share the exact same single 2 MiB scratch pool
+    # and 16 KiB flags pool (and stable base pointer per stream slot).
+    assert len(scratch_storages) == 1
+    assert len(flags_storages) == 1
+    assert len(set(slot0_scratch_ptrs)) == 1
+    assert len(set(slot0_flags_ptrs)) == 1
+    assert len(tc._TC_SPLITK_SCRATCH_POOLS) == 1
+    assert len(tc._TC_SPLITK_FLAGS_POOLS) == 1
+    scratch_pool = next(iter(tc._TC_SPLITK_SCRATCH_POOLS.values()))
+    flags_pool = next(iter(tc._TC_SPLITK_FLAGS_POOLS.values()))
+    assert scratch_pool.numel() * scratch_pool.element_size() == 2 * 1024 * 1024
+    assert flags_pool.numel() * flags_pool.element_size() == 16 * 1024
+
+
+def test_oversized_shape_uses_overflow_tier_without_moving_default_pool():
+    device = torch.device("cpu")
+    default_sc, default_fl = tc.tc_splitk_buffers(device, 8, 512, 5120, 8)
+    default_sc_ptr = default_sc[0].data_ptr()
+    default_fl_ptr = default_fl[0].data_ptr()
+
+    # 32 rows (m_tiles=4), N=2048 (n_blocks=128), split_k=4 -> 1 MiB per slot.
+    big_sc, big_fl = tc.tc_splitk_buffers(device, 32, 2048, 5120, 4)
+    assert big_sc[0].numel() * 4 == 1024 * 1024
+    assert big_sc[0].untyped_storage().data_ptr() != default_sc[0].untyped_storage().data_ptr()
+    # Flags still fit in the shared default 16 KiB flags pool!
+    assert big_fl[0].untyped_storage().data_ptr() == default_fl[0].untyped_storage().data_ptr()
+    # Default pool pointers did not move (CUDA-graph safe).
+    default_sc_again, default_fl_again = tc.tc_splitk_buffers(device, 8, 512, 5120, 8)
+    assert default_sc_again[0].data_ptr() == default_sc_ptr
+    assert default_fl_again[0].data_ptr() == default_fl_ptr
+
+
+def test_preparation_memory_deduplicates_shared_pool_across_shapes():
+    device_meta = SimpleNamespace(ordinal=0)
+    q1 = GemvQuery(
+        source_dtype="bfloat16",
+        weight_dtype="bfloat16",
+        max_rows=1,
+        in_features=5120,
+        out_features=512,
+        source_contiguous=True,
+        source_aligned=True,
+        weight_contiguous=True,
+        weight_aligned=True,
+        output_dtype="bfloat16",
+        output_contiguous=True,
+        output_aligned=True,
+        bias_dtype=None,
+    )
+    q2 = GemvQuery(
+        source_dtype="bfloat16",
+        weight_dtype="bfloat16",
+        max_rows=8,
+        in_features=5120,
+        out_features=1024,
+        source_contiguous=True,
+        source_aligned=True,
+        weight_contiguous=True,
+        weight_aligned=True,
+        output_dtype="bfloat16",
+        output_contiguous=True,
+        output_aligned=True,
+        bias_dtype=None,
+    )
+    cfg = GemvConfig(backend="tc", split_k=8)
+    p1 = gemv_prep.plan(q1)
+    p2 = gemv_prep.plan(q2)
+
+    m1_before = p1._memory_requirements(cfg, device_meta)
+    m2_before = p2._memory_requirements(cfg, device_meta)
+    assert [e.key for e in m1_before.persistent] == [
+        e.key for e in m2_before.persistent
+    ]
+    assert [e.required_nbytes for e in m1_before.persistent] == [2 * 1024 * 1024, 16 * 1024]
+    assert [e.resident_nbytes for e in m1_before.persistent] == [0, 0]
+
+    tc.tc_splitk_buffers(torch.device("cpu"), 1, 512, 5120, 8)
+    m2_after = p2._memory_requirements(cfg, device_meta)
+    assert [e.resident_nbytes for e in m2_after.persistent] == [2 * 1024 * 1024, 16 * 1024]
