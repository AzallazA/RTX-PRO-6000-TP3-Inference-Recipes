@@ -0,0 +1,378 @@
+"""CPU unit tests for lazy allocation and post-race reclamation of PCIeTwoShotBF16."""
+
+from __future__ import annotations
+
+from contextlib import nullcontext
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from b12x.comm.pcie import _twoshot_preparation as preparation
+from b12x.comm.pcie import pcie_allreduce as dispatch
+from b12x.comm.pcie import pcie_twoshot_bf16 as twoshot_mod
+from b12x.comm.pcie.pcie_oneshot import _OwnedSharedBuffer
+from b12x.comm.pcie.pcie_twoshot_bf16 import PCIeTwoShotBF16, _make_layout
+from b12x.preparation import FrozenMapping, _collective as collective
+from b12x.preparation.types import CollectiveRequirement, _plan_scope
+
+
+class _FakeIpc:
+    def __init__(self):
+        self.set_devices = []
+        self.closed_imports = []
+        self.freed_exports = []
+
+    def cudaSetDevice(self, index: int) -> None:
+        self.set_devices.append(int(index))
+
+    def cudaIpcCloseMemHandle(self, ptr: int) -> None:
+        self.closed_imports.append(int(ptr))
+
+    def cudaFree(self, ptr: int) -> None:
+        self.freed_exports.append(int(ptr))
+
+
+def _make_lazy_runtime(monkeypatch, *, world_size: int = 3, max_rows: int = 131072):
+    layout = _make_layout(max_rows, 8, world_size)
+    ipc = _FakeIpc()
+    alloc_calls = []
+
+    def fake_alloc(group, nbytes, *, zero_fill, ipc):
+        alloc_calls.append((nbytes, zero_fill))
+        base = 0x10000000 + len(alloc_calls) * 0x1000000
+        peers = tuple(base + r * 0x100000 for r in range(world_size))
+        return _OwnedSharedBuffer(
+            local_ptr=peers[0],
+            peer_ptrs=peers,
+            remote_ptrs=peers[1:],
+            nbytes=nbytes,
+        )
+
+    monkeypatch.setattr(
+        twoshot_mod.PCIeOneshotAllReduce, "_allocate_shared_buffer", fake_alloc
+    )
+    monkeypatch.setattr(twoshot_mod, "_device_guard", lambda _: nullcontext())
+    monkeypatch.setattr(twoshot_mod, "_cuda_device_index", lambda _: 0)
+    monkeypatch.setattr(
+        twoshot_mod, "_finish_collective_runtime_setup", lambda **kwargs: None
+    )
+    monkeypatch.setattr(twoshot_mod, "_is_current_stream_capturing", lambda _: False)
+
+    close_calls = []
+
+    def fake_close(channels, *, exchange_group, device):
+        close_calls.append(tuple(channels))
+        for ch in channels:
+            ch._close_ipc_imports_strict()
+            ch._free_ipc_exports_strict()
+            ch._coordinated_close_complete = True
+
+    monkeypatch.setattr(twoshot_mod, "_coordinated_close_channels", fake_close)
+
+    runtime = PCIeTwoShotBF16._from_prepared_factory(
+        rank=0,
+        world_size=world_size,
+        device=torch.device("cpu"),
+        signal_ptrs=(),
+        staging_ptrs=((), ()),
+        owned_buffers=(),
+        ipc=ipc,
+        exchange_group=object(),
+        max_rows=max_rows,
+        row_elems=8,
+        pack_stride=layout.pack_stride,
+        reduced_offset=layout.reduced_offset,
+        slot_bytes=layout.slot_bytes,
+        signal_bytes=layout.signal_bytes,
+        slab_bytes=layout.slab_bytes,
+        lazy=True,
+        allocated=False,
+    )
+    return runtime, layout, ipc, alloc_calls, close_calls
+
+
+def test_allreduce_factory_provisions_twoshot_lazily(monkeypatch):
+    runtime = SimpleNamespace(rank=0, world_size=3, device=torch.device("cpu"))
+    provisioned = []
+    monkeypatch.setattr(dispatch.dist, "get_world_size", lambda group: 3)
+    monkeypatch.setattr(
+        dispatch.PCIeOneshotAllReducePool,
+        "from_exchange_group",
+        lambda **kwargs: runtime,
+    )
+    monkeypatch.setattr(
+        dispatch.PCIeAllReduce, "_maybe_island_rs", lambda **kwargs: None
+    )
+    monkeypatch.setattr(dispatch, "_bf16_twoshot_supported", lambda **kwargs: True)
+    monkeypatch.setattr(
+        dispatch.PCIeTwoShotBF16,
+        "from_exchange_group",
+        lambda **kwargs: provisioned.append(kwargs) or object(),
+    )
+
+    dispatch.PCIeAllReduce.from_exchange_group(
+        exchange_group=object(),
+        device="cpu",
+        single_channel=True,
+        max_size=2 << 20,
+    )
+    assert len(provisioned) == 1
+    assert provisioned[0]["lazy"] is True
+
+
+def test_lazy_twoshot_queries_and_memory_match_eager(monkeypatch):
+    runtime, layout, _, alloc_calls, close_calls = _make_lazy_runtime(monkeypatch)
+    assert not runtime._allocated
+    assert runtime._owned_buffers == []
+    assert runtime._push_shard is None
+    assert alloc_calls == []
+
+    inp = torch.empty(32768, dtype=torch.bfloat16)
+    query_lazy = preparation.query_from_runtime(
+        runtime,
+        surface="PCIeTwoShotBF16.all_reduce",
+        call={"inp": inp, "transport": "push"},
+    )
+    meta_lazy = preparation.query_from_metadata(
+        runtime,
+        surface="PCIeTwoShotBF16.all_reduce",
+        shape=tuple(inp.shape),
+        dtype=inp.dtype,
+        transport="push",
+    )
+    assert query_lazy.setup == meta_lazy.setup
+    assert query_lazy.setup["slab_nbytes"] == layout.slab_bytes
+    assert query_lazy.setup["signal_ptr_count"] == 16
+    assert query_lazy.setup["staging_ptr_count"] == (16, 16)
+
+    plan = preparation.plan(query_lazy, runtime=runtime)
+    with _plan_scope(plan):
+        mem_before = plan._memory_requirements(None, None)
+    assert all(entry.resident_nbytes == 0 for entry in mem_before.persistent)
+    assert sorted(entry.required_nbytes for entry in mem_before.persistent) == sorted(
+        [layout.pack_stride * 16, layout.slab_bytes]
+    )
+
+    runtime.ensure_allocated()
+    assert runtime._allocated
+    assert len(alloc_calls) == 1
+    assert runtime._push_shard is not None
+    assert not runtime._push_shard.is_inference()
+
+    query_alloc = preparation.query_from_runtime(
+        runtime,
+        surface="PCIeTwoShotBF16.all_reduce",
+        call={"inp": inp, "transport": "push"},
+    )
+    assert query_alloc == query_lazy
+
+    with _plan_scope(plan):
+        mem_after = plan._memory_requirements(None, None)
+    assert all(
+        entry.resident_nbytes == entry.required_nbytes
+        for entry in mem_after.persistent
+    )
+
+    runtime.release_storage()
+    assert not runtime._allocated
+    assert not runtime._closed
+    assert runtime._owned_buffers == []
+    assert runtime._push_shard is None
+    assert len(close_calls) == 1
+
+    with _plan_scope(plan):
+        mem_released = plan._memory_requirements(None, None)
+    assert all(entry.resident_nbytes == 0 for entry in mem_released.persistent)
+
+
+def test_lazy_twoshot_allocates_on_first_launch_and_rejects_unallocated_capture(
+    monkeypatch,
+):
+    runtime, _, _, alloc_calls, _ = _make_lazy_runtime(monkeypatch, max_rows=1024)
+    payload = torch.empty(1024, dtype=torch.bfloat16)
+    out = torch.empty_like(payload)
+    launches = []
+    state = SimpleNamespace(
+        query=SimpleNamespace(
+            call={
+                "operation": "all_reduce",
+                "transport": "push",
+                "threads": 512,
+                "block_limit": 64,
+            }
+        ),
+        launcher=lambda *key: lambda *args: launches.append((key, args)),
+    )
+
+    monkeypatch.setattr(twoshot_mod, "_is_current_stream_capturing", lambda _: True)
+    runtime._capture_context_depth = 1
+    with pytest.raises(RuntimeError, match="cannot lazily allocate"):
+        runtime._launch_prepared(
+            payload, None, out, state=state, threads=512, block_limit=64
+        )
+    assert alloc_calls == []
+    assert launches == []
+
+    monkeypatch.setattr(twoshot_mod, "_is_current_stream_capturing", lambda _: False)
+    runtime._capture_context_depth = 0
+    with torch.inference_mode():
+        runtime._launch_prepared(
+            payload, None, out, state=state, threads=512, block_limit=64
+        )
+    assert len(alloc_calls) == 1
+    assert runtime._allocated
+    assert runtime._push_shard is not None
+    assert not runtime._push_shard.is_inference()
+    assert len(launches) == 2
+
+    # Release and re-allocate on next eager launch.
+    runtime.release_storage()
+    assert not runtime._allocated
+    runtime._launch_prepared(
+        payload, None, out, state=state, threads=512, block_limit=64
+    )
+    assert len(alloc_calls) == 2
+    assert runtime._allocated
+
