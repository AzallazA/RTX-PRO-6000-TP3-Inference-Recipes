+def test_coupled_prequant_m_le_128_gpu_parity(num_tokens: int):
+    """Verify supports_prequant_mxfp8 + prepared_moe_prequant_out / prepared_moe_mxfp8_out for M<=128."""
+    device = require_b12x()
+    e, k, n, top_k = 32, 512, 576, 6
