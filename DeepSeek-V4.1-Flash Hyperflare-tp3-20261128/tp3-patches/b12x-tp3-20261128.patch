+        ),
+        override=MoeDecodeConfig(
+            backend="dynamic",
+            route_planner="triton",
+            max_active_clusters=None,
+            dynamic_tile_m=128,
+            dynamic_route_mode="grouped",
+            csf_inline_scales=csf_inline,
+        ),
+    )
+    session = PreparationSession(compile_workers=0, autotune=False)
+    box = {}
