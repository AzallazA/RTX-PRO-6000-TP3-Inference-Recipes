+def _assert_hierarchical_parity_vs_streaming(
+    *,
+    got_i: torch.Tensor,
+    got_v: torch.Tensor,
+    got_cand: torch.Tensor,
+    got_cand_n: torch.Tensor,
+    ref_i: torch.Tensor,
+    ref_v: torch.Tensor,
+    ref_cand: torch.Tensor,
+    ref_cand_n: torch.Tensor,
+    q_mxfp4: torch.Tensor,
+    q_scales: torch.Tensor,
+    query_weights: torch.Tensor,
+    pool: torch.Tensor,
+    page_table: torch.Tensor,
+    cache_lengths: torch.Tensor,
+    active_width: int,
+    page_size: int,
+) -> None:
+    """Assert 0-ULP bit-exact parity of MultiQueryHierarchicalMXFP4 vs HierarchicalFusedMXFP4."""
+    gi, gv = got_i.cpu(), got_v.cpu()
+    ri, rv = ref_i.cpu(), ref_v.cpu()
+    gc, gn = got_cand.cpu(), got_cand_n.cpu()
+    rc, rn = ref_cand.cpu(), ref_cand_n.cpu()
+    lens = cache_lengths.cpu()
+    rows = gi.shape[0]
+    neg_inf_bits = torch.tensor(float("-inf"), dtype=torch.float32).view(torch.int32)
+
+    for r in range(rows):
+        vis = min(max(int(lens[r].item()), 0), max(int(active_width), 0))
+        newest = (vis - 1) // 8 if vis > 0 else -1
+
+        # 1. Exact top-512 token parity (0-ULP score multiset + CPU oracle verification).
+        g_cnt = int((gi[r] >= 0).sum().item())
+        r_cnt = int((ri[r] >= 0).sum().item())
+        assert g_cnt == r_cnt, f"row {r}: token count {g_cnt} != {r_cnt}"
+        assert torch.all(gi[r, :g_cnt] >= 0) and torch.all(gi[r, g_cnt:] == -1)
+        assert torch.all(gv[r, g_cnt:].view(torch.int32) == neg_inf_bits)
+        if g_cnt > 1:
+            assert torch.all(gi[r, 1:g_cnt] > gi[r, : g_cnt - 1])
+        if g_cnt > 0:
+            assert torch.equal(
+                gv[r, :g_cnt].sort().values.view(torch.int32),
+                rv[r, :r_cnt].sort().values.view(torch.int32),
+            ), f"row {r}: top-512 score bit mismatch vs streaming reference"
+            oracle_v = _reference_scores_at_positions(
+                q_mxfp4,
+                q_scales,
+                query_weights,
+                pool,
+                page_table,
+                cache_lengths,
+                active_width,
+                page_size,
+                row=r,
+                positions=gi[r, :g_cnt],
+            )
+            assert torch.equal(
+                gv[r, :g_cnt].view(torch.int32), oracle_v.view(torch.int32)
+            ), f"row {r}: top-512 score bit mismatch vs CPU oracle"
+
+        # 2. Exact top-2048 block expansion + 0-ULP block-max parity.
+        g_len = int(gn[r].item())
+        r_len = int(rn[r].item())
+        assert g_len == r_len, f"row {r}: candidate_output_lengths {g_len} != {r_len}"
+        assert torch.all(gc[r, g_len:] == -1)
+        if g_len == 0:
+            assert vis == 0
+            continue
+        g_ids = gc[r, :g_len]
+        r_ids = rc[r, :r_len]
+        assert torch.all((g_ids >= 0) & (g_ids < vis))
+        if g_len > 1:
+            assert torch.all(g_ids[1:] > g_ids[:-1])
+        g_blks = torch.unique_consecutive(g_ids // 8)
+        r_blks = torch.unique_consecutive(r_ids // 8)
+        assert g_blks.numel() == r_blks.numel()
+        if newest >= 0:
+            assert bool((g_blks == newest).any()), (
+                f"row {r}: mandatory newest block {newest} missing"
+            )
+        # Verify exact 8x expansion of each selected block.
+        expected_exp = torch.cat(
+            [
+                torch.arange(int(b) * 8, min(int(b) * 8 + 8, vis), dtype=torch.int32)
+                for b in g_blks.tolist()
+            ]
+        )
+        assert torch.equal(g_ids, expected_exp), f"row {r}: 8x block expansion mismatch"
+        if not torch.equal(g_blks, r_blks):
+            # When ties exist at the 2048th block cutoff, selected block-max multisets
+            # must still match 0-ULP bit-for-bit!
+            def _block_maxes(blks: torch.Tensor) -> torch.Tensor:
+                pos = (blks[:, None] * 8 + torch.arange(8)[None, :]).flatten()
+                sc = _reference_scores_at_positions(
+                    q_mxfp4,
+                    q_scales,
+                    query_weights,
+                    pool,
+                    page_table,
+                    cache_lengths,
+                    active_width,
+                    page_size,
+                    row=r,
+                    positions=pos,
+                ).view(blks.numel(), 8)
+                bmax = sc.max(dim=1).values
+                bmax = torch.where(blks == newest, float("inf"), bmax)
+                return bmax.sort().values.view(torch.int32)
+
+            assert torch.equal(_block_maxes(g_blks), _block_maxes(r_blks)), (
+                f"row {r}: top-2048 block-max multiset mismatch vs streaming reference"
+            )
