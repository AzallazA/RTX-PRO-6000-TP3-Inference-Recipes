+            comp_len[r] = int(valid_r.numel())
+            if valid_r.numel() > 0:
+                comp_idx[r, : valid_r.numel()] = valid_r
+        return comp_idx, comp_len
+
+    ref_swa_idx, ref_swa_len = _compact_valid_prefix(swa_indices, swa_lengths)
+    if indexed is not None:
+        ref_idx_idx, ref_idx_len = _compact_valid_prefix(
+            indexed_indices, indexed_lengths
+        )
+    else:
+        ref_idx_idx, ref_idx_len = None, None
+
+    ref_out, ref_lse = compressed_sparse_mla_reference(
+        q,
+        swa,
+        ref_swa_idx,
+        ref_swa_len,
+        extra_k_cache=indexed,
+        extra_indices=ref_idx_idx,
+        extra_topk_lengths=ref_idx_len,
+        swa_page_size=64,
+        extra_page_size=64,
+        cache_format="deepseek_v41",
+        attn_sink=sink,
+        sm_scale=_SM_SCALE,
+        return_lse=True,
+    )
+    expected_lse = ref_lse * 1.4426950408889634 if lse_scale == "base2" else ref_lse
+    torch.testing.assert_close(out_direct, ref_out, atol=3e-3, rtol=3e-3)
+    torch.testing.assert_close(lse_direct, expected_lse, atol=1e-3, rtol=1e-3)
+    assert torch.equal(out_direct[0], torch.zeros_like(out_direct[0]))
+    assert torch.equal(out_direct[8], torch.zeros_like(out_direct[8]))
+    if not with_sink:
+        assert torch.isneginf(lse_direct[0]).all()
+        assert torch.isneginf(lse_direct[8]).all()
