+def _reference_scores_at_positions(
+    q_mxfp4: torch.Tensor,
+    q_scales: torch.Tensor,
+    query_weights: torch.Tensor,
+    pool: torch.Tensor,
+    page_table: torch.Tensor,
+    cache_lengths: torch.Tensor,
+    active_width: int,
+    page_size: int,
+    *,
+    row: int,
+    positions: torch.Tensor,
+    row_to_req: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """Exact CPU float64 oracle evaluated only on a selected subset of positions."""
+    pos = positions.cpu().long()
+    if pos.numel() == 0:
+        return torch.empty((0,), dtype=torch.float32)
+    pool_cpu = pool.cpu()
+    pool_pages = pool_cpu.shape[0]
+    k_packed = pool_cpu[:, : page_size * 64].view(pool_pages, page_size, 64)
+    k_scales = pool_cpu[:, page_size * 64 : page_size * 68].view(
+        pool_pages, page_size, 4
+    )
+    q_f = _decode_mxfp4(q_mxfp4[row : row + 1], q_scales[row : row + 1])[0]
+    w_bf = query_weights[row].cpu().to(torch.bfloat16)
+    pt = page_table.cpu()
+    prow = (
+        0
+        if pt.shape[0] == 1
+        else (row if row_to_req is None else int(row_to_req[row].item()))
+    )
+    vis = min(max(int(cache_lengths[row].item()), 0), max(int(active_width), 0))
+    out = torch.full((pos.numel(),), float("-inf"), dtype=torch.float32)
+    if vis <= 0 or prow < 0 or prow >= pt.shape[0]:
+        return out
+    pcol = pos // page_size
+    tok = pos % page_size
+    in_bounds = (pos >= 0) & (pos < vis) & (pcol < pt.shape[1])
+    pid = torch.full((pos.numel(),), -1, dtype=torch.int64)
+    pid[in_bounds] = pt[prow, pcol[in_bounds]].long()
+    valid = in_bounds & (pid >= 0) & (pid < pool_pages)
+    if not valid.any():
+        return out
+    kv = _decode_mxfp4(k_packed[pid[valid], tok[valid]], k_scales[pid[valid], tok[valid]])
+    dots = (kv @ q_f.T).to(torch.float32)
+    dots_bf = torch.clamp_min(dots.to(torch.bfloat16), 0.0)
+    prods_bf = (dots_bf * w_bf.unsqueeze(0)).to(torch.float32)
+    total = torch.zeros(int(valid.sum().item()), dtype=torch.float32)
+    for h in range(q_f.shape[0]):
+        total = total + prods_bf[:, h]
+    out[valid] = total.to(torch.bfloat16).to(torch.float32)
+    return out
+
+
+def _run_streaming_hierarchical_reference(
+    *,
+    q_mxfp4: torch.Tensor,
+    q_scales: torch.Tensor,
+    query_weights: torch.Tensor,
+    pool: torch.Tensor,
+    page_table: torch.Tensor,
+    cache_lengths: torch.Tensor,
+    active_width: torch.Tensor,
+    page_size: int,
+    width: int,
+    ctas: int = 4,
+):
+    """Run single-query streaming HierarchicalFusedMXFP4 + sort/expand on GPU."""
+    import cutlass.cute as cute
+    from cutlass import BFloat16, Float32, Int32, Int64, Uint8
+    from b12x._lib.compiler import KernelCompileSpec, compile as b12x_compile
+    from b12x._lib.utils.device import current_cuda_stream
+    from b12x._lib.utils.pointers import make_ptr
+    from b12x.attention.dsa_indexer.hierarchical_fused import (
+        HierarchicalFusedMXFP4,
+        hierarchical_scratch_shapes,
+    )
+    from b12x.attention.dsa_indexer import mxfp4 as mxfp4_mod
+
+    device = q_mxfp4.device
+    rows, heads, _ = q_mxfp4.shape
+    obj = HierarchicalFusedMXFP4(heads, page_size, ctas)
+    local_types = (
+        Uint8,
+        Uint8,
+        BFloat16,
+        Uint8,
+        Int32,
+        Int32,
+        Int32,
+        Int32,
+        Float32,
+        Int32,
+        Float32,
+        Int32,
+        Float32,
+        Int32,
+        Int32,
+    )
+    merge_types = (
+        Int32,
+        Int32,
+        Int32,
+        Float32,
+        Int32,
+        Float32,
+        Int32,
+        Float32,
+        Int32,
+    )
+    ptrs = tuple(
+        make_ptr(t, 16, cute.AddressSpace.gmem, assumed_align=1) for t in local_types
+    )
+    local = b12x_compile(
+        obj.local,
+        *ptrs,
+        Int32(1),
+        Int32(1),
+        Int32(1),
+        Int64(1),
+        Int64(1),
+        Int64(1),
+        current_cuda_stream(),
+        compile_spec=KernelCompileSpec.from_key(
+            "attention.indexer.mq_1m_parity_streaming_local",
+            1,
+            (heads, page_size, ctas),
+        ),
+    )
+    merge = None
+    if ctas > 1:
+        mptrs = tuple(
+            make_ptr(t, 16, cute.AddressSpace.gmem, assumed_align=1)
+            for t in merge_types
+        )
+        merge = b12x_compile(
+            obj.merge,
+            *mptrs,
+            Int32(1),
+            current_cuda_stream(),
+            compile_spec=KernelCompileSpec.from_key(
+                "attention.indexer.mq_1m_parity_streaming_merge",
+                1,
+                (heads, page_size, ctas),
+            ),
+        )
+    expand = mxfp4_mod._compile("sort", (2048, True), device.index)
+    scratch = {
+        name: torch.full(shape, 17, dtype=dtype, device=device)
+        for name, (dtype, shape) in hierarchical_scratch_shapes(rows, ctas).items()
+    }
+    out_i = torch.full((rows, 512), -7, dtype=torch.int32, device=device)
+    out_v = torch.full((rows, 512), float("nan"), dtype=torch.float32, device=device)
+    cand_i = torch.full((rows, 16384), -7, dtype=torch.int32, device=device)
+    cand_n = torch.full((rows,), -7, dtype=torch.int32, device=device)
+    tensors = (
+        q_mxfp4,
+        q_scales,
+        query_weights,
+        pool,
+        page_table,
+        cache_lengths,
+        active_width,
+        out_i,
+        out_v,
+        scratch["block_indices"],
+        scratch["block_values"],
+        scratch["partial_indices"],
+        scratch["partial_values"],
+        scratch["partial_counts"],
+        scratch["state"],
+    )
+    stride = 0 if page_table.shape[0] == 1 else page_table.stride(0)
+    local(
+        *(mxfp4_mod._ptr(t, d) for t, d in zip(tensors, local_types, strict=True)),
+        Int32(rows),
+        Int32(width),
+        Int32(page_table.shape[1]),
+        Int64(stride),
+        Int64(pool.stride(0)),
+        Int64(pool.shape[0]),
+        current_cuda_stream(),
+    )
+    if merge is not None:
+        mtensors = (
+            cache_lengths,
+            active_width,
+            out_i,
+            out_v,
+            scratch["block_indices"],
+            scratch["block_values"],
+            scratch["partial_indices"],
+            scratch["partial_values"],
+            scratch["partial_counts"],
+        )
+        merge(
+            *(mxfp4_mod._ptr(t, d) for t, d in zip(mtensors, merge_types, strict=True)),
+            Int32(rows),
+            current_cuda_stream(),
+        )
+    mxfp4_mod._launch(
+        "sort",
+        (2048, True),
+        (
+            scratch["block_indices"],
+            scratch["block_values"],
+            cand_i,
+            scratch["block_values"],
+            cache_lengths,
+            active_width,
+            cand_n,
+        ),
+        (rows,),
+        launcher=expand,
+    )
+    torch.cuda.synchronize()
+    return out_i, out_v, cand_i, cand_n
+
