+    idx_vals = (
+        torch.randn((comp_tokens, 512), device=device, generator=gen) * 0.25
+    ).bfloat16()
+    indexed = pack_deepseek_v41_cache_reference(
+        idx_vals, page_size=64, cache_kind="indexed"
+    )
