+@cute.jit
+def _f8_128x4_offset(row: Int32, g: Int32, k_blocks4: cutlass.Constexpr[int]) -> Int64:
+    tile_r = row >> Int32(7)
+    tile_k = g >> Int32(2)
+    r_in = row & Int32(127)
+    return (
+        (Int64(tile_r) * Int64(k_blocks4) + Int64(tile_k)) * Int64(32)
+        + Int64(r_in & Int32(31))
+    ) * Int64(16) + Int64((r_in >> Int32(5)) * Int32(4) + (g & Int32(3)))
