+                out_v.fill_(float("nan"))
+                cand_i.fill_(-17)
+                cand_n.fill_(-17)
+                graph.replay()
+                torch.cuda.synchronize()
+                assert int(binding.runtime.scratch["state"].count_nonzero().item()) == 0
+                snapshots.append(
+                    (
+                        aw,
+                        page_table.clone(),
+                        cache_lengths.clone(),
+                        out_i.clone(),
+                        out_v.clone(),
+                        cand_i.clone(),
+                        cand_n.clone(),
+                    )
+                )
+        finally:
