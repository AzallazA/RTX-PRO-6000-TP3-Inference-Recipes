index 00000000..b3a3470d
--- /dev/null
+++ b/tp3-tools/glm-prs-gpu.sh
@@ -0,0 +1,161 @@
+#!/bin/bash
+# GPU plan for branch glm53-tp3-prs (upstream PRs #59+#179 tool arguments, #172 docs, #217 width-one in place,
+# #218 shared draft selection) on GLM-5.3-Flash FP4-Local TP3. Written 2026-11-09; not yet run.
+#
+#   tp3-tools/glm-prs-gpu.sh              # phase a then phase b
+#   PHASES=a tp3-tools/glm-prs-gpu.sh     # tool-call fixes only (no export, ~40 min)
+#   PHASES=b tp3-tools/glm-prs-gpu.sh     # GPU tests, re-export, A/B, qualification if faster (~4-5 h)
+#
+# Phase a (helios parser only, no re-export): serve the a16 default package 082232 with this worktree's binary,
+#   smoke, live tool-argument edge cases (tp3-tools/glm-prs-tool-edges.py), tools-60 from the glm-qual suite, and the
+#   server log's parser failures. OLD_EDGES=1 (default) repeats the edge cases on the old binary (~/flare-up-v3's,
+#   whose Rust equals glm53-tp3) so the off_schema_* cases show #179's before/after.
+# Phase b (recipe changes, re-export): GPU tests of #217/#218 at TP3 shapes (gate), a16 export with the 082232
+#   flags (glm53-export-tp3.sh defaults: no CP, chunk 4096, 5 drafts, concurrency 8, no overrides), dry runs,
+#   3 alternating rounds base/candidate (decode c1/c4/c8 at 32K, 60 s, both on this worktree's binary so only the
+#   package differs) with per-width round counts and GPU time from /metrics, then eval/tools/hotel at c8 on the
+#   candidate only if it is faster (MIN_GAIN, default +1.0 % mean over c1/c4/c8 and no cell below -1.5 %).
+# The DeepSeek default is restored at the end (and on any exit) with /tmp/restart-default.sh.
+# Never run this while another chain or export is queued on the GPUs (handbook C.4, D.2.9); it waits for running
+# exports and chain-*.sh scripts first, and logs while it waits.
+set -uo pipefail
+W=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
+V3=$HOME/flare-up-v3                      # old binary only (read-only use, as every GLM chain serves)
+BENCH=$HOME/llm-inference-bench
+QUAL=${QUAL:-$HOME/flare-up-glm-qual/tp3-tools/glm-qual/qual_all.sh}
+CKPT=${CKPT:-/path/to/ckpt/glm53-fp4-local}
+BASE=${BASE:-/path/to/archive-a/flare-packages/models/glm53-fp4-local/gb202-tp3-202611082232}
+M=${M:-$HOME/.cache/flare/packages/models/glm53-fp4-local}   # store the export writes to (CONFIG unset)
+PHASES=${PHASES:-a b}; OLD_EDGES=${OLD_EDGES:-1}; REPS=${REPS:-4}; MIN_GAIN=${MIN_GAIN:-1.0}; MAX_LOSS=${MAX_LOSS:--1.5}
+GF="--port 15015 --host 127.0.0.1 --served-model-name GLM-5.3-Flash --prefix-cache-memory 32G --mtp-draft-tokens 5"
+R=$HOME/bench-results/glm-prs-$(date +%m%d-%H%M); mkdir -p "$R"
+export CUDA_HOME=/usr/local/cuda-13.1 PATH=/usr/local/cuda-13.1/bin:$PATH HF_HUB_OFFLINE=1
+K=$HOME/.cache/flare/kernels; export TRITON_CACHE_DIR=$K/triton B12X_COMPILE_CACHE_DIR=$K/b12x TORCHINDUCTOR_CACHE_DIR=$K/inductor
+
+log(){ echo "$(date +%H:%M) $*" | tee -a "$R/CHAIN.md"; }
+pids(){ ps -eo pid,args | awk '$2 ~ /(^|\/)flare$/ && $3=="run"{print $1}'; }
+stop(){ for p in $(pids); do kill -INT $p; done; for i in $(seq 1 60); do [ -z "$(pids)" ] && break; sleep 3; done
+        for p in $(pids); do kill -KILL $p; done
+        until [ "$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits | sort -n | tail -1)" -lt 1000 ]; do sleep 2; done; }
+restore(){ stop; /tmp/restart-default.sh > /dev/null 2>&1; log "default restored; glm-prs chain done"; }
+# serve LABEL PACKAGE BINARY_TREE -> 0 when /v1/models answers (archive drive A loads are slower than the boot drive: 30 min)
+serve(){ stop; SERVE_LOG=$R/serve-$1.log
+  (cd "$3" && nohup ./flare/target/release/flare run "$2" --gpus 0,1,2 $GF > "$SERVE_LOG" 2>&1 &)
+  for i in $(seq 1 360); do sleep 5; curl -s -m 2 localhost:15015/v1/models | grep -q '"id"' && return 0; [ -z "$(pids)" ] && break; done
+  log "serve $1 FAILED: $(tail -2 "$SERVE_LOG" | tr '\n' ' ' | cut -c1-200)"; return 1; }
+smoke(){ curl -s -m 600 localhost:15015/v1/chat/completions -H 'Content-Type: application/json' -d '{"model":"GLM-5.3-Flash","messages":[{"role":"user","content":"What is 17*23? Reply with just the number."}],"max_tokens":2000,"reasoning_effort":"low"}' > "$R/smoke-$1.json"
+  python3 -c "import json;print(json.load(open('$R/smoke-$1.json'))['choices'][0]['message']['content'].strip()[:30])" 2>&1 | tail -1; }
+parser_failures(){ grep -cE "requires an argument key|failed conversion|does not match its declared|does not match any declared|GLM argument|GLM tool call" "$1" 2>/dev/null; }
+metrics(){ curl -s -m 10 localhost:15015/metrics > "$1"; }
+# per-width round counts and GPU time between two /metrics scrapes
+widths(){ python3 - "$1" "$2" <<'EOF'
+import re, sys
+def read(path):
+    out = {}
+    for line in open(path):
+        m = re.match(r'flare_speculative_(rounds|gpu_nanoseconds)_total\{batch="(\d+)",width="(\d+)"\} (\S+)', line)
+        if m:
+            key = int(m[3]); out.setdefault(key, [0, 0])[m[1] == "gpu_nanoseconds"] += float(m[4])
+    return out
+a, b = read(sys.argv[1]), read(sys.argv[2])
+d = {w: [b[w][0] - a.get(w, [0, 0])[0], b[w][1] - a.get(w, [0, 0])[1]] for w in sorted(b)}
+total = sum(v[0] for v in d.values()) or 1
+print(" ".join(f"w{w}:{v[0] / total:.0%}/{v[1] / max(v[0], 1) / 1e3:.0f}us" for w, v in d.items() if v[0]))
+EOF
+}
+
+# --- wait for the GPUs' other users (exports and chains), never stop them --------------------------------------
+while ps -eo args | grep -qE '[i]gnition export|[c]hain-?[a-z0-9-]*\.sh'; do
+  [ "${waited:-0}" = 0 ] && log "waiting for: $(ps -eo args | grep -E '[i]gnition export|[c]hain-?[a-z0-9-]*\.sh' | cut -c1-120 | tr '\n' ';')"
+  waited=1; sleep 120; done
+trap restore EXIT   # set after the wait, so an interrupted wait leaves the default server alone
+log "chain start: worktree $W ($(git -C "$W" log -1 --format=%h)), phases: $PHASES"
+[ -x "$W/flare/target/release/flare" ] || { log "no release binary in $W (cargo build --locked --release --manifest-path flare/Cargo.toml)"; exit 2; }
+
+# --- phase a: tool-call parser (#59 + #179), no re-export -----------------------------------------------------
+if [[ " $PHASES " == *" a "* ]]; then
+  if serve a-new "$BASE" "$W"; then
+    log "phase a: 082232 on the new binary; smoke $(smoke a-new)"
+    (cd "$W" && python3 tp3-tools/glm-prs-tool-edges.py "$R/edges-new.json" "$REPS" > "$R/edges-new.log" 2>&1)
+    log "edges (new binary): $(tail -2 "$R/edges-new.log" | tr '\n' ' ')"
+    QUAL_OUT=$R/qual-a LABEL=glm-prs-a FLARE_LOG=$SERVE_LOG CKPT=$CKPT "$QUAL" tools > "$R/qual-a.log" 2>&1
+    log "tools-60 (new binary): $(tail -1 "$R/qual-a/tools.log")"
+    log "server log parser failures (new binary): $(parser_failures "$SERVE_LOG")"
+  fi
+  if [ "$OLD_EDGES" = 1 ] && serve a-old "$BASE" "$V3"; then
+    (cd "$W" && python3 tp3-tools/glm-prs-tool-edges.py "$R/edges-old.json" "$REPS" > "$R/edges-old.log" 2>&1)
+    log "edges (old binary, before #179): $(tail -2 "$R/edges-old.log" | tr '\n' ' ') | server log parser failures $(parser_failures "$SERVE_LOG")"
+  fi
+fi
+
+# --- phase b: #217 + #218, re-export and A/B -------------------------------------------------------------------
+if [[ " $PHASES " == *" b "* ]]; then
+  stop
+  T=(/usr/bin/env FLARE_RUN_CUDA_TESTS=1 FLARE_GLM53_SNAPSHOT=$CKPT PYTHONPATH=$W)
+  PY=$W/.venv/bin/python; [ -e "$W/.venv" ] || ln -s "$V3/.venv" "$W/.venv"   # as ~/flare-up-glm/.venv
+  log "ignition imports from $(cd "$W" && "${T[@]}" CUDA_VISIBLE_DEVICES= "$PY" -c 'import ignition;print(ignition.__file__)')"
+  # #218: reused selection at every TP3 rank shape (24 heads), TP2 and TP4 (1 GPU). Gate.
+  (cd "$W" && timeout 3600 "${T[@]}" CUDA_VISIBLE_DEVICES=0 "$PY" -m pytest -q -p no:cacheprovider \
+     tests/recipes/test_glm53_mla_cuda.py -k reused_selection > "$R/gpu-218-mla.log" 2>&1); g1=$?
+  # #217: the in-place path is the plain one-column KDA decode plan; at TP3 it runs 24 heads per rank (16 real on
+  # rank 2), which the recorded verification path never exercised. world-3 decode case of the KDA TP test. Gate.
+  K3=$(cd "$W" && "${T[@]}" CUDA_VISIBLE_DEVICES= "$PY" -m pytest -q --collect-only -p no:cacheprovider \
+       tests/recipes/test_glm53_kda_tp_cuda.py 2>/dev/null | grep -E '\[.*decode.*\]' | grep -E '(\[3-|-3\])')
+  if [ -n "$K3" ]; then
+    (cd "$W" && timeout 3600 "${T[@]}" CUDA_VISIBLE_DEVICES=0,1,2 "$PY" -m pytest -q -p no:cacheprovider $K3 \
+       > "$R/gpu-217-kda-tp3.log" 2>&1); g2=$?
+  else g2=9; echo "world-3 decode case not collected" > "$R/gpu-217-kda-tp3.log"; fi
+  # #217: width one in place vs recorded across width-one / recorded / width-one rounds (TP4 head partition,
+  # layer 0). Informational: the PR's own test, not at TP3 shapes.
+  (cd "$W" && timeout 3600 "${T[@]}" CUDA_VISIBLE_DEVICES=0 "$PY" -m pytest -q -p no:cacheprovider \
+     tests/recipes/test_glm53_mtp_state_cuda.py > "$R/gpu-217-mtp-state.log" 2>&1); g3=$?
+  log "GPU tests: 218 mla reused selection exit $g1 ($(tail -1 "$R/gpu-218-mla.log" | cut -c1-80)) | 217 KDA TP3 decode exit $g2 ($(tail -1 "$R/gpu-217-kda-tp3.log" | cut -c1-80)) | 217 mtp state exit $g3 (info: $(tail -1 "$R/gpu-217-mtp-state.log" | cut -c1-80))"
+  if [ $g1 != 0 ] || [ $g2 != 0 ]; then
+    [ "${SKIP_GATE:-0}" = 1 ] && log "gate failed, SKIP_GATE=1: exporting anyway" || { log "gate failed: no export (SKIP_GATE=1 overrides)"; exit 1; }
+  fi
+  free=$(df --output=avail -BG "$(dirname "$M")" | tail -1 | tr -dc 0-9)
+  [ "$free" -ge 150 ] || { log "only ${free} GB free on the package store: no export (handbook D.2.9)"; exit 1; }
+  t0=$(date +%s); (cd "$W" && timeout 28800 ./tp3-tools/glm53-export-tp3.sh > "$R/export.log" 2>&1); erc=$?
+  CAND=$(grep -o "$M/gb202-tp3-[0-9]*" "$R/export.log" | tail -1)
+  log "export exit $erc after $(( ($(date +%s)-t0)/60 )) min: ${CAND:-none} $( [ $erc = 0 ] || tr '\r' '\n' < "$R/export.log" | grep -E 'Error' | tail -1 | cut -c1-200)"
+  [ $erc = 0 ] && [ -n "$CAND" ] || exit 1
+  for P in "$BASE" "$CAND"; do
+    (cd "$W" && timeout 900 ./flare/target/release/flare run "$P" --gpus 0,1,2 $GF --dry-run > "$R/dryrun-$(basename "$P").log" 2>&1)
+    log "dry run $(basename "$P"): $(grep -o '[0-9,]* KV tokens' "$R/dryrun-$(basename "$P").log" | tail -1)"
+  done
+  for round in 1 2 3; do for pair in "base:$BASE" "cand:$CAND"; do L=${pair%%:*}; P=${pair#*:}
+    serve "$L-r$round" "$P" "$W" || continue
+    s=$(smoke "$L-r$round"); metrics "$R/metrics-$L-r$round-0.txt"
+    (cd "$BENCH" && .venv/bin/python llm_decode_bench.py --port 15015 --model GLM-5.3-Flash --concurrency 1,4,8 \
+       --contexts 32k --duration 60 --display-mode plain --output "$R/$L-32k-r$round.json" > "$R/$L-32k-r$round.log" 2>&1)
+    metrics "$R/metrics-$L-r$round-1.txt"
+    log "bench $L r$round: $(python3 "$V3/tp3-tools/bench_cell.py" "$R/$L-32k-r$round.json") | widths $(widths "$R/metrics-$L-r$round-0.txt" "$R/metrics-$L-r$round-1.txt") | smoke $s"
+  done; done
+  python3 - "$R" "$MIN_GAIN" "$MAX_LOSS" > "$R/decision.txt" <<'EOF'
+import glob, json, sys
+R, gain, loss = sys.argv[1], float(sys.argv[2]), float(sys.argv[3])
+def cells(label):
+    out = {}
+    for path in sorted(glob.glob(f"{R}/{label}-32k-r*.json")):
+        for r in json.load(open(path))["results"]:
+            if (r.get("aggregate_tps") or 0) > 0:
+                out.setdefault(r["concurrency"], []).append(r["aggregate_tps"])
+    return {c: sum(v) / len(v) for c, v in out.items()}
+b, c = cells("base"), cells("cand")
+deltas = {k: 100 * (c[k] / b[k] - 1) for k in sorted(b) if k in c}
+mean = sum(deltas.values()) / max(len(deltas), 1)
+faster = len(deltas) == 3 and mean >= gain and min(deltas.values()) >= loss
+print(" ".join(f"c{k} {b[k]:.0f}->{c[k]:.0f} ({d:+.1f}%)" for k, d in deltas.items()), f"mean {mean:+.1f}%",
+      "FASTER" if faster else "NOT-FASTER")
+EOF
+  log "A/B (3 rounds, means): $(cat "$R/decision.txt")"
+  if grep -q " FASTER" "$R/decision.txt"; then
+    if serve qual-cand "$CAND" "$W"; then
+      QUAL_OUT=$R/qual-b LABEL=glm-prs-cand QC=8 FLARE_LOG=$SERVE_LOG CKPT=$CKPT "$QUAL" eval tools hotel > "$R/qual-b.log" 2>&1
+      log "candidate qualification (eval/tools/hotel c8):"; sed -n '/qualification start/,$p' "$R/qual-b/QUAL.md" | cut -d'—' -f2- | tee -a "$R/CHAIN.md"
+      log "server log parser failures (candidate): $(parser_failures "$SERVE_LOG")"
+    fi
+  else
+    log "candidate not faster: no qualification run (handbook D.6 rule 0)"
+  fi
+fi
diff --git a/tp3-tools/glm-prs-tool-edges.py b/tp3-tools/glm-prs-tool-edges.py
new file mode 100755
index 00000000..f6ef04ca
--- /dev/null
+++ b/tp3-tools/glm-prs-tool-edges.py
@@ -0,0 +1,150 @@
+#!/usr/bin/env python3
+"""Live GLM-5.3-Flash tool-argument edge cases for the #59/#179 parser change (glm53-tp3-prs).
+
+Each case sends one tool-requiring prompt REPS times (non-streaming, plus streaming for the cases marked so) and
+classifies every reply:
+  pass      HTTP 200, finish_reason tool_calls, the expected tool, arguments parse and satisfy the case's check
+  mismatch  a tool call whose arguments do not satisfy the check (the value is recorded; off-schema values are
+            retained by #179, so for the off_schema_* cases any completed call is a pass)
+  no_call   the model answered without calling a tool (model behaviour, not a parser result)
+  error     HTTP error, aborted stream or an error event: the parser failed the call (#39 class)
+The off_schema_* cases ask the model to pass a value of the wrong JSON type; before #179 the server failed those
+calls ("tool parameter value does not match its declared JSON type"), after it they must complete. The
+markup_in_value case puts a literal </arg_value> inside a string value (non-streaming and streaming). Before the
+glm53-tp3 </arg_value>-in-value fix the parser split at the first closing tag (mismatch or error); with it a closing
+tag ends a value only before the next <arg_key> or the end of the call, so that case must pass too. Parser errors in
+every case count against PASS; EXEMPT_MARKUP=1 restores the old exemption for binaries without the fix.
+
+usage: glm-prs-tool-edges.py OUT.json [REPS=4]   (FLARE_URL, MODEL, TOOLS_EFFORT from the environment)
+"""
+import json
+import os
+import sys
+import urllib.error
+import urllib.request
+
+URL = os.environ.get("FLARE_URL", "http://127.0.0.1:15015").rstrip("/") + "/v1/chat/completions"
+MODEL = os.environ.get("MODEL", "GLM-5.3-Flash")
+EFFORT = os.environ.get("TOOLS_EFFORT", "low")
+
+
+def tool(name, properties, required=()):
+    return {"type": "function", "function": {"name": name, "description": f"{name} tool.", "parameters": {
+        "type": "object", "properties": properties, "required": list(required)}}}
+
+
+SET_FLAG = tool("set_flag", {"name": {"type": "string"}, "enabled": {"type": "boolean"}}, ["name", "enabled"])
+TAG_FILE = tool("tag_file", {"path": {"type": "string"}, "tags": {"type": "array", "items": {"type": "string"}}},
+                ["path", "tags"])
+CONFIGURE = tool("configure", {"settings": {"type": "object"}}, ["settings"])
+SET_LIMIT = tool("set_limit", {"limit": {"anyOf": [{"type": "integer"}, {"type": "null"}]}}, ["limit"])
+WRITE_FILE = tool("write_file", {"path": {"type": "string"}, "content": {"type": "string"}}, ["path", "content"])
+SET_COUNT = tool("set_count", {"count": {"type": "integer"}}, ["count"])
+
+# name, tools, prompt, expected tool, check(arguments) -> bool, also streamed
+CASES = [
+    ("bool_true", [SET_FLAG], "Enable the feature flag named dark_mode.", "set_flag",
+     lambda a: a.get("enabled") is True, True),
+    ("array_tags", [TAG_FILE], "Tag the file /srv/a.txt with the tags alpha, beta and gamma.", "tag_file",
+     lambda a: isinstance(a.get("tags"), list) and sorted(a["tags"]) == ["alpha", "beta", "gamma"], False),
+    ("nested_object", [CONFIGURE], "Configure the server: port 8080, and tls enabled with cert /etc/c.pem and "
+     "protocols h2 and http/1.1. Put tls in a nested object.", "configure",
+     lambda a: isinstance(a.get("settings"), dict) and any(isinstance(v, dict) for v in a["settings"].values()), False),
+    ("anyof_null", [SET_LIMIT], "Remove the limit: call set_limit with limit set to null.", "set_limit",
+     lambda a: "limit" in a and a["limit"] is None, False),
+    ("empty_string", [WRITE_FILE], "Create the empty file /tmp/empty.txt (its content is the empty string).",
+     "write_file", lambda a: a.get("content") == "", False),
+    ("markup_in_value", [WRITE_FILE], "Write the file /tmp/t.xml whose content is exactly this text: "
+     "<a></arg_value><b/></a>", "write_file", lambda a: "</arg_value>" in a.get("content", ""), True),
+    ("off_schema_int", [SET_COUNT], "Call set_count and pass count as the literal word many (the string many, "
+     "even though the schema says integer; do not convert it).", "set_count", lambda a: "count" in a, True),
+    ("off_schema_bool", [SET_FLAG], "Call set_flag for the flag named beta with enabled set to the literal string "
+     "yes (not a boolean; pass the word yes exactly).", "set_flag", lambda a: "enabled" in a, False),
+]
+
+
+def body(tools, prompt, stream):
+    return {"model": MODEL, "messages": [{"role": "user", "content": prompt}], "tools": tools,
+            "tool_choice": "auto", "max_tokens": 8192, "temperature": 1.0, "top_p": 0.95,
+            "reasoning_effort": EFFORT, "stream": stream}
+
+
+def post(payload):
+    request = urllib.request.Request(URL, json.dumps(payload).encode(), {"Content-Type": "application/json"})
+    return urllib.request.urlopen(request, timeout=900)
+
+
+def call_once(tools, prompt, stream):
+    """(finish_reason, [(name, arguments string)], error or None)."""
+    try:
+        with post(body(tools, prompt, stream)) as response:
+            if not stream:
+                choice = json.load(response)["choices"][0]
+                calls = [(c["function"]["name"], c["function"]["arguments"])
+                         for c in choice["message"].get("tool_calls") or []]
+                return choice.get("finish_reason"), calls, None
+            finish, calls, done = None, {}, False
+            for raw in response:
+                line = raw.decode().strip()
+                if not line.startswith("data:"):
+                    continue
+                data = line[5:].strip()
+                if data == "[DONE]":
+                    done = True
+                    break
+                event = json.loads(data)
+                if "error" in event:
+                    return None, [], f"stream error event: {str(event['error'])[:300]}"
+                for choice in event.get("choices", []):
+                    finish = choice.get("finish_reason") or finish
+                    for delta in choice.get("delta", {}).get("tool_calls") or []:
+                        slot = calls.setdefault(delta.get("index", 0), ["", ""])
+                        function = delta.get("function") or {}
+                        slot[0] += function.get("name") or ""
+                        slot[1] += function.get("arguments") or ""
+            if not done:
+                return finish, [], "stream ended without [DONE]"
+            return finish, [tuple(calls[i]) for i in sorted(calls)], None
+    except urllib.error.HTTPError as error:
+        return None, [], f"HTTP {error.code}: {error.read()[:300]!r}"
+    except Exception as error:  # noqa: BLE001
+        return None, [], f"{type(error).__name__}: {error}"
+
+
+def classify(expected, check, finish, calls, error):
+    if error:
+        return "error", error
+    if not calls:
+        return "no_call", finish
+    name, arguments = calls[0]
+    try:
+        parsed = json.loads(arguments)
+    except ValueError:
+        return "mismatch", f"arguments are not JSON: {arguments[:200]}"
+    if name != expected or not isinstance(parsed, dict):
+        return "mismatch", f"{name} {arguments[:200]}"
+    return ("pass" if check(parsed) and finish == "tool_calls" else "mismatch"), parsed
+
+
+def main():
+    out, reps = sys.argv[1], int(sys.argv[2]) if len(sys.argv) > 2 else 4
+    results, summary = [], {}
+    for name, tools, prompt, expected, check, streamed in CASES:
+        for stream in (False, True) if streamed else (False,):
+            label = f"{name}{'/stream' if stream else ''}"
+            for rep in range(reps):
+                verdict, detail = classify(expected, check, *call_once(tools, prompt, stream))
+                results.append({"case": label, "rep": rep, "verdict": verdict, "detail": detail})
+                summary.setdefault(label, {}).setdefault(verdict, 0)
+                summary[label][verdict] += 1
+    json.dump({"summary": summary, "results": results}, open(out, "w"), indent=1, default=str)
+    exempt = os.environ.get("EXEMPT_MARKUP") == "1"
+    errors = sum(v.get("error", 0) for k, v in summary.items() if not (exempt and k.startswith("markup_in_value")))
+    print(" | ".join(f"{k} " + ",".join(f"{v}{n}" for v, n in sorted(c.items())) for k, c in summary.items()))
+    scope = "outside markup_in_value" if exempt else "in all cases"
+    print(f"tool edges: {'PASS' if errors == 0 else 'FAIL'} ({errors} parser errors {scope})")
+    return 0 if errors == 0 else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tp3-tools/glm-tool-fix-gpu.sh b/tp3-tools/glm-tool-fix-gpu.sh
new file mode 100755
index 00000000..bfae8892
--- /dev/null
+++ b/tp3-tools/glm-tool-fix-gpu.sh
@@ -0,0 +1,55 @@
+#!/bin/bash
+# GPU check for the GLM </arg_value>-in-value parser fix (branch glm53-tp3, ~/flare-up-glm). Written 2026-11-09;
+# not yet run. Helios parser only: no export, ~40 min.
+#
+#   tp3-tools/glm-tool-fix-gpu.sh             # REPS=4 edge repetitions by default
+#
+# Stops any flare server, serves the GLM a16 default package 082232 with this worktree's binary, runs the live
+# tool-argument edge cases (tp3-tools/glm-prs-tool-edges.py; markup_in_value now counts, streaming included) and
+# tools-60 from the glm-qual suite, counts parser failures in the server log, and restores the DeepSeek default with
+# /tmp/restart-default.sh at the end (and on any exit). Log: ~/bench-results/glm-tool-fix-<mmdd-HHMM>/CHAIN.md.
+# Never run this while another chain or export is queued on the GPUs (handbook C.4, D.2.9): it waits for running
+# exports and chain scripts first.
+set -uo pipefail
+W=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
+QUAL=${QUAL:-$HOME/flare-up-glm-qual/tp3-tools/glm-qual/qual_all.sh}
+CKPT=${CKPT:-/path/to/ckpt/glm53-fp4-local}
+P=${P:-/path/to/archive-a/flare-packages/models/glm53-fp4-local/gb202-tp3-202611082232}
+REPS=${REPS:-4}
+GF="--port 15015 --host 127.0.0.1 --served-model-name GLM-5.3-Flash --prefix-cache-memory 32G --mtp-draft-tokens 5"
+R=$HOME/bench-results/glm-tool-fix-$(date +%m%d-%H%M); mkdir -p "$R"
+export CUDA_HOME=/usr/local/cuda-13.1 PATH=/usr/local/cuda-13.1/bin:$PATH HF_HUB_OFFLINE=1
+K=$HOME/.cache/flare/kernels; export TRITON_CACHE_DIR=$K/triton B12X_COMPILE_CACHE_DIR=$K/b12x TORCHINDUCTOR_CACHE_DIR=$K/inductor
+
+log(){ echo "$(date +%H:%M) $*" | tee -a "$R/CHAIN.md"; }
+# stop/ready helpers as in /tmp/glm-704-chain.sh
+pids(){ ps -eo pid,args | awk '$2 ~ /(^|\/)flare$/ && $3=="run"{print $1}'; }
+stop(){ for p in $(pids); do kill -INT $p; done; for i in $(seq 1 60); do [ -z "$(pids)" ] && break; sleep 3; done
+        for p in $(pids); do kill -KILL $p; done
+        until [ "$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits | sort -n | tail -1)" -lt 1000 ]; do sleep 2; done; }
+restore(){ stop; /tmp/restart-default.sh > /dev/null 2>&1; log "default restored; glm-tool-fix chain done"; }
+parser_failures(){ grep -cE "requires an argument key|unterminated GLM|failed conversion|does not match its declared|does not match any declared|GLM argument|GLM tool call|incomplete GLM tool call" "$1" 2>/dev/null; }
+
+while ps -eo args | grep -qE '[i]gnition export|[c]hain-?[a-z0-9-]*\.sh'; do
+  [ "${waited:-0}" = 0 ] && log "waiting for: $(ps -eo args | grep -E '[i]gnition export|[c]hain-?[a-z0-9-]*\.sh' | cut -c1-120 | tr '\n' ';')"
+  waited=1; sleep 120; done
+[ -x "$W/flare/target/release/flare" ] || { log "no release binary in $W (cargo build --locked --release --manifest-path flare/Cargo.toml)"; exit 2; }
+trap restore EXIT   # set after the wait, so an interrupted wait leaves the default server alone
+log "chain start: worktree $W ($(git -C "$W" log -1 --format=%h)), package $(basename "$P"), reps $REPS"
+
+stop; SERVE_LOG=$R/serve.log
+(cd "$W" && nohup ./flare/target/release/flare run "$P" --gpus 0,1,2 $GF > "$SERVE_LOG" 2>&1 &)
+ok=0; for i in $(seq 1 360); do sleep 5; curl -s -m 2 localhost:15015/v1/models | grep -q '"id"' && { ok=1; break; }; [ -z "$(pids)" ] && break; done
+[ $ok = 1 ] || { log "serve FAILED: $(tail -2 "$SERVE_LOG" | tr '\n' ' ' | cut -c1-200)"; exit 1; }
+curl -s -m 600 localhost:15015/v1/chat/completions -H 'Content-Type: application/json' -d '{"model":"GLM-5.3-Flash","messages":[{"role":"user","content":"What is 17*23? Reply with just the number."}],"max_tokens":2000,"reasoning_effort":"low"}' > "$R/smoke.json"
+log "served; smoke $(python3 -c "import json;print(json.load(open('$R/smoke.json'))['choices'][0]['message']['content'].strip()[:30])" 2>&1 | tail -1)"
+
+(cd "$W" && python3 tp3-tools/glm-prs-tool-edges.py "$R/edges.json" "$REPS" > "$R/edges.log" 2>&1); erc=$?
+log "edges exit $erc: $(tail -2 "$R/edges.log" | tr '\n' ' ')"
+log "markup_in_value: $(python3 -c "import json;s=json.load(open('$R/edges.json'))['summary'];print({k:v for k,v in s.items() if k.startswith('markup_in_value')})" 2>&1 | tail -1)"
+log "server log parser failures after edges: $(parser_failures "$SERVE_LOG")"
+
+QUAL_OUT=$R/qual LABEL=glm-tool-fix FLARE_LOG=$SERVE_LOG CKPT=$CKPT "$QUAL" tools > "$R/qual.log" 2>&1
+log "tools-60: $(tail -1 "$R/qual/tools.log" 2>/dev/null)"
+log "server log parser failures total: $(parser_failures "$SERVE_LOG")"
+grep -E "requires an argument key|unterminated GLM|failed conversion|GLM argument|GLM tool call" "$SERVE_LOG" | head -20 > "$R/parser-failures.txt"
diff --git a/tp3-tools/glm53-export-tp2.sh b/tp3-tools/glm53-export-tp2.sh
new file mode 100755
index 00000000..698c2e50
--- /dev/null
+++ b/tp3-tools/glm53-export-tp2.sh
@@ -0,0 +1,65 @@
+#!/bin/bash
+# GLM-5.3-Flash at TP2 on two RTX PRO 6000: upstream's declared rank count (no TP3 padding involved: 32 heads,
+# 1024 expert columns and 77440 vocabulary rows per rank, exact), with Flare's native decode context parallelism
+# (DCP2, 512-token pages) left on. GPUS defaults to 0,1.
+#
+#   tp3-tools/glm53-export-tp2.sh                       # 11-10 defaults: a16, KDA side chain, overlay (push at world 2)
+#   B12X_PCIE_DCP_GATHER_PULL=1 tp3-tools/glm53-export-tp2.sh   # world-2 pull gather (overlay, opt-in, unmeasured)
+#   DCP=0 / CONC=4 / VISION=1 / CONFIG=<flare config.toml> / B12X_OVERLAY= (empty: no overlay)
+#
+# TP3 improvements carried over (2026-11-10, branch glm53-tp2-update; defaults overridable from the environment):
+#   FLARE_GLM53_EXPERT_ACTIVATION=a16   A4 prefill / A16 decode experts. This is already the recipe default on SM120
+#                           (a4 only on SM103), so the 11-08 package 082052 is a16 too; set explicitly to pin it.
+#   FLARE_GLM53_KDA_SIDE_CHAIN=1   f_a -> f_b, b and g_a -> g_b beside the KDA q/k/v GEMM, no staging copies (TP3:
+#                           +2.2/+1.3/+1.1 % c1/c4/c8, bitwise-identical outputs). At TP2: b_proj N=32 and f_a N=128
+#                           GEMVs instead of one N=160 launch (new tuning shapes; the rest of the cache is warm).
+#   B12X_OVERLAY            <worktree>/.b12x-overlay when present (tp3-tools/make-b12x-overlay.sh). Its pull gather is
+#                           world-3 only under B12X_PCIE_DCP_GATHER_PULL=auto (default), so a TP2 export with the
+#                           overlay compiles the same push kernels as without it; =1 selects the world-2 pull plane.
+#   FLARE_GLM53_EMBED_HOST=1   (branch glm53-vram, opt-in, unmeasured) the replicated BF16 token embedding (1210 MiB per
+#                           rank) lives in device-visible host memory; KV pages take the VRAM (~+0.38M KV tokens at TP2).
+#   FLARE_GLM53_VISION_STAGE=1   (with VISION=1; GPU-validated 11-12, release setting with IMAGE_CONCURRENCY=2) the replicated
+#                           vision tower (373 MiB per rank) in host memory, staged through 22 MiB of VRAM slots per image.
+# Not carried over (rejected at TP3): NVFP4 draft head / MXFP8 eh_proj, a4 decode, LIL checkpoint, FP32 partials,
+# 704 expert columns (TP3-only; TP2 splits 2048 exactly). The script refuses the draft-precision and column overrides.
+#
+# Check in the log: plan line (TP2, context_parallel True), free device bytes after weights (~95 - 83 GiB), KV pages.
+set -euo pipefail
+ROOT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
+cd "$ROOT"
+CKPT=${CKPT:-/path/to/ckpt/glm53-fp4-local}
+[ -d "$CKPT" ] || { echo "checkpoint directory $CKPT is missing" >&2; exit 2; }
+for name in DRAFT_HEAD DRAFT_EH_PROJ EXPERT_COLUMNS; do
+  var=FLARE_GLM53_$name
+  [ -z "${!var:-}" ] || { echo "$var=${!var} is a TP3 option (rejected or not applicable at TP2); unset it" >&2; exit 2; }
+done
+export FLARE_GLM53_EXPERT_ACTIVATION=${FLARE_GLM53_EXPERT_ACTIVATION:-a16}
+export FLARE_GLM53_KDA_SIDE_CHAIN=${FLARE_GLM53_KDA_SIDE_CHAIN:-1}
+
+B12X_OVERLAY=${B12X_OVERLAY-$( [ -d "$ROOT/.b12x-overlay/b12x_tree" ] && echo "$ROOT/.b12x-overlay" )}
+export PYTHONPATH="${B12X_OVERLAY:+$B12X_OVERLAY:}$ROOT" TORCH_EXTENSIONS_DIR="$ROOT/.brrr-ext" CUDA_HOME=/usr/local/cuda-13.1
+export PATH="/usr/local/cuda-13.1/bin:$PATH" HF_HUB_OFFLINE=1
+TEXT_ONLY=(--language-model-only)
+[ "${VISION:-0}" = "1" ] && TEXT_ONLY=()
+# IMAGE_CONCURRENCY=<n> (with VISION=1): --image-concurrency n feature slots (64 MiB each per rank; default min(4, CONC)).
+IMAGE_FLAGS=(); [ -n "${IMAGE_CONCURRENCY:-}" ] && IMAGE_FLAGS=(--image-concurrency "$IMAGE_CONCURRENCY")
+CONFIG_FLAGS=(); [ -n "${CONFIG:-}" ] && CONFIG_FLAGS=(--config "$CONFIG")
+# MTP_ONLY=1: pass --mtp-only (upstream b547413b): omit the ordinary (no-draft) graph set ("-no-mtp" prefill and
+# resume/init/restore/snapshot graphs, plain decode graphs); the package then refuses --mtp-draft-tokens 0.
+# Default 0 = unchanged export command.
+case "${MTP_ONLY:-0}" in
+  0) MTP_ONLY_FLAGS=() ;;
+  1) MTP_ONLY_FLAGS=(--mtp-only) ;;
+  *) echo "MTP_ONLY must be 0 or 1, not ${MTP_ONLY}" >&2; exit 2 ;;
+esac
+case "${DCP:-1}" in
+  1) CP_FLAG=() ;;
+  0) CP_FLAG=(--no-context-parallel) ;;
+  *) echo "DCP must be 0 or 1, not ${DCP}" >&2; exit 2 ;;
+esac
+echo "glm53-export-tp2: GPUS=${GPUS:-0,1} DCP=${DCP:-1} activation=$FLARE_GLM53_EXPERT_ACTIVATION" \
+     "kda_side_chain=$FLARE_GLM53_KDA_SIDE_CHAIN embed_host=${FLARE_GLM53_EMBED_HOST:-0} vision=${VISION:-0} vision_stage=${FLARE_GLM53_VISION_STAGE:-0} image_concurrency=${IMAGE_CONCURRENCY:-default} overlay=${B12X_OVERLAY:-none}" \
+     "gather_pull=${B12X_PCIE_DCP_GATHER_PULL:-auto} commit=$(git -C "$ROOT" log -1 --format=%h 2>/dev/null)"
+exec .venv/bin/ignition export "$CKPT" ${CONFIG_FLAGS[@]+"${CONFIG_FLAGS[@]}"} --gpus "${GPUS:-0,1}" \
+  ${CP_FLAG[@]+"${CP_FLAG[@]}"} --prefill-chunk-size 4096 --mtp-draft-tokens 5 \
+  --max-concurrency "${CONC:-8}" "${TEXT_ONLY[@]}" ${IMAGE_FLAGS[@]+"${IMAGE_FLAGS[@]}"} ${MTP_ONLY_FLAGS[@]+"${MTP_ONLY_FLAGS[@]}"} --verbose
diff --git a/tp3-tools/glm53-export-tp3.sh b/tp3-tools/glm53-export-tp3.sh
new file mode 100755
index 00000000..2bf956b9
--- /dev/null
+++ b/tp3-tools/glm53-export-tp3.sh
@@ -0,0 +1,96 @@
+#!/bin/bash
+# First GLM 5.3 Flash TP3 export from the plain checkpoint directory (revision 76348ddb) on three GB202 GPUs.
+#
+#   tp3-tools/glm53-export-tp3.sh            # after tp3-tools/glm53-gpu-validate.sh passed
+#   CONC=32 VISION=1 tp3-tools/glm53-export-tp3.sh
+#   DCP=1 tp3-tools/glm53-export-tp3.sh      # decode context parallelism over the three ranks (DCP3, opt-in)
+#
+# Flags the glm53 recipe needs at world size 3:
+#   --no-context-parallel   (default, DCP=0) three ranks shard heads and experts only. The recipe declares no
+#                           context-parallel page size for three ranks unless FLARE_GLM53_DCP3=1 (recipe.py
+#                           `_costs`), so the planner keeps it off anyway; the flag makes the choice explicit.
+#   DCP=1                   exports with FLARE_GLM53_DCP3=1 and without --no-context-parallel: 768-token pages
+#                           (256 local records on each rank), page tables rounded up to 1366 pages for 2^20,
+#                           72-head query/LSE exchange and 3 x 512 candidate merge (dcp.py). Not qualified yet:
+#                           tp3-tools/glm-dcp3-gpu.sh runs the GPU stages. The served context stays 1048576;
+#                           serving needs a flare binary with the partial-last-page catalog check (this branch).
+#   --prefill-chunk-size 4096   the recipe default; the TP3 prefill all-reduce is one PCIe runtime sized for
+#                           this chunk (bootstrap.py, mirrored from deepseek41), 32 MiB per layer reduction.
+#   --mtp-draft-tokens 5    the recipe's default drafts (Speculation(draft_tokens=5, token_capacity=128)).
+#   --collective-tuning runtime --collective-ladder gb202_pcie_tp3.json
+#                           the ladder is accepted at world 3: planning validates world_size (3) and compute
+#                           capability (12, 0) only, and the GLM bootstrap passes collective_tuning to every
+#                           PCIe all-reduce (joint kernels). The buckets are byte-sized, so DeepSeek's
+#                           5120-wide ladder applies to 4096-wide rows.
+#   --max-concurrency ${CONC:-8}   first export at 8 (as the DeepSeek TP3 release); the recipe default is 32.
+#   --language-model-only   unless VISION=1: the replicated vision tower costs VRAM on every rank and is not
+#                           part of the TP3 question.
+# No --gpus auto-selection is involved: three GPUs are listed, which is also the only way a four-GPU host
+# gets TP3 (recipe exact_rank_counts).
+# Fork-only export overrides (recipe.py `_tp3_override`, unset = upstream choice) pass through the environment:
+#   FLARE_GLM53_EXPERT_ACTIVATION=a4|a16, FLARE_GLM53_EXPAND_SCALES=1|0,
+#   FLARE_GLM53_EXPERT_COLUMNS=768|704   routed experts 704 columns per rank instead of 768 (shared expert
+#                           stays 768); new MoE shapes, so the first such export tunes them cold.
+#   FLARE_GLM53_KDA_SIDE_CHAIN=1   (branch glm53-tp3-speed-dcp3) run f_a -> f_b, b and g_a -> g_b beside the KDA q/k/v GEMM
+#                           and drop the two per-layer staging copies (same weights; ~6-8 us per KDA layer at c1).
+#   FLARE_GLM53_DRAFT_HEAD=nvfp4   NVFP4 proposal head built from the MXFP8 head (draft passes only).
+#   FLARE_GLM53_DRAFT_EH_PROJ=mxfp8   the draft layer's BF16 eh_proj as MXFP8 (draft passes only).
+#   FLARE_GLM53_VISION_STAGE=1   (with VISION=1; GPU-validated 11-12, release setting with IMAGE_CONCURRENCY=4) park the
+#                           replicated vision tower (373 MiB per rank) in device-visible host memory and stage it
+#                           through 22 MiB of VRAM slots per image (DeepSeek's TP3 vision weight staging).
+# MTP_ONLY=1   pass --mtp-only (upstream b547413b): omit the ordinary (no-draft) graph set ("-no-mtp" prefill and
+#              resume/init/restore/snapshot graphs, plain decode graphs); vision and width-1 speculative rounds stay.
+#              The package then refuses to load with 0 drafts. Default 0 = unchanged export command.
+#
+# Expect a cold tuning cache: every GEMM/MoE/attention shape of the 22-head, 768-column, 51648-row shards is
+# new, so the first export autotunes everything (hours, as the first DeepSeek TP3 export did); the second
+# export of the same shapes reuses the shared tuning cache. A cold cache also needs more free VRAM than
+# serving; if tuning runs out of memory, retry with CONC=4.
+#
+# What to check in the export log (--verbose):
+#   * the plan line: tensor_parallel 3, context_parallel False, prefill chunk 4096, drafts 5, concurrency.
+#   * padded shard shapes on every rank: KDA q/k/v 2816 rows (22 heads), MLA q_b 5632 rows / kv_b 11264 rows,
+#     experts intermediate 768 (plan geometry), shared gate/up 1536 rows, lm_head 51648 rows; rank 2's loads
+#     report the padded tails (no "exceeds its ... checkpoint extent" error).
+#   * collectives: one PCIe all-reduce runtime shared by decode and prefill (no DMA all-reduce line), the
+#     vocabulary gather with 154944 columns, no head exchange / candidate gather (no DCP).
+#   * "after weights": free device bytes per rank (expect roughly 96 GB - 63 GB weights); "after model
+#     state" and the final memory report: KV pages per rank and the free bytes the planner left.
+#   * the KV estimate versus the plan: pages * 256 tokens; compare with `flare run <pkg> --dry-run` later.
+set -euo pipefail
+ROOT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
+cd "$ROOT"
+CKPT=${CKPT:-/path/to/ckpt/glm53-fp4-local}
+[ -d "$CKPT" ] || { echo "checkpoint directory $CKPT is missing" >&2; exit 2; }
+
+# B12X_OVERLAY=<dir>: a patched b12x copy ahead of the venv. Default: <worktree>/.b12x-overlay when present (the
+# world-3 pull gather, built by tp3-tools/make-b12x-overlay.sh); B12X_OVERLAY= (empty) exports without it.
+B12X_OVERLAY=${B12X_OVERLAY-$( [ -d "$ROOT/.b12x-overlay/b12x_tree" ] && echo "$ROOT/.b12x-overlay" )}
+export PYTHONPATH="${B12X_OVERLAY:+$B12X_OVERLAY:}$ROOT" TORCH_EXTENSIONS_DIR="$ROOT/.brrr-ext" CUDA_HOME=/usr/local/cuda-13.1
+export PATH="/usr/local/cuda-13.1/bin:$PATH" HF_HUB_OFFLINE=1
+TEXT_ONLY=(--language-model-only)
+[ "${VISION:-0}" = "1" ] && TEXT_ONLY=()
+# IMAGE_CONCURRENCY=<n> (with VISION=1): --image-concurrency n feature slots (64 MiB each per rank; default min(4, CONC)).
+IMAGE_FLAGS=(); [ -n "${IMAGE_CONCURRENCY:-}" ] && IMAGE_FLAGS=(--image-concurrency "$IMAGE_CONCURRENCY")
+# Static collective tuning, as the DS41 TP3 release export: the TP3 runtime ladder stops at 24 MiB and a
+# 4096-row GLM prefill chunk reduces 32 MiB per call (export 1108-1557 failed "no bucket for 33554432 bytes").
+# CONFIG=<flare config.toml> selects another package store (paths.package_cache), e.g. on a drive with more room.
+CONFIG_FLAGS=(); [ -n "${CONFIG:-}" ] && CONFIG_FLAGS=(--config "$CONFIG")
+LADDER_FLAGS=(); [ "${RUNTIME_LADDER:-0}" = "1" ] && LADDER_FLAGS=(--collective-tuning runtime --collective-ladder ignition/preparation/ladders/gb202_pcie_tp3.json)
+# DCP3 is opt-in: the recipe declares 768-token context-parallel pages at three ranks only under FLARE_GLM53_DCP3=1.
+case "${DCP:-0}" in
+  0) CP_FLAGS=(--no-context-parallel); export FLARE_GLM53_DCP3=0 ;;
+  1) CP_FLAGS=(); export FLARE_GLM53_DCP3=1 ;;
+  *) echo "DCP must be 0 or 1, not ${DCP}" >&2; exit 2 ;;
+esac
+case "${MTP_ONLY:-0}" in
+  0) MTP_ONLY_FLAGS=() ;;
+  1) MTP_ONLY_FLAGS=(--mtp-only) ;;
+  *) echo "MTP_ONLY must be 0 or 1, not ${MTP_ONLY}" >&2; exit 2 ;;
+esac
+
+exec .venv/bin/ignition export "$CKPT" ${CONFIG_FLAGS[@]+"${CONFIG_FLAGS[@]}"} --gpus "${GPUS:-0,1,2}" \
+  ${CP_FLAGS[@]+"${CP_FLAGS[@]}"} --prefill-chunk-size 4096 --mtp-draft-tokens 5 \
+  --max-concurrency "${CONC:-8}" "${TEXT_ONLY[@]}" ${IMAGE_FLAGS[@]+"${IMAGE_FLAGS[@]}"} \
+  ${LADDER_FLAGS[@]+"${LADDER_FLAGS[@]}"} ${MTP_ONLY_FLAGS[@]+"${MTP_ONLY_FLAGS[@]}"} \
+  --verbose
diff --git a/tp3-tools/glm53-gpu-validate.sh b/tp3-tools/glm53-gpu-validate.sh
new file mode 100755
index 00000000..33716dc7
--- /dev/null
+++ b/tp3-tools/glm53-gpu-validate.sh
@@ -0,0 +1,86 @@
+#!/bin/bash
+# GLM 5.3 Flash TP3: the GPU validation of the padded three-rank partition as one scripted run.
+#
+#   tp3-tools/glm53-gpu-validate.sh LOGDIR
+#
+# Runs from the worktree root with its .venv. Steps run in order and the script stops at the first
+# failure; every step logs to LOGDIR/NN-name.log and prints one summary line. Steps 1-4 need one free
+# GPU (CUDA_VISIBLE_DEVICES=0); steps 5-6 need three (0,1,2) and spawn one rank process per GPU.
+# The checkpoint is the plain directory FLARE_GLM53_SNAPSHOT (default /path/to/ckpt/glm53-fp4-local,
+# revision 76348ddb); the tests skip when it is absent, so a run full of skips means the path is wrong.
+# Check the GPUs before using them (TP3-GUIDELINES C.1): the script refuses GPUs with more than
+# $BUSY_MIB (default 2000) MiB in use unless FORCE=1.
+#
+# What each step proves (CPU tests already cover the loader arithmetic; these run the kernels):
+#   1 nvidia_weights   NVIDIA checkpoint partitions at TP1/2/3/4: padded block-FP8/MXFP8/BF16 shards equal the
+#                      checkpoint rows with zero tails (rank 2 of 3 holds heads 44..65, columns 1536..2303).
+#   2 weights          NVFP4-CSF experts: packed w13/w2 columns and the expanded CSF scales; rank 2's padded
+#                      rows/columns must decode to zero (CsfSource padded_rows/padded_columns, padding_base 0),
+#                      plus the MTP layer's experts and attention; also at 704 routed columns per rank
+#                      (FLARE_GLM53_EXPERT_COLUMNS=704: ranks 0/1 exact, rank 2 holds 1408..2047 + 64 zero).
+#   3 moe_overlap      routed + shared expert graph at 768 columns on the last rank (b12x MoE kernel acceptance),
+#                      and at 704 routed / 768 shared columns ([3-704]).
+#   3b sparse_mla_heads multi-row sparse decode at 16/22/24/32 heads: inactive rows zero, rows independent
+#                      (the 22-head two-row case is where step 4 first failed; 24 is the 24/24/16 alternative).
+#   4 mla              sparse MLA replay with 22 heads on the last rank (absorb/expand BMM and sparse_mla tiling).
+#   5 kda_tp           three-rank KDA graphs with the PCIe all-reduce, prefill and decode, 22 heads per rank.
+#   6 mlp_tp           three-rank dense (4096) and shared-expert (768) MLP graphs with the PCIe all-reduce.
+set -euo pipefail
+LOGDIR=${1:?usage: glm53-gpu-validate.sh LOGDIR}
+ROOT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
+cd "$ROOT"
+mkdir -p "$LOGDIR"
+
+export PYTHONPATH="$ROOT" TORCH_EXTENSIONS_DIR="$ROOT/.brrr-ext" CUDA_HOME=/usr/local/cuda-13.1
+export PATH="/usr/local/cuda-13.1/bin:$PATH"
+# Pin every kernel cache the way `ignition export` does (ignition/cli/environment.py apply()). Tests that
+# tune then compile_forward() a planned Triton kernel need TRITON_CACHE_DIR set up front: b12x compiles the
+# planned program into Triton's cache during session.tune(), and the first Inductor kernel compiled by
+# compile_forward() otherwise points TRITON_CACHE_DIR at /tmp/torchinductor_<user>/triton/<device>
+# (torch/_inductor/runtime/triton_heuristics.py, `if os.getenv("TRITON_CACHE_DIR") is None`), so the deferred
+# load then fails with "planned Triton program has not been compiled" (glm_pool _fwht_quant_kernel, step 04).
+KERNEL_CACHE=${KERNEL_CACHE:-$HOME/.cache/flare/kernels}
+export TRITON_CACHE_DIR="$KERNEL_CACHE/triton" B12X_COMPILE_CACHE_DIR="$KERNEL_CACHE/b12x" \
+       TORCHINDUCTOR_CACHE_DIR="$KERNEL_CACHE/inductor"
+mkdir -p "$TRITON_CACHE_DIR" "$B12X_COMPILE_CACHE_DIR" "$TORCHINDUCTOR_CACHE_DIR"
+export FLARE_GLM53_SNAPSHOT=${FLARE_GLM53_SNAPSHOT:-/path/to/ckpt/glm53-fp4-local}
+export FLARE_RUN_CUDA_TESTS=1 FLARE_RUN_TP_CUDA_TESTS=1 HF_HUB_OFFLINE=1
+PYTEST="$ROOT/.venv/bin/python -m pytest -q -p no:cacheprovider -x"
+
+[ -d "$FLARE_GLM53_SNAPSHOT" ] || { echo "checkpoint directory $FLARE_GLM53_SNAPSHOT is missing" >&2; exit 2; }
+[ -f "$FLARE_GLM53_SNAPSHOT/model.safetensors.index.json" ] || \
+  echo "warning: $FLARE_GLM53_SNAPSHOT has no model.safetensors.index.json yet (download incomplete?)" >&2
+
+check_gpus() {
+  # $1 = comma-separated GPU indices; refuse GPUs another job holds.
+  local busy
+  busy=$(nvidia-smi --query-gpu=index,memory.used --format=csv,noheader,nounits -i "$1" | awk -F', ' -v limit="${BUSY_MIB:-2000}" '$2 > limit {print "GPU " $1 " uses " $2 " MiB"}')
+  if [ -n "$busy" ] && [ "${FORCE:-0}" != "1" ]; then
+    echo "GPUs are in use (set FORCE=1 to override):" >&2; echo "$busy" >&2; exit 3
+  fi
+}
+
+step() {
+  # step NN name gpus pytest-args...
+  local number=$1 name=$2 gpus=$3; shift 3
+  local log="$LOGDIR/$number-$name.log" start status summary
+  start=$(date +%s)
+  if CUDA_VISIBLE_DEVICES="$gpus" $PYTEST "$@" >"$log" 2>&1; then status=PASS; else status=FAIL; fi
+  summary=$(grep -E "^[0-9]+ (passed|failed|skipped|error)|passed|failed" "$log" | tail -1)
+  printf '%s %-16s gpus=%-5s %4ds  %s  (%s)\n' "$status" "$name" "$gpus" "$(( $(date +%s) - start ))" "${summary:-no pytest summary}" "$log"
+  [ "$status" = PASS ] || { echo "stopping at the first failure; see $log" >&2; exit 1; }
+}
+
+echo "GLM 5.3 TP3 GPU validation: logs in $LOGDIR, checkpoint $FLARE_GLM53_SNAPSHOT, worktree $ROOT"
+check_gpus 0
+step 01 nvidia_weights 0 tests/recipes/test_glm53_nvidia_weights.py
+step 02 weights        0 tests/recipes/test_glm53_weights.py -k "nvfp4_shards or mtp_experts"
+step 03 moe_overlap    0 tests/recipes/test_glm53_moe_overlap.py
+# Kernel-only check of multi-row sparse decode at 16/22/24/32 heads (inactive row zero, rows independent):
+# isolates the [3-decode-2-*] failure of step 04 from the recipe. Both steps report every case (--maxfail).
+step 03b sparse_mla_heads 0 tests/recipes/test_glm53_sparse_mla_heads_cuda.py --maxfail=50
+step 04 mla            0 tests/recipes/test_glm53_mla_cuda.py --maxfail=50
+check_gpus 0,1,2
+step 05 kda_tp         0,1,2 tests/recipes/test_glm53_kda_tp_cuda.py
+step 06 mlp_tp         0,1,2 tests/recipes/test_glm53_mlp_tp_cuda.py
+echo "all steps passed; next: tp3-tools/glm53-export-tp3.sh"
diff --git a/tp3-tools/make-b12x-overlay.sh b/tp3-tools/make-b12x-overlay.sh
new file mode 100755
index 00000000..59821e13
--- /dev/null
+++ b/tp3-tools/make-b12x-overlay.sh
@@ -0,0 +1,18 @@
+#!/bin/bash
+# Build the b12x overlay GLM exports use (B12X_OVERLAY in glm53-export-tp3.sh): a copy of the venv's (already
+# tp3-patches-patched) b12x plus tp3-patches/overlay/flashinfer-dcp-gather-pull-world3.patch, so the shared venv (also used
+# by the DS41 exports) stays unchanged. World-3 pull gather: +7-8 % GLM a16 c1/c4/c8 (2026-11-09, pkg 092215).
+#   tp3-tools/make-b12x-overlay.sh [OUT]     default OUT: <worktree>/.b12x-overlay
+set -euo pipefail
+ROOT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
+OUT=${1:-$ROOT/.b12x-overlay}
+S=$("$ROOT/.venv/bin/python" -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')
+rm -rf "$OUT"; mkdir -p "$OUT/b12x"
+cp -a "$S/flashinfer/experimental/b12x" "$OUT/b12x_tree"
+find "$OUT/b12x_tree" -name __pycache__ -prune -exec rm -rf {} +
+# Shim: the venv's b12x/__init__.py, rooted at the overlay tree.
+sed 's#^_root = Path(_flashinfer.origin).parent / "experimental" / "b12x"#_root = Path(__file__).resolve().parent.parent / "b12x_tree"#' \
+    "$S/b12x/__init__.py" > "$OUT/b12x/__init__.py"
+grep -q 'b12x_tree' "$OUT/b12x/__init__.py"
+patch -d "$OUT/b12x_tree" -p4 --forward < "$ROOT/tp3-patches/overlay/flashinfer-dcp-gather-pull-world3.patch"
+echo "overlay ready: $OUT"
diff --git a/tp3-tools/mini-export.sh b/tp3-tools/mini-export.sh
new file mode 100755
index 00000000..d29b5a3b
--- /dev/null
+++ b/tp3-tools/mini-export.sh
@@ -0,0 +1,56 @@
+#!/bin/bash
+# Mini export: export a truncated DeepSeek-V4.1-Flash checkpoint view (6 or 8 layers; no parking, no Engram) at TP3,
+# serve it, run tp3-tools/consistency.py (decode vs prefill), stop the server. About 10 minutes. It catches compile,
+# trace and wiring faults in risky kernel or wiring changes; it says nothing about speed (handbook D.2 rule 1).
+#   SNAP    truncated checkpoint view directory (required; 8-layer views carry native scales for parking/BRRR tests)
+#   LAYERS  BRRR layers, e.g. 0-5 (default: none)
+#   LABEL   label for the log directory (default: mini)
+#   OUT     log directory (default: ./mini-<label>-<MMDD-HHMM>)
+#   GPUS    default 0,1,2; PORT is fixed at 15015 (consistency.py's URL)
+#   FLARE_BIN  server binary (default: this checkout's flare-cli/target/release/flare; worktrees without a Rust build
+#              point it at the serving checkout's binary)
+# Further FLARE_DS41_* settings pass through from the environment (e.g. FLARE_DS41_FUSED_QKV_NORM=1). Run from any
+# worktree: the export imports this checkout (PYTHONPATH), and the log records which ignition it imported.
+# The GPUs must be idle: stop any server first; this script refuses to start next to one and starts none afterwards.
+set -euo pipefail
+ROOT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
+cd "$ROOT"
+: "${SNAP:?set SNAP to a truncated checkpoint view}"
+LABEL=${LABEL:-mini}
+OUT=${OUT:-$PWD/mini-$LABEL-$(date +%m%d-%H%M)}
+mkdir -p "$OUT"
+pids(){ ps -eo pid,args | awk '$2 ~ /(^|\/)flare$/ && $3=="run"{print $1}'; }
+[ -z "$(pids)" ] || { echo "a flare server is running: stop it first (export and serving cannot share the GPUs)" >&2; exit 2; }
+export PYTHONPATH="$ROOT" CUDA_HOME="${CUDA_HOME:-/usr/local/cuda-13.1}" HF_HUB_OFFLINE=1 \
+       TORCH_EXTENSIONS_DIR="$ROOT/.brrr-ext" FLARE_DS41_TP3_GRAPH_GIB=1 FLARE_DS41_TP3_VOCAB_PARALLEL=1 \
+       FLARE_DS41_MINI=1 FLARE_DS41_BRRR_LAYERS="${LAYERS:-}" FLARE_DS41_BRRR_LOG=1 FLARE_DS41_BRRR_CKPT="$SNAP"
+export PATH="$CUDA_HOME/bin:$PATH"
+.venv/bin/python -c 'import ignition; print("ignition imported from", ignition.__file__)' | tee "$OUT/export.log"
+start=$(date +%s)
+rc=0; timeout 3600 .venv/bin/ignition export "$SNAP" --gpus "${GPUS:-0,1,2}" --max-concurrency 8 \
+  --prefill-chunk-size 4096 --mtp-draft-tokens 5 --draft-head-quantization nvfp4 --markov-head-quantization fp8 \
+  --vocabulary-parallel-sampling --verbose >> "$OUT/export.log" 2>&1 || rc=$?
+echo "export exit $rc after $(( ($(date +%s) - start) / 60 )) min" | tee "$OUT/SUMMARY.txt"
+if [ "$rc" != 0 ]; then
+  tr '\r' '\n' < "$OUT/export.log" | grep -E "Error|Traceback" | grep -v "^b12x" | tail -4 | cut -c1-300 | tee -a "$OUT/SUMMARY.txt"
+  exit "$rc"
+fi
+P=$(grep -oE "[^ ]*/(packages|cores)/models/[^ ]*" "$OUT/export.log" | tail -1)
+echo "package $P" | tee -a "$OUT/SUMMARY.txt"
+"${FLARE_BIN:-$ROOT/flare-cli/target/release/flare}" run "$P" --gpus "${GPUS:-0,1,2}" --port 15015 --host 127.0.0.1 \
+  --served-model-name DeepSeek-V4.1-Flash --mtp-draft-tokens 5 > "$OUT/serve.log" 2>&1 &
+ready=0
+for _ in $(seq 1 120); do
+  sleep 5
+  curl -s -m 2 localhost:15015/v1/models | grep -q '"id"' && { ready=1; break; }
+  [ -n "$(pids)" ] || break
+done
+if [ "$ready" = 1 ]; then
+  grep -E "OK.*Allocate cache" "$OUT/serve.log" | cut -c1-120 | tee -a "$OUT/SUMMARY.txt" || true
+  .venv/bin/python tp3-tools/consistency.py 48 6 "$SNAP" | tee "$OUT/consistency.txt" | tail -3 | tee -a "$OUT/SUMMARY.txt"
+else
+  echo "server did not come up; see $OUT/serve.log" | tee -a "$OUT/SUMMARY.txt"
+fi
+for p in $(pids); do kill -INT "$p"; done
+for _ in $(seq 1 60); do [ -z "$(pids)" ] && break; sleep 3; done
+[ "$ready" = 1 ]
diff --git a/tp3-tools/mixed_bank.py b/tp3-tools/mixed_bank.py
new file mode 100644
index 00000000..1627ffbf
--- /dev/null
+++ b/tp3-tools/mixed_bank.py
@@ -0,0 +1,61 @@
+"""One expert bank in one virtual range: the first `split` experts in VRAM, the rest in pinned host memory (CUDA VMM)."""
+import torch
+from cuda.bindings import driver as d
+from b12x.sequence._shared.disk_table import _tensor_from_pointer
+
+_keep = []
+
+
+def _ok(result):
+    err = result[0] if isinstance(result, tuple) else result
+    if err != d.CUresult.CUDA_SUCCESS:
+        raise RuntimeError(f"CUDA driver error {err}")
+    return result[1] if isinstance(result, tuple) and len(result) == 2 else (result[1:] if isinstance(result, tuple) else None)
+
+
+def _prop(kind, device):
+    p = d.CUmemAllocationProp()
+    p.type = d.CUmemAllocationType.CU_MEM_ALLOCATION_TYPE_PINNED
+    p.location.type = kind
+    p.location.id = device if kind == d.CUmemLocationType.CU_MEM_LOCATION_TYPE_DEVICE else 0
+    return p
+
+
+def mixed_tensor(shape, dtype, split, device):
+    """Tensor whose rows [0, split) are device-backed and rows [split, shape[0]) host-backed."""
+    dev = torch.device(device).index
+    torch.cuda.init(); torch.empty(1, device=device)  # make the primary context current
+    row = torch.Size(shape[1:]).numel() * dtype.itemsize
+    total = shape[0] * row
+    pd = _prop(d.CUmemLocationType.CU_MEM_LOCATION_TYPE_DEVICE, dev)
+    ph = _prop(d.CUmemLocationType.CU_MEM_LOCATION_TYPE_HOST_NUMA, 0)
+    flag = d.CUmemAllocationGranularity_flags.CU_MEM_ALLOC_GRANULARITY_MINIMUM
+    gran = max(_ok(d.cuMemGetAllocationGranularity(pd, flag)), _ok(d.cuMemGetAllocationGranularity(ph, flag)))
+    up = lambda n: -(-n // gran) * gran
+    dev_bytes = up(split * row)          # the boundary page goes to the device side
+    size = up(total)
+    host_bytes = max(size - dev_bytes, 0)
+    va = _ok(d.cuMemAddressReserve(size, gran, 0, 0))
+    handles = []
+    for nbytes, prop, offset in ((dev_bytes, pd, 0), (host_bytes, ph, dev_bytes)):
+        if nbytes:
+            h = _ok(d.cuMemCreate(nbytes, prop, 0))
+            _ok(d.cuMemMap(int(va) + offset, nbytes, 0, h, 0))
+            handles.append(h)
+    access = d.CUmemAccessDesc()
+    access.location.type = d.CUmemLocationType.CU_MEM_LOCATION_TYPE_DEVICE
+    access.location.id = dev
+    access.flags = d.CUmemAccess_flags.CU_MEM_ACCESS_FLAGS_PROT_READWRITE
+    _ok(d.cuMemSetAccess(va, size, [access], 1))
+    _keep.append((va, size, handles))
+    return _tensor_from_pointer(int(va), shape=tuple(shape), dtype=dtype, device=torch.device("cuda", dev), nbytes=total)
+
+
+def allocator(split, device):
+    def host_alloc(name, shape, dtype):
+        view = mixed_tensor(shape, dtype, split, device)
+
+        class Region:
+            device_view = view
+        return Region
+    return host_alloc
diff --git a/tp3-tools/overlap_bench.py b/tp3-tools/overlap_bench.py
new file mode 100644
index 00000000..519d2fd6
--- /dev/null
+++ b/tp3-tools/overlap_bench.py
@@ -0,0 +1,152 @@
+"""Microbenchmark for TP3 hot/cold expert overlap on one parked layer.
+
+Cold experts live in real pinned, device-mapped host memory. Routes are sampled from the
+vLLM route counts. Each case is captured as a CUDA graph two ways: serial (hot then cold
+on one stream) and forked (cold on a second stream, joined before the sum).
+usage: overlap_bench.py SNAPSHOT LAYER [HOT=326]
+"""
+import json, os, sys
+import torch
+
+from b12x.preparation import PreparationSession
+from b12x.sequence._shared.disk_table import _tensor_from_pointer
+from ignition.components.moe import PreparedRoutedExperts
+from ignition.components.parallel import TensorParallelShard
+from ignition.preparation.checkpoint import inspect_indexed_checkpoint
+from ignition.recipes.deepseek41.tp3_config import TP3Config
+from ignition.recipes.deepseek41.weights import DeepSeekWeightLoader
+
+snap, L = sys.argv[1], int(sys.argv[2])
+H = int(sys.argv[3]) if len(sys.argv) > 3 else 326
+dev = torch.device("cuda", 0); torch.cuda.set_device(dev)
+shard = TensorParallelShard(0, 3)
+ffn = f"layers.{L}.ffn"
+counts_dir = os.path.expanduser("~/ds41-tp3/release/ds41-kraken-tp3-20261019/expert-order-blend")  # site-specific
+raw = json.load(open(f"{counts_dir}/expert-routes-rank0-layer{L}.json"))
+counts = raw.get("counts", raw) if isinstance(raw, dict) else raw
+if isinstance(counts, dict):
+    counts = [counts[k] for k in sorted(counts, key=int)]
+counts = torch.tensor(counts, dtype=torch.float64)
+order = torch.argsort(counts, descending=True)
+hot, cold = sorted(order[:H].tolist()), sorted(order[H:].tolist())
+pinned = []
+
+
+def host_alloc(name, shape, dtype):
+    if os.environ.get("COLD_ON_DEVICE"):
+        view = torch.empty(shape, dtype=dtype, device=dev); pinned.append(view)
+
+        class Region:
+            device_view = view
+        return Region
+    # Real mapped host memory: pinned allocation, device view at the same UVA address.
+    host = torch.empty(shape, dtype=dtype, pin_memory=True)
+    pinned.append(host)
+    view = _tensor_from_pointer(host.data_ptr(), shape=tuple(shape), dtype=dtype, device=dev, nbytes=host.nbytes)
+
+    class Region:
+        device_view = view
+    return Region
+
+
+with torch.no_grad(), DeepSeekWeightLoader(inspect_indexed_checkpoint(snap), dev, shard=shard,
+                                           expert_scale_compression="csf", prefixes=(f"{ffn}.experts.",),
+                                           tp3=TP3Config.from_environment()) as loader:
+    text = loader.config.text
+    E = text["n_routed_experts"]
+    interval = shard.partition(text["moe_intermediate_size"], alignment=32)
+    hot_bank = loader.load_experts([f"{ffn}.experts.{i}" for i in hot], interval)
+    loader._host_allocator = host_alloc
+    cold_bank = loader.load_experts([f"{ffn}.experts.{i}" for i in cold], interval, host=True)
+    sys.path.insert(0, os.path.expanduser("~/flare-tp3-tools"))
+    import mixed_bank
+    loader._host_allocator = mixed_bank.allocator(H, dev)
+    merged_bank = loader.load_experts([f"{ffn}.experts.{i}" for i in hot + cold], interval, host=True)
+    loader._host_allocator = None
+    device_bank = loader.load_experts([f"{ffn}.experts.{i}" for i in hot + cold], interval)
+hot_map = torch.full((E,), -1, dtype=torch.int32); hot_map[hot] = torch.arange(len(hot), dtype=torch.int32)
+cold_map = torch.full((E,), -1, dtype=torch.int32); cold_map[cold] = torch.arange(len(cold), dtype=torch.int32)
+perm = torch.empty(E, dtype=torch.int32); perm[torch.tensor(hot + cold)] = torch.arange(E, dtype=torch.int32)
+hot_map, cold_map, perm = hot_map.to(dev), cold_map.to(dev), perm.to(dev)
+prob = counts / counts.sum()
+print(f"layer {L}: {H} hot / {E - H} cold (host), cold route share {prob[cold].sum() * 100:.2f}%")
+
+hidden = text["hidden_size"]
+aux = torch.cuda.Stream()
+flush = torch.empty(512 << 20, dtype=torch.uint8, device=dev)
+with torch.no_grad(), PreparationSession(device=dev, autotune=False, compile_workers=0) as session:
+    for rows in (6, 24, 48):
+        x = torch.randn((rows, hidden), dtype=torch.bfloat16, device=dev)
+        ids = torch.multinomial(prob, rows * 6, replacement=True).view(rows, 6).int().to(dev)
+        w = torch.rand((rows, 6), dtype=torch.float32, device=dev)
+        hid, cid = torch.empty_like(ids), torch.empty_like(ids)
+        torch.index_select(hot_map, 0, ids.view(-1), out=hid.view(-1))
+        torch.index_select(cold_map, 0, ids.view(-1), out=cid.view(-1))
+        out_hot, out_cold, out_merged = torch.zeros_like(x), torch.zeros_like(x), torch.zeros_like(x)
+        mid = torch.empty_like(ids); torch.index_select(perm, 0, ids.view(-1), out=mid.view(-1))
+        op_hot = PreparedRoutedExperts(x, hot_bank, hid, w, out_hot, session=session, name=f"hot{rows}")
+        op_cold = PreparedRoutedExperts(x, cold_bank, cid, w, out_cold, session=session, name=f"cold{rows}")
+        op_merged = PreparedRoutedExperts(x, merged_bank, mid, w, out_merged, session=session, name=f"merged{rows}")
+        out_device = torch.zeros_like(x)
+        op_device = PreparedRoutedExperts(x, device_bank, mid, w, out_device, session=session, name=f"device{rows}")
+        n_cold = int((cid >= 0).sum()); n_cold_experts = int(torch.unique(cid[cid >= 0]).numel())
+
+        def serial():
+            op_hot(); op_cold(); out_hot.add_(out_cold)
+
+        def forked():
+            aux.wait_stream(torch.cuda.current_stream())
+            with torch.cuda.stream(aux):
+                op_cold()
+            op_hot()
+            torch.cuda.current_stream().wait_stream(aux)
+            out_hot.add_(out_cold)
+
+        def hot_only():
+            op_hot()
+
+        def merged():
+            op_merged()
+
+        results = {}
+        for label, fn in (("hot only", hot_only), ("serial", serial), ("forked", forked), ("merged", merged)):
+            for _ in range(3):
+                fn()
+            torch.cuda.synchronize()
+            g = torch.cuda.CUDAGraph()
+            s = torch.cuda.Stream()
+            s.wait_stream(torch.cuda.current_stream())
+            with torch.cuda.graph(g, stream=s):
+                fn()
+            torch.cuda.synchronize()
+            for _ in range(20):
+                g.replay()
+            # Flush the 128 MB L2 between replays (real decode streams ~40 layers through L2 between visits).
+            times = []
+            for _ in range(100):
+                flush.fill_(1)
+                start, end = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+                start.record(); g.replay(); end.record()
+                torch.cuda.synchronize(); times.append(start.elapsed_time(end) * 1000)
+            times.sort(); results[label] = times[len(times) // 2]
+        serial()
+        merged(); torch.cuda.synchronize()
+        err = float((out_merged.float() - out_hot.float()).norm() / out_hot.float().norm().clamp_min(1e-9))
+        op_device(); torch.cuda.synchronize()
+        exact = torch.equal(out_merged, out_device)
+        rel = lambda a, b: float((a.float() - b.float()).norm() / b.float().norm().clamp_min(1e-9))
+        cold_rows = (cid >= 0).any(-1)
+        print(f"    merged vs all-VRAM: {'bit-identical' if exact else 'DIFFERS'} rel {rel(out_merged, out_device):.5f}"
+              f" | all-VRAM vs serial rel {rel(out_device, out_hot):.5f}"
+              f" | rows with a cold route: merged-vs-VRAM rel {rel(out_merged[cold_rows], out_device[cold_rows]) if cold_rows.any() else float('nan'):.5f}"
+              f" | other rows {rel(out_merged[~cold_rows], out_device[~cold_rows]):.5f}")
+        first = out_device.clone(); op_device(); torch.cuda.synchronize()
+        print(f"    all-VRAM vs itself (rerun): rel {rel(out_device, first):.5f}")
+        out_device.copy_(first); out_merged.zero_()
+        for k in range(rows):   # zero all but one cold route to see whether host-backed weights contribute
+            pass
+        a = merged_bank.w13 if hasattr(merged_bank, "w13") else None
+        saved = results["serial"] - results["merged"]
+        print(f"  rows {rows:2d} ({n_cold} cold routes, {n_cold_experts} cold experts): hot only {results['hot only']:6.1f} us"
+              f" | serial {results['serial']:6.1f} us | forked {results['forked']:6.1f} us"
+              f" | merged {results['merged']:6.1f} us | merged saves {saved:5.1f} us/layer ({saved / results['serial'] * 100:4.1f}%) | rel err {err:.4f}")
diff --git a/tp3-tools/release/check_env.sh b/tp3-tools/release/check_env.sh
new file mode 100755
index 00000000..299e53dc
--- /dev/null
+++ b/tp3-tools/release/check_env.sh
@@ -0,0 +1,134 @@
+#!/bin/bash
+# Preflight for building and serving this release. Read-only: it changes nothing and starts nothing on the GPUs.
+#   usage: ./check_env.sh <fork checkout dir>    the Flare clone at BASE below (EXPORT.md step 2), before or after source.patch
+#   env:   CUDA_HOME     CUDA toolkit root (default /usr/local/cuda-13.1 if present, else the nvcc on PATH)
+#          FLARE_CACHE   where packages and the kernel tuning cache go (default ~/.cache/flare)
+#          MIN_FREE_GB   free space required on the drive holding FLARE_CACHE (default 900: checkpoints ~412 GB,
+#                        package ~380 GB, tuning cache 60-80 GB; lower it if the checkpoints live on another drive)
+#          GPUS          GPU indices you will export and serve on (default 0,1,2)
+# Prints one PASS / WARN / FAIL line per check and exits 1 if anything FAILed. WARN lines are steps not done yet.
+set -uo pipefail
+FORK=${1:?usage: check_env.sh <fork checkout dir>}
+HERE=$(dirname "$(readlink -f "$0")")
+FLARE_CACHE=${FLARE_CACHE:-$HOME/.cache/flare}; MIN_FREE_GB=${MIN_FREE_GB:-900}; GPUS=${GPUS:-0,1,2}
+# Upstream base of source.patch: Hyperflare main cbf21a12 (2026-11-10) since the ds41-tp3-sync merge; 972e28e4 before.
+BASE=${BASE:-cbf21a12d118217b8ad4e6bfa565562a90addeec}
+fails=0
+pass(){ echo "PASS  $*"; }; warn(){ echo "WARN  $*"; }; fail(){ echo "FAIL  $*"; fails=$((fails+1)); }
+vge(){ [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -1)" = "$2" ]; }   # vge A B: version A >= B
+
+# --- CUDA toolkit: 13.1+ with nvcc that targets SM120 (sm_120a). The export compiles the BRRR layer kernel with it.
+if [ -z "${CUDA_HOME:-}" ] && [ -x /usr/local/cuda-13.1/bin/nvcc ]; then CUDA_HOME=/usr/local/cuda-13.1; fi
+NVCC=${CUDA_HOME:+$CUDA_HOME/bin/nvcc}
+[ -n "$NVCC" ] && [ -x "$NVCC" ] || NVCC=$(command -v nvcc || true)
+if [ -z "$NVCC" ]; then
+  fail "nvcc not found: install CUDA 13.1 and export CUDA_HOME=/usr/local/cuda-13.1 PATH=\$CUDA_HOME/bin:\$PATH"
+else
+  v=$("$NVCC" --version | grep -oE 'release [0-9]+\.[0-9]+' | cut -d' ' -f2)
+  if vge "$v" 13.1; then pass "CUDA toolkit $v ($NVCC)"; else fail "CUDA toolkit $v at $NVCC; 13.1 or newer is required (12.x cannot target SM120)"; fi
+  if "$NVCC" --list-gpu-code 2>/dev/null | grep -q '^sm_120'; then pass "nvcc accepts sm_120 (sm_120a)"; else fail "nvcc at $NVCC does not list sm_120"; fi
+  if [ "${CUDA_HOME:-}" != "$(dirname "$(dirname "$NVCC")")" ]; then
+    warn "CUDA_HOME is not set to this toolkit; before exporting: export CUDA_HOME=$(dirname "$(dirname "$NVCC")") PATH=\$CUDA_HOME/bin:\$PATH"
+  fi
+fi
+
+# --- locked memory: Flare pins host memory (cold experts, Engram tables, prefix cache)
+if [ "$(ulimit -l)" = unlimited ]; then pass "memlock unlimited"
+else fail "ulimit -l is $(ulimit -l); add '<user> - memlock unlimited' in /etc/security/limits.d/90-memlock.conf and log in again"; fi
+
+# --- toolchain
+if command -v rustc >/dev/null; then
+  v=$(rustc --version | awk '{print $2}')
+  if vge "$v" 1.88; then pass "rustc $v (fork requires >= 1.88)"; else fail "rustc $v; the fork requires 1.88 or newer (rustup update)"; fi
+else fail "rustc not found (install rustup)"; fi
+if command -v cargo >/dev/null; then pass "cargo $(cargo --version | awk '{print $2}')"; else fail "cargo not found"; fi
+if command -v uv >/dev/null; then pass "uv $(uv --version | awk '{print $2}')"; else fail "uv not found (https://docs.astral.sh/uv/)"; fi
+if command -v patch >/dev/null; then pass "patch present (applies tp3-patches/)"; else fail "patch not found (install the patch package)"; fi
+command -v git >/dev/null || fail "git not found"
+
+# --- fork checkout and source.patch
+if ! git -C "$FORK" rev-parse --git-dir >/dev/null 2>&1; then
+  fail "$FORK is not a git checkout (EXPORT.md step 2)"
+else
+  head=$(git -C "$FORK" rev-parse HEAD)
+  if [ "$head" = "$BASE" ]; then pass "fork checkout at upstream Flare ${BASE:0:8}"
+  elif git -C "$FORK" merge-base --is-ancestor "$BASE" "$head" 2>/dev/null; then warn "fork HEAD ${head:0:8} is ahead of ${BASE:0:8} (fine if you committed source.patch on top of it)"
+  else fail "fork HEAD ${head:0:8} is not ${BASE:0:8}: git checkout $BASE (fresh clone if coming from 20261105)"; fi
+  if git -C "$FORK" apply --check --reverse "$HERE/source.patch" 2>/dev/null; then pass "source.patch applied"
+  elif git -C "$FORK" apply --check "$HERE/source.patch" 2>/dev/null; then warn "source.patch not applied yet (it applies cleanly): git -C $FORK apply $HERE/source.patch"
+  else fail "source.patch neither applied nor applicable: wrong base commit or local changes (git -C $FORK status)"; fi
+fi
+
+# --- Python environment: uv-managed Python 3.12, FlashInfer patches, ignition.runtime_patches
+VENV=$FORK/.venv
+if [ -x "$VENV/bin/python" ]; then
+  pv=$("$VENV/bin/python" -c 'import sys; print("%d.%d.%d" % sys.version_info[:3])')
+  case $pv in 3.12.*) pass "fork .venv Python $pv" ;; *) fail ".venv Python is $pv; Flare pins 3.12 (uv sync --locked --extra prepare --extra test)" ;; esac
+  SP=$("$VENV/bin/python" -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')
+  IMPL=$SP/flashinfer/experimental/b12x/moe/fused_moe/_impl.py
+  if [ ! -f "$IMPL" ]; then
+    fail "FlashInfer is not installed in .venv (uv sync --locked --extra prepare --extra test)"
+  else
+    # The swiglu patch adds a guard to the tiny_decode selection in _impl.py; without it replies corrupt mid-way at TP3.
+    if grep -q 'tiny_decode implements plain SiLU-GLU only' "$IMPL"; then pass "tiny_decode honors swiglu_limit (flashinfer-tiny-decode-swiglu.patch content present)"
+    else fail "flashinfer-tiny-decode-swiglu.patch content missing in $IMPL (replies corrupt at TP3 without it)"; fi
+    # The release folder carries its own tp3-patches/; run from the fork (tp3-tools/release/), check the fork's.
+    PATCHES=$HERE/tp3-patches; [ -d "$PATCHES" ] || PATCHES=$FORK/tp3-patches
+    for p in "$PATCHES"/*.patch; do
+      b=$(basename "$p")
+      if patch -R --dry-run -f -s -p1 -d "$SP" < "$p" >/dev/null 2>&1; then pass "$b applied"
+      elif patch --dry-run -f -s -p1 -d "$SP" < "$p" >/dev/null 2>&1; then fail "$b not applied (applies cleanly): patch -p1 -d $SP < $p"
+      else fail "$b neither applied nor applicable to the installed FlashInfer (wrong version? re-run uv sync --locked, then re-apply)"; fi
+    done
+  fi
+  # Upstream replaced `python -m ignition.patches` (on-disk edits of torch/Triton, re-run after every uv sync) with
+  # ignition.runtime_patches: version-checked in-memory fixes that ignition export applies itself. Nothing to run;
+  # check that the module is there and accepts the installed torch/Triton (it raises on a version mismatch).
+  if (cd "$FORK" && "$VENV/bin/python" -c 'from ignition import runtime_patches as r; r.apply(); print(r.identity())') >/dev/null 2>&1; then
+    pass "ignition.runtime_patches import and apply (torch Inductor and Triton fixes, in memory)"
+  else fail "ignition.runtime_patches failed to import or apply: (cd $FORK && .venv/bin/python -c 'from ignition import runtime_patches as r; r.apply()') shows why; usually uv sync --locked --extra prepare --extra test"; fi
+  if [ -x "$VENV/bin/ignition" ]; then pass "ignition CLI present"; else warn ".venv/bin/ignition missing (uv sync --locked --extra prepare --extra test)"; fi
+  if [ -x "$VENV/bin/ninja" ]; then pass "ninja present (BRRR kernel compile)"; else warn ".venv/bin/ninja missing; the BRRR kernel compile needs it (uv sync --locked --extra prepare --extra test)"; fi
+  tv=$("$VENV/bin/python" -c 'import importlib.metadata as m; print(m.version("torch"))' 2>/dev/null || echo missing)
+  fv=$("$VENV/bin/python" -c 'import importlib.metadata as m; print(m.version("flashinfer-python"))' 2>/dev/null || echo missing)
+  cv=$("$VENV/bin/python" -c 'import importlib.metadata as m; print(m.version("nvidia-cutlass-dsl"))' 2>/dev/null || echo missing)
+  echo "      torch $tv, flashinfer-python $fv, nvidia-cutlass-dsl $cv (release: 2.14.1+cu132, 0.7.3, 4.8.1; see versions.txt). A cu132 torch wheel next to the"
+  echo "      13.1 toolkit is expected: the wheel ships its own CUDA libraries, nvcc 13.1 only compiles the BRRR kernel."
+else
+  warn "no .venv in $FORK yet: uv sync --locked --extra prepare --extra test, then the FlashInfer patches (EXPORT.md step 2); re-run this check afterwards"
+fi
+# The flare binary moved to flare-cli/ upstream (flare/ is now the shared library crate).
+if [ -x "$FORK/flare-cli/target/release/flare" ]; then pass "flare binary built: $FORK/flare-cli/target/release/flare"
+else warn "flare binary not built yet: cargo build --locked --release --manifest-path $FORK/flare-cli/Cargo.toml"; fi
+
+# --- disk
+d=$FLARE_CACHE; while [ ! -d "$d" ]; do d=$(dirname "$d"); done
+free=$(df -BG --output=avail "$d" | tail -1 | tr -dc 0-9)
+if [ "$free" -ge "$MIN_FREE_GB" ]; then pass "$free GB free on the drive holding $FLARE_CACHE (need $MIN_FREE_GB)"
+else fail "$free GB free on the drive holding $FLARE_CACHE; $MIN_FREE_GB GB needed (set MIN_FREE_GB if the checkpoints are on another drive)"; fi
+
+# --- GPUs: 3 visible SM120 cards, idle. Kernel tuning captures the power limit and clocks in effect during the export.
+if ! command -v nvidia-smi >/dev/null; then
+  fail "nvidia-smi not found (NVIDIA driver 615.71.09 or any driver supporting CUDA 13.1)"
+else
+  drv=$(nvidia-smi --query-gpu=driver_version --format=csv,noheader | head -1 | tr -d ' ')
+  n=0; bad=0
+  IFS=, read -ra want <<< "$GPUS"
+  while IFS=, read -r idx name cc used plim smmax memmax; do
+    idx=${idx// /}; cc=${cc// /}; used=${used// /}; plim=${plim// /}; smmax=${smmax// /}; memmax=${memmax// /}; name=${name# }
+    for w in "${want[@]}"; do
+      [ "$w" = "$idx" ] || continue
+      n=$((n+1))
+      [ "$cc" = "12.0" ] || { fail "GPU $idx: compute capability $cc, need 12.0 (SM120, RTX PRO 6000 Blackwell)"; bad=1; }
+      [ "$used" -lt 1024 ] || { fail "GPU $idx: $used MiB in use; stop the server and other GPU processes before exporting"; bad=1; }
+      echo "      GPU $idx: $name · power limit $plim W · max clocks SM $smmax MHz, memory $memmax MHz · $used MiB used"
+    done
+  done < <(nvidia-smi --query-gpu=index,name,compute_cap,memory.used,power.limit,clocks.max.sm,clocks.max.memory --format=csv,noheader,nounits)
+  if [ "$n" -ne 3 ]; then fail "$n of the GPUs in GPUS=$GPUS are visible; this release needs exactly 3"
+  elif [ "$bad" = 0 ]; then pass "3 SM120 GPUs ($GPUS) visible and idle, driver $drv"; fi
+  echo "      Export with the power limit and clock offsets you will serve with: the tuning cache records kernels measured"
+  echo "      at those settings. The release numbers were taken at 450 W, +75 MHz core, +6000 MHz memory offset; 350 W is 10-14% slower."
+fi
+
+echo
+if [ "$fails" = 0 ]; then echo "All checks passed."; else echo "$fails check(s) FAILED."; exit 1; fi
