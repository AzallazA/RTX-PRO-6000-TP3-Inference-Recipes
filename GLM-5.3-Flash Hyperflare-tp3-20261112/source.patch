new file mode 100755
index 00000000..866daf71
--- /dev/null
+++ b/tp3-tools/release/serve.sh
@@ -0,0 +1,22 @@
+#!/bin/bash
+# Serve the exported package on 3 GPUs with both Engram tables in host RAM (~97 GiB).
+#   FLARE         path to this fork's flare binary   (default: flare-cli/target/release/flare in the fork checkout)
+#   PACKAGE       model name (= the checkpoint directory name the package was exported from) or a package path
+#                 (default ds41-1017-engram-mxfp4 = the view name in EXPORT.md; Flare picks its default version)
+#   ENGRAM_RAM=0  read the Engram tables from disk instead: ~90 GiB less host RAM, decode ~4% slower, prefill unchanged
+#   PREFIX_CACHE  host RAM for reusable prompt KV (default 16G; 32G/48G cost only RAM)
+#   BUDGET        max verification rows per step (default 24; 128 = no cap, ~1-2% slower at c8)
+#   DRAFTS        DSpark drafts (default 5); must equal the DRAFTS the package was exported with
+#   ALPHA         adaptive-verification alpha (default 0.8; 0.6 and 1.0 measured within noise)
+#   SCHEDULER     scheduler policy (default balanced; throughput measured within ~2%)
+#   GPUS, PORT, HOST   default 0,1,2 / 15015 / 127.0.0.1
+set -euo pipefail
+FLARE=${FLARE:-flare-cli/target/release/flare}
+PACKAGE=${PACKAGE:-ds41-1017-engram-mxfp4}
+ENV=() STORAGE=()
+if [ "${ENGRAM_RAM:-1}" = 1 ]; then ENV=(FLARE_ENGRAM_RAM_TABLES=0); else STORAGE=(--embedding-table-storage disk); fi
+# /usr/bin/env explicitly: some shells put another `env` (for example uv's) first on PATH.
+exec /usr/bin/env "${ENV[@]}" "$FLARE" run "$PACKAGE" --gpus "${GPUS:-0,1,2}" --port "${PORT:-15015}" \
+  --host "${HOST:-127.0.0.1}" --served-model-name DeepSeek-V4.1-Flash --prefix-cache-memory "${PREFIX_CACHE:-16G}" \
+  --mtp-draft-tokens "${DRAFTS:-5}" --mtp-adaptive-verification --mtp-max-verification-token-budget "${BUDGET:-24}" \
+  --mtp-adaptive-verification-alpha "${ALPHA:-0.8}" --scheduler-policy "${SCHEDULER:-balanced}" "${STORAGE[@]}"
diff --git a/tp3-tools/spec_metrics.py b/tp3-tools/spec_metrics.py
new file mode 100644
index 00000000..c28e0380
--- /dev/null
+++ b/tp3-tools/spec_metrics.py
@@ -0,0 +1,28 @@
+"""Snapshot/diff Helios speculative metrics: per (batch,width) rounds, GPU ms/round, tokens/round, and GPU busy share.
+usage: spec_metrics.py snap OUT.json | spec_metrics.py diff A.json B.json"""
+import json, re, sys, time, urllib.request
+NAMES = ("rounds", "gpu_nanoseconds", "emitted_tokens", "accepted_drafts", "offered_drafts")
+
+def snap():
+    text = urllib.request.urlopen("http://127.0.0.1:15015/metrics", timeout=10).read().decode()
+    out = {"t": time.time(), "m": {}}
+    for line in text.splitlines():
+        m = re.match(r'flare_speculative_(\w+)_total\{batch="(\d+)",width="(\d+)"\} (\S+)', line)
+        if m and m[1] in NAMES:
+            out["m"].setdefault(f"{m[2]},{m[3]}", {})[m[1]] = float(m[4])
+    return out
+
+if sys.argv[1] == "snap":
+    json.dump(snap(), open(sys.argv[2], "w"))
+else:
+    a, b = (json.load(open(p)) for p in sys.argv[2:4])
+    wall = b["t"] - a["t"]; gpu_total = 0
+    print(f"wall {wall:.1f} s")
+    print(f"{'batch,width':>11} {'rounds':>8} {'GPU ms/round':>12} {'tok/round':>9} {'accept':>6}")
+    for k in sorted(b["m"], key=lambda s: tuple(map(int, s.split(",")))):
+        d = {n: b["m"][k].get(n, 0) - a["m"].get(k, {}).get(n, 0) for n in NAMES}
+        if d["rounds"] <= 0: continue
+        gpu_total += d["gpu_nanoseconds"]
+        acc = d["accepted_drafts"] / d["offered_drafts"] if d["offered_drafts"] else 0
+        print(f"{k:>11} {d['rounds']:8.0f} {d['gpu_nanoseconds']/d['rounds']/1e6:12.3f} {d['emitted_tokens']/d['rounds']:9.2f} {acc:6.2f}")
+    print(f"GPU busy (speculative) {gpu_total/1e9:.1f} s of {wall:.1f} s wall = {gpu_total/1e9/wall*100:.0f}%")
