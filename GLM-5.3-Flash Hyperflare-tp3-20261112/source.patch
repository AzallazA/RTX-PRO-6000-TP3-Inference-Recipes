diff --git a/ignition/recipes/deepseek41/fused_qkv_norm.py b/ignition/recipes/deepseek41/fused_qkv_norm.py
new file mode 100644
index 00000000..35dc7476
--- /dev/null
+++ b/ignition/recipes/deepseek41/fused_qkv_norm.py
@@ -0,0 +1,134 @@
+# SPDX-License-Identifier: Apache-2.0
+"""TP3: qkv_a's 4-way split-K reduction fused into the MLA norm + MXFP8 encode (TP3Config.fused_qkv_norm).
+
+MEASURED 2026-11-07: bit-identical output, no speed gain (alternating A/B level with the stock kernels) -> NOT adopted;
+kept opt-in for reference. Not part of any published build.
+
+b12x reduces qkv_a's four FP32 K partials in its own kernel, writes the BF16 sum, and mla_norm_mxfp8 then reads it
+back. Here the dense GEMM leaves the partials in its split-K workspace (b12x DEFERRED_SPLIT_K) and one kernel sums
+them, rounds the sum to BF16 exactly as the reduce kernel stores it, and runs mla_norm_mxfp8's arithmetic on it:
+bit-identical outputs, one launch and one round trip fewer per layer. Graph widths whose GEMM did not choose 4-way
+split-K keep the stock norm kernel.
+"""
+
+import torch
+import triton
+import triton.language as tl
+from b12x.gemm.blockscaled._quantize import _scale_offset
+
+
+@triton.jit
+def _split4_mla_norm_mxfp8(P, TOTAL, QW, KW, QBF, KV, Q8, ROWS, S,
+                           Q_FEATURES: tl.constexpr, KV_FEATURES: tl.constexpr, EPSILON: tl.constexpr,
+                           MIN_AMAX: tl.constexpr):
+    row = tl.program_id(0).to(tl.int64)
+    task = tl.program_id(1)
+    total = TOTAL.to(tl.int64)
+    width: tl.constexpr = Q_FEATURES + KV_FEATURES
+    if task == 0:
+        c = tl.arange(0, 2048)
+        m = c < Q_FEATURES
+        w = tl.load(QW + c, m, 0).to(tl.float32)
+        qp = P + row * width + c
+        s = tl.load(qp, m, 0.0) + tl.load(qp + total, m, 0.0)
+        s += tl.load(qp + 2 * total, m, 0.0)
+        s += tl.load(qp + 3 * total, m, 0.0)
+        x = s.to(tl.bfloat16).to(tl.float32)
+        variance = tl.sum(x * x, 0) / Q_FEATURES
+        y = (x * tl.rsqrt(variance + EPSILON) * w).to(QBF.dtype.element_ty)
+        tl.store(QBF + row * Q_FEATURES + c, y, m)
+        grouped = tl.reshape(y.to(tl.float32), (64, 32))
+        amax = tl.maximum(tl.max(tl.abs(grouped), 1), MIN_AMAX)
+        bits = (amax * (1.0 / 448.0)).to(tl.uint32, bitcast=True)
+        exponent = ((bits >> 23) & 255).to(tl.int32) - 127 + ((bits & 0x7FFFFF) != 0).to(tl.int32)
+        scale = ((exponent + 127).to(tl.uint32) << 23).to(tl.float32, bitcast=True)
+        quant = tl.minimum(tl.maximum(tl.div_rn(grouped, scale[:, None]), -448.0), 448.0).to(tl.float8e4nv)
+        tl.store(Q8 + row * Q_FEATURES + c, tl.reshape(quant, (2048,)), m)
+        group = tl.arange(0, 64)
+        byte = (exponent + 127).to(tl.uint8)
+        groups: tl.constexpr = Q_FEATURES // 32
+        tl.store(ROWS + row * groups + group, byte, group < groups)
+        tl.store(S + _scale_offset(row, group, groups), byte, group < groups)
+    else:
+        kc = tl.arange(0, 512)
+        kw = tl.load(KW + kc).to(tl.float32)
+        kp = P + row * width + Q_FEATURES + kc
+        ks = tl.load(kp) + tl.load(kp + total)
+        ks += tl.load(kp + 2 * total)
+        ks += tl.load(kp + 3 * total)
+        kx = ks.to(tl.bfloat16).to(tl.float32)
+        ky = kx * tl.rsqrt(tl.sum(kx * kx, 0) / KV_FEATURES + EPSILON) * kw
+        tl.store(KV + row * KV_FEATURES + kc, ky)
+
+
+def launch_split4(partials, qw, kw, query, kv, values, rows_base, mma_base, *, eps, min_amax=1e-4):
+    _, m, n = partials.shape
+    _split4_mla_norm_mxfp8[(m, 2, 1)](partials, m * n, qw, kw, query, kv, values, rows_base, mma_base,
+                                       Q_FEATURES=1280, KV_FEATURES=512, EPSILON=eps, MIN_AMAX=min_amax)
+
+
+_SEEN = set()
+
+
+def _log(kind, rows):
+    if (kind, rows) not in _SEEN:
+        _SEEN.add((kind, rows))
+        print(f"[fused_qkv_norm] {kind} norm at {rows} rows", flush=True)
+
+
+@torch.library.custom_op("flare::fused_qkv_norm_arm", mutates_args=("projected",))
+def fused_qkv_norm_arm(projected: torch.Tensor) -> None:
+    """Arms the deferral for the qkv_a GEMM that follows in this graph: runs at capture, right before the GEMM, so
+    the key is live only between this op and the consumer below (never while another graph executes)."""
+    from b12x._lib.dense_gemm.preparation import DEFERRED_SPLIT_K
+
+    DEFERRED_SPLIT_K[projected.data_ptr()] = None
+
+
+@fused_qkv_norm_arm.register_fake
+def _fake_fused_qkv_norm_arm(projected):
+    pass
+
+
+@torch.library.custom_op("flare::fused_qkv_norm",
+                         mutates_args=("query", "kv", "values_base", "scale_rows_base", "scale_mma_base"))
+def fused_qkv_norm(projected: torch.Tensor, qw: torch.Tensor, kw: torch.Tensor, query: torch.Tensor, kv: torch.Tensor,
+                   values_base: torch.Tensor, scale_rows_base: torch.Tensor, scale_mma_base: torch.Tensor,
+                   norm_handle: int, eps: float, log: bool) -> None:
+    from b12x._lib.dense_gemm.preparation import DEFERRED_SPLIT_K
+
+    deferred = DEFERRED_SPLIT_K.pop(projected.data_ptr(), None)  # disarm: the key dies with this consumer
+    if deferred is not None:
+        partials, m, n = deferred
+        if m != projected.shape[0] or n != projected.shape[1]:
+            raise ValueError("deferred qkv_a partials do not match the projected rows")
+        launch_split4(partials, qw, kw, query, kv, values_base, scale_rows_base, scale_mma_base, eps=eps)
+        if log:
+            _log("fused", m)
+    else:
+        if log:
+            _log("stock", projected.shape[0])
+        torch.ops.b12x.mla_norm_mxfp8_prepared(projected, qw, kw, query, kv, values_base, scale_rows_base,
+                                               scale_mma_base, norm_handle)
+
+
+@fused_qkv_norm.register_fake
+def _fake_fused_qkv_norm(projected, qw, kw, query, kv, values_base, scale_rows_base, scale_mma_base, norm_handle, eps, log):
+    pass
+
+
+class PreparedFusedQKVNorm:
+    """Replaces norm_quant(s.projected) after qkv_a: `arm()` goes right before the qkv_a projection, `__call__` right
+    where the stock norm ran. Both are custom ops, so the arm/consume window is baked into each graph."""
+
+    def __init__(self, norm_quant, eps, *, log=False):
+        """``log`` (TP3Config.brrr_log) prints which norm each graph width selected."""
+        self.norm_quant, self.eps, self.log = norm_quant, eps, bool(log)
+
+    def arm(self, projected):
+        fused_qkv_norm_arm(projected)
+
+    def __call__(self, projected):
+        nq = self.norm_quant
+        fused_qkv_norm(projected, *nq.weights, nq.query, nq.kv, *nq.encoded_bases, nq.plan.handle, self.eps, self.log)
+        return nq.query, nq.kv
diff --git a/ignition/recipes/deepseek41/probe.py b/ignition/recipes/deepseek41/probe.py
new file mode 100644
index 00000000..fde521d2
--- /dev/null
+++ b/ignition/recipes/deepseek41/probe.py
@@ -0,0 +1,183 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Debug-only per-layer residual probes for the DeepSeek decode-corruption hunt (flare#193).
+
+Enabled by TP3Config.probe (FLARE_DS41_PROBE=1; debug-serve only, never export with it); the decoder owns a
+``Probe`` and every layer records through it. Each captured forward records
+four statistics (sum, sum of squares, max |x|, first element) per probed tensor:
+
+  * decode graphs: row 0, into a ring buffer indexed by a device-side decode step counter;
+  * prefill graphs: every row, into a prefill table (overwritten by each prefill chunk).
+
+Rank 0 dumps the buffers to /tmp/flare_probe.pt whenever /tmp/flare_probe_req exists.
+"""
+
+import os
+import threading
+import time
+
+import torch
+
+RING, LAYERS, STAGES, PREFILL_ROWS = 512, 40, 6, 4096
+FULL_LAYERS = (37, 38, 39)  # full-row captures of the MoE input and routed output (bf16)
+_STATE = {}
+
+
+def _state(device):
+    key = torch.device(device).index
+    if key not in _STATE:
+        state = {
+            "ring": torch.zeros((RING, LAYERS, STAGES, 4), dtype=torch.float32, device=device),
+            "counter": torch.zeros((1,), dtype=torch.int64, device=device),
+            "prefill": torch.zeros((PREFILL_ROWS, LAYERS, STAGES, 4), dtype=torch.float32, device=device),
+            "prefill_rows": torch.zeros((1,), dtype=torch.int64, device=device),
+            "ring_pos": torch.full((RING,), -1, dtype=torch.int64, device=device),
+            "prefill_pos": torch.full((PREFILL_ROWS,), -1, dtype=torch.int64, device=device),
+            "ring_ids": torch.full((RING, LAYERS, 6), -1, dtype=torch.int32, device=device),
+            "ring_w": torch.zeros((RING, LAYERS, 6), dtype=torch.float32, device=device),
+            "prefill_ids": torch.full((PREFILL_ROWS, LAYERS, 6), -1, dtype=torch.int32, device=device),
+            "prefill_w": torch.zeros((PREFILL_ROWS, LAYERS, 6), dtype=torch.float32, device=device),
+            "ring_in": torch.zeros((RING, len(FULL_LAYERS), 5120), dtype=torch.bfloat16, device=device),
+            "ring_out": torch.zeros((RING, len(FULL_LAYERS), 5120), dtype=torch.bfloat16, device=device),
+            "prefill_in": torch.zeros((PREFILL_ROWS, len(FULL_LAYERS), 5120), dtype=torch.bfloat16, device=device),
+            "prefill_out": torch.zeros((PREFILL_ROWS, len(FULL_LAYERS), 5120), dtype=torch.bfloat16, device=device),
+        }
+        _STATE[key] = state
+        if key == 0:
+            threading.Thread(target=_dumper, args=(state,), daemon=True).start()
+    return _STATE[key]
+
+
+def _dumper(state):
+    while True:
+        if os.path.exists("/tmp/flare_probe_req"):
+            try:
+                torch.save({name: value.detach().cpu() for name, value in state.items()}, "/tmp/flare_probe.pt.tmp")
+                os.replace("/tmp/flare_probe.pt.tmp", "/tmp/flare_probe.pt")
+            finally:
+                os.remove("/tmp/flare_probe_req")
+        time.sleep(0.2)
+
+
+@torch.library.custom_op("flare_debug::probe_step", mutates_args=("counter",))
+def _probe_step(counter: torch.Tensor) -> None:
+    counter.add_(1)
+
+
+@_probe_step.register_fake
+def _probe_step_fake(counter):
+    pass
+
+
+@torch.library.custom_op("flare_debug::probe_record", mutates_args=("ring", "prefill", "prefill_rows"))
+def _probe_record(value: torch.Tensor, ring: torch.Tensor, prefill: torch.Tensor, prefill_rows: torch.Tensor,
+                  counter: torch.Tensor, layer: int, stage: int, decode: bool) -> None:
+    rows = value.shape[0]
+    flat = value.reshape(rows, -1).float()
+    stats = torch.stack((flat.sum(1), (flat * flat).sum(1), flat.abs().amax(1), flat[:, 0]), dim=1)
+    if decode:
+        slot = torch.remainder(counter, RING)
+        ring[:, layer, stage].index_copy_(0, slot, stats[:1])
+    else:
+        count = min(rows, PREFILL_ROWS)
+        prefill[:count, layer, stage].copy_(stats[:count])
+        prefill_rows.fill_(rows)
+
+
+@_probe_record.register_fake
+def _probe_record_fake(value, ring, prefill, prefill_rows, counter, layer, stage, decode):
+    pass
+
+
+@torch.library.custom_op("flare_debug::probe_positions", mutates_args=("ring_pos", "prefill_pos"))
+def _probe_positions(positions: torch.Tensor, ring_pos: torch.Tensor, prefill_pos: torch.Tensor,
+                     counter: torch.Tensor, decode: bool) -> None:
+    if decode:
+        ring_pos.index_copy_(0, torch.remainder(counter, RING), positions[:1].long())
+    else:
+        count = min(positions.shape[0], PREFILL_ROWS)
+        prefill_pos[:count].copy_(positions[:count].long())
+
+
+@_probe_positions.register_fake
+def _probe_positions_fake(positions, ring_pos, prefill_pos, counter, decode):
+    pass
+
+
+
+
+@torch.library.custom_op("flare_debug::probe_router",
+                         mutates_args=("ring_ids", "ring_w", "prefill_ids", "prefill_w"))
+def _probe_router(ids: torch.Tensor, weights: torch.Tensor, ring_ids: torch.Tensor, ring_w: torch.Tensor,
+                  prefill_ids: torch.Tensor, prefill_w: torch.Tensor, counter: torch.Tensor, layer: int,
+                  decode: bool) -> None:
+    if decode:
+        slot = torch.remainder(counter, RING)
+        ring_ids[:, layer].index_copy_(0, slot, ids[:1].int())
+        ring_w[:, layer].index_copy_(0, slot, weights[:1].float())
+    else:
+        count = min(ids.shape[0], PREFILL_ROWS)
+        prefill_ids[:count, layer].copy_(ids[:count].int())
+        prefill_w[:count, layer].copy_(weights[:count].float())
+
+
+@_probe_router.register_fake
+def _probe_router_fake(ids, weights, ring_ids, ring_w, prefill_ids, prefill_w, counter, layer, decode):
+    pass
+
+
+
+
+@torch.library.custom_op("flare_debug::probe_full", mutates_args=("ring", "prefill"))
+def _probe_full(value: torch.Tensor, ring: torch.Tensor, prefill: torch.Tensor, counter: torch.Tensor,
+                index: int, decode: bool) -> None:
+    rows = value.reshape(value.shape[0], -1)
+    if decode:
+        ring[:, index].index_copy_(0, torch.remainder(counter, RING), rows[:1].to(ring.dtype))
+    else:
+        count = min(rows.shape[0], PREFILL_ROWS)
+        prefill[:count, index].copy_(rows[:count].to(prefill.dtype))
+
+
+@_probe_full.register_fake
+def _probe_full_fake(value, ring, prefill, counter, index, decode):
+    pass
+
+
+class Probe:
+    """Recording entry points; every method is a no-op unless ``enabled`` (one instance per prepared decoder)."""
+
+    def __init__(self, enabled=False):
+        self.enabled = bool(enabled)
+
+    def allocate(self, device):
+        """Allocate the device state eagerly, outside traced forwards."""
+        if self.enabled:
+            _state(device)
+
+    def positions(self, value, mode):
+        if self.enabled and mode in ("decode", "prefill"):
+            state = _state(value.device)
+            _probe_positions(value.reshape(-1), state["ring_pos"], state["prefill_pos"], state["counter"], mode == "decode")
+
+    def router(self, ids, weights, layer, mode):
+        if self.enabled and mode in ("decode", "prefill") and ids.shape[-1] == 6:
+            state = _state(ids.device)
+            _probe_router(ids, weights, state["ring_ids"], state["ring_w"], state["prefill_ids"], state["prefill_w"],
+                          state["counter"], layer, mode == "decode")
+
+    def full(self, value, layer, kind, mode):
+        if (self.enabled and mode in ("decode", "prefill") and layer in FULL_LAYERS
+                and value.reshape(value.shape[0], -1).shape[1] == 5120):
+            state = _state(value.device)
+            _probe_full(value, state["ring_" + kind], state["prefill_" + kind], state["counter"],
+                        FULL_LAYERS.index(layer), mode == "decode")
+
+    def step(self, device, mode):
+        if self.enabled and mode == "decode":
+            _probe_step(_state(device)["counter"])
+
+    def record(self, value, layer, stage, mode):
+        if self.enabled and mode in ("decode", "prefill"):
+            state = _state(value.device)
+            _probe_record(value, state["ring"], state["prefill"], state["prefill_rows"], state["counter"],
+                          layer, stage, mode == "decode")
