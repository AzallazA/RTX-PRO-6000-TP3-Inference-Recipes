+    }
+    let finished: Vec<_> = s.slots.iter().filter_map(|slot| slot.request.as_ref())
+        .filter(|r| r.phase == RequestPhase::Finishing && r.pending == 0).map(|r| r.handle).collect();
+    for h in finished {
+        s.finish(h).unwrap();
+    }
+    plan
+}
