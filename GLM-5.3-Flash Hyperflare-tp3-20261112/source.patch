+    codes = (torch.bucketize(quantized.abs(), bounds) | ((quantized < 0).long() << 3)).to(torch.uint8)
+    codes = codes.view(-1, columns)
+    return codes[:, 0::2] | (codes[:, 1::2] << 4), scale.view(-1, columns // 16)
