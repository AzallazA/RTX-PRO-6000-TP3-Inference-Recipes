+        if slice.digest()? != id {
+            return Err(invalid(format!(
+                "payload {label} bytes do not match the assigned identity"
+            )));
+        }
+        Ok(())
+    })();
+    if result.is_err() {
+        let _ = std::fs::remove_file(to);
+    }
+    result.map(|()| true)
+}
