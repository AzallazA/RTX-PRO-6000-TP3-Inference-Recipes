+
+@brrr_sparse_decode.register_fake
+def _fake_brrr_sparse_decode(q, out, swa, swa_page, swa_indices, swa_lengths, idx, idx_page, idx_logical,
+                             idx_lengths, idx_table, sink, scale, partial, stats, counters):
