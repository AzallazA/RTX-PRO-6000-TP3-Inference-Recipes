+"""Append a Helios speculative-metrics snapshot every 2 s to a JSONL file (for steps/s per bench cell)."""
+import json, sys, time, urllib.request, re
+out = open(sys.argv[1], "a")
+while True:
+    try:
+        text = urllib.request.urlopen("http://127.0.0.1:15015/metrics", timeout=5).read().decode()
+        m = {}
+        for line in text.splitlines():
+            r = re.match(r'flare_speculative_(rounds|emitted_tokens|gpu_nanoseconds)_total\{batch="(\d+)",width="(\d+)"\} (\S+)', line)
+            if r: m.setdefault(r[2], {}).setdefault(r[1], 0.0); m[r[2]][r[1]] += float(r[4])
+        out.write(json.dumps({"t": time.time(), "m": m}) + "\n"); out.flush()
+    except Exception:
+        out.write(json.dumps({"t": time.time(), "m": None}) + "\n"); out.flush()
+    time.sleep(2)
diff --git a/tp3-tools/test_flare_sparse_decode.py b/tp3-tools/test_flare_sparse_decode.py
new file mode 100644
index 00000000..52756e28
--- /dev/null
+++ b/tp3-tools/test_flare_sparse_decode.py
@@ -0,0 +1,88 @@
+"""Standalone check: BRRR flare_sparse_decode vs b12x's pure-torch compressed sparse MLA reference.
+
+Random DeepSeek-V4.1 window (528 B) and indexed (288 B) caches packed with b12x's reference encoder, random per-row
+window slots and logical indexed positions mapped through a random page table, partial lengths and -1 holes.
+Prints max/mean relative error per case; bf16 rounding of P and the output bounds it around 1e-2.
+"""
+import sys
+from pathlib import Path
+
+import torch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from brrr.cuext import extension  # noqa: E402
+from b12x.attention._shared.mla.compressed_reference import (  # noqa: E402
+    compressed_sparse_mla_reference, pack_deepseek_v41_cache_reference)
+
+ext = extension("flare_sparse_decode")
+dev = torch.device("cuda", int(sys.argv[1]) if len(sys.argv) > 1 else 0)
+torch.manual_seed(0)
+H, D = ext.H, ext.D
+
+
+def case(rows, swa_page, idx_page, idx_width, swa_tokens=2048, idx_tokens=4096, table_width=64, holes=False):
+    swa_kv = torch.randn(swa_tokens, D, device=dev) * 0.5
+    idx_kv = torch.randn(idx_tokens, D, device=dev) * 0.5
+    swa = pack_deepseek_v41_cache_reference(swa_kv, page_size=swa_page, cache_kind="swa")
+    idx = pack_deepseek_v41_cache_reference(idx_kv, page_size=idx_page, cache_kind="indexed") if idx_width else None
+    q = (torch.randn(rows, H, D, device=dev) * 0.3).bfloat16()
+    sink = torch.randn(H, device=dev)
+    swa_idx = torch.randint(0, swa.shape[0] * swa_page, (rows, 128), device=dev, dtype=torch.int32)
+    swa_len = torch.randint(0, 129, (rows,), device=dev, dtype=torch.int32)
+    if rows > 2:
+        swa_len[1] = 0  # window-less row
+    if holes:
+        swa_idx[torch.rand(rows, 128, device=dev) < 0.05] = -1
+    args = dict(swa_idx=swa_idx, swa_len=swa_len)
+    if idx_width:
+        pages = idx.shape[0]
+        table = torch.randint(0, pages, (rows, table_width), device=dev, dtype=torch.int32)
+        logical = torch.randint(0, table_width * idx_page, (rows, idx_width), device=dev, dtype=torch.int32)
+        idx_len = torch.randint(0, idx_width + 1, (rows,), device=dev, dtype=torch.int32)
+        if rows > 2:
+            idx_len[1] = 0  # row 1 attends to nothing but the sink
+        if holes:
+            logical[torch.rand(rows, idx_width, device=dev) < 0.05] = -1
+        mapped = torch.where(logical >= 0, table.gather(1, (logical.clamp_min(0) // idx_page).long()) * idx_page
+                             + logical.clamp_min(0) % idx_page, -1).int()
+        mapped[torch.arange(idx_width, device=dev)[None, :] >= idx_len[:, None]] = -1
+    scale = D ** -0.5
+    out = torch.empty_like(q)
+    partial = torch.empty(rows * ext.CL * H * D, device=dev)
+    stats = torch.empty(rows * ext.CL * H * 2, device=dev)
+    counters = torch.zeros(rows, device=dev, dtype=torch.int32)
+    for _ in range(2):  # second launch checks the self-reset counters
+        ext.decode(q, out, swa, swa_page, swa_idx, swa_len, idx, idx_page,
+                   logical if idx_width else None, idx_len if idx_width else None, table if idx_width else None,
+                   sink, scale, partial, stats, counters)
+    torch.cuda.synchronize(dev)
+    # The reference treats the length as a valid PREFIX and stops at the first -1; the kernel (like b12x's production
+    # page-mapping kernel) skips invalid entries wherever they are. Compact each row's valid keys to the front so both
+    # see the same key set.
+    def compact(indices, lengths):
+        out = torch.full_like(indices, -1)
+        for r in range(indices.shape[0]):
+            valid = indices[r, :int(lengths[r])]
+            valid = valid[valid >= 0]
+            out[r, :valid.numel()] = valid
+        return out
+    ref_swa = compact(swa_idx, swa_len)
+    kw = {}
+    if idx_width:
+        kw = dict(extra_k_cache=idx, extra_indices=compact(mapped, torch.full((rows,), idx_width, device=dev)),
+                  extra_topk_lengths=torch.full((rows,), idx_width, device=dev, dtype=torch.int32), extra_page_size=idx_page)
+    ref = compressed_sparse_mla_reference(q, swa, ref_swa, torch.full((rows,), 128, device=dev, dtype=torch.int32),
+        sm_scale=scale, attn_sink=sink, swa_page_size=swa_page, cache_format="deepseek_v41", **kw)
+    ref = ref[0] if isinstance(ref, tuple) else ref
+    err = (out.float() - ref.float()).abs()
+    rel = err.max().item() / ref.float().abs().max().item()
+    cos = torch.nn.functional.cosine_similarity(out.float().flatten(), ref.float().flatten(), dim=0).item()
+    print(f"rows {rows:2d} swa_page {swa_page} idx_page {idx_page} idx_width {idx_width}: max rel err {rel:.2e}, cosine {cos:.6f}")
+    return cos
+
+
+cases = [(1, 128, 32, 512, False), (6, 128, 32, 512, False), (24, 128, 32, 512, False), (48, 134, 32, 512, False),
+         (6, 128, 1, 512, False), (6, 128, 32, 0, False), (8, 128, 64, 512, False),
+         (6, 128, 32, 512, True), (24, 128, 32, 512, True), (64, 134, 32, 512, True)]  # -1 holes mid-row; 64 = capacity
+worst = min(case(r, sp, ip, w, holes=h) for r, sp, ip, w, h in cases)
+print("PASS" if worst > 0.9999 else "FAIL", f"(worst cosine {worst:.6f})")
diff --git a/tp3-tools/test_fused_qkv_norm.py b/tp3-tools/test_fused_qkv_norm.py
new file mode 100644
index 00000000..c7f54c57
--- /dev/null
+++ b/tp3-tools/test_fused_qkv_norm.py
@@ -0,0 +1,39 @@
+"""Bit-exactness check: fused split-4 reduce + MLA norm/MXFP8 vs b12x's reduce kernel followed by mla_norm_mxfp8."""
+import sys
+from pathlib import Path
+
+import torch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from b12x._lib.dense_gemm.reductions import _reduce_split_k4_bf16  # noqa: E402
+from b12x.quantization import mxfp8  # noqa: E402
+from b12x.quantization.mla_norm_mxfp8._kernels import mla_norm_mxfp8_kernel  # noqa: E402
+from ignition.recipes.deepseek41.fused_qkv_norm import launch_split4  # noqa: E402
+
+dev = torch.device("cuda", 0)
+torch.manual_seed(0)
+ok = True
+for rows in (1, 6, 8, 24, 48, 64):
+    partials = torch.randn(4, rows, 1792, device=dev) * torch.rand(1, rows, 1, device=dev) * 3
+    qw = torch.rand(1280, device=dev, dtype=torch.bfloat16) + 0.5
+    kw = torch.rand(512, device=dev, dtype=torch.bfloat16) + 0.5
+    outs = []
+    for fused in (False, True):
+        q = torch.zeros(rows, 1280, device=dev, dtype=torch.bfloat16)
+        kv = torch.zeros(rows, 512, device=dev, dtype=torch.bfloat16)
+        vs, rs, ms = mxfp8.dense_rows_storage_shapes(rows, 1280)
+        bases = (torch.zeros(vs, device=dev, dtype=torch.float8_e4m3fn), torch.zeros(rs, device=dev, dtype=torch.uint8),
+                 torch.zeros(ms, device=dev, dtype=torch.uint8))
+        if fused:
+            launch_split4(partials, qw, kw, q, kv, *bases, eps=1e-20)
+        else:
+            projected = torch.empty(rows, 1792, 1, device=dev, dtype=torch.bfloat16)
+            _reduce_split_k4_bf16(partials.permute(1, 2, 0), projected, m=rows, n=1792)
+            mla_norm_mxfp8_kernel[(rows, 2, 1)](projected.view(rows, 1792), qw, kw, q, kv, *bases, 1280, 512, 1e-20,
+                                                1e-4, False, False)
+        torch.cuda.synchronize(dev)
+        outs.append((q, kv, *bases))
+    same = [torch.equal(a.view(torch.uint8), b.view(torch.uint8)) for a, b in zip(*outs)]
+    ok &= all(same)
+    print(f"rows {rows:2d}: query/kv/q8/scale_rows/scale_mma bit-identical {same}")
+print("PASS" if ok else "FAIL")
diff --git a/tp3-tools/tool_calls.py b/tp3-tools/tool_calls.py
new file mode 100644
index 00000000..a4e95af7
--- /dev/null
+++ b/tp3-tools/tool_calls.py
@@ -0,0 +1,123 @@
+#!/usr/bin/env python3
+"""Tool-call qualification (flare#193 lesson): N tool-requiring prompts at concurrency C.
+
+Per request: no HTTP/server error; the model calls a tool (finish_reason tool_calls); every call names a
+declared tool, its arguments parse as a JSON object with non-empty unique keys, all required parameters
+present with the right JSON types and enum values. A second turn returns the tool result and must end
+with a non-empty assistant answer.
+usage: tool_calls.py [N=60] [C=4]
+"""
+import json, random, sys, time, urllib.error, urllib.request
+from concurrent.futures import ThreadPoolExecutor
+
+URL = "http://127.0.0.1:15015/v1/chat/completions"
+N = int(sys.argv[1]) if len(sys.argv) > 1 else 60
+C = int(sys.argv[2]) if len(sys.argv) > 2 else 4
+TOOLS = [
+    {"type": "function", "function": {"name": "get_weather", "description": "Current weather for a city.",
+     "parameters": {"type": "object", "properties": {
+         "city": {"type": "string"}, "unit": {"type": "string", "enum": ["celsius", "fahrenheit"]}},
+         "required": ["city", "unit"]}}},
+    {"type": "function", "function": {"name": "search_files", "description": "Find files matching a glob under a directory.",
+     "parameters": {"type": "object", "properties": {
+         "pattern": {"type": "string"}, "path": {"type": "string"}, "max_results": {"type": "integer"}},
+         "required": ["pattern", "path"]}}},
+    {"type": "function", "function": {"name": "run_command", "description": "Run a shell command and return its output.",
+     "parameters": {"type": "object", "properties": {
+         "command": {"type": "string"}, "timeout_seconds": {"type": "integer"}},
+         "required": ["command", "timeout_seconds"]}}},
+]
+SPEC = {t["function"]["name"]: t["function"]["parameters"] for t in TOOLS}
+TYPES = {"string": str, "integer": int, "number": (int, float), "boolean": bool, "object": dict, "array": list}
+CITIES = ["Lisbon", "Osaka", "Nairobi", "Calgary", "Hanoi", "Reykjavik", "Lima", "Tbilisi"]
+TASKS = [
+    lambda r: (f"What's the weather in {r.choice(CITIES)} right now, in {r.choice(['celsius', 'fahrenheit'])}? Use the tool.", "get_weather"),
+    lambda r: (f"Find all {r.choice(['*.py', '*.rs', '*.md', '*.json'])} files under {r.choice(['/srv/app', '~/projects', '/etc'])}, at most {r.randint(5, 50)} results.", "search_files"),
+    lambda r: (f"Run `{r.choice(['df -h', 'uname -a', 'ls -la /tmp', 'git status'])}` with a {r.randint(5, 120)} second timeout and tell me what it says.", "run_command"),
+]
+FAKE = {"get_weather": {"temperature": 18, "conditions": "light rain"},
+        "search_files": {"matches": ["a/one.py", "b/two.py"], "truncated": False},
+        "run_command": {"exit_code": 0, "stdout": "ok\n"}}
+
+
+def post(body):
+    req = urllib.request.Request(URL, json.dumps(body).encode(), {"Content-Type": "application/json"})
+    try:
+        with urllib.request.urlopen(req, timeout=900) as r:
+            return json.load(r), None
+    except urllib.error.HTTPError as e:
+        return None, f"HTTP {e.code}: {e.read()[:300]!r}"
+    except Exception as e:  # noqa: BLE001
+        return None, f"{type(e).__name__}: {e}"
+
+
+def check_call(call):
+    fn = call.get("function", {})
+    name = fn.get("name")
+    if name not in SPEC:
+        return f"unknown tool {name!r}"
+    try:
+        args = json.loads(fn.get("arguments") or "")
+    except json.JSONDecodeError as e:
+        return f"arguments not JSON: {e}"
+    if not isinstance(args, dict):
+        return "arguments not an object"
+    if any(not k for k in args):
+        return "empty argument name"
+    spec = SPEC[name]
+    for key in spec["required"]:
+        if key not in args:
+            return f"missing required {key}"
+    for key, value in args.items():
+        prop = spec["properties"].get(key)
+        if prop is None:
+            return f"undeclared argument {key}"
+        if not isinstance(value, TYPES[prop["type"]]) or (prop["type"] == "integer" and isinstance(value, bool)):
+            return f"{key} has type {type(value).__name__}"
+        if "enum" in prop and value not in prop["enum"]:
+            return f"{key}={value!r} not in enum"
+    return None
+
+
+def one(i):
+    rng = random.Random(1000 + i)
+    prompt, expected = rng.choice(TASKS)(rng)
+    msgs = [{"role": "user", "content": prompt}]
+    base = dict(model="DeepSeek-V4.1-Flash", tools=TOOLS, max_tokens=4096, reasoning_effort="high", seed=i)
+    d, err = post({**base, "messages": msgs})
+    if err:
+        return i, "FAIL", err
+    choice = d["choices"][0]
+    calls = choice["message"].get("tool_calls") or []
+    if not calls:
+        return i, "FAIL", f"no tool call (finish={choice.get('finish_reason')}): {(choice['message'].get('content') or '')[:120]!r}"
+    names = [c.get("function", {}).get("name") for c in calls]
+    if len(set(c.get("id") for c in calls)) != len(calls):
+        return i, "FAIL", "duplicate tool call ids"
+    for c in calls:
+        problem = check_call(c)
+        if problem:
+            return i, "FAIL", problem
+    msgs.append(choice["message"])
+    for c in calls:
+        msgs.append({"role": "tool", "tool_call_id": c["id"], "content": json.dumps(FAKE[c["function"]["name"]])})
+    d2, err = post({**base, "messages": msgs})
+    if err:
+        return i, "FAIL", "turn 2: " + err
+    answer = (d2["choices"][0]["message"].get("content") or "").strip()
+    if not answer and not d2["choices"][0]["message"].get("tool_calls"):
+        return i, "FAIL", "turn 2: empty answer"
+    return i, "OK", f"{','.join(names)}{'' if expected in names else ' (unexpected tool)'}"
+
+
+t0 = time.time()
+with ThreadPoolExecutor(C) as pool:
+    results = sorted(pool.map(one, range(N)))
+ok = sum(1 for _, s, _ in results if s == "OK")
+odd = [r for r in results if r[1] == "OK" and "unexpected" in r[2]]
+for r in results:
+    if r[1] != "OK":
+        print("  FAIL", r[0], r[2])
+print(f"tool calls: {ok}/{N} OK ({len(odd)} chose a different tool), concurrency {C}, {time.time() - t0:.0f} s")
+json.dump([dict(index=i, status=s, detail=d) for i, s, d in results],
+          open(__file__.replace(".py", ".json"), "w"), indent=2)
diff --git a/tp3-tools/verify_fix.py b/tp3-tools/verify_fix.py
new file mode 100644
index 00000000..dd697c1a
--- /dev/null
+++ b/tp3-tools/verify_fix.py
@@ -0,0 +1,38 @@
+"""flare#193 fix check: count TRUE decode corruptions (decode junk where teacher-forced prefill is confident)."""
+import json, sys, urllib.request
+
+URL = "http://localhost:15015"
+PROMPTS = [
+    ("# Test suite for is_palindrome: 60 checks, one per line.\n"
+     "def is_palindrome(s):\n    t = [c.lower() for c in s if c.isalnum()]\n    return t == t[::-1]\n\n"
+     "print(is_palindrome(\"racecar\"))  # True\nprint(is_palindrome(\"hello\"))  # False\n"
+     "print(is_palindrome(\"A man, a plan, a canal: Panama\"))  # True\n"),
+    ("// debounce tests: 40 cases\nfunction debounce(fn, ms) {\n  let t;\n  return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); };\n}\n"
+     "const a = debounce(log, 100);\nconst b = debounce(log, 200);\n"),
+]
+
+
+def post(body):
+    req = urllib.request.Request(URL + "/v1/completions", json.dumps({"model": "DeepSeek-V4.1-Flash", **body}).encode(),
+                                 {"Content-Type": "application/json"})
+    return json.load(urllib.request.urlopen(req, timeout=600))
+
+
+runs = int(sys.argv[1]) if len(sys.argv) > 1 else 20
+true_bad, natural, tokens = [], 0, 0
+for run in range(runs):
+    P = PROMPTS[run % len(PROMPTS)]
+    lp = post({"prompt": P, "max_tokens": 300, "top_p": 0.95, "logprobs": 5})["choices"][0]["logprobs"]
+    toks, tlp, tops = lp["tokens"], lp["token_logprobs"], lp["top_logprobs"]
+    tokens += len(toks)
+    for i in range(2, len(toks) - 1):
+        if max(tops[i].values()) < -1.6 and tlp[i - 1] > -0.02 and tlp[i - 2] > -0.02:
+            ref = post({"prompt": P + "".join(toks[:i]), "max_tokens": 1, "top_p": 0.95, "logprobs": 5})
+            rtop = max(ref["choices"][0]["logprobs"]["top_logprobs"][0].items(), key=lambda kv: kv[1])
+            if rtop[1] > -0.3:
+                true_bad.append((run, i, toks[i - 1], toks[i], round(max(tops[i].values()), 2), rtop))
+            else:
+                natural += 1
+print(f"{runs} runs, {tokens} tokens: TRUE corruptions {len(true_bad)}, natural-uncertainty flags {natural}")
+for b in true_bad[:10]:
+    print("  ", b)
