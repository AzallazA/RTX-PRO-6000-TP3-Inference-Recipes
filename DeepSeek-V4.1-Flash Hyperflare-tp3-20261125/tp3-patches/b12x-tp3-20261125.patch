+        if cur is None or cur[0] != cap_id:
+            _TC_CAPTURE_STREAMS[device_ordinal] = (cap_id, {stream_ptr: 0})
+            return 0
+        mapping = cur[1]
+        slot = mapping.get(stream_ptr)
+        if slot is None:
+            slot = len(mapping)
+            if slot >= _TC_SPLITK_MAX_STREAMS:
+                raise RuntimeError(
+                    f"split-K stream pool exhausted ({_TC_SPLITK_MAX_STREAMS} concurrent streams in capture)"
