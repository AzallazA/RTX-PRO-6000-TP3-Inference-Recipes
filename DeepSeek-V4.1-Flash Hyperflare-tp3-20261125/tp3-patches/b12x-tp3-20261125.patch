+def select_tc_splitk_stream_slot(device_ordinal: int, stream_ptr: int) -> int:
+    """Assign each concurrent stream inside a CUDA graph capture a disjoint buffer slot.
+
+    Prevent concurrent side-stream and main-stream split-K TC-GEMV launches of the same
+    shape (e.g. ``compressor.project_gates`` on a side stream beside ``compressor.project_values``
+    on the main stream) from racing on a shared process-global scratch/flags buffer.
