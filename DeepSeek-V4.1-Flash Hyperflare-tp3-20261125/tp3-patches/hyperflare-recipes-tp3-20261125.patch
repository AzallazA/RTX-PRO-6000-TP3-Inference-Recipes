+# SPDX-FileCopyrightText: Copyright (c) 2026 Flare community contributors
+# SPDX-License-Identifier: Apache-2.0
+"""Fuse four projection partials into the prepared MLA normalization."""
+
+from dataclasses import replace
+from functools import lru_cache
+
+import torch
+import triton
+import triton.language as tl
+from b12x._lib.runtime_control import raise_if_kernel_resolution_frozen
+from b12x.gemm.blockscaled._quantize import _scale_offset
+from b12x.preparation.types import plan_from_handle, require_prepared
+from b12x.quantization.mxfp8 import dense_scale_view_from_storage
+
+
+@triton.jit
+def _sum_four(partials, offsets, total, mask):
+    accum = tl.load(partials + offsets, mask=mask, other=0)
+    accum += tl.load(partials + total + offsets, mask=mask, other=0)
+    accum += tl.load(partials + 2 * total + offsets, mask=mask, other=0)
+    accum += tl.load(partials + 3 * total + offsets, mask=mask, other=0)
+    # Preserve the original QKV projection output rounding.
+    return accum.to(tl.bfloat16).to(tl.float32)
+
+
+@triton.jit
+def reduce_norm_mxfp8(
+    PARTIALS,
+    PROJECTED,
+    TOTAL: tl.constexpr,
+    QW,
+    KW,
+    ANGLES,
+    QBF,
+    KV,
+    Q8,
+    ROWS,
+    S,
+    Q_FEATURES: tl.constexpr,
+    KV_FEATURES: tl.constexpr,
+    EPSILON: tl.constexpr,
+    MIN_AMAX: tl.constexpr,
+    INCOMING_PDL: tl.constexpr,
+    RELEASE_DEPENDENTS: tl.constexpr,
+    WRITE_PROJECTED: tl.constexpr,
+    WRITE_QBF: tl.constexpr,
+    FUSE_KV_ROPE: tl.constexpr,
+    SPLIT_ANGLES: tl.constexpr = False,
+):
+    row = tl.program_id(0).to(tl.int64)
+    task = tl.program_id(1)
+    if RELEASE_DEPENDENTS:
+        # The dependent GEMM may load its immutable RHS now; it waits before
+        # consuming Q8 and S, which are written below.
+        tl.extra.cuda.gdc_launch_dependents()
+    if task == 0:
+        c = tl.arange(0, 2048)
+        w = tl.load(QW + c, c < Q_FEATURES, 0).to(tl.float32)
+        if INCOMING_PDL:
+            tl.extra.cuda.gdc_wait()
+        offsets = row * (Q_FEATURES + KV_FEATURES) + c
+        x = _sum_four(PARTIALS, offsets, TOTAL, c < Q_FEATURES)
+        if WRITE_PROJECTED:
+            tl.store(PROJECTED + offsets, x, c < Q_FEATURES)
+        variance = tl.sum(x * x, 0) / Q_FEATURES
+        y = (x * tl.rsqrt(variance + EPSILON) * w).to(QBF.dtype.element_ty)
+        if WRITE_QBF:
+            tl.store(QBF + row * Q_FEATURES + c, y, c < Q_FEATURES)
+        grouped = tl.reshape(y.to(tl.float32), (64, 32))
+        amax = tl.maximum(tl.max(tl.abs(grouped), 1), MIN_AMAX)
+        bits = (amax * (1.0 / 448.0)).to(tl.uint32, bitcast=True)
+        exponent = (
+            ((bits >> 23) & 255).to(tl.int32)
+            - 127
+            + ((bits & 0x7FFFFF) != 0).to(tl.int32)
+        )
+        inv_scale = ((127 - exponent).to(tl.uint32) << 23).to(tl.float32, bitcast=True)
+        quant = tl.minimum(
+            tl.maximum(grouped * inv_scale[:, None], -448.0), 448.0
+        ).to(tl.float8e4nv)
+        tl.store(Q8 + row * Q_FEATURES + c, tl.reshape(quant, (2048,)), c < Q_FEATURES)
+        group = tl.arange(0, 64)
+        byte = (exponent + 127).to(tl.uint8)
+        groups: tl.constexpr = Q_FEATURES // 32
+        tl.store(ROWS + row * groups + group, byte, group < groups)
+        tl.store(S + _scale_offset(row, group, groups), byte, group < groups)
+    else:
+        kc = tl.arange(0, 512)
+        kw = tl.load(KW + kc).to(tl.float32)
+        if INCOMING_PDL:
+            tl.extra.cuda.gdc_wait()
+        kv_offsets = row * (Q_FEATURES + KV_FEATURES) + Q_FEATURES + kc
+        kx = _sum_four(PARTIALS, kv_offsets, TOTAL, kc < KV_FEATURES)
+        if WRITE_PROJECTED:
+            tl.store(PROJECTED + kv_offsets, kx)
+        inv_rms = tl.rsqrt(tl.sum(kx * kx, 0) / KV_FEATURES + EPSILON)
+        ky = (kx * inv_rms * kw).to(KV.dtype.element_ty)
+        if FUSE_KV_ROPE:
+            tl.store(KV + row * KV_FEATURES + kc, ky, kc < KV_FEATURES - 64)
+            pair = tl.arange(0, 32)
+            ro = KV_FEATURES - 64 + 2 * pair
+            ky_bits = tl.reshape(ky.to(tl.float32).to(tl.uint32, bitcast=True), (8, 32, 2))
+            even_bits, odd_bits = tl.split(ky_bits)
+            blk = tl.arange(0, 8)[:, None]
+            a = tl.sum(tl.where(blk == 7, even_bits, 0), axis=0).to(tl.float32, bitcast=True)
+            b = tl.sum(tl.where(blk == 7, odd_bits, 0), axis=0).to(tl.float32, bitcast=True)
+            if SPLIT_ANGLES:
+                cos = tl.load(ANGLES + row * 64 + pair)
+                sin = tl.load(ANGLES + row * 64 + 32 + pair)
+            else:
+                cos = tl.load(ANGLES + row * 64 + 2 * pair)
+                sin = tl.load(ANGLES + row * 64 + 2 * pair + 1)
+            base = KV + row * KV_FEATURES + ro
+            tl.store(base, (a * cos - b * sin).to(KV.dtype.element_ty))
+            tl.store(base + 1, (a * sin + b * cos).to(KV.dtype.element_ty))
+        else:
+            tl.store(KV + row * KV_FEATURES + kc, ky)
+
+
+Q, KV = 1280, 512
+N = Q + KV
+
+
+def _supports(projection, norm):
+    p = projection.core.lowering
+    q = projection.query
+    norm_query = norm.query
+    return (q.recipe == "mxfp8" and q.workspace_form == "provided"
+            and q.output_mode == "provided" and q.alpha_mode == "unit"
+            and p.n == N and p.l == 1 and p.c_dtype == "bfloat16"
+            and p.policy.split_k_slices == 4 and not p.policy.split_k_atomic_bf16
+            and projection.core.reduction is not None
+            and (norm_query.query_features, norm_query.kv_features) == (Q, KV)
+            and norm_query.epsilon == 1e-20 and norm_query.min_amax == 1e-4
+            and norm.programmatic_serialization == p.programmatic_serialization)
+
+
+@lru_cache(maxsize=None)
+def _program(device, rows, query_dtype, kv_dtype, pdl, release, write_projected=False,
+             write_qbf=True, fuse_kv_rope=False, split_angles=False):
+    raise_if_kernel_resolution_frozen(
+        "triton.warmup", target=reduce_norm_mxfp8,
+        cache_key=(device, rows, query_dtype, kv_dtype, pdl, release, write_projected, write_qbf, fuse_kv_rope, split_angles),
+    )
+    with torch.cuda.device(device):
+        result = reduce_norm_mxfp8.warmup(
+            torch.float32, torch.bfloat16, rows * N,
+            query_dtype, kv_dtype, torch.float32, torch.bfloat16, torch.bfloat16,
+            torch.float8_e4m3fn, torch.uint8, torch.uint8,
+            Q, KV, 1e-20, 1e-4, pdl, release, write_projected, write_qbf, fuse_kv_rope, split_angles,
+            grid=(rows, 2, 1), num_warps=8, enable_fp_fusion=False, launch_pdl=pdl,
+        )
+        result._init_handles()
+        return result
+
+
+def prepare(projection, norm, *, write_projected=False, write_qbf=True, fuse_kv_rope=False, split_angles=False):
+    if not _supports(projection, norm):
+        return False
+    spec = norm.query
+    _program(projection.core.device, spec.rows, getattr(torch, spec.query_weight_dtype),
+             getattr(torch, spec.kv_weight_dtype), norm.programmatic_serialization, spec.release_dependents,
+             bool(write_projected), bool(write_qbf), bool(fuse_kv_rope), bool(split_angles))
+    return True
+
+
+class _NormalizePartials:
+    def __init__(self, rows, arguments, pdl, release, write_projected, write_qbf, fuse_kv_rope, split_angles):
+        self.rows = rows
+        self.arguments = arguments
+        self.pdl = pdl
+        self.release = release
+        self.write_projected = bool(write_projected)
+        self.write_qbf = bool(write_qbf)
+        self.fuse_kv_rope = bool(fuse_kv_rope)
+        self.split_angles = bool(split_angles)
+
+    def __getitem__(self, _grid):
+        return self.run
+
+    def run(self, partials, projected, total, _block, pdl):
+        if (total != self.rows * N or tuple(partials.shape) != (4, self.rows, N)
+                or not partials.is_contiguous() or pdl != self.pdl):
+            raise ValueError("MLA normalization requires prepared contiguous four-way QKV partials")
+        qw, kw, angles, *rest = self.arguments
+        angles_arg = partials if angles is None else angles
+        launch = _program(partials.device, self.rows, qw.dtype, kw.dtype, pdl, self.release,
+                          self.write_projected, self.write_qbf, self.fuse_kv_rope, self.split_angles)
+        launch[(self.rows, 2, 1)](
+            partials, projected, total, qw, kw, angles_arg, *rest,
+            Q, KV, 1e-20, 1e-4, pdl, self.release, self.write_projected, self.write_qbf,
+            self.fuse_kv_rope, self.split_angles,
+        )
+
+
+@torch.library.custom_op("flare::mla_qkv_reduce_norm", mutates_args=(
+    "projected", "workspace", "query_low", "kv", "encoded", "scale_rows", "scale_mma",
+))
+def run(a: torch.Tensor, a_scale: torch.Tensor, b: torch.Tensor, b_scale: torch.Tensor,
+        qw: torch.Tensor, kw: torch.Tensor, projected: torch.Tensor, workspace: torch.Tensor,
+        query_low: torch.Tensor, kv: torch.Tensor, encoded: torch.Tensor,
+        scale_rows: torch.Tensor, scale_mma: torch.Tensor, projection_handle: int, norm_handle: int,
+        angles: torch.Tensor | None = None, write_projected: bool = False, write_qbf: bool = True) -> None:
+    projection = require_prepared(plan_from_handle(projection_handle), "gemm.mm", a.device)
+    norm = require_prepared(plan_from_handle(norm_handle), "quantization.mla_norm_mxfp8", a.device)
+    if not _supports(projection, norm):
+        raise ValueError("MLA projection and normalization plans no longer support fused split-K reduction")
+    rows, columns = a.shape
+    spec = norm.query
+    if (rows != spec.rows or tuple(b.shape) != (N, columns)
+            or qw.dtype != getattr(torch, spec.query_weight_dtype)
+            or kw.dtype != getattr(torch, spec.kv_weight_dtype)):
+        raise ValueError("MLA projection operands differ from the normalization geometry")
+    fuse_kv_rope = angles is not None
+    split_angles = False
+    if fuse_kv_rope:
+        if angles.dtype != torch.float32 or not angles.is_contiguous() or angles.shape[0] != rows:
+            raise ValueError("MLA fused KV rotary expects contiguous [rows, 64] or [rows, 32, 2] FP32 angles")
+        if angles.ndim == 2 and angles.shape[1] == 64:
+            split_angles = True
+        elif not (angles.ndim == 3 and tuple(angles.shape[1:]) == (32, 2)):
+            raise ValueError("MLA fused KV rotary expects contiguous [rows, 64] or [rows, 32, 2] FP32 angles")
+    sfa = dense_scale_view_from_storage(a_scale, rows, columns)
+    sfb = dense_scale_view_from_storage(b_scale, N, columns)
+    reduction = _NormalizePartials(rows, (qw, kw, angles, query_low, kv, encoded, scale_rows, scale_mma),
+                                   norm.programmatic_serialization, spec.release_dependents,
+                                   write_projected, write_qbf, fuse_kv_rope, split_angles)
+    execution = replace(projection, core=replace(projection.core, reduction=reduction))
+    execution.run(a.view(rows, columns, 1), sfa, b.view(N, columns, 1), sfb,
+                  None, projected.view(rows, N, 1), workspace.view(torch.float32), torch.bfloat16, None)
+
+
+@run.register_fake
+def _run_fake(a, a_scale, b, b_scale, qw, kw, projected, workspace, query_low, kv, encoded,
+              scale_rows, scale_mma, projection_handle, norm_handle,
+              angles=None, write_projected=False, write_qbf=True):
+    pass
