index 0000000..fdd6454
--- /dev/null
+++ b/hyperflare_recipes/recipes/deepseek41/draft_feedback.py
@@ -0,0 +1,42 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 Flare community contributors
+# SPDX-License-Identifier: Apache-2.0
+
+"""Assemble the three target-layer residual means consumed by the draft context projection."""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _three_tap_mean(First, Second, Third, Output, HIDDEN: tl.constexpr, BLOCK: tl.constexpr):
+    row = tl.program_id(1)
+    tap = tl.program_id(2)
+    column = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    source = tl.where(tap == 0, First, tl.where(tap == 1, Second, Third))
+    start = source + row * (4 * HIDDEN) + column
+    a = tl.load(start).to(tl.float32)
+    b = tl.load(start + HIDDEN).to(tl.float32)
+    c = tl.load(start + 2 * HIDDEN).to(tl.float32)
+    d = tl.load(start + 3 * HIDDEN).to(tl.float32)
+    # ATen starts at positive zero and adds the four streams in order. Reassociation
+    # can change a BF16 result even when every FP32 input came from a BF16 value.
+    total = tl.inline_asm_elementwise(
+        "{ .reg .f32 s; add.rn.f32 s, 0f00000000, $1; add.rn.f32 s, s, $2; "
+        "add.rn.f32 s, s, $3; add.rn.f32 $0, s, $4; }",
+        constraints="=f,f,f,f,f", args=[a, b, c, d], dtype=tl.float32, is_pure=True, pack=1)
+    tl.store(Output + row * (3 * HIDDEN) + tap * HIDDEN + column, (total * 0.25).to(tl.bfloat16))
+
+
+def concatenate_stream_means(residuals):
+    """Write the target-layer means in checkpoint order for the draft context projection."""
+    first = residuals[0]
+    rows = first.shape[0]
+    shape = (rows, 4, 5120)
+    if (len(residuals) != 3 or not first.is_cuda or
+            any(t.shape != shape or t.dtype != torch.bfloat16 or not t.is_contiguous() for t in residuals)):
+        return torch.cat([t.float().mean(1) for t in residuals], dim=1).bfloat16()
+    hidden = first.shape[-1]
+    output = first.new_empty((rows, 3 * hidden))
+    torch.library.wrap_triton(_three_tap_mean)[(hidden // 256, rows, 3)](*residuals, output, HIDDEN=hidden, BLOCK=256)
+    return output
