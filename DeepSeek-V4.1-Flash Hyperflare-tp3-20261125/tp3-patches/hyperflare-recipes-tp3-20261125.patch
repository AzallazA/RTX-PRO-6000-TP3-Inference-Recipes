+    })
+    assert kernel_defines(cfg) == ("BRRR_PUSH=1", "BRRR_SKIP_PAD=1", "BRRR_TWO_SHOT_MIN=129")
+    meta = cfg.to_metadata()
+    assert meta["brrr_push"] is True and meta["brrr_skip_pad"] is True
+    assert meta["pin_mid_qkv_norm"] is True and meta["index_side_prefill"] is True
+    assert meta["brrr_two_shot_min"] == 129
+    check_switches(SimpleNamespace(SPIN_TRAP=0, PUSH=1, SKIP_PAD=1, SPIN_NS=200, TWO_SHOT_MIN=129, **LAYOUT_DEFAULTS), cfg)
+    with pytest.raises(RuntimeError, match="do not match"):
+        check_switches(SimpleNamespace(SPIN_TRAP=0, PUSH=0, SKIP_PAD=1, SPIN_NS=200, TWO_SHOT_MIN=129, **LAYOUT_DEFAULTS), cfg)
+
+    # Flat 1D pool packer: disjoint ranges share offset 0, overlapping ranges stack with 256-byte alignment.
+    class _Blk:
+        def __init__(self, nbytes, b, e):
+            self.symbolic_size = sympy.Integer(nbytes)
+            self.live_range = SimpleNamespace(begin=b, end=e)
+        def get_earliest_available(self):
+            return None
+
+    b1, b2, b3 = _Blk(1000, 0, 5), _Blk(1000, 5, 10), _Blk(500, 3, 7)
