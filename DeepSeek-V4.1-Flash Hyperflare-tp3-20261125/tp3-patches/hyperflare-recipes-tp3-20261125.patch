+                    mid_out.iterator + token_idx.to(Int64) * Int64(self.output_stride_row),
+                    cute.make_layout((HEADS, t.d_v), stride=(self.output_stride_head, self.output_stride_dim)),
+                )
+                out_lse = cute.make_tensor(
+                    mid_lse.iterator + token_idx.to(Int64) * Int64(self.mid_lse_stride_row),
+                    cute.make_layout((HEADS,), stride=(self.mid_lse_stride_head,)),
+                )
+                s7_epilogue_h24(
+                    accn, accn2,
+                    gstate[0], gstate[1], gstate[4],
+                    gstate[2], gstate[3], gstate[5],
+                    out_o, out_lse, warp_id, lane, tid, kv_addr,
+                    out_stride_head=self.output_stride_head,
+                    epilogue_mode=EPILOGUE_FINAL_BF16,
+                    has_attn_sink=self.has_sink, attn_sink=attn_sink,
+                    fast_rcp=True, coalesced_output=coalesced,
+                )
+            else:
+                coalesced_split = cutlass.const_expr(
+                    self.mid_out_stride_dim == 1
+                    and self.mid_out_stride_head % 8 == 0
+                    and self.mid_out_stride_split % 8 == 0
+                )
+                out_o = cute.make_tensor(
+                    mid_out.iterator + token_idx.to(Int64) * Int64(self.mid_out_stride_row)
+                    + split_idx.to(Int64) * Int64(self.mid_out_stride_split),
+                    cute.make_layout((HEADS, t.d_v), stride=(self.mid_out_stride_head, self.mid_out_stride_dim)),
+                )
+                out_lse = cute.make_tensor(
+                    mid_lse.iterator + token_idx.to(Int64) * Int64(self.mid_lse_stride_row)
+                    + split_idx.to(Int64) * Int64(self.mid_lse_stride_split),
+                    cute.make_layout((HEADS,), stride=(self.mid_lse_stride_head,)),
+                )
+                s7_epilogue_h24(
+                    accn, accn2,
+                    gstate[0], gstate[1], gstate[4],
+                    gstate[2], gstate[3], gstate[5],
+                    out_o, out_lse, warp_id, lane, tid, kv_addr,
+                    out_stride_head=self.mid_out_stride_head,
+                    epilogue_mode=EPILOGUE_PARTIAL_WRITEBACK,
+                    has_attn_sink=False, attn_sink=attn_sink,
+                    fast_rcp=True, coalesced_output=coalesced_split,
+                )
