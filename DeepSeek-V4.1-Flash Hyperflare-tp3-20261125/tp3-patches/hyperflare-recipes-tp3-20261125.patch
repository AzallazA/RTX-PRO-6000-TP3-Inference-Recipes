+@cute.jit
+def _io_issue_gather_dsv41_decode(
+    kv_cache_u8: cute.Tensor,
+    topk_indices: cute.Tensor,
+    kv_dst_addr: Int32,
+    full_mbar_ptr,
+    g_start: Int32,
+    g_end: Int32,
+    stride_kv_block: Int64,
+    io_lane: Int32,
+    *,
+    page_block_size: cutlass.Constexpr,
+    dsv41_swa: cutlass.Constexpr,
+    use_mapping: cutlass.Constexpr = False,
+    mapping_page_table=None,
+    mapping_table_width: Int32 = Int32(-1),
+    mapping_table_offset: Int64 = Int64(0),
+    mapping_num_pages: Int64 = Int64(0),
+    mapping_page_size: cutlass.Constexpr = 1,
+):
+    """Single-pass DSV41 decode IO gather for 1 IO warp (32 lanes x 2 entries = 64 candidates).
+
+    Loads/maps each candidate index once in registers (eliminating the SMEM token_idx buffer),
+    issues expect_tx + cp.async.bulk FIRST, then overlaps source_tag SMEM stores + CTA fence
+    under TMA before arriving on full_mbar_ptr.
+    """
+    _ios = Int64(528 if dsv41_swa else 288)
+    _nope = Int32(528 if dsv41_swa else 288)
+    _valid_tag = Uint32(1 if dsv41_swa else 0)
+    _pbs = Int32(page_block_size)
+
+    entry0 = io_lane
+    entry1 = io_lane + Int32(32)
+    cand0 = g_start + entry0
+    cand1 = g_start + entry1
+
+    idx0 = Int32(-1)
+    if cand0 < g_end:
+        idx0 = Int32(topk_indices[cand0])
+    idx1 = Int32(-1)
+    if cand1 < g_end:
+        idx1 = Int32(topk_indices[cand1])
+
+    if cutlass.const_expr(use_mapping):
+        l0 = Int64(idx0)
+        idx0 = Int32(-1)
+        if l0 >= Int64(0):
+            if mapping_table_width < Int32(0):
+                idx0 = Int32(l0)
+            else:
+                p0 = l0 // Int64(mapping_page_size)
+                if p0 < Int64(mapping_table_width):
+                    pid0 = Int64(mapping_page_table[mapping_table_offset + p0])
+                    if (pid0 >= Int64(0)) & (pid0 < mapping_num_pages):
+                        slot0 = pid0 * Int64(mapping_page_size) + l0 % Int64(mapping_page_size)
+                        if slot0 <= Int64(2147483647):
+                            idx0 = Int32(slot0)
+        l1 = Int64(idx1)
+        idx1 = Int32(-1)
+        if l1 >= Int64(0):
+            if mapping_table_width < Int32(0):
+                idx1 = Int32(l1)
+            else:
+                p1 = l1 // Int64(mapping_page_size)
+                if p1 < Int64(mapping_table_width):
+                    pid1 = Int64(mapping_page_table[mapping_table_offset + p1])
+                    if (pid1 >= Int64(0)) & (pid1 < mapping_num_pages):
+                        slot1 = pid1 * Int64(mapping_page_size) + l1 % Int64(mapping_page_size)
+                        if slot1 <= Int64(2147483647):
+                            idx1 = Int32(slot1)
+
+    if io_lane == Int32(0):
+        cute.arch.mbarrier_expect_tx(full_mbar_ptr, Int32(BI) * _nope)
+    cute.arch.sync_warp()
+
+    full_mbar_u32 = shared_ptr_to_u32(full_mbar_ptr)
+    c0 = idx0
+    if c0 < Int32(0):
+        c0 = Int32(0)
+    blk0 = c0 // _pbs
+    loc0 = c0 - blk0 * _pbs
+    off0 = Int64(blk0) * stride_kv_block + Int64(loc0) * _ios
+    cp_async_bulk_g2s_mbar(
+        kv_dst_addr + entry0 * Int32(KV_SMEM_STRIDE),
+        get_ptr_as_int64(kv_cache_u8, off0),
+        _nope,
+        full_mbar_u32,
+    )
+
+    c1 = idx1
+    if c1 < Int32(0):
+        c1 = Int32(0)
+    blk1 = c1 // _pbs
+    loc1 = c1 - blk1 * _pbs
+    off1 = Int64(blk1) * stride_kv_block + Int64(loc1) * _ios
+    cp_async_bulk_g2s_mbar(
+        kv_dst_addr + entry1 * Int32(KV_SMEM_STRIDE),
+        get_ptr_as_int64(kv_cache_u8, off1),
+        _nope,
+        full_mbar_u32,
+    )
+
+    tag0 = _valid_tag
+    if idx0 < Int32(0):
+        tag0 = Uint32(2)
+    tag1 = _valid_tag
+    if idx1 < Int32(0):
+        tag1 = Uint32(2)
+    st_shared_u32(kv_dst_addr + entry0 * Int32(KV_SMEM_STRIDE) + Int32(528), tag0)
+    st_shared_u32(kv_dst_addr + entry1 * Int32(KV_SMEM_STRIDE) + Int32(528), tag1)
+    cute.arch.fence_acq_rel_cta()
+    cute.arch.sync_warp()
+    if io_lane == Int32(0):
+        cute.arch.mbarrier_arrive(full_mbar_ptr)
+
+
+@cute.jit
+def s1_pair(qk, qk2, q_addr: Int32, kv_addr: Int32, warp_first_cand: Int32, lane: Int32, *,
+            known_swa: cutlass.Constexpr):
+    """b12x s1_qk_nope_nvfp4_bf16 (544-byte DSV41 staging) for both head tiles with known source format."""
+    gid = lane >> Int32(2)
+    kv_gid_row = warp_first_cand + gid
+    tag = ld_shared_u32(kv_addr + kv_gid_row * Int32(544) + Int32(528)).to(Int32)
+    want_tag = Int32(1 if known_swa else 0)
+    valid = tag == want_tag
+    all_valid = cute.arch.vote_all_sync(valid)
+    q0, q1, q2, q3 = qk[0], qk[1], qk[2], qk[3]
+    r0, r1, r2, r3 = qk2[0], qk2[1], qk2[2], qk2[3]
+    if all_valid:
+        q0, q1, q2, q3, r0, r1, r2, r3 = _qk_source_pair(
+            [q0, q1, q2, q3], [r0, r1, r2, r3], q_addr, kv_addr,
+            warp_first_cand, lane, cutlass.Boolean(True), swa=known_swa, assume_valid=True)
+    else:
+        q0, q1, q2, q3, r0, r1, r2, r3 = _qk_source_pair(
+            [q0, q1, q2, q3], [r0, r1, r2, r3], q_addr, kv_addr,
+            warp_first_cand, lane, valid, swa=known_swa, assume_valid=False)
+    qk[0], qk[1], qk[2], qk[3] = q0, q1, q2, q3
+    qk2[0], qk2[1], qk2[2], qk2[3] = r0, r1, r2, r3
+    return qk, qk2, all_valid, tag
+
+
+@cute.jit
+def s1_pair_dispatch(qk, qk2, q_addr: Int32, kv_addr: Int32, warp_first_cand: Int32, lane: Int32,
+                     known_swa: cutlass.Boolean):
+    """Runtime SWA/indexed dispatch for s1_pair returning (qk, qk2, all_valid, tag)."""
+    q0, q1, q2, q3 = qk[0], qk[1], qk[2], qk[3]
+    r0, r1, r2, r3 = qk2[0], qk2[1], qk2[2], qk2[3]
+    all_valid = cutlass.Boolean(False)
+    tag = Int32(2)
+    if known_swa:
+        a, b, all_valid, tag = s1_pair(
+            [q0, q1, q2, q3], [r0, r1, r2, r3], q_addr, kv_addr, warp_first_cand, lane, known_swa=True)
+        q0, q1, q2, q3 = a[0], a[1], a[2], a[3]
+        r0, r1, r2, r3 = b[0], b[1], b[2], b[3]
+    else:
+        a, b, all_valid, tag = s1_pair(
+            [q0, q1, q2, q3], [r0, r1, r2, r3], q_addr, kv_addr, warp_first_cand, lane, known_swa=False)
+        q0, q1, q2, q3 = a[0], a[1], a[2], a[3]
+        r0, r1, r2, r3 = b[0], b[1], b[2], b[3]
+    qk[0], qk[1], qk[2], qk[3] = q0, q1, q2, q3
+    qk2[0], qk2[1], qk2[2], qk2[3] = r0, r1, r2, r3
+    return qk, qk2, all_valid, tag
+
+
+@cute.jit
+def s3_mask_and_scale_tag_pair(
+    qk0,
+    qk1,
+    tag: Int32,
+    all_valid: cutlass.Boolean,
+    sm_scale_log2: Float32,
+    lane: Int32,
+):
+    """Tag-reusing S3 mask + base-2 prescale for heads 0-15 (qk0[0..3]) and heads 16-23 (qk1[0..1]).
+
+    When ``all_valid`` is True (~95%+ of chunks), skips all index loads and masking (6 FMULs only).
+    On partial chunks, shuffles ``tag`` (0/1 valid, 2 invalid) from lanes ``tid*8`` and ``tid*8+4``.
+    """
+    if not all_valid:
+        tid = lane & Int32(3)
+        tag0 = cute.arch.shuffle_sync(tag, tid * Int32(8))
+        tag1 = cute.arch.shuffle_sync(tag, tid * Int32(8) + Int32(4))
+        if tag0 == Int32(2):
+            qk0[0] = Float32(-1.0e30)
+            qk0[2] = Float32(-1.0e30)
+            qk1[0] = Float32(-1.0e30)
+        if tag1 == Int32(2):
+            qk0[1] = Float32(-1.0e30)
+            qk0[3] = Float32(-1.0e30)
+            qk1[1] = Float32(-1.0e30)
+
+    qk0[0] = qk0[0] * sm_scale_log2
+    qk0[1] = qk0[1] * sm_scale_log2
+    qk0[2] = qk0[2] * sm_scale_log2
+    qk0[3] = qk0[3] * sm_scale_log2
+    qk1[0] = qk1[0] * sm_scale_log2
+    qk1[1] = qk1[1] * sm_scale_log2
+    return qk0, qk1
+
+
+@cute.jit
+def s5_pair(w_pre, w_pre2, sm_p_addr: Int32, sm_p2_addr: Int32, warp_id: Int32, lane: Int32):
+    """Vectorized bf16x2 P stores for 16 + 8 heads (3x st.shared.u32 instead of 6x st.shared.u16)."""
+    gid = lane >> Int32(2)
+    tid = lane & Int32(3)
+    c0 = warp_id * Int32(8) + tid * Int32(2)
+    st_shared_bf16x2_from_f32(sm_p_addr + (gid * Int32(SM_P_STRIDE) + c0) * Int32(2), w_pre[0], w_pre[1])
+    st_shared_bf16x2_from_f32(
+        sm_p_addr + ((gid + Int32(8)) * Int32(SM_P_STRIDE) + c0) * Int32(2), w_pre[2], w_pre[3])
+    st_shared_bf16x2_from_f32(sm_p2_addr + (gid * Int32(SM_P_STRIDE) + c0) * Int32(2), w_pre2[0], w_pre2[1])
+
+
+@cute.jit
+def s4_online_softmax_h24_exact(
+    qk0,
+    qk1,
+    accn: cute.Tensor,
+    accn2: cute.Tensor,
+    gstate: cute.Tensor,
+    reduce_max_addr: Int32,
+    reduce_sum_addr: Int32,
+    is_first: cutlass.Boolean,
+    warp_id: Int32,
+    lane: Int32,
+):
+    """Fused 1-barrier online softmax for 16 + 8 heads, bit-identical to two b12x s4_online_softmax calls."""
+    gid = lane >> Int32(2)
+    tid = lane & Int32(3)
+    _NI = Float32(-1e29)
+
+    lm0 = fmax_f32(qk0[0], qk0[1])
+    lm1 = fmax_f32(qk0[2], qk0[3])
+    lm2 = fmax_f32(qk1[0], qk1[1])
+    lm0 = fmax_f32(lm0, cute.arch.shuffle_sync_bfly(lm0, offset=2))
+    lm1 = fmax_f32(lm1, cute.arch.shuffle_sync_bfly(lm1, offset=2))
+    lm2 = fmax_f32(lm2, cute.arch.shuffle_sync_bfly(lm2, offset=2))
+    lm0 = fmax_f32(lm0, cute.arch.shuffle_sync_bfly(lm0, offset=1))
+    lm1 = fmax_f32(lm1, cute.arch.shuffle_sync_bfly(lm1, offset=1))
+    lm2 = fmax_f32(lm2, cute.arch.shuffle_sync_bfly(lm2, offset=1))
+
+    p00 = _exp2_approx_ftz_f32(qk0[0] - lm0)
+    p01 = _exp2_approx_ftz_f32(qk0[1] - lm0)
+    p02 = _exp2_approx_ftz_f32(qk0[2] - lm1)
+    p03 = _exp2_approx_ftz_f32(qk0[3] - lm1)
+    p10 = _exp2_approx_ftz_f32(qk1[0] - lm2)
+    p11 = _exp2_approx_ftz_f32(qk1[1] - lm2)
+
+    ls0 = p00 + p01
+    ls1 = p02 + p03
+    ls2 = p10 + p11
+    ls0 = ls0 + cute.arch.shuffle_sync_bfly(ls0, offset=2)
+    ls1 = ls1 + cute.arch.shuffle_sync_bfly(ls1, offset=2)
+    ls2 = ls2 + cute.arch.shuffle_sync_bfly(ls2, offset=2)
+    ls0 = ls0 + cute.arch.shuffle_sync_bfly(ls0, offset=1)
+    ls1 = ls1 + cute.arch.shuffle_sync_bfly(ls1, offset=1)
+    ls2 = ls2 + cute.arch.shuffle_sync_bfly(ls2, offset=1)
+
+    if tid == Int32(0):
+        base = warp_id * Int32(HEADS) + gid
+        st_shared_f32(reduce_max_addr + base * Int32(4), lm0)
+        st_shared_f32(reduce_max_addr + (base + Int32(8)) * Int32(4), lm1)
+        st_shared_f32(reduce_max_addr + (base + Int32(16)) * Int32(4), lm2)
+        st_shared_f32(reduce_sum_addr + base * Int32(4), ls0)
+        st_shared_f32(reduce_sum_addr + (base + Int32(8)) * Int32(4), ls1)
+        st_shared_f32(reduce_sum_addr + (base + Int32(16)) * Int32(4), ls2)
+    cute.arch.barrier(barrier_id=3, number_of_threads=MATH_THREADS)
+
+    h1 = gid + Int32(8)
+    h2 = gid + Int32(16)
+    wmax0, wmax1, wmax2 = [], [], []
+    wsum0, wsum1, wsum2 = [], [], []
+    for w in cutlass.range_constexpr(8):
+        wb = Int32(w) * Int32(HEADS)
+        wmax0.append(ld_shared_f32(reduce_max_addr + (wb + gid) * Int32(4)))
+        wsum0.append(ld_shared_f32(reduce_sum_addr + (wb + gid) * Int32(4)))
+        wmax1.append(ld_shared_f32(reduce_max_addr + (wb + h1) * Int32(4)))
+        wsum1.append(ld_shared_f32(reduce_sum_addr + (wb + h1) * Int32(4)))
+        wmax2.append(ld_shared_f32(reduce_max_addr + (wb + h2) * Int32(4)))
+        wsum2.append(ld_shared_f32(reduce_sum_addr + (wb + h2) * Int32(4)))
+
+    blm0 = Float32(-1e30)
+    blm1 = Float32(-1e30)
+    blm2 = Float32(-1e30)
+    for w in cutlass.range_constexpr(8):
+        blm0 = fmax_f32(blm0, wmax0[w])
+        blm1 = fmax_f32(blm1, wmax1[w])
+        blm2 = fmax_f32(blm2, wmax2[w])
+
+    bls0 = Float32(0.0)
+    bls1 = Float32(0.0)
+    bls2 = Float32(0.0)
+    for w in cutlass.range_constexpr(8):
+        bls0 = bls0 + wsum0[w] * _exp2_approx_ftz_f32(wmax0[w] - blm0)
+        bls1 = bls1 + wsum1[w] * _exp2_approx_ftz_f32(wmax1[w] - blm1)
+        bls2 = bls2 + wsum2[w] * _exp2_approx_ftz_f32(wmax2[w] - blm2)
+
+    gm0, gm1, gm2 = gstate[0], gstate[1], gstate[4]
+    ngm0 = fmax_f32(gm0, blm0)
+    ngm1 = fmax_f32(gm1, blm1)
+    ngm2 = fmax_f32(gm2, blm2)
+    alpha0 = Float32(0.0)
+    alpha1 = Float32(0.0)
+    alpha2 = Float32(0.0)
+    if gm0 > _NI:
+        alpha0 = _exp2_approx_ftz_f32(gm0 - ngm0)
+    if gm1 > _NI:
+        alpha1 = _exp2_approx_ftz_f32(gm1 - ngm1)
+    if gm2 > _NI:
+        alpha2 = _exp2_approx_ftz_f32(gm2 - ngm2)
+
+    br0 = _exp2_approx_ftz_f32(blm0 - ngm0)
+    br1 = _exp2_approx_ftz_f32(blm1 - ngm1)
+    br2 = _exp2_approx_ftz_f32(blm2 - ngm2)
+    wr0 = _exp2_approx_ftz_f32(lm0 - ngm0)
+    wr1 = _exp2_approx_ftz_f32(lm1 - ngm1)
+    vr0 = _exp2_approx_ftz_f32(lm2 - ngm2)
+
+    if not is_first:
+        if fmin_f32(alpha0, alpha1) < Float32(1.0):
+            for vc in cutlass.range_constexpr(N_V_CHUNKS):
+                accn[vc * 4 + 0] = accn[vc * 4 + 0] * alpha0
+                accn[vc * 4 + 1] = accn[vc * 4 + 1] * alpha0
+                accn[vc * 4 + 2] = accn[vc * 4 + 2] * alpha1
+                accn[vc * 4 + 3] = accn[vc * 4 + 3] * alpha1
+        if alpha2 < Float32(1.0):
+            for vc in cutlass.range_constexpr(N_V_CHUNKS):
+                accn2[vc * 2 + 0] = accn2[vc * 2 + 0] * alpha2
+                accn2[vc * 2 + 1] = accn2[vc * 2 + 1] * alpha2
+        gstate[2] = gstate[2] * alpha0 + bls0 * br0
+        gstate[3] = gstate[3] * alpha1 + bls1 * br1
+        gstate[5] = gstate[5] * alpha2 + bls2 * br2
+    else:
+        gstate[2] = bls0 * br0
+        gstate[3] = bls1 * br1
+        gstate[5] = bls2 * br2
+    gstate[0] = ngm0
+    gstate[1] = ngm1
+    gstate[4] = ngm2
+
+    return [p00 * wr0, p01 * wr0, p02 * wr1, p03 * wr1], [p10 * vr0, p11 * vr0]
+
+
+@cute.jit
+def _pv_pair_inplace(accn: cute.Tensor, accn2: cute.Tensor, sm_p_addr: Int32, sm_p2_addr: Int32, kv_addr: Int32,
+                     warp_id: Int32, lane: Int32, latent_scale: Float32, *, known_swa: cutlass.Constexpr):
+    """In-place BF16 P.V for 16 + 8 heads: outer ks (0..3), inner vc (0..7).
+
+    Hoists P ldmatrix (8 instead of 64/chunk) and source-tag loads (8 instead of 64/chunk) to the outer ks loop,
+    and accumulates directly into accn/accn2 (eliminating 8 temp regs and 48 FADDs/chunk).
+    """
+    gid = lane >> Int32(2)
+    tid = lane & Int32(3)
+    entry_parity = gid & Int32(1)
+    pair_selector = Int32(0x5410 if entry_parity == Int32(0) else 0x3276)
+    a_row = (lane & Int32(7)) + ((lane >> Int32(3)) & Int32(1)) * Int32(8)
+    a_row2 = lane & Int32(7)
+    a_col = (lane >> Int32(4)) * Int32(8)
+    col_warp_lane = warp_id * Int32(8) + (gid & ~Int32(1))
+    want_tag = Int32(1 if known_swa else 0)
+    swa_scale_lane = warp_id >> Int32(2)
+    nvfp4_scale_lane = warp_id >> Int32(1)
+
+    for ks in cutlass.range_constexpr(BI // 16):
+        k_base = Int32(ks * 16)
+        a0, a1, a2, a3 = ldmatrix_m8n8x4_b16(
+            sm_p_addr + (a_row * Int32(SM_P_STRIDE) + (k_base + a_col)) * Int32(2))
+        c0, c1, c2, c3 = ldmatrix_m8n8x4_b16(
+            sm_p2_addr + (a_row2 * Int32(SM_P_STRIDE) + (k_base + a_col)) * Int32(2))
+        ent0 = k_base + tid * Int32(2) + entry_parity
+        row0 = kv_addr + ent0 * Int32(KV_SMEM_STRIDE)
+        row8 = row0 + Int32(8 * KV_SMEM_STRIDE)
+        tag0 = ld_shared_u32(row0 + Int32(528)).to(Int32)
+        tag8 = ld_shared_u32(row8 + Int32(528)).to(Int32)
+        v0_ok = tag0 == want_tag
+        v8_ok = tag8 == want_tag
+        all_valid = cute.arch.vote_all_sync(v0_ok & v8_ok)
+        if all_valid:
+            for vc in cutlass.range_constexpr(N_V_CHUNKS):
+                if cutlass.const_expr(known_swa):
+                    dim_off = Int32(vc * 64) + col_warp_lane
+                    sc_off = Int32(512 + vc * 2) + swa_scale_lane
+                    pair0, pair8 = _mxfp8_pv_pair_sm120(
+                        dm._ld_u16_zext(row0, dim_off),
+                        dm._ld_u16_zext(row8, dim_off),
+                        dm._ld_u8_zext(row0, sc_off),
+                        dm._ld_u8_zext(row8, sc_off),
+                    )
+                else:
+                    byte_off = Int32(vc * 32) + (col_warp_lane >> Int32(1))
+                    sc_off = Int32(256 + vc * 4) + nvfp4_scale_lane
+                    pair0, pair8 = _nvfp4_pv_pair_sm120(
+                        dm._ld_u8_zext(row0, byte_off),
+                        dm._ld_u8_zext(row8, byte_off),
+                        dm._ld_u8_zext(row0, sc_off),
+                        dm._ld_u8_zext(row8, sc_off),
+                    )
+                peer0 = cute.arch.shuffle_sync_bfly(pair0, offset=4)
+                peer8 = cute.arch.shuffle_sync_bfly(pair8, offset=4)
+                b0 = byte_perm(pair0, peer0, pair_selector)
+                b1 = byte_perm(pair8, peer8, pair_selector)
+                accn[vc * 4 + 0], accn[vc * 4 + 1], accn[vc * 4 + 2], accn[vc * 4 + 3] = mma_m16n8k16_f32_bf16(
+                    accn[vc * 4 + 0], accn[vc * 4 + 1], accn[vc * 4 + 2], accn[vc * 4 + 3],
+                    a0, a1, a2, a3, b0, b1)
+                accn2[vc * 2 + 0], accn2[vc * 2 + 1], _, _ = mma_m16n8k16_f32_bf16(
+                    accn2[vc * 2 + 0], accn2[vc * 2 + 1], Float32(0.0), Float32(0.0),
+                    c0, c1, c2, c3, b0, b1)
+        else:
+            for vc in cutlass.range_constexpr(N_V_CHUNKS):
+                pair0 = Uint32(0)
+                pair8 = Uint32(0)
+                if cutlass.const_expr(known_swa):
+                    dim_off = Int32(vc * 64) + col_warp_lane
+                    sc_off = Int32(512 + vc * 2) + swa_scale_lane
+                    if v0_ok:
+                        pair0 = mxfp8_pair_to_bf16x2_sm120(
+                            dm._ld_u16_zext(row0, dim_off), dm._ld_u8_zext(row0, sc_off))
+                    if v8_ok:
+                        pair8 = mxfp8_pair_to_bf16x2_sm120(
+                            dm._ld_u16_zext(row8, dim_off), dm._ld_u8_zext(row8, sc_off))
+                else:
+                    byte_off = Int32(vc * 32) + (col_warp_lane >> Int32(1))
+                    sc_off = Int32(256 + vc * 4) + nvfp4_scale_lane
+                    if v0_ok:
+                        pair0 = nvfp4_pair_to_bf16x2_sm120(
+                            dm._ld_u8_zext(row0, byte_off), dm._ld_u8_zext(row0, sc_off))
+                    if v8_ok:
+                        pair8 = nvfp4_pair_to_bf16x2_sm120(
+                            dm._ld_u8_zext(row8, byte_off), dm._ld_u8_zext(row8, sc_off))
+                peer0 = cute.arch.shuffle_sync_bfly(pair0, offset=4)
+                peer8 = cute.arch.shuffle_sync_bfly(pair8, offset=4)
+                b0 = byte_perm(pair0, peer0, pair_selector)
+                b1 = byte_perm(pair8, peer8, pair_selector)
+                accn[vc * 4 + 0], accn[vc * 4 + 1], accn[vc * 4 + 2], accn[vc * 4 + 3] = mma_m16n8k16_f32_bf16(
+                    accn[vc * 4 + 0], accn[vc * 4 + 1], accn[vc * 4 + 2], accn[vc * 4 + 3],
+                    a0, a1, a2, a3, b0, b1)
+                accn2[vc * 2 + 0], accn2[vc * 2 + 1], _, _ = mma_m16n8k16_f32_bf16(
+                    accn2[vc * 2 + 0], accn2[vc * 2 + 1], Float32(0.0), Float32(0.0),
+                    c0, c1, c2, c3, b0, b1)
