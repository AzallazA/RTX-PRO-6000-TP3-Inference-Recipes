+
+"""CPU interpreter & unit tests for batched Markov finish, staged confidence reuse, and spec_metrics depth parsing."""
+
+import importlib.util
+import os
+import subprocess
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+
+import torch
+import triton
+import triton.language as tl
