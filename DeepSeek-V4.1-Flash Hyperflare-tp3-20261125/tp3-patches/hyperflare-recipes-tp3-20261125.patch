+"""CuTe kernel of the one-launch 24-head DSV41 BF16 MLA decode (see mla_h24_decode.py for the design and hook).
+
+Specialised copy of b12x ``UnifiedDecodeKernel._kernel_body`` for the path a TP3 DS41 rank runs (DSV41, BF16
+arithmetic, NVFP4/MXFP8 544-byte staging, SWA + indexed sections, per-token lengths, fused page mapping, generic
+8-math-warp arm). The IO producer, S3 mask, S4 online softmax and S7 epilogue are b12x's own functions; the QK, P
+store and PV stages are b12x's with each dequantized K/V fragment fed to two MMAs (heads 0-15 and 16-23).
+"""
+
+import functools
+
+import cutlass
+import cutlass.cute as cute
+import cutlass.utils as cutlass_utils
+from cutlass import Float32, Int32, Int64, Uint32
+from cutlass._mlir import ir
+from cutlass._mlir.dialects import llvm
+from cutlass.cutlass_dsl import T, dsl_user_op
+
+from b12x._lib.intrinsics.atomics import ld_shared_u32, st_shared_u32, store_bf16x2
+from b12x._lib.intrinsics.constants import mma_m16n8k16_f32_bf16
+from b12x._lib.intrinsics.math import fmax_f32, fmin_f32, rcp_approx_ftz
+from b12x._lib.intrinsics.memory import (
+    cp_async_bulk_g2s_mbar,
+    elem_pointer,
+    get_ptr_as_int64,
+    ld_global_nc_v4_u32,
+    ld_shared_v2_u32,
+    ld_shared_v4_u32,
+    ldmatrix_m8n8x4_b16,
+    shared_ptr_to_u32,
+    st_global_v4_u32,
+    st_shared_v4_u32,
+    u32_as_f32,
+)
+from b12x._lib.intrinsics.packed import (
+    byte_perm,
+    fp8x4_e4m3_to_bfloat2x2_native_sm120,
+    mxfp8_pair_to_bf16x2_sm120,
+    nvfp4_pair_to_bf16x2_sm120,
+)
+from b12x.attention._shared.cute.ops import LOG2_E
+from b12x.attention._shared.mla import decode_math as dm
+from b12x.attention._shared.mla.decode_math import (
+    EPILOGUE_FINAL_BF16,
+    EPILOGUE_PARTIAL_WRITEBACK,
+    _NEG_INF,
+    _exp2_approx_ftz_f32,
+    _log2_approx_ftz_f32,
+    ld_shared_f32,
+    st_shared_f32,
+)
+from b12x.attention._shared.mla.kernel import _exit_thread
+
+from hyperflare_recipes.components.mla_h24_decode import (BI, BLOCK_THREADS, CAND_WINDOW, D_NOPE, HEADS, KV_SMEM_STRIDE,
+                                                MATH_THREADS, N_V_CHUNKS, Q_NOPE_STRIDE, SM_P_STRIDE, check_traits,
+                                                smem_offsets, SMEM_LIMIT)
+
+
+@functools.lru_cache(maxsize=1)
+def storage_cls():
+    class SharedStorage:
+        pass
+
+    SharedStorage.__annotations__ = {
+        "q": cute.struct.Align[cute.struct.MemRange[cutlass.BFloat16, HEADS * Q_NOPE_STRIDE], 128],
+        "kv": cute.struct.Align[cute.struct.MemRange[cutlass.Uint8, 2 * BI * KV_SMEM_STRIDE], 128],
+        "mbar": cute.struct.Align[cute.struct.MemRange[cutlass.Uint64, 4], 16],
+        "reduce": cute.struct.MemRange[cutlass.Float32, 2 * 8 * HEADS],
+        "sm_p": cute.struct.Align[cute.struct.MemRange[cutlass.BFloat16, 16 * SM_P_STRIDE], 128],
+        "sm_p2": cute.struct.Align[cute.struct.MemRange[cutlass.BFloat16, 8 * SM_P_STRIDE], 16],
+    }
+    storage = cute.struct(SharedStorage)
+    expected, total = smem_offsets()
+    if dict(storage._offsets) != {name: offset for name, offset, _ in expected}:
+        raise ValueError(f"H24 SharedStorage offsets {dict(storage._offsets)} diverge from {expected}")
+    if int(storage.size_in_bytes()) != total or total > SMEM_LIMIT:
+        raise ValueError(f"H24 SharedStorage is {int(storage.size_in_bytes())} B (layout {total}, limit {SMEM_LIMIT})")
+    return storage
+
+
+@dsl_user_op
+def _rotate_bf16x2(pair_u32: Uint32, c: Float32, s: Float32, *, loc=None, ip=None) -> Uint32:
+    """Rotate one packed bf16x2 interleaved pair (a, b) in FP32 and repack to bf16x2."""
+    return Uint32(
+        llvm.inline_asm(
+            T.i32(),
+            [
+                Uint32(pair_u32).ir_value(loc=loc, ip=ip),
+                Float32(c).ir_value(loc=loc, ip=ip),
+                Float32(s).ir_value(loc=loc, ip=ip),
+            ],
+            """
+            {
+                .reg .b32 lo, hi;
+                .reg .f32 a, b, t0, t1, oa, ob;
+                shl.b32 lo, $1, 16;
+                and.b32 hi, $1, 0xFFFF0000;
+                mov.b32 a, lo;
+                mov.b32 b, hi;
+                mul.f32 t0, b, $3;
+                mul.f32 t1, b, $2;
+                neg.f32 t0, t0;
+                fma.rn.f32 oa, a, $2, t0;
+                fma.rn.f32 ob, a, $3, t1;
+                cvt.rn.bf16x2.f32 $0, ob, oa;
+            }
+            """,
+            "=r,r,f,f",
+            has_side_effects=False,
+            is_align_stack=False,
+            asm_dialect=llvm.AsmDialect.AD_ATT,
+            loc=loc,
+            ip=ip,
+        )
+    )
+
+
+@cute.jit
+def s0_load_q24(
+    q_token: cute.Tensor,
+    q_addr: Int32,
+    tid: Int32,
+    angles_row=None,
+    *,
+    fuse_rope: cutlass.Constexpr = False,
+    split_angles: cutlass.Constexpr = True,
+):
+    """Vectorized 128-bit (8x BF16) Q loader for all 24 heads (1536 packs / 256 threads = 6 packs/thread).
+
+    When ``fuse_rope=True``, threads owning dims [448, 512) (``(tid & 63) >= 56``, 32 threads total) load 4 FP32
+    (cos, sin) pairs once and rotate each 8x BF16 pack in registers before writing to SMEM across all 6 head steps.
+    """
+    pack = tid & Int32(63)
+    h0 = tid >> Int32(6)
+    d = pack * Int32(8)
+    if cutlass.const_expr(fuse_rope):
+        is_rope = pack >= Int32(56)
+        c0 = Float32(0.0)
+        c1 = Float32(0.0)
+        c2 = Float32(0.0)
+        c3 = Float32(0.0)
+        s0 = Float32(0.0)
+        s1 = Float32(0.0)
+        s2 = Float32(0.0)
+        s3 = Float32(0.0)
+        if is_rope:
+            pair0 = (pack - Int32(56)) * Int32(4)
+            if cutlass.const_expr(split_angles):
+                cu0, cu1, cu2, cu3 = ld_global_nc_v4_u32((angles_row.iterator + pair0).toint())
+                su0, su1, su2, su3 = ld_global_nc_v4_u32((angles_row.iterator + pair0 + Int32(32)).toint())
+                c0, c1, c2, c3 = u32_as_f32(cu0), u32_as_f32(cu1), u32_as_f32(cu2), u32_as_f32(cu3)
+                s0, s1, s2, s3 = u32_as_f32(su0), u32_as_f32(su1), u32_as_f32(su2), u32_as_f32(su3)
+            else:
+                a0, a1, a2, a3 = ld_global_nc_v4_u32((angles_row.iterator + pair0 * Int32(2)).toint())
+                b0, b1, b2, b3 = ld_global_nc_v4_u32((angles_row.iterator + pair0 * Int32(2) + Int32(4)).toint())
+                c0, s0, c1, s1 = u32_as_f32(a0), u32_as_f32(a1), u32_as_f32(a2), u32_as_f32(a3)
+                c2, s2, c3, s3 = u32_as_f32(b0), u32_as_f32(b1), u32_as_f32(b2), u32_as_f32(b3)
+        for step in cutlass.range_constexpr((HEADS * (D_NOPE // 8)) // MATH_THREADS):
+            h = h0 + Int32(step * 4)
+            v0, v1, v2, v3 = ld_global_nc_v4_u32(elem_pointer(q_token, (h, d)).toint())
+            if is_rope:
+                v0 = _rotate_bf16x2(v0, c0, s0)
+                v1 = _rotate_bf16x2(v1, c1, s1)
+                v2 = _rotate_bf16x2(v2, c2, s2)
+                v3 = _rotate_bf16x2(v3, c3, s3)
+            st_shared_v4_u32(q_addr + (h * Int32(Q_NOPE_STRIDE) + d) * Int32(2), v0, v1, v2, v3)
+    else:
+        for step in cutlass.range_constexpr((HEADS * (D_NOPE // 8)) // MATH_THREADS):
+            h = h0 + Int32(step * 4)
+            v0, v1, v2, v3 = ld_global_nc_v4_u32(elem_pointer(q_token, (h, d)).toint())
+            st_shared_v4_u32(q_addr + (h * Int32(Q_NOPE_STRIDE) + d) * Int32(2), v0, v1, v2, v3)
+    cute.arch.barrier(barrier_id=2, number_of_threads=MATH_THREADS)
+
+
+@dsl_user_op
+def _ue8m0x2_to_bf16x2_sm120(packed16: Uint32, *, loc=None, ip=None) -> Uint32:
+    """Convert two packed UE8M0 scale bytes (in low 16 bits) to bf16x2 on SM120a."""
+    return Uint32(
+        llvm.inline_asm(
+            T.i32(),
+            [Uint32(packed16).ir_value(loc=loc, ip=ip)],
+            """
+            {
+                .reg .b16 sf;
+                cvt.u16.u32 sf, $1;
+                cvt.rn.bf16x2.ue8m0x2 $0, sf;
+            }
+            """,
+            "=r,r",
+            has_side_effects=False,
+            is_align_stack=False,
+            asm_dialect=llvm.AsmDialect.AD_ATT,
+            loc=loc,
+            ip=ip,
+        )
+    )
+
+
+@dsl_user_op
+def _mxfp8_pairs_with_bf16_scale_sm120(
+    packed0: Uint32,
+    packed1: Uint32,
+    scale_pair: Uint32,
+    *,
+    hi: bool,
+    loc=None,
+    ip=None,
+):
+    """Decode two E4M3 pairs and scale by the low or high BF16 lane of ``scale_pair``."""
+    sel = "0x3232" if hi else "0x1010"
+    result = llvm.inline_asm(
+        ir.Type.parse("!llvm.struct<(i32, i32)>"),
+        [
+            Uint32(packed0).ir_value(loc=loc, ip=ip),
+            Uint32(packed1).ir_value(loc=loc, ip=ip),
+            Uint32(scale_pair).ir_value(loc=loc, ip=ip),
+        ],
+        f"""
+        {{
+            .reg .b16 q0, q1;
+            .reg .b32 v0, v1, factors;
+            cvt.u16.u32 q0, $2;
+            cvt.u16.u32 q1, $3;
+            cvt.rn.bf16x2.e4m3x2 v0, q0;
+            cvt.rn.bf16x2.e4m3x2 v1, q1;
+            prmt.b32 factors, $4, $4, {sel};
+            mul.bf16x2 $0, v0, factors;
+            mul.bf16x2 $1, v1, factors;
+        }}
+        """,
+        "=r,=r,r,r,r",
+        has_side_effects=False,
+        is_align_stack=False,
+        asm_dialect=llvm.AsmDialect.AD_ATT,
+        loc=loc,
+        ip=ip,
+    )
+    return (
+        Uint32(llvm.extractvalue(T.i32(), result, [0], loc=loc, ip=ip)),
+        Uint32(llvm.extractvalue(T.i32(), result, [1], loc=loc, ip=ip)),
+    )
+
+
+@dsl_user_op
+def _nvfp4_pairs_with_bf16_scale_sm120(
+    packed0: Uint32,
+    packed1: Uint32,
+    scale_pair: Uint32,
+    *,
+    hi: bool,
+    loc=None,
+    ip=None,
+):
+    """Decode two E2M1 pairs and scale by the low or high BF16 lane of ``scale_pair``."""
+    sel = "0x3232" if hi else "0x1010"
+    result = llvm.inline_asm(
+        ir.Type.parse("!llvm.struct<(i32, i32)>"),
+        [
+            Uint32(packed0).ir_value(loc=loc, ip=ip),
+            Uint32(packed1).ir_value(loc=loc, ip=ip),
+            Uint32(scale_pair).ir_value(loc=loc, ip=ip),
+        ],
+        f"""
+        {{
+            .reg .b8 q0, q1;
+            .reg .b32 v0, v1, factors;
+            cvt.u8.u32 q0, $2;
+            cvt.u8.u32 q1, $3;
+            cvt.rn.bf16x2.e2m1x2 v0, q0;
+            cvt.rn.bf16x2.e2m1x2 v1, q1;
+            prmt.b32 factors, $4, $4, {sel};
+            mul.bf16x2 $0, v0, factors;
+            mul.bf16x2 $1, v1, factors;
+        }}
+        """,
+        "=r,=r,r,r,r",
+        has_side_effects=False,
+        is_align_stack=False,
+        asm_dialect=llvm.AsmDialect.AD_ATT,
+        loc=loc,
+        ip=ip,
+    )
+    return (
+        Uint32(llvm.extractvalue(T.i32(), result, [0], loc=loc, ip=ip)),
+        Uint32(llvm.extractvalue(T.i32(), result, [1], loc=loc, ip=ip)),
+    )
+
+
+@cute.jit
+def _qk_source_pair(qk, qk2, q_addr: Int32, kv_addr: Int32, warp_first_cand: Int32, lane: Int32,
+                    valid: cutlass.Boolean, *, swa: cutlass.Constexpr, assume_valid: cutlass.Constexpr = True,
+                    vec_nvfp4: cutlass.Constexpr = True):
+    """DSV41 QK with packed scale loads (u32 for NVFP4, u16 for MXFP8) fed to both head tiles.
+
+    Fast path (``assume_valid=True``) is fully unrolled with zero branches. Rare partial-tile
+    path (``assume_valid=False``) rolls the outer ``blk`` loop (``unroll=1``) to cut I-cache ~35%
+    while keeping packed scale loads and zero stack/local spills.
+    """
+    gid = lane >> Int32(2)
+    tid = lane & Int32(3)
+    tid_shift = tid << Int32(3)
+    a_row = (lane & Int32(7)) + ((lane >> Int32(3)) & Int32(1)) * Int32(8)
+    a_row2 = Int32(16) + (lane & Int32(7))
+    a_col = (lane >> Int32(4)) * Int32(8)
+    kv_gid_row = warp_first_cand + gid
+    row = kv_addr + kv_gid_row * Int32(544)
+    q0, q1, q2, q3 = qk[0], qk[1], qk[2], qk[3]
+    r0, r1, r2, r3 = qk2[0], qk2[1], qk2[2], qk2[3]
+    if cutlass.const_expr(assume_valid):
+        for blk in cutlass.range_constexpr(8):
+            if cutlass.const_expr(swa):
+                s_pair = _ue8m0x2_to_bf16x2_sm120(dm._ld_u16_zext(row, Int32(512 + blk * 2)))
+                for ks in cutlass.range_constexpr(4):
+                    ko = Int32(blk * 64 + ks * 16)
+                    dim_even = ko + tid * Int32(2)
+                    p0 = dm._ld_u16_zext(row, dim_even)
+                    p1 = dm._ld_u16_zext(row, dim_even + Int32(8))
+                    b0, b1 = _mxfp8_pairs_with_bf16_scale_sm120(p0, p1, s_pair, hi=(ks >= 2))
+                    a0, a1, a2, a3 = ldmatrix_m8n8x4_b16(
+                        dm._smem_byte(q_addr, a_row * Int32(Q_NOPE_STRIDE * 2) + (ko + a_col) * Int32(2)))
+                    q0, q1, q2, q3 = mma_m16n8k16_f32_bf16(q0, q1, q2, q3, a0, a1, a2, a3, b0, b1)
+                    c0, c1, c2, c3 = ldmatrix_m8n8x4_b16(
+                        dm._smem_byte(q_addr, a_row2 * Int32(Q_NOPE_STRIDE * 2) + (ko + a_col) * Int32(2)))
+                    r0, r1, r2, r3 = mma_m16n8k16_f32_bf16(r0, r1, r2, r3, c0, c1, c2, c3, b0, b1)
+            else:
+                s_word = ld_shared_u32(row + Int32(256 + blk * 4))
+                s01, s23 = fp8x4_e4m3_to_bfloat2x2_native_sm120(s_word)
+                if cutlass.const_expr(vec_nvfp4):
+                    w0, w1 = ld_shared_v2_u32(row + Int32(blk * 32) + tid * Int32(8))
+                    for ks in cutlass.range_constexpr(4):
+                        ko = Int32(blk * 64 + ks * 16)
+                        w0_ks = cute.arch.shuffle_sync(w0, ks, mask_and_clamp=0x1C03)
+                        w1_ks = cute.arch.shuffle_sync(w1, ks, mask_and_clamp=0x1C03)
+                        b0, b1 = _nvfp4_pairs_with_bf16_scale_sm120(
+                            w0_ks >> tid_shift, w1_ks >> tid_shift,
+                            s01 if ks < 2 else s23, hi=((ks & 1) == 1))
+                        a0, a1, a2, a3 = ldmatrix_m8n8x4_b16(
+                            dm._smem_byte(q_addr, a_row * Int32(Q_NOPE_STRIDE * 2) + (ko + a_col) * Int32(2)))
+                        q0, q1, q2, q3 = mma_m16n8k16_f32_bf16(q0, q1, q2, q3, a0, a1, a2, a3, b0, b1)
+                        c0, c1, c2, c3 = ldmatrix_m8n8x4_b16(
+                            dm._smem_byte(q_addr, a_row2 * Int32(Q_NOPE_STRIDE * 2) + (ko + a_col) * Int32(2)))
+                        r0, r1, r2, r3 = mma_m16n8k16_f32_bf16(r0, r1, r2, r3, c0, c1, c2, c3, b0, b1)
+                else:
+                    for ks in cutlass.range_constexpr(4):
+                        ko = Int32(blk * 64 + ks * 16)
+                        byte_off = Int32(blk * 32 + ks * 8) + tid
+                        p0 = dm._ld_u8_zext(row, byte_off)
+                        p1 = dm._ld_u8_zext(row, byte_off + Int32(4))
+                        b0, b1 = _nvfp4_pairs_with_bf16_scale_sm120(
+                            p0, p1, s01 if ks < 2 else s23, hi=((ks & 1) == 1))
+                        a0, a1, a2, a3 = ldmatrix_m8n8x4_b16(
+                            dm._smem_byte(q_addr, a_row * Int32(Q_NOPE_STRIDE * 2) + (ko + a_col) * Int32(2)))
+                        q0, q1, q2, q3 = mma_m16n8k16_f32_bf16(q0, q1, q2, q3, a0, a1, a2, a3, b0, b1)
+                        c0, c1, c2, c3 = ldmatrix_m8n8x4_b16(
+                            dm._smem_byte(q_addr, a_row2 * Int32(Q_NOPE_STRIDE * 2) + (ko + a_col) * Int32(2)))
+                        r0, r1, r2, r3 = mma_m16n8k16_f32_bf16(r0, r1, r2, r3, c0, c1, c2, c3, b0, b1)
+    else:
+        for blk in cutlass.range(8, unroll=1):
+            blk_i = Int32(blk)
+            if cutlass.const_expr(swa):
+                s_pair = Uint32(0)
+                if valid:
+                    s_pair = _ue8m0x2_to_bf16x2_sm120(dm._ld_u16_zext(row, Int32(512) + blk_i * Int32(2)))
+                for ks in cutlass.range_constexpr(4):
+                    ko = blk_i * Int32(64) + Int32(ks * 16)
+                    b0, b1 = Uint32(0), Uint32(0)
+                    if valid:
+                        dim_even = ko + tid * Int32(2)
+                        p0 = dm._ld_u16_zext(row, dim_even)
+                        p1 = dm._ld_u16_zext(row, dim_even + Int32(8))
+                        b0, b1 = _mxfp8_pairs_with_bf16_scale_sm120(p0, p1, s_pair, hi=(ks >= 2))
+                    a0, a1, a2, a3 = ldmatrix_m8n8x4_b16(
+                        dm._smem_byte(q_addr, a_row * Int32(Q_NOPE_STRIDE * 2) + (ko + a_col) * Int32(2)))
+                    q0, q1, q2, q3 = mma_m16n8k16_f32_bf16(q0, q1, q2, q3, a0, a1, a2, a3, b0, b1)
+                    c0, c1, c2, c3 = ldmatrix_m8n8x4_b16(
+                        dm._smem_byte(q_addr, a_row2 * Int32(Q_NOPE_STRIDE * 2) + (ko + a_col) * Int32(2)))
+                    r0, r1, r2, r3 = mma_m16n8k16_f32_bf16(r0, r1, r2, r3, c0, c1, c2, c3, b0, b1)
+            else:
+                s01, s23 = Uint32(0), Uint32(0)
+                w0, w1 = Uint32(0), Uint32(0)
+                if valid:
+                    s_word = ld_shared_u32(row + Int32(256) + blk_i * Int32(4))
+                    s01, s23 = fp8x4_e4m3_to_bfloat2x2_native_sm120(s_word)
+                    if cutlass.const_expr(vec_nvfp4):
+                        w0, w1 = ld_shared_v2_u32(row + blk_i * Int32(32) + tid * Int32(8))
+                for ks in cutlass.range_constexpr(4):
+                    ko = blk_i * Int32(64) + Int32(ks * 16)
+                    if cutlass.const_expr(vec_nvfp4):
+                        w0_ks = cute.arch.shuffle_sync(w0, ks, mask_and_clamp=0x1C03)
+                        w1_ks = cute.arch.shuffle_sync(w1, ks, mask_and_clamp=0x1C03)
+                        b0, b1 = _nvfp4_pairs_with_bf16_scale_sm120(
+                            w0_ks >> tid_shift, w1_ks >> tid_shift,
+                            s01 if ks < 2 else s23, hi=((ks & 1) == 1))
+                    else:
+                        b0, b1 = Uint32(0), Uint32(0)
+                        if valid:
+                            byte_off = blk_i * Int32(32) + Int32(ks * 8) + tid
+                            p0 = dm._ld_u8_zext(row, byte_off)
+                            p1 = dm._ld_u8_zext(row, byte_off + Int32(4))
+                            b0, b1 = _nvfp4_pairs_with_bf16_scale_sm120(
+                                p0, p1, s01 if ks < 2 else s23, hi=((ks & 1) == 1))
+                    a0, a1, a2, a3 = ldmatrix_m8n8x4_b16(
+                        dm._smem_byte(q_addr, a_row * Int32(Q_NOPE_STRIDE * 2) + (ko + a_col) * Int32(2)))
+                    q0, q1, q2, q3 = mma_m16n8k16_f32_bf16(q0, q1, q2, q3, a0, a1, a2, a3, b0, b1)
+                    c0, c1, c2, c3 = ldmatrix_m8n8x4_b16(
+                        dm._smem_byte(q_addr, a_row2 * Int32(Q_NOPE_STRIDE * 2) + (ko + a_col) * Int32(2)))
+                    r0, r1, r2, r3 = mma_m16n8k16_f32_bf16(r0, r1, r2, r3, c0, c1, c2, c3, b0, b1)
+    return q0, q1, q2, q3, r0, r1, r2, r3
+
+
+@dsl_user_op
+def st_shared_bf16x2_from_f32(addr: Int32, f0: Float32, f1: Float32, *, loc=None, ip=None):
+    """Pack two FP32 values to bf16x2 (f0 low, f1 high) and store 32 bits to shared memory."""
+    llvm.inline_asm(
+        None,
+        [
+            Int32(addr).ir_value(loc=loc, ip=ip),
+            Float32(f0).ir_value(loc=loc, ip=ip),
+            Float32(f1).ir_value(loc=loc, ip=ip),
+        ],
+        """
+        {
+            .reg .b32 packed;
+            cvt.rn.bf16x2.f32 packed, $2, $1;
+            st.shared.u32 [$0], packed;
+        }
+        """,
+        "r,f,f",
+        has_side_effects=True,
+        is_align_stack=False,
+        asm_dialect=llvm.AsmDialect.AD_ATT,
+        loc=loc,
+        ip=ip,
+    )
+
+
+@dsl_user_op
+def _mxfp8_pv_pair_sm120(
+    q0: Uint32, q8: Uint32, sc0: Uint32, sc8: Uint32, *, loc=None, ip=None
+):
+    """Decode two MXFP8 E4M3 pairs (row0, row8) using a single packed cvt.rn.bf16x2.ue8m0x2 for (sc0, sc8)."""
+    result = llvm.inline_asm(
+        ir.Type.parse("!llvm.struct<(i32, i32)>"),
+        [
+            Uint32(q0).ir_value(loc=loc, ip=ip),
+            Uint32(q8).ir_value(loc=loc, ip=ip),
+            Uint32(sc0).ir_value(loc=loc, ip=ip),
+            Uint32(sc8).ir_value(loc=loc, ip=ip),
+        ],
+        """
+        {
+            .reg .b16 hq0, hq8, sf;
+            .reg .b32 v0, v8, sf_pair, s08, f0, f8;
+            cvt.u16.u32 hq0, $2;
+            cvt.u16.u32 hq8, $3;
+            prmt.b32 sf_pair, $4, $5, 0x0040;
+            cvt.u16.u32 sf, sf_pair;
+            cvt.rn.bf16x2.ue8m0x2 s08, sf;
+            cvt.rn.bf16x2.e4m3x2 v0, hq0;
+            cvt.rn.bf16x2.e4m3x2 v8, hq8;
+            prmt.b32 f0, s08, s08, 0x1010;
+            prmt.b32 f8, s08, s08, 0x3232;
+            mul.bf16x2 $0, v0, f0;
+            mul.bf16x2 $1, v8, f8;
+        }
+        """,
+        "=r,=r,r,r,r,r",
+        has_side_effects=False,
+        is_align_stack=False,
+        asm_dialect=llvm.AsmDialect.AD_ATT,
+        loc=loc,
+        ip=ip,
+    )
+    return (
+        Uint32(llvm.extractvalue(T.i32(), result, [0], loc=loc, ip=ip)),
+        Uint32(llvm.extractvalue(T.i32(), result, [1], loc=loc, ip=ip)),
+    )
+
+
+@dsl_user_op
+def _nvfp4_pv_pair_sm120(
+    q0: Uint32, q8: Uint32, sc0: Uint32, sc8: Uint32, *, loc=None, ip=None
+):
+    """Decode two NVFP4 E2M1 pairs (row0, row8) using a single packed cvt.rn.bf16x2.e4m3x2 for (sc0, sc8)."""
+    result = llvm.inline_asm(
+        ir.Type.parse("!llvm.struct<(i32, i32)>"),
+        [
+            Uint32(q0).ir_value(loc=loc, ip=ip),
+            Uint32(q8).ir_value(loc=loc, ip=ip),
+            Uint32(sc0).ir_value(loc=loc, ip=ip),
+            Uint32(sc8).ir_value(loc=loc, ip=ip),
+        ],
+        """
+        {
+            .reg .b8 bq0, bq8;
+            .reg .b16 sf;
+            .reg .b32 v0, v8, sf_pair, s08, f0, f8;
+            cvt.u8.u32 bq0, $2;
+            cvt.u8.u32 bq8, $3;
+            prmt.b32 sf_pair, $4, $5, 0x0040;
+            cvt.u16.u32 sf, sf_pair;
+            cvt.rn.bf16x2.e4m3x2 s08, sf;
+            cvt.rn.bf16x2.e2m1x2 v0, bq0;
+            cvt.rn.bf16x2.e2m1x2 v8, bq8;
+            prmt.b32 f0, s08, s08, 0x1010;
+            prmt.b32 f8, s08, s08, 0x3232;
+            mul.bf16x2 $0, v0, f0;
+            mul.bf16x2 $1, v8, f8;
+        }
+        """,
+        "=r,=r,r,r,r,r",
+        has_side_effects=False,
+        is_align_stack=False,
+        asm_dialect=llvm.AsmDialect.AD_ATT,
+        loc=loc,
+        ip=ip,
+    )
+    return (
+        Uint32(llvm.extractvalue(T.i32(), result, [0], loc=loc, ip=ip)),
+        Uint32(llvm.extractvalue(T.i32(), result, [1], loc=loc, ip=ip)),
+    )
+
