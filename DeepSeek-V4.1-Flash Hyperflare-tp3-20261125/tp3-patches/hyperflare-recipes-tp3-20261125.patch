@@ -0,0 +1,78 @@
+#!/bin/bash
+# FP8-Engram checkpoint view for DeepSeek-V4.1-Flash-1017: symlinks to EVERY file of DeepSeek's original snapshot
+# (shards 1-48, config.json, model.safetensors.index.json, tokenizer, ...). Shards 47-48 hold DeepSeek's FP8 Engram tables
+# (F8_E4M3 [rows, 256] + F8_E8M0 [rows, 8] scales, 189 GiB); DeepSeek's own config.json and index are used unchanged.
+# No NVIDIA download is needed (the 20261111 folder's MXFP4 view took shards 47-48 from nvidia/DeepSeek-V4.1-Flash-1017-NVFP4).
+# The output directory's name becomes the model name of the package (serve.sh default: ds41-1017-engram-fp8).
+#   usage: make_checkpoint_view.sh <deepseek snapshot dir> <output dir (must not exist)>
+#   expect: two "Engram table F8_E4M3 ... ok" lines and "96085 tensors in 48 shards, missing 0; payload 510286023000 vs index total_size 510286023000"
+set -euo pipefail
+[ $# -eq 2 ] || { echo "usage: $0 <deepseek snapshot dir> <output dir>" >&2; exit 2; }
+DS=$(realpath -e -- "$1")
+OUT=$2
+while [[ "$OUT" == */ ]]; do OUT=${OUT%/}; done
+[ -n "$OUT" ] && [ ! -e "$OUT" ] && [ ! -L "$OUT" ] || { echo "Refusing existing output $2" >&2; exit 2; }
+[ -d "$DS" ] || { echo "Checkpoint snapshot is not a directory at $DS" >&2; exit 2; }
+# Include each named ancestor before resolving the output's symlinks.
+declare -A output_ancestors=()
+ancestor=$(dirname -- "$OUT")
+while :; do
+    resolved=$(realpath -m -- "$ancestor")
+    output_ancestors["$resolved"]=1
+    [[ "$ancestor" == / || "$ancestor" == . ]] && break
+    ancestor=$(dirname -- "$ancestor")
+done
+OUT=$(realpath -m -- "$OUT")
+shopt -s dotglob nullglob
+entries=()
+targets=()
+# A source directory that contains the output would make the view link back to itself.
+for f in "$DS"/*; do
+    target=$(realpath -e -- "$f")
+    if [[ "${output_ancestors[$target]+x}" || "$OUT" == "${target%/}/"* ]]; then
+        continue
+    fi
+    entries+=("${f##*/}")
+    targets+=("$target")
+done
+PARENT=$(dirname -- "$OUT")
+mkdir -p -- "$PARENT"
+STAGE=$(mktemp -d -- "$PARENT/.checkpoint-view.XXXXXXXX")
+trap 'rm -rf -- "$STAGE"' EXIT
+trap 'exit 130' INT
+trap 'exit 143' TERM
+mkdir -- "$STAGE/view"
+for i in "${!entries[@]}"; do
+    ln -s -- "${targets[i]}" "$STAGE/view/${entries[i]}"
+done
+/usr/bin/python3 -I - "$STAGE/view" <<'PY'
+import json, os, struct, sys
+out = sys.argv[1]
+idx = json.load(open(f"{out}/model.safetensors.index.json"))
+seen, missing, total = {}, [], 0
+for name, shard in idx["weight_map"].items():
+    if shard not in seen:
+        with open(f"{out}/{shard}", "rb") as h:
+            n = struct.unpack("<Q", h.read(8))[0]
+            seen[shard] = json.loads(h.read(n))
+            end = max(v["data_offsets"][1] for k, v in seen[shard].items() if k != "__metadata__")
+            if 8 + n + end != os.path.getsize(f"{out}/{shard}"):
+                sys.exit(f"{shard}: size {os.path.getsize(f'{out}/{shard}')} != header end {8 + n + end}")
+    if name not in seen[shard]:
+        missing.append(name)
+    else:
+        o = seen[shard][name]["data_offsets"]; total += o[1] - o[0]
+bad = []
+for layer, shard in ((1, "model-00047-of-00048.safetensors"), (14, "model-00048-of-00048.safetensors")):
+    w = seen[shard].get(f"layers.{layer}.engram.embed.weight", {}); s = seen[shard].get(f"layers.{layer}.engram.embed.scale", {})
+    ok = w.get("dtype") == "F8_E4M3" and len(w.get("shape", [])) == 2 and w["shape"][1] == 256 \
+         and s.get("dtype") == "F8_E8M0" and s.get("shape") == [w["shape"][0], 8]
+    print(f"layer-{layer} Engram table {w.get('dtype')} {w.get('shape')} scales {s.get('dtype')} {s.get('shape')} {'ok' if ok else 'BAD'}")
+    bad += [] if ok else [layer]
+ts = idx.get("metadata", {}).get("total_size")
+print(f"{len(idx['weight_map'])} tensors in {len(seen)} shards, missing {len(missing)}; payload {total} vs index total_size {ts}")
+sys.exit(1 if missing or bad or ts != total else 0)
+PY
+mv -nT -- "$STAGE/view" "$OUT"
+[ ! -d "$STAGE/view" ] || { echo "Refusing existing output $OUT" >&2; exit 2; }
+echo "FP8 checkpoint view ready: $OUT"
diff --git a/tp3-tools/release/serve.sh b/tp3-tools/release/serve.sh
new file mode 100755
index 0000000..13e5d90
--- /dev/null
+++ b/tp3-tools/release/serve.sh
@@ -0,0 +1,64 @@
+#!/bin/bash
+# Serve the exported package on 3 GPUs with both FP8 Engram tables in host RAM (~189 GiB of tables; the server
+# commits ~218 GiB of host RAM in total at PREFIX_CACHE=12G, so this needs a 256 GB machine, see README "Memory").
+#   FLARE         path to this fork's flare binary   (default: flare-cli/target/release/flare in the fork checkout)
+#   PACKAGE       model name (= the checkpoint directory name the package was exported from) or a package path
+#                 (default ds41-1017-engram-fp8 = the view name in EXPORT.md; Hyperflare picks its default version)
+#   ENGRAM_RAM    1 (default) = both Engram tables in host RAM
+#                 layer1 = layer 1's table in RAM, layer 14's read from disk through a row cache of ENGRAM_CACHE
+#                 (default 32GiB); ~60 GiB less committed host RAM (README "Memory")
+#                 0 = both tables from disk through a row cache of ENGRAM_CACHE (default 32GiB, shared by the tables)
+#   READ_AHEAD    Engram disk read-ahead before each prefill chunk (FLARE_ENGRAM_READ_AHEAD; default 1; empty = off).
+#                 Does nothing with both tables in RAM; keep it on with ENGRAM_RAM=layer1 or 0
+#   STEERING_KEYS_FILE  file with steering keys (FLARE_STEERING_API_KEYS_FILE; one key per line or comma-separated,
+#                 '#' comment lines, mode 600). Unset by default: any client may then set steering_scale.
+#                 With keys, a nonzero steering_scale needs X-Steering-Key (README "Steering access")
+#   PREFIX_CACHE  host RAM for reusable prompt KV (default 12G; 32G does not fit beside the FP8 tables in 256 GB)
+#   BUDGET        max verification rows per step (default 32)
+#   DRAFTS        DSpark drafts (default 5); must equal the DRAFTS the package was exported with
+#   ALPHA         adaptive-verification alpha scalar or comma-separated max_batch:alpha schedule (default 0.8)
+#   SCHEDULER     scheduler policy (default interactive = balanced + a 50 ms first-token target; balanced = upstream)
+#   TTFT_ORDER    which overdue request the interactive guard serves first (default shortest = fewest prompt chunks
+#                 left; oldest = the 20261111 behaviour; empty = do not pass the flag)
+#   TAIL_MERGE    --scheduler-prefill-tail-merge (default true)
+#   PREFILL_MERGE short message pieces at a request's own checkpoint merge into the next chunk up to this many tokens
+#                 (FLARE_SCHEDULER_PREFILL_MERGE_MIN_ROWS; default 512; empty or 0 = off)
+#   STACK_LIMIT   CUDA per-thread stack limit in bytes (FLARE_CUDA_STACK_LIMIT; default 48; set 64 if an older nvcc
+#                 produces >48 B stack; empty = use the limit recorded in the core, 1,024 for the release package)
+#   FAST=0        turn off private Engram tables on 4 KiB pages and fast exit (FLARE_ENGRAM_PRIVATE_TABLES,
+#                 FLARE_FAST_EXIT; on by default: faster start and stop)
+#   GPUS, PORT, HOST   default 0,1,2 / 15015 / 127.0.0.1 (plain HTTP: see README "Over a network" before changing HOST)
+#   Usage: serve.sh [--dry-run]. A dry run prints the memory plan for the selected settings.
+set -euo pipefail
+if (( $# > 1 )) || { (( $# == 1 )) && [[ $1 != --dry-run ]]; }; then
+  echo "usage: ${0##*/} [--dry-run]" >&2
+  exit 2
+fi
+FLARE=${FLARE:-flare-cli/target/release/flare}
+PACKAGE=${PACKAGE:-ds41-1017-engram-fp8}
+# Start with the wrapper's settings even when a parent service exported Flare overrides.
+unset FLARE_ENGRAM_RAM_TABLES FLARE_ENGRAM_RAM_LAYERS FLARE_ENGRAM_PRIVATE_TABLES FLARE_FAST_EXIT
+unset FLARE_CUDA_STACK_LIMIT FLARE_SCHEDULER_PREFILL_MERGE_MIN_ROWS FLARE_ENGRAM_READ_AHEAD FLARE_STEERING_API_KEYS_FILE
+ENV=() STORAGE=() EXTRA=()
+case ${ENGRAM_RAM:-1} in
+  1) ENV+=(FLARE_ENGRAM_RAM_TABLES=0) ;;
+  layer1) ENV+=(FLARE_ENGRAM_RAM_LAYERS=0); STORAGE=(--embedding-table-storage disk --embedding-table-cache-size "${ENGRAM_CACHE:-32GiB}") ;;
+  0) STORAGE=(--embedding-table-storage disk --embedding-table-cache-size "${ENGRAM_CACHE:-32GiB}") ;;
+  *) echo "ENGRAM_RAM must be 1, layer1 or 0" >&2; exit 2 ;;
+esac
+[ "${FAST:-1}" = 1 ] && ENV+=(FLARE_ENGRAM_PRIVATE_TABLES=1 FLARE_FAST_EXIT=1)
+SL=${STACK_LIMIT-48}; PM=${PREFILL_MERGE-512}; TO=${TTFT_ORDER-shortest}; RA=${READ_AHEAD-1}
+[ -n "$SL" ] && ENV+=(FLARE_CUDA_STACK_LIMIT=$SL)
+[ -n "$PM" ] && ENV+=(FLARE_SCHEDULER_PREFILL_MERGE_MIN_ROWS=$PM)
+[ -n "$RA" ] && ENV+=(FLARE_ENGRAM_READ_AHEAD=$RA)
+[ -n "$TO" ] && EXTRA+=(--scheduler-ttft-order "$TO")
+if [ -n "${STEERING_KEYS_FILE:-}" ]; then
+  [ -r "$STEERING_KEYS_FILE" ] || { echo "STEERING_KEYS_FILE $STEERING_KEYS_FILE is not readable" >&2; exit 2; }
+  ENV+=(FLARE_STEERING_API_KEYS_FILE="$STEERING_KEYS_FILE")
+fi
+exec /usr/bin/env "${ENV[@]}" "$FLARE" run "$PACKAGE" --gpus "${GPUS:-0,1,2}" --port "${PORT:-15015}" \
+  --host "${HOST:-127.0.0.1}" --served-model-name DeepSeek-V4.1-Flash --prefix-cache-memory "${PREFIX_CACHE:-12G}" \
+  --mtp-draft-tokens "${DRAFTS:-5}" --mtp-adaptive-verification --mtp-max-verification-token-budget "${BUDGET:-32}" \
+  --mtp-adaptive-verification-alpha "${ALPHA:-0.8}" --scheduler-policy "${SCHEDULER:-interactive}" \
+  --scheduler-prefill-tail-merge "${TAIL_MERGE:-true}" \
+  "${EXTRA[@]}" "${STORAGE[@]}" "$@"
diff --git a/tp3-tools/spec_metrics.py b/tp3-tools/spec_metrics.py
new file mode 100644
index 0000000..295e0aa
--- /dev/null
+++ b/tp3-tools/spec_metrics.py
@@ -0,0 +1,79 @@
+"""Snapshot/diff Helios speculative metrics: per (batch,width) rounds, GPU ms/round, tokens/round,
+GPU busy share, and per-depth draft acceptance (flare_speculative_drafts_total).
+usage: spec_metrics.py snap OUT.json | spec_metrics.py diff A.json B.json"""
+import json, re, sys, time, urllib.request
+NAMES = ("rounds", "gpu_nanoseconds", "emitted_tokens", "accepted_drafts", "offered_drafts")
+_BW_RE = re.compile(r'flare_speculative_(\w+)_total\{batch="(\d+)",width="(\d+)"\} (\S+)')
+_DEPTH_RE = re.compile(r'flare_speculative_drafts_total\{([^}]+)\} (\S+)')
+_LABEL_RE = re.compile(r'(\w+)="([^"]*)"')
+
+
+def parse_metrics(text):
+    out = {"t": time.time(), "m": {}, "d": {}}
+    for line in text.splitlines():
+        m = _BW_RE.match(line)
+        if m and m[1] in NAMES:
+            out["m"].setdefault(f"{m[2]},{m[3]}", {})[m[1]] = float(m[4])
+            continue
+        dm = _DEPTH_RE.match(line)
+        if dm:
+            labels = dict(_LABEL_RE.findall(dm[1]))
+            depth, source, outcome = labels.get("depth"), labels.get("source"), labels.get("outcome")
+            if depth and source and outcome in ("offered", "accepted"):
+                out["d"].setdefault(source, {}).setdefault(depth, {})[outcome] = float(dm[2])
+    return out
+
+
+def snap():
+    text = urllib.request.urlopen("http://127.0.0.1:15015/metrics", timeout=10).read().decode()
+    return parse_metrics(text)
+
+
+def format_diff(a, b):
+    lines = []
+    wall = b["t"] - a["t"]
+    gpu_total = 0.0
+    lines.append(f"wall {wall:.1f} s")
+    lines.append(f"{'batch,width':>11} {'rounds':>8} {'GPU ms/round':>12} {'tok/round':>9} {'accept':>6}")
+    for k in sorted(b["m"], key=lambda s: tuple(map(int, s.split(",")))):
+        d = {n: b["m"][k].get(n, 0) - a["m"].get(k, {}).get(n, 0) for n in NAMES}
+        if d["rounds"] <= 0:
+            continue
+        gpu_total += d["gpu_nanoseconds"]
+        acc = d["accepted_drafts"] / d["offered_drafts"] if d["offered_drafts"] else 0
+        lines.append(f"{k:>11} {d['rounds']:8.0f} {d['gpu_nanoseconds']/d['rounds']/1e6:12.3f} "
+                     f"{d['emitted_tokens']/d['rounds']:9.2f} {acc:6.2f}")
+    busy_pct = (gpu_total / 1e9 / wall * 100) if wall > 0 else 0.0
+    lines.append(f"GPU busy (speculative) {gpu_total/1e9:.1f} s of {wall:.1f} s wall = {busy_pct:.0f}%")
+
+    a_depths, b_depths = a.get("d", {}), b.get("d", {})
+    for source in sorted(b_depths):
+        rows = []
+        offered_d1 = 0.0
+        for depth in sorted(b_depths[source], key=int):
+            off = b_depths[source][depth].get("offered", 0.0) - a_depths.get(source, {}).get(depth, {}).get("offered", 0.0)
+            acc = b_depths[source][depth].get("accepted", 0.0) - a_depths.get(source, {}).get(depth, {}).get("accepted", 0.0)
+            if off <= 0 and acc <= 0:
+                continue
+            if int(depth) == 1:
+                offered_d1 = off
+            rows.append((int(depth), off, acc))
+        if not rows:
+            continue
+        lines.append(f"\nper-depth drafts (source={source}):")
+        lines.append(f"{'depth':>5} {'offered':>10} {'accepted':>10} {'cond_acc':>9} {'surv_d1':>9}")
+        for depth, off, acc in rows:
+            cond = acc / off if off > 0 else 0.0
+            surv = acc / offered_d1 if offered_d1 > 0 else 0.0
+            lines.append(f"{depth:5d} {off:10.0f} {acc:10.0f} {cond:9.3f} {surv:9.3f}")
+    return "\n".join(lines)
+
+
+if __name__ == "__main__":
+    if sys.argv[1] == "snap":
+        with open(sys.argv[2], "w") as fh:
+            json.dump(snap(), fh)
+    else:
+        with open(sys.argv[2]) as fa, open(sys.argv[3]) as fb:
+            a, b = json.load(fa), json.load(fb)
+        print(format_diff(a, b))
diff --git a/tp3-tools/steps_logger.py b/tp3-tools/steps_logger.py
