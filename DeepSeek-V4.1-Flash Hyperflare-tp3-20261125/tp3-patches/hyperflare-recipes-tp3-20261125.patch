+def test_batched_markov_finish_is_bit_identical_in_cpu_interpreter():
+    root = Path(__file__).resolve().parents[2]
+    env = dict(os.environ, TRITON_INTERPRET="1", CUDA_VISIBLE_DEVICES="",
+               PYTHONPATH=os.pathsep.join(filter(None, (str(root), os.environ.get("PYTHONPATH")))))
+    completed = subprocess.run([sys.executable, str(Path(__file__).resolve())],
+                               cwd=root, env=env, capture_output=True, text=True, timeout=900)
+    assert completed.returncode == 0, completed.stdout + completed.stderr
+    assert "batched markov finish ok" in completed.stdout, completed.stdout + completed.stderr
+
+
+def test_draft_confidence_reuses_staged_markov_rows():
+    from hyperflare_recipes.components.split_draft import PreparedDraftConfidence
+
+    b, depth, hidden_w, rank = 4, 5, 16, 8
+    gen = torch.Generator().manual_seed(42)
+    table = torch.randn((64, rank), generator=gen, dtype=torch.bfloat16)
+    head_hidden = torch.randn((b, depth, hidden_w), generator=gen, dtype=torch.bfloat16)
+    active = torch.tensor([True, False, True, True])
+    candidates = torch.tensor([[3, 9, 10, 11, 12, 13], [7, 0, 0, 0, 0, 0], [15, 2, 4, 6, 8, 1], [1, 5, 5, 9, 3, 2]])
+    drafts = torch.tensor([[9, 10, 11, 12, 13], [0, 0, 0, 0, 0], [2, 4, 6, 8, 1], [5, 5, 9, 3, 2]])
+    preceding = torch.cat((torch.where(active[:, None], candidates[:, :1], 0), drafts[:, :depth - 1]), dim=1)
+    # Step-major [depth, b, rank] as produced by PreparedVocabularySoftmax(stage_rows=True, batched_finish=True).
+    staged = table[preceding].transpose(0, 1).contiguous()
+
+    weight = torch.randn((1, hidden_w + rank), generator=gen, dtype=torch.bfloat16)
+
+    def proj(x):
+        return (x.float() @ weight.float().T)
+
+    conf_staged = object.__new__(PreparedDraftConfidence)
+    conf_staged.batch, conf_staged.depth, conf_staged.offset = b, depth, 0
+    conf_staged.feature_dtype = torch.bfloat16
+    conf_staged.projection = proj
+    conf_staged.embedding = None  # Must not be called when markov_staged is present!
+
+    conf_embed = object.__new__(PreparedDraftConfidence)
+    conf_embed.batch, conf_embed.depth, conf_embed.offset = b, depth, 0
+    conf_embed.feature_dtype = torch.bfloat16
+    conf_embed.projection = proj
+    conf_embed.embedding = lambda *, token_ids: table[token_ids]
+
+    p_staged = SimpleNamespace(active=active, candidates=candidates, drafts=drafts,
+                               features={"head_hidden": head_hidden, "markov_staged": staged})
+    p_embed = SimpleNamespace(active=active, candidates=candidates, drafts=drafts,
+                              features={"head_hidden": head_hidden})
+    out_staged = conf_staged(p_staged)
+    out_embed = conf_embed(p_embed)
+    assert torch.equal(out_staged.view(torch.int32), out_embed.view(torch.int32))
+
+
+def test_spec_metrics_parses_per_depth_drafts():
+    root = Path(__file__).resolve().parents[2]
+    spec = importlib.util.spec_from_file_location("spec_metrics", root / "tp3-tools" / "spec_metrics.py")
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+
+    snap_a = mod.parse_metrics(
+        'flare_speculative_rounds_total{batch="1",width="6"} 10\n'
+        'flare_speculative_gpu_nanoseconds_total{batch="1",width="6"} 75000000\n'
+        'flare_speculative_emitted_tokens_total{batch="1",width="6"} 25\n'
+        'flare_speculative_accepted_drafts_total{batch="1",width="6"} 15\n'
+        'flare_speculative_offered_drafts_total{batch="1",width="6"} 50\n'
+        'flare_speculative_drafts_total{depth="1",outcome="offered",source="mtp"} 10\n'
+        'flare_speculative_drafts_total{depth="1",outcome="accepted",source="mtp"} 8\n'
+        'flare_speculative_drafts_total{depth="2",outcome="offered",source="mtp"} 10\n'
+        'flare_speculative_drafts_total{depth="2",outcome="accepted",source="mtp"} 4\n'
+    )
+    snap_a["t"] = 100.0
+    snap_b = mod.parse_metrics(
+        'flare_speculative_rounds_total{batch="1",width="6"} 20\n'
+        'flare_speculative_gpu_nanoseconds_total{batch="1",width="6"} 150000000\n'
+        'flare_speculative_emitted_tokens_total{batch="1",width="6"} 52\n'
+        'flare_speculative_accepted_drafts_total{batch="1",width="6"} 32\n'
+        'flare_speculative_offered_drafts_total{batch="1",width="6"} 90\n'
+        'flare_speculative_drafts_total{depth="1",outcome="offered",source="mtp"} 20\n'
+        'flare_speculative_drafts_total{depth="1",outcome="accepted",source="mtp"} 16\n'
+        'flare_speculative_drafts_total{depth="2",outcome="offered",source="mtp"} 18\n'
+        'flare_speculative_drafts_total{depth="2",outcome="accepted",source="mtp"} 8\n'
+    )
+    snap_b["t"] = 110.0
+    report = mod.format_diff(snap_a, snap_b)
+    assert "per-depth drafts (source=mtp):" in report
+    assert "    1         10          8     0.800     0.800" in report
+    assert "    2          8          4     0.500     0.400" in report
+
+
+@triton.jit
+def _noise(Seed, Offset, token):
+    return ((token * 7 + Seed * 3 + Offset) % 13).to(tl.float32) * 0.01
+
+
+def _run_case(b, width, world, stage_rows, fp8, has_masses, has_limits, generator):
+    from hyperflare_recipes.components import vocabulary_sampling as v
+    from ignition.components.sampling import RUNNING
+
+    vocab, local, rank, capacity, block = 700, 256, 64, 5, 256
+    blocks = triton.cdiv(local, block)
+    words = v.SUMMARY_WORDS
+    offset = torch.tensor([64], dtype=torch.int32)
+    logits = torch.randn((b, width, local), generator=generator).to(torch.bfloat16)
+    table = torch.randn((vocab, rank), generator=generator).to(torch.bfloat16)
+    if fp8:
+        head = (torch.randn((local, rank), generator=generator) * 4).to(torch.float8_e4m3fn)
+        scale = torch.rand((local,), generator=generator) * 0.1 + 0.01
+    else:
+        head = torch.randn((local, rank), generator=generator).to(torch.bfloat16)
+        scale = torch.ones((1,))
+    pending = torch.tensor([5, -3, vocab + 40][:b], dtype=torch.int64)
+    histogram = torch.randint(0, 3, (capacity, vocab), generator=generator, dtype=torch.int32)
+    slots = torch.tensor([2, 0, 3][:b], dtype=torch.int32)
+    generations = torch.tensor([7, 99, 7][:b], dtype=torch.int64)  # row 1 inactive (gen mismatch)
+    live = torch.tensor([b], dtype=torch.int32)
+    generation = torch.full((capacity,), 7, dtype=torch.int64)
+    status = torch.full((capacity,), RUNNING, dtype=torch.int32)
+    params = torch.tensor([[0.7, 1, 0, 1.1, 0.2, 0.05]] * capacity, dtype=torch.float32).flatten()
+    top_k = torch.zeros((capacity,), dtype=torch.int32)
+    grammar = torch.zeros((capacity, triton.cdiv(vocab, 32)), dtype=torch.int32)
+    grammar_enabled = torch.zeros((capacity,), dtype=torch.int32)
+    seeds = torch.arange(b, dtype=torch.int64) + 11
+    offsets = torch.zeros((b,), dtype=torch.int64)
+    limits = torch.tensor([width + 1, width + 1, max(2, width - 1)][:b], dtype=torch.int32) if has_limits else None
+    # Fixed peer summaries per step for ranks 1..world-1.
+    peer_summaries = torch.randn((width, b, world - 1, words), generator=generator)
+    peer_summaries[..., 0] = peer_summaries[..., 0].abs() * 0.5
+    peer_summaries[..., 1] = peer_summaries[..., 1].abs() + 0.5
+    peer_summaries[..., 2] = peer_summaries[..., 2] * 0.2
+    peer_summaries[..., 3] = torch.randint(320, vocab, (width, b, world - 1), generator=generator).float()
+    peer_summaries[..., 4] = 0.0
+
+    # --- Reference serial path ---
+    ref_probs = torch.full((b, width, local), -7.0)
+    ref_valid = torch.zeros((b, width), dtype=torch.bool)
+    ref_tokens = torch.zeros((b, width), dtype=torch.int64)
+    ref_masses = torch.full((b, width, blocks), -3.0) if has_masses else None
+    ref_staged = torch.full((width, b, rank), float("nan"), dtype=torch.bfloat16)
+    for step in range(width):
+        partials = torch.empty((b, 5, blocks), dtype=torch.float32)
+        summary = torch.empty((b, words), dtype=torch.float32)
+        if stage_rows:
+            v._stage_markov_rows[(b,)](table, pending, ref_tokens, ref_staged[step], DRAFTS=width, VOCAB=vocab,
+                                       RANK=rank, RANK_PAD=triton.next_power_of_2(rank), STEP=step)
+        v._score_tiles[(blocks, b)](
+            offset, logits, ref_probs, partials, ref_staged[step] if stage_rows else table, head, scale,
+            pending, ref_tokens, histogram, slots, generations, live, generation, status, params, top_k,
+            grammar, grammar_enabled, seeds, offsets, limits, logits.stride(0), logits.stride(1),
+            histogram.stride(0), grammar.stride(0),
+            LOCAL=local, VOCAB=vocab, WIDTH=width, DRAFTS=width, PREFIX=step, BLOCKS=blocks,
+            CAPACITY=capacity, BATCH=b, RUNNING=RUNNING, MARKOV=True, RANK=rank, FP8=fp8,
+            SAMPLE=True, STEP=step, BLOCK=block, HAS_LIMITS=has_limits, STAGED=stage_rows,
+        )
+        v._softmax_records[(b,)](partials, summary, None, None, None, None, BLOCKS=blocks,
+                                 PAD=triton.next_power_of_2(blocks), WIDTH=width, CAPACITY=capacity, BATCH=b,
+                                 RAW_TILES=0, RAW_PAD=0)
+        gathered = torch.cat((summary.unsqueeze(1), peer_summaries[step]), dim=1).reshape(b, world * words)
+        v._finish_distribution[(blocks, b)](
+            offset, ref_probs, gathered, ref_valid, ref_tokens, ref_masses, limits,
+            slots, generations, live, generation, status, params, None, None,
+            LOCAL=local, VOCAB=vocab, WIDTH=width, STEP=step, WORLD=world, CAPACITY=capacity, BATCH=b,
+            RUNNING=RUNNING, SAMPLE=True, BLOCK=block, BLOCKS=blocks, RANK_PAD=triton.next_power_of_2(world),
+            HAS_MASSES=has_masses, HAS_LIMITS=has_limits, RAW_LOGPROBS=False,
+        )
+
+    # --- Candidate batched path ---
+    cand_probs = torch.full((b, width, local), -7.0)
+    cand_valid = torch.zeros((b, width), dtype=torch.bool)
+    cand_tokens = torch.zeros((b, width), dtype=torch.int64)
+    cand_masses = torch.full((b, width, blocks), -3.0) if has_masses else None
+    cand_staged = torch.full((width, b, rank), float("nan"), dtype=torch.bfloat16)
+    gathered_all = torch.empty((width, b, world * words), dtype=torch.float32)
+    for step in range(width):
+        partials = torch.empty((b, 5, blocks), dtype=torch.float32)
+        summary = torch.empty((b, words), dtype=torch.float32)
+        if stage_rows and step == 0:
+            v._stage_markov_rows[(b,)](table, pending, cand_tokens, cand_staged[0], DRAFTS=width, VOCAB=vocab,
+                                       RANK=rank, RANK_PAD=triton.next_power_of_2(rank), STEP=0)
+        v._score_tiles[(blocks, b)](
+            offset, logits, cand_probs, partials, cand_staged[step] if stage_rows else table, head, scale,
+            pending, cand_tokens, histogram, slots, generations, live, generation, status, params, top_k,
+            grammar, grammar_enabled, seeds, offsets, limits, logits.stride(0), logits.stride(1),
+            histogram.stride(0), grammar.stride(0),
+            LOCAL=local, VOCAB=vocab, WIDTH=width, DRAFTS=width, PREFIX=step, BLOCKS=blocks,
+            CAPACITY=capacity, BATCH=b, RUNNING=RUNNING, MARKOV=True, RANK=rank, FP8=fp8,
+            SAMPLE=True, STEP=step, BLOCK=block, HAS_LIMITS=has_limits, STAGED=stage_rows,
+        )
+        v._softmax_records[(b,)](partials, summary, None, None, None, None, BLOCKS=blocks,
+                                 PAD=triton.next_power_of_2(blocks), WIDTH=width, CAPACITY=capacity, BATCH=b,
+                                 RAW_TILES=0, RAW_PAD=0)
+        gathered_all[step].copy_(torch.cat((summary.unsqueeze(1), peer_summaries[step]), dim=1).reshape(b, world * words))
+        if step + 1 < width:
+            v._extract_and_stage_markov[(b,)](
+                gathered_all[step], cand_valid, cand_tokens,
+                table if stage_rows else cand_tokens,
+                cand_staged[step + 1] if stage_rows else cand_tokens,
+                limits, slots, generations, live, generation, status,
+                VOCAB=vocab, WIDTH=width, STEP=step, WORLD=world, CAPACITY=capacity, BATCH=b,
+                RUNNING=RUNNING, RANK_PAD=triton.next_power_of_2(world), STAGE_NEXT=stage_rows,
+                RANK=rank if stage_rows else 1, EMBED_PAD=triton.next_power_of_2(rank if stage_rows else 1),
+                HAS_LIMITS=has_limits,
+            )
+    v._finish_distribution_batched[(blocks, width * b)](
+        offset, cand_probs, gathered_all, cand_valid, cand_tokens, cand_masses, limits,
+        slots, generations, live, generation, status,
+        LOCAL=local, WIDTH=width, WORLD=world, CAPACITY=capacity, BATCH=b, RUNNING=RUNNING,
+        BLOCK=block, BLOCKS=blocks, RANK_PAD=triton.next_power_of_2(world),
+        HAS_MASSES=has_masses, HAS_LIMITS=has_limits,
+    )
+
+    assert torch.equal(ref_tokens, cand_tokens), f"tokens differ: {ref_tokens} vs {cand_tokens}"
+    assert torch.equal(ref_valid, cand_valid), f"valid differs: {ref_valid} vs {cand_valid}"
+    assert torch.equal(ref_probs.view(torch.int32), cand_probs.view(torch.int32)), "probs differ"
+    if has_masses:
+        assert torch.equal(ref_masses.view(torch.int32), cand_masses.view(torch.int32)), "tile masses differ"
+    if stage_rows:
+        assert torch.equal(ref_staged.view(torch.int16), cand_staged.view(torch.int16)), "staged differs"
+        # Also verify _refresh_copied_markov_rows when copied tokens overwrite a prefix.
+        copied = torch.zeros((b, width), dtype=torch.bool)
+        if width > 1:
+            copied[0, 0] = True
+            updated = cand_tokens.clone()
+            updated[0, 0] = 123
+            v._refresh_copied_markov_rows[(b, width - 1)](
+                table, updated, copied, cand_staged,
+                DRAFTS=width, VOCAB=vocab, BATCH=b, RANK=rank, RANK_PAD=triton.next_power_of_2(rank),
+            )
+            assert torch.equal(cand_staged[1, 0].view(torch.int16), table[123].view(torch.int16))
+            if b > 1:
+                assert torch.equal(cand_staged[1, 1].view(torch.int16), ref_staged[1, 1].view(torch.int16))
+
+
+def _check_precomputed_bias_path(generator):
+    from hyperflare_recipes.components import vocabulary_sampling as v
+    from ignition.components.sampling import RUNNING
+
+    b, width, local, vocab, rank, capacity, block = 4, 2, 256, 700, 64, 5, 256
+    blocks = triton.cdiv(local, block)
+    offset = torch.tensor([64], dtype=torch.int32)
+    logits = torch.randn((b, width, local), generator=generator).to(torch.bfloat16)
+    staged = torch.randn((b, rank), generator=generator, dtype=torch.bfloat16)
+    head = (torch.randn((local, rank), generator=generator) * 4).to(torch.float8_e4m3fn)
+    scale = torch.rand((local,), generator=generator) * 0.1 + 0.01
+    pending = torch.zeros((b,), dtype=torch.int64)
+    tokens = torch.zeros((b, width), dtype=torch.int64)
+    histogram = torch.zeros((capacity, vocab), dtype=torch.int32)
+    slots = torch.arange(b, dtype=torch.int32)
+    generations = torch.full((b,), 7, dtype=torch.int64)
+    live = torch.tensor([b], dtype=torch.int32)
+    generation = torch.full((capacity,), 7, dtype=torch.int64)
+    status = torch.full((capacity,), RUNNING, dtype=torch.int32)
+    params = torch.tensor([[1.0, 1, 0, 1.0, 0.0, 0.0]] * capacity, dtype=torch.float32).flatten()
+    top_k = torch.zeros((capacity,), dtype=torch.int32)
+    grammar = torch.zeros((capacity, triton.cdiv(vocab, 32)), dtype=torch.int32)
+    grammar_enabled = torch.zeros((capacity,), dtype=torch.int32)
+    seeds = torch.arange(b, dtype=torch.int64) + 11
+    offsets = torch.zeros((b,), dtype=torch.int64)
+    limits = torch.full((b,), width + 1, dtype=torch.int32)
+
+    probs_ref = torch.empty((b, width, local), dtype=torch.float32)
+    partials_ref = torch.empty((b, 5, blocks), dtype=torch.float32)
+    v._score_tiles[(blocks, b)](
+        offset, logits, probs_ref, partials_ref, staged, head, scale,
+        pending, tokens, histogram, slots, generations, live, generation, status, params, top_k,
+        grammar, grammar_enabled, seeds, offsets, limits, logits.stride(0), logits.stride(1),
+        histogram.stride(0), grammar.stride(0),
+        LOCAL=local, VOCAB=vocab, WIDTH=width, DRAFTS=width, PREFIX=0, BLOCKS=blocks,
+        CAPACITY=capacity, BATCH=b, RUNNING=RUNNING, MARKOV=True, RANK=rank, FP8=True,
+        SAMPLE=True, STEP=0, BLOCK=block, HAS_LIMITS=True, STAGED=True, PRECOMPUTED_BIAS=False,
+    )
+
+    bias = (staged.float() @ head.to(torch.float32).T) * scale[None, :]
+    probs_pre = torch.empty((b, width, local), dtype=torch.float32)
+    partials_pre = torch.empty((b, 5, blocks), dtype=torch.float32)
+    v._score_tiles[(blocks, b)](
+        offset, logits, probs_pre, partials_pre, bias, head, scale,
+        pending, tokens, histogram, slots, generations, live, generation, status, params, top_k,
+        grammar, grammar_enabled, seeds, offsets, limits, logits.stride(0), logits.stride(1),
+        histogram.stride(0), grammar.stride(0),
+        LOCAL=local, VOCAB=vocab, WIDTH=width, DRAFTS=width, PREFIX=0, BLOCKS=blocks,
+        CAPACITY=capacity, BATCH=b, RUNNING=RUNNING, MARKOV=True, RANK=rank, FP8=True,
+        SAMPLE=True, STEP=0, BLOCK=block, HAS_LIMITS=True, STAGED=True, PRECOMPUTED_BIAS=True,
+    )
+    torch.testing.assert_close(probs_pre[:, 0], probs_ref[:, 0], rtol=1e-5, atol=1e-5)
+    torch.testing.assert_close(partials_pre[:, :3], partials_ref[:, :3], rtol=1e-5, atol=1e-5)
+
+
+def main():
+    from hyperflare_recipes.components import vocabulary_sampling as v
+
+    v._token_noise = _noise
+    gen = torch.Generator().manual_seed(2026)
+    for b in (1, 3):
+        for width in (2, 4):
+            for stage_rows in (False, True):
+                for fp8 in (False, True):
+                    _run_case(b, width, 3, stage_rows, fp8, has_masses=True, has_limits=True, generator=gen)
+    _run_case(3, 4, 3, True, True, has_masses=False, has_limits=False, generator=gen)
+    _check_precomputed_bias_path(gen)
+    print("batched markov finish ok")
+
+
+if __name__ == "__main__":
+    main()
