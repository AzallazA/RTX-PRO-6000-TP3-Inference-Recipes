+# SPDX-FileCopyrightText: Copyright (c) 2026 Flare community contributors
+# SPDX-License-Identifier: Apache-2.0
+
+"""CuTe kernel of the one-launch 24-head DSV41 BF16 MLA prefill (see mla_h24_prefill.py).
+
+Specialised 24-head (16 + 8) single-pass kernel matching b12x ``UnifiedPrefillMGKernel`` for DSV41 BF16
+(NVFP4/MXFP8 544-byte staging, SWA-only and SWA + indexed dual-cache, optional ``attn_sink``). Each CTA handles
+one query token and all 24 heads: 128 IO threads gather each 64-candidate KV window once (b12x's
+``io_issue_gather_glm_mg``), and 256 math threads dequantize every K/V fragment once for both head tiles (heads
+0-15 and 16-23), finishing both tiles with b12x's ``s7_epilogue``. Bit-identical BF16 output and base-2 LSE.
+"""
+
+import functools
+
+import cutlass
+import cutlass.cute as cute
+import cutlass.utils as cutlass_utils
+from cutlass import Float32, Int32, Int64, Uint32, Uint64
+
+from b12x._lib.intrinsics.atomics import ld_shared_f32_offset, st_shared_f32_offset, st_shared_u32
+from b12x._lib.intrinsics.math import fmax_f32, fmin_f32
+from b12x._lib.intrinsics.memory import (
+    cp_async_bulk_g2s_mbar_l2hint,
+    create_l2_evict_first_policy,
+    get_ptr_as_int64,
+    shared_ptr_to_u32,
+)
+from b12x.attention._shared.mla.decode_math import EPILOGUE_FINAL_BF16, _exp2_approx_ftz_f32, ld_shared_f32, st_shared_f32
+
+from hyperflare_recipes.components.mla_h24_kernel import (
+    _pv_pair_inplace,
+    s0_load_q24,
+    s1_pair,
+    s1_pair_dispatch,
+    s3_mask_and_scale_tag_pair,
+    s5_pair,
+    s7_epilogue_h24,
+)
+from hyperflare_recipes.components.mla_h24_prefill import (
+    BI,
+    BLOCK_THREADS,
+    CAND_WINDOW,
+    D_NOPE,
+    HEADS,
+    IO_THREADS,
+    KV_SMEM_STRIDE,
+    MATH_THREADS,
+    N_V_CHUNKS,
+    Q_NOPE_STRIDE,
+    REDUCE_GROUP_BYTES,
+    REDUCE_WARP_SUM_OFF,
+    SM_P_STRIDE,
+    SMEM_LIMIT,
+    check_traits,
+    smem_offsets,
+)
+
+
+@functools.lru_cache(maxsize=1)
+def storage_cls():
+    class SharedStorage:
+        pass
+
+    SharedStorage.__annotations__ = {
+        "q": cute.struct.Align[cute.struct.MemRange[cutlass.BFloat16, HEADS * Q_NOPE_STRIDE], 128],
+        "kv": cute.struct.Align[cute.struct.MemRange[cutlass.Uint8, 2 * BI * KV_SMEM_STRIDE], 128],
+        "mbar": cute.struct.Align[cute.struct.MemRange[cutlass.Uint64, 4], 16],
+        "reduce": cute.struct.MemRange[cutlass.Float32, 2 * REDUCE_GROUP_BYTES // 4],
+        "sm_p": cute.struct.Align[cute.struct.MemRange[cutlass.BFloat16, 16 * SM_P_STRIDE], 128],
+        "sm_p2": cute.struct.Align[cute.struct.MemRange[cutlass.BFloat16, 8 * SM_P_STRIDE], 16],
+    }
+    storage = cute.struct(SharedStorage)
+    expected, total = smem_offsets()
+    if dict(storage._offsets) != {name: offset for name, offset, _ in expected}:
+        raise ValueError(f"H24 prefill SharedStorage offsets {dict(storage._offsets)} diverge from {expected}")
+    if int(storage.size_in_bytes()) != total or total > SMEM_LIMIT:
+        raise ValueError(
+            f"H24 prefill SharedStorage is {int(storage.size_in_bytes())} B (layout {total}, limit {SMEM_LIMIT})"
+        )
+    return storage
+
+
+@cute.jit
+def _io_issue_gather_dsv41_prefill(
+    kv_cache_u8: cute.Tensor,
+    topk_indices: cute.Tensor,
+    kv_dst_addr: Int32,
+    full_mbar_ptr,
+    g_start: Int32,
+    g_end: Int32,
+    stride_kv_block: Int64,
+    io_lane: Int32,
+    cache_policy: Uint64,
+    *,
+    page_block_size: cutlass.Constexpr,
+    dsv41_swa: cutlass.Constexpr,
+):
+    """Single-pass DSV41 prefill IO gather for 64 IO threads (2 warps, 1 candidate per thread).
+
+    Loads ``topk_indices[g_start + entry]`` ONCE, issues ``mbarrier_expect_tx`` + ``cp.async.bulk``
+    FIRST, then overlaps ``source_tag`` store + CTA fence under TMA before each IO warp arrives.
+    """
+    _ios = Int64(528 if dsv41_swa else 288)
+    _nope = Int32(528 if dsv41_swa else 288)
+    _valid_tag = Uint32(1 if dsv41_swa else 0)
+    _pbs = Int32(page_block_size)
+
+    entry = io_lane
+    cand_pos = g_start + entry
+    idx_raw = Int32(-1)
+    if cand_pos < g_end:
+        idx_raw = Int32(topk_indices[cand_pos])
+
+    if (io_lane & Int32(31)) == Int32(0):
+        cute.arch.mbarrier_expect_tx(full_mbar_ptr, Int32(32) * _nope)
+    cute.arch.sync_warp()
+
+    idx = idx_raw
+    if idx < Int32(0):
+        idx = Int32(0)
+    block_idx = idx // _pbs
+    local_idx = idx - block_idx * _pbs
+    data_base_off = Int64(block_idx) * stride_kv_block + Int64(local_idx) * _ios
+    cp_async_bulk_g2s_mbar_l2hint(
+        kv_dst_addr + entry * Int32(KV_SMEM_STRIDE),
+        get_ptr_as_int64(kv_cache_u8, data_base_off),
+        _nope,
+        shared_ptr_to_u32(full_mbar_ptr),
+        cache_policy,
+    )
+
+    source_tag = _valid_tag
+    if idx_raw < Int32(0):
+        source_tag = Uint32(2)
+    st_shared_u32(kv_dst_addr + entry * Int32(KV_SMEM_STRIDE) + Int32(528), source_tag)
+    cute.arch.fence_acq_rel_cta()
+    cute.arch.sync_warp()
+    if (io_lane & Int32(31)) == Int32(0):
+        cute.arch.mbarrier_arrive(full_mbar_ptr)
+
+
+@cute.jit
+def s4_online_softmax_h24(
+    qk0,
+    qk1,
+    acc0_frag: cute.Tensor,
+    acc1_frag: cute.Tensor,
+    gmax0_frag: cute.Tensor,
+    gmax1_frag: cute.Tensor,
+    gsum0_frag: cute.Tensor,
+    gsum1_frag: cute.Tensor,
+    reduce_addr: Int32,
+    is_first: cutlass.Boolean,
+    warp_id: Int32,
+    lane: Int32,
+):
+    """1-barrier deferred-row-sum online softmax for 16 + 8 heads using all-thread 8-warp max read."""
+    bar_kw = dict(barrier_id=3, number_of_threads=MATH_THREADS)
+    gid = lane >> Int32(2)
+    tid = lane & Int32(3)
+
+    lm00 = fmax_f32(qk0[0], qk0[1])
+    lm01 = fmax_f32(qk0[2], qk0[3])
+    lm10 = fmax_f32(qk1[0], qk1[1])
+    lm00 = fmax_f32(lm00, cute.arch.shuffle_sync_bfly(lm00, offset=2))
+    lm01 = fmax_f32(lm01, cute.arch.shuffle_sync_bfly(lm01, offset=2))
+    lm10 = fmax_f32(lm10, cute.arch.shuffle_sync_bfly(lm10, offset=2))
+    lm00 = fmax_f32(lm00, cute.arch.shuffle_sync_bfly(lm00, offset=1))
+    lm01 = fmax_f32(lm01, cute.arch.shuffle_sync_bfly(lm01, offset=1))
+    lm10 = fmax_f32(lm10, cute.arch.shuffle_sync_bfly(lm10, offset=1))
+
+    reduce_warp_head_addr = reduce_addr + (warp_id * Int32(16) + gid) * Int32(4)
+    if tid == Int32(0):
+        st_shared_f32_offset(reduce_warp_head_addr, 0, lm00)
+        st_shared_f32_offset(reduce_warp_head_addr, 8 * 4, lm01)
+        st_shared_f32_offset(reduce_warp_head_addr, REDUCE_GROUP_BYTES, lm10)
+    cute.arch.barrier(**bar_kw)
+
+    reduce_lane_head_addr = reduce_addr + gid * Int32(4)
+    bmax00 = Float32(-1e30)
+    bmax01 = Float32(-1e30)
+    bmax10 = Float32(-1e30)
+    for w in cutlass.range_constexpr(8):
+        bmax00 = fmax_f32(bmax00, ld_shared_f32_offset(reduce_lane_head_addr, w * 16 * 4))
+        bmax01 = fmax_f32(bmax01, ld_shared_f32_offset(reduce_lane_head_addr, w * 16 * 4 + 8 * 4))
+        bmax10 = fmax_f32(bmax10, ld_shared_f32_offset(reduce_lane_head_addr, REDUCE_GROUP_BYTES + w * 16 * 4))
+
+    ngm00 = bmax00
+    ngm01 = bmax01
+    ngm10 = bmax10
+    if is_first:
+        gmax0_frag[0] = ngm00
+        gmax0_frag[1] = ngm01
+        gmax1_frag[0] = ngm10
+    else:
+        old_m00 = gmax0_frag[0]
+        old_m01 = gmax0_frag[1]
+        old_m10 = gmax1_frag[0]
+        ngm00 = fmax_f32(old_m00, bmax00)
+        ngm01 = fmax_f32(old_m01, bmax01)
+        ngm10 = fmax_f32(old_m10, bmax10)
+        alpha00 = _exp2_approx_ftz_f32(old_m00 - ngm00)
+        alpha01 = _exp2_approx_ftz_f32(old_m01 - ngm01)
+        alpha10 = _exp2_approx_ftz_f32(old_m10 - ngm10)
+        gmax0_frag[0] = ngm00
+        gmax0_frag[1] = ngm01
+        gmax1_frag[0] = ngm10
+
+        if fmin_f32(alpha00, alpha01) < Float32(1.0):
+            for vc in cutlass.range_constexpr(N_V_CHUNKS):
+                acc0_frag[vc * 4 + 0] = acc0_frag[vc * 4 + 0] * alpha00
+                acc0_frag[vc * 4 + 1] = acc0_frag[vc * 4 + 1] * alpha00
+                acc0_frag[vc * 4 + 2] = acc0_frag[vc * 4 + 2] * alpha01
+                acc0_frag[vc * 4 + 3] = acc0_frag[vc * 4 + 3] * alpha01
+            gsum0_frag[0] = gsum0_frag[0] * alpha00
+            gsum0_frag[1] = gsum0_frag[1] * alpha01
+
+        if alpha10 < Float32(1.0):
+            for vc in cutlass.range_constexpr(N_V_CHUNKS):
+                acc1_frag[vc * 2 + 0] = acc1_frag[vc * 2 + 0] * alpha10
+                acc1_frag[vc * 2 + 1] = acc1_frag[vc * 2 + 1] * alpha10
+            gsum1_frag[0] = gsum1_frag[0] * alpha10
+
+    p0 = [
+        _exp2_approx_ftz_f32(qk0[0] - ngm00),
+        _exp2_approx_ftz_f32(qk0[1] - ngm00),
+        _exp2_approx_ftz_f32(qk0[2] - ngm01),
+        _exp2_approx_ftz_f32(qk0[3] - ngm01),
+    ]
+    p1 = [
+        _exp2_approx_ftz_f32(qk1[0] - ngm10),
+        _exp2_approx_ftz_f32(qk1[1] - ngm10),
+        Float32(0.0),
+        Float32(0.0),
+    ]
+
+    ls00 = p0[0] + p0[1]
+    ls01 = p0[2] + p0[3]
+    ls10 = p1[0] + p1[1]
+    ls00 = ls00 + cute.arch.shuffle_sync_bfly(ls00, offset=2)
+    ls01 = ls01 + cute.arch.shuffle_sync_bfly(ls01, offset=2)
+    ls10 = ls10 + cute.arch.shuffle_sync_bfly(ls10, offset=2)
+    ls00 = ls00 + cute.arch.shuffle_sync_bfly(ls00, offset=1)
+    ls01 = ls01 + cute.arch.shuffle_sync_bfly(ls01, offset=1)
+    ls10 = ls10 + cute.arch.shuffle_sync_bfly(ls10, offset=1)
+
+    gsum0_frag[0] = gsum0_frag[0] + ls00
+    gsum0_frag[1] = gsum0_frag[1] + ls01
+    gsum1_frag[0] = gsum1_frag[0] + ls10
+    return p0, p1
+
+
+@cute.jit
+def s4_finalize_row_sum_h24(
+    gs0,
+    gs1,
+    reduce0_sum_addr: Int32,
+    reduce1_sum_addr: Int32,
+    warp_id: Int32,
+    lane: Int32,
+    tid_flat: Int32,
+):
+    """Final cross-warp row-sum reduction for 16 heads (group 0) + 8 heads (group 1)."""
+    bar_kw = dict(barrier_id=3, number_of_threads=MATH_THREADS)
+    gid = lane >> Int32(2)
+    tid = lane & Int32(3)
+
+    if tid == Int32(0):
+        st_shared_f32(reduce0_sum_addr + (warp_id * Int32(16) + gid) * Int32(4), gs0[0])
+        st_shared_f32(reduce0_sum_addr + (warp_id * Int32(16) + gid + Int32(8)) * Int32(4), gs0[1])
+        st_shared_f32(reduce1_sum_addr + (warp_id * Int32(16) + gid) * Int32(4), gs1[0])
+    cute.arch.barrier(**bar_kw)
+
+    if tid_flat < Int32(HEADS):
+        group = tid_flat >> Int32(4)
+        h = tid_flat & Int32(15)
+        rsum = reduce0_sum_addr
+        if group != Int32(0):
+            rsum = reduce1_sum_addr
+        total = Float32(0.0)
+        for w in cutlass.range_constexpr(8):
+            total = total + ld_shared_f32(rsum + (Int32(w) * Int32(16) + h) * Int32(4))
+        st_shared_f32(rsum + h * Int32(4), total)
+    cute.arch.barrier(**bar_kw)
+
+    gs0[0] = ld_shared_f32(reduce0_sum_addr + gid * Int32(4))
+    gs0[1] = ld_shared_f32(reduce0_sum_addr + (gid + Int32(8)) * Int32(4))
+    gs1[0] = ld_shared_f32(reduce1_sum_addr + gid * Int32(4))
+    return gs0, gs1
+
+
+@cute.jit
+def _pv_pair_h24(
+    acc0_frag: cute.Tensor,
+    acc1_frag: cute.Tensor,
+    sm_p_addr: Int32,
+    sm_p2_addr: Int32,
+    kv_addr: Int32,
+    warp_id: Int32,
+    lane: Int32,
+    latent_scale: Float32,
+    *,
+    known_swa: cutlass.Constexpr,
+):
+    """BF16 P.V for 16 + 8 heads sharing the inverted outer-ks, inner-vc H24 PV implementation."""
+    _pv_pair_inplace(
+        acc0_frag, acc1_frag, sm_p_addr, sm_p2_addr, kv_addr,
+        warp_id, lane, latent_scale, known_swa=known_swa,
+    )
+
