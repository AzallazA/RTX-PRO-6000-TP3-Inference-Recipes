diff --git a/hyperflare_recipes/recipes/deepseek41/exl3/kernels/xmoe/quant/exl3_moe_transfer_kernel.cuh b/hyperflare_recipes/recipes/deepseek41/exl3/kernels/xmoe/quant/exl3_moe_transfer_kernel.cuh
