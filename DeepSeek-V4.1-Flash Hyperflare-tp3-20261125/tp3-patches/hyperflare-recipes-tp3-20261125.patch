+@triton.jit
+def _markov_gemm_bias(
+    Staged, Head, HeadScale, Out,
+    LOCAL: tl.constexpr, RANK: tl.constexpr, BATCH: tl.constexpr,
+    BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr,
+):
+    """Compute Out[b, local] = (Head[local, rank].bf16 * scale) @ Staged[b, rank].T in one pass over Head.
+
+    Used for multi-row (b >= 4) FP8 Markov sampling to avoid re-reading the 11 MB Markov head once per request row.
+    """
+    pid_m = tl.program_id(0)
+    m_off = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
+    m_mask = m_off < LOCAL
+    n_off = tl.arange(0, BLOCK_N)
+    n_mask = n_off < BATCH
+    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)
+    for k0 in tl.static_range(0, RANK, BLOCK_K):
+        k_off = k0 + tl.arange(0, BLOCK_K)
+        h = tl.load(Head + m_off[:, None].to(tl.int64) * RANK + k_off[None, :], mask=m_mask[:, None], other=0.0).to(tl.bfloat16)
+        e = tl.load(Staged + n_off[None, :].to(tl.int64) * RANK + k_off[:, None], mask=n_mask[None, :], other=0.0).to(tl.bfloat16)
+        acc = tl.dot(h, e, acc, out_dtype=tl.float32)
