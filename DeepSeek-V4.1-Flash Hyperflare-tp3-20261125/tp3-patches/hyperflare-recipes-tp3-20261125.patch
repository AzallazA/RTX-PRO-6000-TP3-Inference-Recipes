+        ex.ds41_exl3_moe(0, torch.randn(rows, 5120, dtype=torch.bfloat16), ids, torch.rand(rows, 6, generator=g),
+                         torch.empty(rows, 5120, dtype=torch.bfloat16), 10.0)
+        hot, cold = fake.launches
