+    @cute.jit
+    def _kernel_body(
+        self,
+        q_all: cute.Tensor,
+        kv_cache_u8: cute.Tensor,
+        indices: cute.Tensor,
+        topk_length: cute.Tensor,
+        attn_sink: cute.Tensor,
+        output: cute.Tensor,
+        out_lse: cute.Tensor,
+        sm_scale_log2: Float32,
+        latent_scale: Float32,
+        stride_kv_block: Int64,
+        extra_kv_cache_u8: cute.Tensor,
+        extra_indices: cute.Tensor,
+        extra_topk_length: cute.Tensor,
+        stride_extra_kv_block: Int64,
+        angles: cute.Tensor,
+        *,
+        has_extra: cutlass.Constexpr,
+        fuse_rope: cutlass.Constexpr,
+    ):
+        t = self.traits
+        tid = Int32(cute.arch.thread_idx()[0])
+        lane = cute.arch.lane_idx()
+        warp_id = tid >> Int32(5)
+        token_idx = Int32(cute.arch.block_idx()[0])
+
+        smem = cutlass_utils.SmemAllocator()
+        st = smem.allocate(storage_cls())
+        q_addr = shared_ptr_to_u32(st.q.data_ptr())
+        kv_addr = shared_ptr_to_u32(st.kv.data_ptr())
+        reduce_addr = shared_ptr_to_u32(st.reduce.data_ptr())
+        reduce_g0 = reduce_addr
+        reduce_g1 = reduce_addr + Int32(REDUCE_GROUP_BYTES)
+        sm_p_addr = shared_ptr_to_u32(st.sm_p.data_ptr())
+        sm_p2_addr = shared_ptr_to_u32(st.sm_p2.data_ptr())
+        mbar_base = st.mbar.data_ptr()
+        kv_buf = Int32(BI * KV_SMEM_STRIDE)
+        is_io = warp_id >= Int32(MATH_THREADS // 32)
+
+        n_buf = 2
+        if tid == Int32(0):
+            for s in cutlass.range_constexpr(n_buf):
+                cute.arch.mbarrier_init(mbar_base + s, Int32(IO_THREADS // 32))
+                cute.arch.mbarrier_init(mbar_base + n_buf + s, Int32(1))
+        cute.arch.barrier()
+
+        section_len = Int32(topk_length[token_idx])
+        if section_len < Int32(0):
+            section_len = Int32(0)
+        if section_len > Int32(self.topk):
+            section_len = Int32(self.topk)
+        is_empty_row = section_len == Int32(0)
+        actual_tiles = (section_len + Int32(CAND_WINDOW - 1)) // Int32(CAND_WINDOW)
+
+        num_main_tiles = Int32(self.num_main_tiles)
+        actual_main = actual_tiles
+        if cutlass.const_expr(has_extra):
+            if actual_main > num_main_tiles:
+                actual_main = num_main_tiles
+            extra_section_len = Int32(extra_topk_length[token_idx])
+            if extra_section_len < Int32(0):
+                extra_section_len = Int32(0)
+            if extra_section_len > Int32(self.extra_topk):
+                extra_section_len = Int32(self.extra_topk)
