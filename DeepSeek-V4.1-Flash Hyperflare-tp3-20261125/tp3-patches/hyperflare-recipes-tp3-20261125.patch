+                        qk, qk2, q_addr, kv_b, warp_first_cand, lane, ci < num_main_chunks)
+                else:
+                    qk, qk2, all_valid, tag = s1_pair(
+                        qk, qk2, q_addr, kv_b, warp_first_cand, lane, known_swa=True)
+                qk, qk2 = s3_mask_and_scale_tag_pair(qk, qk2, tag, all_valid, sm_scale_log2, lane)
