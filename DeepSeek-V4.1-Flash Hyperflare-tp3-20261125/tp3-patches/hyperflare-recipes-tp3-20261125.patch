@@ -0,0 +1,386 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 Flare community contributors
+# SPDX-License-Identifier: Apache-2.0
+
+"""One-launch 24-head DSV41 BF16 MLA prefill for TP3. Default off.
+
+At TP3 a DeepSeek V4.1 rank holds 24 query heads. b12x tiles DSV41 BF16 MLA prefill 16 heads per CTA, so
+``run_unified_prefill`` launches a 16-head grid and an 8-head remainder grid (zero-padded to 16 rows), each
+gathering and dequantizing every 64-candidate KV window from scratch (~1.24 ms/layer = ~25 ms per 4,096-row
+encoder chunk spent on the 8-head remainder launch alone).
+
+``H24PrefillKernel`` is our own CuTe kernel (no b12x file changes): one CTA per query token stages Q for all 24
+heads, gathers each 64-candidate KV window once (b12x's ``io_issue_gather_glm_mg`` producer, unchanged), and feeds
+each dequantized K/V fragment to both head tiles (heads 0-15 and heads 16-23), writing both tiles via b12x's own
+``s7_epilogue`` (including optional ``attn_sink``). Bit-identical BF16 output and base-2 LSE by construction.
+
+Selection: ``FLARE_DS41_MLA_H24_PREFILL=1`` wraps b12x's ``prefill_mg._sparse_mla_prefill_mg_flat_launch``. For
+DSV41 BF16 24-head prefill (``fp8_internal=False``), the 16-head partition launches ``H24PrefillKernel`` (using
+the identical runtime argument tuple so a prepared launch replays directly through b12x's ``run_compiled``) and
+the 8-head remainder partition returns ``REMAINDER_DONE``.
+"""
+
+import functools
+import hashlib
+import inspect
+import os
+from pathlib import Path
+
+from .mla_h24_decode import (
+    BI,
+    CAND_WINDOW,
+    D_NOPE,
+    ENV_Q_ROPE,
+    HEADS,
+    KV_SMEM_STRIDE,
+    MATH_THREADS,
+    N_V_CHUNKS,
+    Q_NOPE_STRIDE,
+    REMAINDER_DONE,
+    SM_P_STRIDE,
+    SMEM_LIMIT,
+    _RemainderDone,
+    _compile_time_angles,
+    _normalize_angles,
+    check_traits,
+    current_q_rope_angles,
+    install_stable_fingerprint,
+    q_rope_angles,
+    q_rope_enabled_from_environment,
+)
+
+ENV = "FLARE_DS41_MLA_H24_PREFILL"
+_TARGET = "_sparse_mla_prefill_mg_flat_launch"
+_ORIGINAL = "_flare_h24_prefill_original"
+KERNEL_ID = "flare.attention.mla.sm120.prefill_h24"
+KERNEL_ID_ROPE = "flare.attention.mla.sm120.prefill_h24_rope"
+KERNEL_VERSION = 1
+
+IO_THREADS = 64
+BLOCK_THREADS = MATH_THREADS + IO_THREADS  # 320 (8 math warps + 2 IO warps)
+IO_REGS = 24
+MATH_REGS = 240
+REDUCE_GROUP_BYTES = 2 * 8 * 16 * 4  # 1024 B per head group (max + sum/persistent-max)
+REDUCE_WARP_SUM_OFF = 8 * 16 * 4     # 512 B
+
+
+def enabled_from_environment(env=None) -> bool:
+    return (os.environ if env is None else env).get(ENV, "").strip() == "1"
+
+
+@functools.lru_cache(maxsize=1)
+def source_identity():
+    here = Path(__file__).resolve().parent
+    own = hashlib.sha256(
+        b"".join(
+            (here / name).read_bytes()
+            for name in ("mla_h24_prefill.py", "mla_h24_prefill_kernel.py", "mla_h24_kernel.py")
+        )
+    ).hexdigest()
+    from b12x.attention._shared.mla import decode_math, io_mg, prefill, prefill_mg, smem_mg, traits
+    base = hashlib.sha256()
+    for module in (prefill, prefill_mg, decode_math, io_mg, smem_mg, traits):
+        base.update(Path(inspect.getsourcefile(module)).read_bytes())
+    return own, base.hexdigest()
+
+
+def smem_offsets():
+    """(name, offset, bytes) of the H24 prefill layout (checked against SharedStorage in tests)."""
+    def align(value, to):
+        return (value + to - 1) // to * to
+
+    regions = (
+        ("q", HEADS * Q_NOPE_STRIDE * 2, 128),
+        ("kv", 2 * BI * KV_SMEM_STRIDE, 128),
+        ("mbar", 4 * 8, 16),
+        ("reduce", 2 * REDUCE_GROUP_BYTES, 4),
+        ("sm_p", 16 * SM_P_STRIDE * 2, 128),
+        ("sm_p2", 8 * SM_P_STRIDE * 2, 16),
+    )
+    out, offset = [], 0
+    for name, size, alignment in regions:
+        offset = align(offset, alignment)
+        out.append((name, offset, size))
+        offset += size
+    return tuple(out), align(offset, 128)
+
+
+def _prefill_runtime_args(
+    q, kv_flat, topk_indices, topk_length, attn_sink_t, output, lse_out,
+    extra_kv_flat, extra_indices_t, extra_len_t, sm_scale, latent_scale,
+    stride_kv_block, has_extra, stride_extra_kv_block, *, angles_2d=None,
+):
+    import cuda.bindings.driver as cuda
+    import cutlass
+    import torch
+    from cutlass import Float32, Int32, Int64
+    from b12x.attention._shared.cute.ops import LOG2_E
+    from b12x.attention._shared.mla.prefill_mg import _to_cute
+
+    stream = cuda.CUstream(torch.cuda.current_stream().cuda_stream)
+    args = (
+        _to_cute(q, cutlass.BFloat16, dynamic_layout=True),
+        _to_cute(kv_flat, cutlass.Uint8, align=16),
+        _to_cute(topk_indices, cutlass.Int32, align=4, dynamic_layout=True),
+        _to_cute(topk_length, cutlass.Int32, align=4, dynamic_layout=True),
+        _to_cute(attn_sink_t, cutlass.Float32, align=4),
+        _to_cute(output, cutlass.BFloat16, align=16, dynamic_layout=True),
+        _to_cute(lse_out, cutlass.Float32, align=4, dynamic_layout=True),
+        Float32(float(sm_scale) * LOG2_E),
+        Float32(float(latent_scale)),
+        Int64(stride_kv_block),
+    )
+    if has_extra:
+        args = args + (
+            _to_cute(extra_kv_flat, cutlass.Uint8, align=16),
+            _to_cute(extra_indices_t, cutlass.Int32, align=4, dynamic_layout=True),
+            _to_cute(extra_len_t, cutlass.Int32, align=4, dynamic_layout=True),
+            Int64(stride_extra_kv_block),
+        )
+    if angles_2d is not None:
+        args = args + (_to_cute(angles_2d, cutlass.Float32, align=16, dynamic_layout=True),)
+    return args + (Int32(int(q.shape[0])), stream)
+
+
+def launch_h24_prefill(
+    q, kv_flat, topk_indices, topk_length, attn_sink_t, output, lse_out,
+    extra_kv_flat, extra_indices_t, extra_len_t, sm_scale, latent_scale,
+    page_block_size, topk, num_tiles, stride_kv_block, has_sink,
+    has_extra, extra_topk, num_main_tiles, pbs_extra, stride_extra_kv_block,
+    *, angles=None,
+):
+    """Compile (or plan under compile_only_launches) and launch H24PrefillKernel.
+
+    When ``angles=None``, runtime argument tuple matches b12x ``_sparse_mla_prefill_mg_flat_launch`` identically,
+    so a prepared launcher replays through b12x's ``run_compiled`` directly. When ``angles`` is provided (FP32
+    ``[rows, 64]`` split or ``[rows, 32, 2]`` interleaved), Q-RoPE on dims [448, 512) is fused into ``s0_load_q24``.
+    """
+    from b12x._lib.compiler import DimKey, KernelCompileSpec, key_field, launch, tensor_key
+    from b12x.attention._shared.mla.prefill_mg import _topk_bucket
+    from b12x.attention._shared.mla.traits import ComputeMode, ModelType, ScaleFormat, make_unified_traits
+
+    traits = make_unified_traits(ModelType.DSV41, ComputeMode.BF16, ScaleFormat.NVFP4_E4M3, fp8_rope=False)
+    check_traits(traits)
+    if tuple(q.shape[1:]) != (HEADS, D_NOPE) or int(q.stride(2)) != 1:
+        raise ValueError(f"H24 prefill needs q (rows, 24, 512) with unit dim stride, got {tuple(q.shape)}")
+    has_extra = bool(has_extra)
+    if has_extra and int(num_main_tiles) < 1:
+        raise ValueError(f"H24 dual-cache prefill requires num_main_tiles>=1, got {num_main_tiles}")
+    angles_2d, split_angles = _normalize_angles(angles, int(q.shape[0]))
+    fuse_rope = angles_2d is not None
+
+    from hyperflare_recipes.components.mla_h24_prefill_kernel import H24PrefillKernel
+
+    kernel = H24PrefillKernel(
+        traits,
+        int(page_block_size),
+        int(num_tiles),
+        q_stride=tuple(q.stride()),
+        indices_stride0=int(topk_indices.stride(0)),
+        output_stride=tuple(output.stride()),
+        out_lse_stride=tuple(lse_out.stride()),
+        has_sink=bool(has_sink),
+        topk=int(topk),
+        has_extra=has_extra,
+        pbs_extra=int(pbs_extra),
+        num_main_tiles=int(num_main_tiles),
+        extra_topk=int(extra_topk),
+        extra_indices_stride0=int(extra_indices_t.stride(0)),
+        angles_stride0=int(angles_2d.stride(0)) if fuse_rope else 64,
+        split_angles=split_angles,
+    )
+    args = _prefill_runtime_args(
+        q, kv_flat, topk_indices, topk_length, attn_sink_t, output, lse_out,
+        extra_kv_flat, extra_indices_t, extra_len_t, sm_scale, latent_scale,
+        stride_kv_block, has_extra, stride_extra_kv_block, angles_2d=angles_2d,
+    )
+
+    own, base = source_identity()
+    spec_fields = [
+        key_field("flare_source", own),
+        key_field("b12x_mla_prefill_source", base),
+        key_field("latent_scale_identity", int(float(latent_scale) == 1.0)),
+        key_field("num_tiles", int(num_tiles)),
+        key_field("page_block_size", int(page_block_size)),
+        key_field("topk_bucket", _topk_bucket(topk)),
+        key_field("has_sink", int(has_sink)),
+        tensor_key("q", q, dims=(DimKey.dynamic(), DimKey.exact(HEADS), DimKey.exact(D_NOPE))),
+        tensor_key("topk_indices", topk_indices, dims=(DimKey.dynamic(), DimKey.bucket(topk))),
+        tensor_key("output", output, dims=(DimKey.dynamic(), DimKey.exact(HEADS), DimKey.exact(512))),
+        tensor_key("out_lse", lse_out, dims=(DimKey.dynamic(), DimKey.exact(HEADS))),
+    ]
+    if has_extra:
+        spec_fields.extend([
+            key_field("has_extra", 1),
+            key_field("num_main_tiles", int(num_main_tiles)),
+            key_field("pbs_extra", int(pbs_extra)),
+            key_field("extra_topk_bucket", _topk_bucket(extra_topk)),
+            tensor_key("extra_indices", extra_indices_t, dims=(DimKey.dynamic(), DimKey.bucket(max(extra_topk, 1)))),
+        ])
+    if fuse_rope:
+        spec_fields.extend([
+            key_field("split_angles", int(split_angles)),
+            tensor_key("angles", angles_2d, dims=(DimKey.dynamic(), DimKey.exact(64))),
+        ])
+    spec = KernelCompileSpec.from_fields(KERNEL_ID_ROPE if fuse_rope else KERNEL_ID, KERNEL_VERSION, *spec_fields)
+    install_stable_fingerprint()
+    if has_extra:
+        entry = kernel.call_dual_rope if fuse_rope else kernel.call_dual
+    else:
+        entry = kernel.call_single_rope if fuse_rope else kernel
+    return launch(entry, compile_spec=spec, compile_args=args, runtime_args=args)
+
+
+def _is_h24_prefill_program(prepared):
+    return any(getattr(key, "name", "") == KERNEL_ID for key in getattr(prepared, "__b12x_programs__", ()) or ())
+
+
+def _is_h24_prefill_rope_program(prepared):
+    return any(getattr(key, "name", "") == KERNEL_ID_ROPE for key in getattr(prepared, "__b12x_programs__", ()) or ())
+
+
+class _H24PrefillLaunch:
+    """Replacement for prefill_mg._sparse_mla_prefill_mg_flat_launch."""
+
+    def __init__(self, inner, launcher=launch_h24_prefill, *, fuse_q_rope=False, split_angles=True):
+        self.inner = inner
+        self.launcher = launcher
+        self.fuse_q_rope = bool(fuse_q_rope)
+        self.split_angles = bool(split_angles)
+        self.signature = inspect.signature(inner)
+        self.pending = {}
+        self.applied = []
+        self.replays = 0
+
+    @staticmethod
+    def _eligible(a):
+        q = a["q"]
+        return (
+            int(q.shape[1]) == HEADS
+            and int(a["model_type"]) == 3
+            and int(a["compute_mode"]) == 1
+            and int(a["scale_format"]) == 2
+            and not a["fp8_rope"]
+            and not a["latent_scale_per_token"]
+            and not a["fp8_internal"]
+            and int(a["mg_n_hg"]) == 1
+        )
+
+    @staticmethod
+    def _identity(a):
+        def pointer(tensor):
+            from torch._subclasses.fake_tensor import FakeTensor
+            if isinstance(tensor, FakeTensor) or getattr(tensor, "is_meta", False):
+                return id(tensor)
+            try:
+                return int(tensor.data_ptr())
+            except Exception:
+                return id(tensor)
+        q = a["q"]
+        index = getattr(getattr(q, "device", None), "index", None)
+        return index, (pointer(q), pointer(a["output"]))
+
+    def __call__(self, *args, **kwargs):
+        bound = self.signature.bind(*args, **kwargs)
+        bound.apply_defaults()
+        a = bound.arguments
+        prepared = a.get("prepared")
+        if prepared is REMAINDER_DONE or isinstance(prepared, _RemainderDone):
+            return None
+        if prepared is not None and _is_h24_prefill_rope_program(prepared):
+            from b12x._lib.compiler import run_compiled
+            angles = current_q_rope_angles()
+            if angles is None:
+                raise RuntimeError("H24 RoPE-fused prefill replay requires active mla_h24_prefill.q_rope_angles(angles)")
+            angles_2d, _ = _normalize_angles(angles, int(a["q"].shape[0]))
+            runtime_args = _prefill_runtime_args(
+                a["q"], a["kv_flat"], a["topk_indices"], a["topk_length"], a["attn_sink_t"],
+                a["output"], a["lse_out"], a["extra_kv_flat"], a["extra_indices_t"], a["extra_len_t"],
+                a["sm_scale"], a["latent_scale"], a["stride_kv_block"], bool(a["has_extra"]),
+                a["stride_extra_kv_block"], angles_2d=angles_2d,
+            )
+            self.replays += 1
+            return run_compiled(prepared, runtime_args)
+        if prepared is not None and _is_h24_prefill_program(prepared):
+            if current_q_rope_angles() is not None:
+                raise RuntimeError("H24 prefill: q_rope_angles is active during replay of a non-RoPE prepared program")
+            self.replays += 1
+            return self.inner(*args, **kwargs)
+        if prepared is not None or not self._eligible(a):
+            if prepared is not None and current_q_rope_angles() is not None:
+                raise RuntimeError("H24 prefill: q_rope_angles is active during replay of a non-H24 prepared program")
+            return self.inner(*args, **kwargs)
+        active = a["active_heads"]
+        active = int(a["q"].shape[1]) if active is None else int(active)
+        offset = int(a["head_offset"])
+        index, identity = self._identity(a)
+        if (offset, active) == (0, 16):
+            angles = current_q_rope_angles()
+            if angles is None and self.fuse_q_rope:
+                angles = _compile_time_angles(a["q"], self.split_angles)
+            kw = {"angles": angles} if angles is not None else {}
+            launched = self.launcher(
+                a["q"], a["kv_flat"], a["topk_indices"], a["topk_length"], a["attn_sink_t"],
+                a["output"], a["lse_out"], a["extra_kv_flat"], a["extra_indices_t"], a["extra_len_t"],
+                a["sm_scale"], a["latent_scale"], a["page_block_size"], a["topk"], a["num_tiles"],
+                a["stride_kv_block"], a["has_sink"], a["has_extra"], a["extra_topk"],
+                a["num_main_tiles"], a["pbs_extra"], a["stride_extra_kv_block"], **kw,
+            )
+            self.pending[index] = identity
+            self.applied.append((int(a["q"].shape[0]), bool(a["has_extra"])))
+            return launched
+        if (offset, active) == (16, 8) and self.pending.get(index) == identity:
+            del self.pending[index]
+            return REMAINDER_DONE
+        raise RuntimeError(
+            f"H24 prefill: unexpected partition (head_offset={offset}, active_heads={active}) for 24-head DSV41 prefill"
+        )
+
+
+def _prefill_module():
+    from b12x.attention._shared.mla import prefill_mg
+    return prefill_mg
+
+
+def install(prefill_mg=None, launcher=launch_h24_prefill, *, fuse_q_rope=False, split_angles=True):
+    """Wrap b12x's prefill MG launcher (idempotent replacement). Returns the wrapper."""
+    prefill_mg = _prefill_module() if prefill_mg is None else prefill_mg
+    current = getattr(prefill_mg, _TARGET)
+    inner = current.inner if isinstance(current, _H24PrefillLaunch) else current
+    wrapper = _H24PrefillLaunch(inner, launcher, fuse_q_rope=fuse_q_rope, split_angles=split_angles)
+    setattr(prefill_mg, _ORIGINAL, inner)
+    setattr(prefill_mg, _TARGET, wrapper)
+    from . import mla_discovery_key
+    mla_discovery_key.install()
+    install_stable_fingerprint()
+    return wrapper
+
+
+def uninstall(prefill_mg=None):
+    prefill_mg = _prefill_module() if prefill_mg is None else prefill_mg
+    original = getattr(prefill_mg, _ORIGINAL, None)
+    if original is not None:
+        setattr(prefill_mg, _TARGET, original)
+        delattr(prefill_mg, _ORIGINAL)
+
+
+def install_from_environment():
+    """Install only when FLARE_DS41_MLA_H24_PREFILL=1, leaving b12x unchanged by default."""
+    if enabled_from_environment():
+        fuse_rope = q_rope_enabled_from_environment()
+        wrapper = install(fuse_q_rope=fuse_rope)
+        rope_msg = " + fused Q-RoPE" if fuse_rope else ""
+        print(f"[flare] {ENV}=1: DSV41 24-head one-launch prefill{rope_msg} installed (pid {os.getpid()})", flush=True)
+        return wrapper
+    return None
+
+
+def is_installed(prefill_mg=None) -> bool:
+    prefill_mg = _prefill_module() if prefill_mg is None else prefill_mg
+    return isinstance(getattr(prefill_mg, _TARGET), _H24PrefillLaunch)
+
+
+def will_fuse_q_rope(prefill_mg=None) -> bool:
+    """Return True if H24 prefill with fused Q-RoPE is installed."""
+    prefill_mg = _prefill_module() if prefill_mg is None else prefill_mg
+    current = getattr(prefill_mg, _TARGET)
+    return isinstance(current, _H24PrefillLaunch) and current.fuse_q_rope
