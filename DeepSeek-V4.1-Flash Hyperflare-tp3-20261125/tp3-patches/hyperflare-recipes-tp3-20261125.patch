diff --git a/hyperflare_recipes/recipes/deepseek41/steering.py b/hyperflare_recipes/recipes/deepseek41/steering.py
new file mode 100644
index 0000000..b824bd1
--- /dev/null
+++ b/hyperflare_recipes/recipes/deepseek41/steering.py
@@ -0,0 +1,174 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 Flare community contributors
+# SPDX-License-Identifier: Apache-2.0
+
+"""Prepared activation-steering constants for DeepSeek V4.1 decoder layers."""
+
+import hashlib
+import math
+from collections.abc import Mapping
+from dataclasses import dataclass
+from pathlib import Path
+from types import MappingProxyType
+
+import torch
+from safetensors.torch import load_file
+
+from ignition.preparation.persistent import persistent_copy
+
+
+@dataclass(frozen=True)
+class LayerSteering:
+    alpha: float
+    direction: torch.Tensor
+    attention_gain_delta: torch.Tensor
+
+
+@dataclass(frozen=True)
+class SteeringSidecar:
+    layers: Mapping[int, LayerSteering]
+    sha256: bytes
+
+    @classmethod
+    def load(cls, path: str | Path, device: torch.device) -> "SteeringSidecar":
+        path = Path(path).expanduser().resolve()
+        if not path.is_file():
+            raise ValueError(f"steering sidecar is not a file: {path}")
+        digest = hashlib.sha256(path.read_bytes()).digest()
+        tensors = load_file(str(path), device="cpu")
+        expected = {
+            f"layers.{layer}.{name}"
+            for layer in range(4, 37)
+            for name in ("alpha", "attn_row_gain", "direction")
+        }
+        if set(tensors) != expected:
+            missing = sorted(expected - set(tensors))
+            extra = sorted(set(tensors) - expected)
+            raise ValueError(
+                f"steering sidecar tensor inventory differs from layers 4 through 36: "
+                f"missing={missing}, extra={extra}"
+            )
+        layers = {}
+        for layer in range(4, 37):
+            prefix = f"layers.{layer}"
+            alpha_tensor = tensors[f"{prefix}.alpha"]
+            direction = tensors[f"{prefix}.direction"]
+            gain = tensors[f"{prefix}.attn_row_gain"]
+            if alpha_tensor.dtype != torch.float32 or alpha_tensor.shape != torch.Size([]):
+                raise ValueError(f"{prefix}.alpha must be a scalar FP32 tensor")
+            if direction.dtype != torch.bfloat16 or direction.shape != (5120,):
+                raise ValueError(f"{prefix}.direction must be BF16[5120]")
+            if gain.dtype != torch.bfloat16 or gain.shape != (5120,):
+                raise ValueError(f"{prefix}.attn_row_gain must be BF16[5120]")
+            alpha = float(alpha_tensor.item())
+            norm = float(direction.float().norm().item())
+            if (not math.isfinite(alpha) or alpha <= 0.0
+                    or not bool(torch.isfinite(direction.float()).all())
+                    or not bool(torch.isfinite(gain.float()).all())
+                    or abs(norm - 1.0) >= 1e-3):
+                raise ValueError(f"{prefix} contains non-finite, non-positive-alpha, or non-unit-norm steering values")
+            layers[layer] = LayerSteering(
+                alpha=alpha,
+                direction=persistent_copy(direction.to(device=device, non_blocking=False).contiguous()),
+                attention_gain_delta=persistent_copy(
+                    (gain.float() - 1.0).to(torch.bfloat16).to(device=device, non_blocking=False).contiguous()
+                ),
+            )
+        return cls(MappingProxyType(layers), digest)
+
+
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _steer_rows_kernel(
+    OutPtr, DirPtr, GainPtr, ScalePtr,
+    ROWS,
+    ROW_STRIDE: tl.constexpr,
+    ALPHA,
+    HAS_GAIN: tl.constexpr,
+    H: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0)
+    stride = tl.num_programs(0)
+    while row < ROWS:
+        s = tl.load(ScalePtr + row).to(tl.float32)
+        if s != 0.0:
+            base = row.to(tl.int64) * ROW_STRIDE
+            dot = tl.zeros((), dtype=tl.float32)
+            for off in tl.static_range(0, H, BLOCK):
+                cols = off + tl.arange(0, BLOCK)
+                mask = cols < H
+                x = tl.load(OutPtr + base + cols, mask=mask, other=0.0).to(tl.float32)
+                d = tl.load(DirPtr + cols, mask=mask, other=0.0).to(tl.float32)
+                dot += tl.sum(x * d, axis=0)
+            coeff = s * ALPHA * dot
+            for off in tl.static_range(0, H, BLOCK):
+                cols = off + tl.arange(0, BLOCK)
+                mask = cols < H
+                x = tl.load(OutPtr + base + cols, mask=mask, other=0.0).to(tl.float32)
+                d = tl.load(DirPtr + cols, mask=mask, other=0.0).to(tl.float32)
+                v = x - coeff * d
+                if HAS_GAIN:
+                    g = tl.load(GainPtr + cols, mask=mask, other=0.0).to(tl.float32)
+                    v = v * (1.0 + s * g)
+                tl.store(OutPtr + base + cols, v.to(OutPtr.dtype.element_ty), mask=mask)
+        row += stride
+
+
+@torch.library.custom_op("flare::ds41_steer_rows_inplace", mutates_args=("output",))
+def _steer_rows_inplace(output: torch.Tensor, direction: torch.Tensor,
+                        gain_delta: torch.Tensor | None, token_scale: torch.Tensor,
+                        alpha: float) -> None:
+    rows, hidden = output.shape
+    if rows == 0:
+        return
+    scale_1d = token_scale.reshape(rows)
+    has_gain = gain_delta is not None
+    gptr = gain_delta if has_gain else direction
+    grid = (min(rows, 188),)
+    _steer_rows_kernel[grid](
+        output, direction, gptr, scale_1d,
+        rows,
+        ROW_STRIDE=output.stride(0), ALPHA=float(alpha),
+        HAS_GAIN=has_gain, H=hidden, BLOCK=1024, num_warps=8,
+    )
+
+
+@_steer_rows_inplace.register_fake
+def _steer_rows_inplace_fake(output, direction, gain_delta, token_scale, alpha):
+    pass
+
+
+def steer_attention(output: torch.Tensor, steering: LayerSteering,
+                    token_scale: torch.Tensor) -> torch.Tensor:
+    """Project and row-rescale a replicated attention output (zero-HBM fast path when scale == 0)."""
+    if output.is_cuda and output.ndim == 2 and output.shape[1] == 5120 and output.stride(1) == 1:
+        _steer_rows_inplace(output, steering.direction, steering.attention_gain_delta,
+                            token_scale, steering.alpha)
+        return output
+    direction = steering.direction.float()
+    projected = output.float()
+    dot = (projected @ direction).unsqueeze(1)
+    projected = projected - token_scale * steering.alpha * dot * direction.unsqueeze(0)
+    projected = projected * (
+        1.0 + token_scale * steering.attention_gain_delta.float().unsqueeze(0)
+    )
+    steered = projected.to(output.dtype)
+    return torch.where(token_scale == 0.0, output, steered)
+
+
+def steer_shared_expert(output: torch.Tensor, steering: LayerSteering,
+                        token_scale: torch.Tensor) -> torch.Tensor:
+    """Project one rank's shared-expert partial before the existing reduction (zero-HBM fast path when scale == 0)."""
+    if output.is_cuda and output.ndim == 2 and output.shape[1] == 5120 and output.stride(1) == 1:
+        _steer_rows_inplace(output, steering.direction, None, token_scale, steering.alpha)
+        return output
+    direction = steering.direction.float()
+    projected = output.float()
+    dot = (projected @ direction).unsqueeze(1)
+    steered = (
+        projected - token_scale * steering.alpha * dot * direction.unsqueeze(0)
+    ).to(output.dtype)
+    return torch.where(token_scale == 0.0, output, steered)
diff --git a/hyperflare_recipes/recipes/deepseek41/tp3_config.py b/hyperflare_recipes/recipes/deepseek41/tp3_config.py
new file mode 100644
index 0000000..bd6ac7a
--- /dev/null
+++ b/hyperflare_recipes/recipes/deepseek41/tp3_config.py
@@ -0,0 +1,1063 @@
+# SPDX-License-Identifier: Apache-2.0
+"""TP3 fork configuration for the DeepSeek V4.1 Flash recipe: one typed, frozen object for every switch.
+
+``TP3Config.from_environment()`` is the single place that reads the ``FLARE_DS41_*`` environment (the release
+``export.sh`` sets it); everything else receives a ``TP3Config`` instance. The dataclass defaults are the bare
+upstream behaviour (nothing parked, no BRRR, no vision staging), so a ``TP3Config()`` is what a test or a plain
+``ignition export`` without the fork's environment gets.
+
+Parsing keeps the historical semantics: an empty string counts as unset, integers default to 0 ("or 0"), layer sets
+accept ``"20-33"`` ranges and ``"20,21"`` lists (mixed, comma separated), and flags are ``"1"`` unless noted.
+"""
+
+import hashlib
+import json
+import os
+import re
+from dataclasses import MISSING, dataclass, field, fields
+from pathlib import Path
+
+ENV_PREFIX = "FLARE_DS41_"
+# b12x's own switch for programmatic dependent launch in its mHC kernels; TP3Config records it as ``mhc_pdl``.
+MHC_PDL_ENV = "B12X_MHC_PDL"
+
+# Switches whose code is not on the 2026-11-14 upstream port yet: TP3Config still parses and records them (the release
+# environment keeps its meaning), but preparation refuses a non-default value until the named stage lands
+# (``TP3Config.require_ported``), so an export never silently drops a saving or a kernel. Empty since S5.
+UNPORTED = {}
+
+# Routed experts per DeepSeek V4.1 MoE layer (hot_experts >= this keeps a parked layer fully resident).
+ROUTED_EXPERTS = 384
+
+# VRAM reclaim switches (2026-11-15 memory map) and their environment names. FLARE_DS41_VRAM_RECLAIM=1 is the
+# umbrella: it turns every one on unless its own variable says otherwise ("1" on, any other set value off).
+VRAM_RECLAIM = {
+    "share_engram_token_map": "SHARE_ENGRAM_TOKEN_MAP",
+    "trim_vocab_gather": "TRIM_VOCAB_GATHER",
+    "skip_draft_vocab_gather": "SKIP_DRAFT_VOCAB_GATHER",
+    "share_vocab_columns": "SHARE_VOCAB_COLUMNS",
+}
+
+# Optional tuning switches added after the 2026-11-15 default (151744): recorded in to_metadata only when set, so the
+# record of a default export stays the reference's (the quick/combined chains require an identical record).
+RECORDED_WHEN_SET = ("brrr_spin_ns", "brrr_two_shot_min", "brrr_ks_wob", "brrr_woa_small", "brrr_woa_uneven", "brrr_per_sm",
+                     "brrr_push_v2",
+                     "prefill_graphs", "draft_vocab", "prefill_skip_suffix", "draft_head_plans", "markov_tile_rows",
+                     "mla_decode_splits", "mla_h24", "index_row_split", "index_row_split_min_context",
+                     "index_row_split_variant_graphs")
+
+# On/off switches added for ds41-tp3-next (2026-11-17): recorded only when on, so a default export's record equals the
+# earlier reference record.
+RECORDED_WHEN_TRUE = ("mma_pad_once", "vision_arena_host", "markov_embed_host", "glue_pass2", "markov_stage_rows",
+                      "rotary_once", "pin_small_qproj", "logprob_single_exchange", "no_generation_logprobs",
+                      "index_row_split_check")
+# Decode small-lever switches (perf/ds41-decode-small-levers, 2026-11-18): on/off, recorded only when on.
+SMALL_LEVERS = ("rotary_once", "pin_small_qproj", "logprob_single_exchange", "no_generation_logprobs")
+# E3c-a exact levers (perf/ds41-e3c-a, 2026-11-19): on/off, recorded only when
+# on, so a default export's record is unchanged. F = dcp_gather_pull, d = rotary_once_prefill.
+E3C_A = ("rotary_once_prefill", "dcp_gather_pull")
+RECORDED_WHEN_TRUE = RECORDED_WHEN_TRUE + E3C_A
+# Steering inside BRRR (feat/ds41-steering-brrr): on/off, recorded
+# only when on.
+RECORDED_WHEN_TRUE = RECORDED_WHEN_TRUE + ("steering_plain_identity",)
+# Stage 1 decode levers (perf/ds41-stage1-decode): on/off, recorded only when on.
+STAGE1_DECODE = ("brrr_draft", "engram_local_lookup", "engram_side_split")
+RECORDED_WHEN_TRUE = RECORDED_WHEN_TRUE + STAGE1_DECODE + (
+    "prefill_dma", "mla_h24_prefill", "brrr_push", "brrr_skip_pad", "pin_mid_qkv_norm", "index_side_prefill",
+    "brrr_rope_angles", "engram_no_readiness_barrier", "engram_full_projection",
+)
+# On/off switches that default True and are recorded only when explicitly turned off.
+RECORDED_WHEN_FALSE = ("a16_qkv",)
+# b12x's switch of the gather-pull overlay patch (tp3-patches/overlay/flashinfer-dcp-gather-pull-world3.patch)
+GATHER_PULL_ENV = "B12X_PCIE_DCP_GATHER_PULL"
+
+# tp3.pin_small_qproj: the plan triple pinned for every attention declaration of at most PIN_SMALL_ROWS rows (b12x
+# offers programmatic launch / evict-first / FP32 split-K partials for MXFP8 GEMMs only up to 8 rows,
+# gemm/_tuning.py ready_small_mxfp8). The values are the 11-15 cache's selections at 3 and 6 target rows (the 5-row
+# declarations lost both by 0.02 / 0.01 us in their standalone races: REVIEW-FABLE.md section 1, 2026-11-18).
+PIN_SMALL_ROWS = 8
+PIN_SMALL_QPROJ = {
+    "qkv_a": {"backend": "cutedsl", "tile_m": 32, "tile_n": 64, "tile_k": 128, "load_path": "tma", "swap_ab": False,
+              "split_k_slices": 4, "large_m_unroll": True, "target_occupancy": None,
+              "programmatic_serialization": True, "evict_first": False},
+    "q_b": {"backend": "cutedsl", "tile_m": 16, "tile_n": 128, "tile_k": 128, "load_path": "tma", "swap_ab": False,
+            "split_k_slices": 1, "large_m_unroll": False, "target_occupancy": None,
+            "programmatic_serialization": True, "evict_first": True},
+    "norm": {"programmatic_serialization": True},
+}
+# tp3.pin_mid_qkv_norm: extend fused split-K qkv_a + qkv_norm (mla_reduce_norm, with PDL) to 9..96 rows
+# (b12x-wave4 lifts ready_small_mxfp8 and split-K row cap to 96; measured -1.3..4.1 us/L on SM120).
+PIN_MID_QKV_ROWS = 96
+PIN_MID_QKV_NORM = {
+    "qkv_a": {"backend": "cutedsl", "tile_m": 32, "tile_n": 64, "tile_k": 128, "load_path": "tma", "swap_ab": False,
+              "split_k_slices": 4, "large_m_unroll": True, "target_occupancy": None,
+              "programmatic_serialization": True, "evict_first": False},
+    "norm": {"programmatic_serialization": True},
+}
+
+
+def pin_mid_qkv_norm_plans(rows: int) -> dict:
+    """Return pinned split-K=4 + PDL qkv_a/norm plans with tile_m >= rows (32/64/128)."""
+    tile_m = 32 if rows <= 32 else (64 if rows <= 64 else 128)
+    return {
+        "qkv_a": {**PIN_MID_QKV_NORM["qkv_a"], "tile_m": tile_m},
+        "norm": PIN_MID_QKV_NORM["norm"],
+    }
+
+# FLARE_DS41_PREFILL_SKIP_SUFFIX=1: the prefill capacities that get an encoder-only twin (the sizes that end the
