++                  "  .reg .pred p;\n"
++                  "XP_MBAR_WAIT:\n"
++                  "  mbarrier.try_wait.parity.shared.b64 p, [%0], %1;\n"
++                  "  @!p bra XP_MBAR_WAIT;\n"
