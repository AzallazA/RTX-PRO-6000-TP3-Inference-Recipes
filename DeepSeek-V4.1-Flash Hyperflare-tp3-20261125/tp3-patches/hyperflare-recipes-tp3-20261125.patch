+            _exit_thread()
+
+        if is_io:
+            # Single-pass DSV41 decode IO producer: 1 load/map per candidate, TMA first, overlapped tag store.
+            io_lane = tid - Int32(MATH_THREADS)
+            prod_phase = Int32(1)
+            prod_idx = Int32(0)
+            for lc in cutlass.range(active_chunks, unroll=1):
+                active_idx = Int32(lc)
+                ci = split_first_chunk + active_idx
+                if cutlass.const_expr(has_extra):
+                    if active_idx >= main_chunk_count:
+                        ci = extra_first_chunk + active_idx - main_chunk_count
+                buf = Int32(lc) & Int32(1)
+                cute.arch.mbarrier_wait(mbar_base + n_buf + prod_idx, phase=prod_phase)
+                if cutlass.const_expr(has_extra):
+                    if ci >= num_main_chunks:
+                        cis = ci - num_main_chunks
+                        g_start = cis * Int32(CAND_WINDOW)
+                        g_end = g_start + Int32(CAND_WINDOW)
+                        if g_end > extra_section_len:
+                            g_end = extra_section_len
+                        _io_issue_gather_dsv41_decode(
+                            extra_kv_cache_u8, extra_row, kv_addr + buf * kv_buf, mbar_base + buf,
+                            g_start, g_end, stride_extra_kv_block, io_lane,
+                            page_block_size=self.pbs_extra,
+                            dsv41_swa=False, use_mapping=True,
+                            mapping_page_table=mapping_page_table,
+                            mapping_table_width=mapping_table_width,
+                            mapping_table_offset=Int64(token_idx) * mapping_table_stride,
+                            mapping_num_pages=mapping_num_pages,
+                            mapping_page_size=self.pbs_extra,
+                        )
+                    else:
+                        g_start = ci * Int32(CAND_WINDOW)
+                        g_end = g_start + Int32(CAND_WINDOW)
+                        if g_end > section_len:
+                            g_end = section_len
+                        _io_issue_gather_dsv41_decode(
+                            kv_cache_u8, topk_row, kv_addr + buf * kv_buf, mbar_base + buf,
+                            g_start, g_end, stride_kv_block, io_lane,
+                            page_block_size=self.page_block_size,
+                            dsv41_swa=True, use_mapping=False,
+                        )
+                else:
+                    g_start = ci * Int32(CAND_WINDOW)
+                    g_end = g_start + Int32(CAND_WINDOW)
+                    if g_end > section_len:
+                        g_end = section_len
+                    _io_issue_gather_dsv41_decode(
+                        kv_cache_u8, topk_row, kv_addr + buf * kv_buf, mbar_base + buf,
+                        g_start, g_end, stride_kv_block, io_lane,
+                        page_block_size=self.page_block_size,
+                        dsv41_swa=True, use_mapping=False,
+                    )
+                prod_idx += Int32(1)
+                if prod_idx == Int32(n_buf):
+                    prod_idx = Int32(0)
+                    prod_phase ^= Int32(1)
+        else:
+            if cutlass.const_expr(fuse_rope):
+                angles_row = cute.make_tensor(
+                    angles.iterator + token_idx.to(Int64) * Int64(self.angles_stride_row),
+                    cute.make_layout(64))
+                s0_load_q24(q_token, q_addr, tid, angles_row, fuse_rope=True, split_angles=self.split_angles)
+            else:
+                s0_load_q24(q_token, q_addr, tid)
+            accn = cute.make_rmem_tensor(N_V_CHUNKS * 4, Float32)
+            accn2 = cute.make_rmem_tensor(N_V_CHUNKS * 2, Float32)
+            gstate = cute.make_rmem_tensor(6, Float32)  # max0, max1, sum0, sum1 (tile 1), max2, sum2 (tile 2)
+            for k in cutlass.range_constexpr(N_V_CHUNKS * 4):
+                accn[k] = Float32(0.0)
+            for k in cutlass.range_constexpr(N_V_CHUNKS * 2):
+                accn2[k] = Float32(0.0)
+            gstate[0] = Float32(-1e30)
+            gstate[1] = Float32(-1e30)
+            gstate[2] = Float32(0.0)
+            gstate[3] = Float32(0.0)
+            gstate[4] = Float32(-1e30)
+            gstate[5] = Float32(0.0)
+            cons_phase = Int32(0)
+            cons_idx = Int32(0)
+            for lc in cutlass.range(active_chunks, unroll=1):
+                active_idx = Int32(lc)
+                ci = split_first_chunk + active_idx
+                if cutlass.const_expr(has_extra):
+                    if active_idx >= main_chunk_count:
+                        ci = extra_first_chunk + active_idx - main_chunk_count
+                buf = Int32(lc) & Int32(1)
+                kv_b = kv_addr + buf * kv_buf
+
+                cute.arch.mbarrier_wait(mbar_base + cons_idx, phase=cons_phase)
+
+                qk = [Float32(0.0), Float32(0.0), Float32(0.0), Float32(0.0)]
+                qk2 = [Float32(0.0), Float32(0.0), Float32(0.0), Float32(0.0)]
+                if cutlass.const_expr(has_extra):
