diff --git a/hyperflare_recipes/components/mla_decode_splits.py b/hyperflare_recipes/components/mla_decode_splits.py
new file mode 100644
index 0000000..a7e9d89
--- /dev/null
+++ b/hyperflare_recipes/components/mla_decode_splits.py
@@ -0,0 +1,185 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 Flare community contributors
+# SPDX-License-Identifier: Apache-2.0
+
+"""Per-row-count split policy for DeepSeek V4.1 BF16 MLA decode (TP3 decode lever 4a, 2026-11-18).
+
+b12x's DSV41 decode forces ``num_splits = workspace.num_chunks_value`` (prepare_unified_decode_launch), so the split
+count follows the tuned split geometry: 10 splits (one 64-candidate window per CTA) or 1 split for the 640-wide
+SWA + indexed decode. ``B12X_MLA_SM120_NUM_SPLITS`` cannot change it (the explicit/forced value wins over that
+environment variable in plan_unified_decode_splits). At TP3, 24 heads run as a 16-head and an 8-head grid of
+rows x 1 x splits CTAs each (one CTA per SM), so the decode costs whole waves of 2 x rows x splits CTAs on 188 SMs;
+fewer, longer splits can save a wave at some row counts (two-point model in decode-trace REVIEW-FABLE.md section 5).
+
+``FLARE_DS41_MLA_DECODE_SPLITS="9:10,18:5,28:10,37:5"`` wraps ``prepare_unified_decode_launch`` at runtime and passes
+``forced_num_splits`` for decode launches that attend an indexed cache: the first ``ROWS:SPLITS`` pair with prepared
+rows <= ROWS applies; rows above the last pair, SWA-only launches (drafts) and non-V4.1 models keep b12x's choice.
+b12x clamps the value to [1, ceil(width / 64)] and to the workspace's split capacity; splits stay on 64-candidate
+window boundaries, so the result differs from 10 splits only by the merge's FP32 rounding, as the tuner's 1-split
+candidate does today. No b12x source changes (b12x keys programs and tuning races by source fingerprints; a runtime
+attribute does not enter them). Export-time: graphs capture the prepared launch. Unset/empty leaves b12x untouched.
+"""
+
+import inspect
+import os
+
+ENV = "FLARE_DS41_MLA_DECODE_SPLITS"
+# 6-9 splits of 10 windows give chunks_per_split 2 with empty splits that still occupy SMs (always worse than 5).
+ALLOWED_SPLITS = (1, 2, 3, 4, 5, 10)
+# Minimum rows at which SWA-only DSV4.1 layers (128 candidates = 2 chunks) switch from 2 splits to 1 split
+# (empirically calibrated on SM120 188-SM GPU with v9 H24: S=2 wins <=41, S=1 EPILOGUE_FINAL_BF16 wins >=42).
+SWA_SINGLE_SPLIT_MIN_ROWS = 42
+# DSpark draft SWA-only layers (133 candidates = 3 chunks: 64+64+5): S=3 wins <=40, S=2 wins 45..59, S=1 wins >=60.
+DRAFT_TWO_SPLIT_MIN_ROWS = 45
+DRAFT_SINGLE_SPLIT_MIN_ROWS = 60
+_TARGET = "prepare_unified_decode_launch"
+_ORIGINAL = "_flare_decode_splits_original"
+
+
+def parse_policy(text):
+    """``"9:10,18:5"`` -> ((9, 10), (18, 5)); empty/None -> (). Row bounds strictly increasing, values >= 1."""
+    if text is None or not text.strip():
+        return ()
+    pairs = []
+    for item in text.split(","):
+        rows, sep, splits = item.strip().partition(":")
+        if not sep:
+            raise ValueError(f"{ENV}: expected ROWS:SPLITS pairs, got {item!r}")
+        rows, splits = int(rows), int(splits)
+        if rows < 1 or splits not in ALLOWED_SPLITS:
+            raise ValueError(f"{ENV}: rows must be positive and splits one of {ALLOWED_SPLITS}, got {item!r}")
+        if pairs and rows <= pairs[-1][0]:
+            raise ValueError(f"{ENV}: row bounds must increase, got {text!r}")
+        pairs.append((rows, splits))
+    return tuple(pairs)
+
+
+def format_policy(policy):
+    return ",".join(f"{rows}:{splits}" for rows, splits in policy)
+
+
+def policy_from_environment(env=None):
+    return parse_policy((os.environ if env is None else env).get(ENV))
+
+
+def splits_for(policy, rows):
+    for bound, splits in policy:
+        if rows <= bound:
+            return splits
+    return None
+
+
+def _kernel_module():
+    from b12x.attention._shared.mla import kernel
+    return kernel
+
+
+def _is_dsv41(traits):
+    if traits is None:
+        return False
+    from b12x.attention._shared.mla.traits import ModelType
+    return int(traits.model_type) == int(ModelType.DSV41)
+
+
+class _DecodeSplitPolicy:
+    """Replacement for kernel.prepare_unified_decode_launch; delegates every call, adding forced_num_splits."""
+
+    def __init__(
+        self,
+        original,
+        policy,
+        is_dsv41=_is_dsv41,
+        *,
+        swa_single_split_min_rows=SWA_SINGLE_SPLIT_MIN_ROWS,
+        draft_two_split_min_rows=DRAFT_TWO_SPLIT_MIN_ROWS,
+        draft_single_split_min_rows=DRAFT_SINGLE_SPLIT_MIN_ROWS,
+    ):
+        self.original = original
+        self.policy = policy
+        self.is_dsv41 = is_dsv41
+        self.swa_single_split_min_rows = swa_single_split_min_rows
+        self.draft_two_split_min_rows = draft_two_split_min_rows
+        self.draft_single_split_min_rows = draft_single_split_min_rows
+        self.signature = inspect.signature(original)
+        self.applied = []  # (rows, requested, planned num_splits) per forced preparation, for logs and tests
+
+    def __call__(self, *args, **kwargs):
+        bound = self.signature.bind(*args, **kwargs)
+        arguments = bound.arguments
+        if arguments.get("forced_num_splits") is None and self.is_dsv41(arguments.get("traits_override")):
+            rows = int(arguments["q_all"].shape[0])
+            if arguments.get("indexed_k_cache") is not None:
+                splits = splits_for(self.policy, rows)
+            else:
+                swa_indices = arguments.get("swa_indices")
+                swa_width = int(swa_indices.shape[1]) if swa_indices is not None and swa_indices.ndim >= 2 else 128
+                if swa_width > 128:
+                    if self.draft_single_split_min_rows is not None and rows >= self.draft_single_split_min_rows:
+                        splits = 1
+                    elif self.draft_two_split_min_rows is not None and rows >= self.draft_two_split_min_rows:
+                        splits = 2
+                    else:
+                        splits = None
+                elif self.swa_single_split_min_rows is not None and rows >= self.swa_single_split_min_rows:
+                    splits = 1
+                else:
+                    splits = None
+            if splits is not None:
+                arguments["forced_num_splits"] = splits
+                launch = self.original(*bound.args, **bound.kwargs)
+                self.applied.append((rows, splits, getattr(launch, "num_splits", None)))
+                return launch
+        return self.original(*bound.args, **bound.kwargs)
+
+
+def install(
+    policy,
+    kernel=None,
+    is_dsv41=_is_dsv41,
+    *,
+    swa_single_split_min_rows=SWA_SINGLE_SPLIT_MIN_ROWS,
+    draft_two_split_min_rows=DRAFT_TWO_SPLIT_MIN_ROWS,
+    draft_single_split_min_rows=DRAFT_SINGLE_SPLIT_MIN_ROWS,
+):
+    """Wrap b12x's decode preparation with ``policy`` (replaces an earlier policy). Returns the wrapper."""
+    kernel = _kernel_module() if kernel is None else kernel
+    current = getattr(kernel, _TARGET)
+    original = current.original if isinstance(current, _DecodeSplitPolicy) else current
+    wrapper = _DecodeSplitPolicy(
+        original,
+        tuple(policy),
+        is_dsv41,
+        swa_single_split_min_rows=swa_single_split_min_rows,
+        draft_two_split_min_rows=draft_two_split_min_rows,
+        draft_single_split_min_rows=draft_single_split_min_rows,
+    )
+    setattr(kernel, _ORIGINAL, original)
+    setattr(kernel, _TARGET, wrapper)
+    from . import mla_discovery_key  # other split counts are other programs: key b12x's persisted discovery to them
+    mla_discovery_key.install()
+    return wrapper
+
+
+def uninstall(kernel=None):
+    kernel = _kernel_module() if kernel is None else kernel
+    original = getattr(kernel, _ORIGINAL, None)
+    if original is not None:
+        setattr(kernel, _TARGET, original)
+        delattr(kernel, _ORIGINAL)
+
+
+def install_from_environment():
+    """Install only when a policy is set, so the default leaves b12x exactly as shipped."""
+    policy = policy_from_environment()
+    if policy:
+        wrapper = install(policy)
+        print(f"[flare] {ENV}={format_policy(policy)}: DSV41 decode split policy installed (pid {os.getpid()})",
+              flush=True)
+        return wrapper
+    return None
+
+
+def installed_policy(kernel=None):
+    """The policy the b12x decode preparation runs with in this process (``()`` when the hook is absent)."""
+    kernel = _kernel_module() if kernel is None else kernel
+    current = getattr(kernel, _TARGET)
+    return current.policy if isinstance(current, _DecodeSplitPolicy) else ()
diff --git a/hyperflare_recipes/components/mla_discovery_key.py b/hyperflare_recipes/components/mla_discovery_key.py
new file mode 100644
index 0000000..1530e73
--- /dev/null
+++ b/hyperflare_recipes/components/mla_discovery_key.py
@@ -0,0 +1,85 @@
+"""Keys b12x's persistent program discovery to the DSV41 decode hooks that change which programs a decode plan launches.
+
+b12x stores each candidate set's discovered programs in the preparation progress database under
+``b12x.preparation._discovery.discovery_key``: the b12x source closure of the factories, the toolchain and the
+candidate pickles. Our hooks (``FLARE_DS41_MLA_DECODE_SPLITS``: other split counts; ``FLARE_DS41_MLA_H24``: our own
+24-head program) change the programs ``compile_compressed_sparse_mla`` launches without changing any of that, so a
+record written by a run without them (or with another policy, or another H24 source) is restored as the planned set.
+Materialisation then launches a program that was never planned and b12x's no-compilation phase rejects it (E2
+export seq346: ``flare.attention.mla.sm120.decode_h24`` unplanned at ``SparseMlaConfig(max_chunks_per_row=1)``).
+
+The wrapper mixes the installed hook identity into the key, only for candidate sets that contain the compressed MLA
+factory and only while a hook is installed, so the default (no hook) and every other operation keep b12x's keys.
+No b12x file changes."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+
+FACTORY_MARK = "compressed_sparse_mla"
+_ORIGINAL = "_flare_mla_discovery_original"
+
+
+def hook_identity():
+    """JSON-ready identity of the installed DSV41 MLA hooks in this process, ``None`` when none is installed."""
+    from . import mla_decode_splits, mla_h24_decode, mla_h24_prefill
+
+    identity = {}
+    splits = mla_decode_splits.installed_policy()
+    if splits:
+        identity["mla_decode_splits"] = mla_decode_splits.format_policy(splits)
+    h24 = mla_h24_decode.installed_policy()
+    if h24:
+        own, base = mla_h24_decode.source_identity()
+        identity["mla_h24"] = [
+            mla_h24_decode.format_policy(h24), mla_h24_decode.KERNEL_VERSION,
+            own, base, int(mla_h24_decode.q_rope_enabled_from_environment()),
+        ]
+    if mla_h24_prefill.is_installed():
+        own, base = mla_h24_prefill.source_identity()
+        identity["mla_h24_prefill"] = [
+            mla_h24_prefill.KERNEL_VERSION, own, base, int(mla_h24_prefill.will_fuse_q_rope()),
+        ]
+    return identity or None
+
+
+def _has_mla_factory(candidates):
+    return any(FACTORY_MARK in str(job.factory) for _, _, jobs in candidates for job in jobs)
+
+
+class _HookedDiscoveryKey:
+    def __init__(self, original):
+        self.original = original
+
+    def __call__(self, candidates, device):
+        key = self.original(candidates, device)
+        if key is None or not _has_mla_factory(candidates):
+            return key
+        identity = hook_identity()
+        if identity is None:
+            return key
+        return hashlib.sha256(json.dumps({"b12x": key, "flare_mla_hooks": identity},
+                                         sort_keys=True).encode()).hexdigest()
+
+
+def install(session=None):
+    """Wrap the discovery key b12x's preparation session uses (idempotent). Returns the wrapper."""
+    if session is None:
+        from b12x.preparation import session
+    current = session.discovery_key
+    if isinstance(current, _HookedDiscoveryKey):
+        return current
+    wrapper = _HookedDiscoveryKey(current)
+    setattr(session, _ORIGINAL, current)
+    session.discovery_key = wrapper
+    return wrapper
+
+
+def uninstall(session=None):
+    if session is None:
+        from b12x.preparation import session
+    original = getattr(session, _ORIGINAL, None)
+    if original is not None:
+        session.discovery_key = original
+        delattr(session, _ORIGINAL)
diff --git a/hyperflare_recipes/components/mla_h24_decode.py b/hyperflare_recipes/components/mla_h24_decode.py
new file mode 100644
index 0000000..9eab4f8
--- /dev/null
+++ b/hyperflare_recipes/components/mla_h24_decode.py
@@ -0,0 +1,723 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 Flare community contributors
+# SPDX-License-Identifier: Apache-2.0
+
+"""One-launch 24-head DSV41 BF16 MLA decode for TP3 (decode lever 4b, 2026-11-18). Default off.
+
+At TP3 a DeepSeek V4.1 rank holds 24 query heads. b12x tiles BF16 MLA decode 16 heads per CTA, so
+``run_unified_decode`` launches a 16-head grid and an 8-head remainder grid (zero-padded to 16 rows), rows x 1 x
+splits CTAs each, one CTA per SM: 2 x rows x splits CTAs, and each remainder CTA gathers and dequantizes the same
+KV again. ``H24DecodeKernel`` is our own CuTe kernel (no b12x file changes): one CTA per (row, split) stages Q for all
+24 heads, gathers each 64-candidate KV window once (b12x's IO producer, unchanged), dequantizes every K/V fragment
+once and feeds it to two MMAs, one for heads 0-15 and one for heads 16-23 (rows 8-15 of that tile repeat heads
+16-23 instead of b12x's zero padding; MMA rows are independent and those rows are never written). Each 16-row tile
+keeps its own online-softmax state and accumulators and runs b12x's own S3/S4/S7 stages, so every written value is
+computed exactly as in the 16 + 8 grids at the same split count (bit-identical by construction; the GPU test checks
+it). The CTA count halves: rows x splits.
+
+Selection: ``FLARE_DS41_MLA_H24="9:0,80:1"`` (ROWS:0|1 pairs, first ``rows <= ROWS`` wins, rows above the last
+bound keep 16 + 8) wraps b12x's module-level ``_sparse_mla_decode_grid_flat_launch``. For a selected DSV41 BF16
+fused-mapping decode with 24 heads, the 16-head grid call launches the H24 kernel (same runtime argument tuple, so a
+prepared launch replays it through b12x's own ``run_compiled``) and the remainder call returns ``REMAINDER_DONE``, a
+launcher that launches nothing. The split count comes from the prepared launch (FLARE_DS41_MLA_DECODE_SPLITS
+applies unchanged). b12x's compile cache keys skip sources outside b12x, so the compile spec carries this file's
+SHA-256 and b12x's MLA source fingerprint explicitly.
+
+Shared memory (sm_120 opt-in limit 101376 B incl. the 1 KB the DSL reserves): Q 24 x 520 BF16 (24960), KV 2 x 64 x
+544 (69632), mbarriers, one softmax reduce scratch shared by both tiles (an extra named barrier separates them),
+token indices, P 16 x 72 + 8 x 72 BF16. b12x's FP8-W, W-scale, Q-scale, KV-scale and RoPE regions are unused on
+this path and dropped. 288 threads (8 math warps + 1 IO warp), one CTA per SM as before.
+"""
+
+import contextlib
+import functools
+import hashlib
+import inspect
+import os
+import threading
+from pathlib import Path
+
+ENV = "FLARE_DS41_MLA_H24"
+ENV_Q_ROPE = "FLARE_DS41_MLA_H24_Q_ROPE"
+_TARGET = "_sparse_mla_decode_grid_flat_launch"
+_ORIGINAL = "_flare_h24_original"
+_RUN_TARGET = "run_unified_decode"
+_RUN_ORIGINAL = "_flare_h24_run_original"
+_MERGE_TARGET = "run_sparse_mla_split_decode_merge"
+_MERGE_ORIGINAL = "_flare_h24_merge_original"
+KERNEL_ID = "flare.attention.mla.sm120.decode_h24"
+KERNEL_ID_ROPE = "flare.attention.mla.sm120.decode_h24_rope"
+KERNEL_VERSION = 1
+HEADS = 24
+SMEM_LIMIT = 101376 - 1024  # sm_120 opt-in per-block limit minus the DSL's static reservation
+
+# DSV41 BF16 geometry (b12x make_unified_traits(DSV41, BF16, NVFP4_E4M3)); asserted against b12x in check_traits.
+BI = 64
+KV_SMEM_STRIDE = 544
+Q_NOPE_STRIDE = 520
+D_NOPE = 512
+SM_P_STRIDE = 72
+N_V_CHUNKS = 8
+MATH_THREADS = 256
+BLOCK_THREADS = 288
+CAND_WINDOW = 64
+
+
+# ---------------------------------------------------------------------------------------------------------------
+# Policy
+# ---------------------------------------------------------------------------------------------------------------
+def parse_policy(text):
+    """``"9:0,80:1"`` -> ((9, False), (80, True)); empty/None -> (). Row bounds strictly increasing."""
+    if text is None or not text.strip():
+        return ()
+    pairs = []
+    for item in text.split(","):
+        rows, sep, value = item.strip().partition(":")
+        if not sep or value.strip() not in ("0", "1"):
+            raise ValueError(f"{ENV}: expected ROWS:0|1 pairs, got {item!r}")
+        rows = int(rows)
+        if rows < 1:
+            raise ValueError(f"{ENV}: rows must be positive, got {item!r}")
+        if pairs and rows <= pairs[-1][0]:
+            raise ValueError(f"{ENV}: row bounds must increase, got {text!r}")
+        pairs.append((rows, value.strip() == "1"))
+    if not any(on for _, on in pairs):
+        raise ValueError(f"{ENV}: {text!r} selects no row count; leave it unset instead")
+    return tuple(pairs)
+
+
+def format_policy(policy):
+    return ",".join(f"{rows}:{int(bool(on))}" for rows, on in policy)
+
+
+def policy_from_environment(env=None):
+    return parse_policy((os.environ if env is None else env).get(ENV))
+
+
+def selected(policy, rows):
+    for bound, on in policy:
+        if rows <= bound:
+            return on
+    return False
+
+
+# ---------------------------------------------------------------------------------------------------------------
+# Compile identity: b12x's cache key covers b12x sources only (source_dependencies skips other modules).
+# ---------------------------------------------------------------------------------------------------------------
+@functools.lru_cache(maxsize=1)
+def source_identity():
+    here = Path(__file__).resolve().parent
+    own = hashlib.sha256(b"".join((here / name).read_bytes() for name in ("mla_h24_decode.py", "mla_h24_kernel.py")))
+    own = own.hexdigest()
+    from b12x.attention._shared.mla import decode_math, io, kernel, smem, traits
+    base = hashlib.sha256()
+    for module in (kernel, decode_math, io, smem, traits):
+        base.update(Path(inspect.getsourcefile(module)).read_bytes())
+    return own, base.hexdigest()
+
+
+# ---------------------------------------------------------------------------------------------------------------
+# Kernel
+# ---------------------------------------------------------------------------------------------------------------
+def smem_offsets():
+    """(name, offset, bytes) of the H24 layout, mirroring mla_h24_kernel.storage_cls alignments (checked against it in tests)."""
+    def align(value, to):
+        return (value + to - 1) // to * to
+    regions = (("q", HEADS * Q_NOPE_STRIDE * 2, 128), ("kv", 2 * BI * KV_SMEM_STRIDE, 128), ("mbar", 32, 16),
+               ("reduce", 2 * 8 * HEADS * 4, 4), ("sm_p", 16 * SM_P_STRIDE * 2, 128),
+               ("sm_p2", 8 * SM_P_STRIDE * 2, 16))
+    out, offset = [], 0
+    for name, size, alignment in regions:
+        offset = align(offset, alignment)
+        out.append((name, offset, size))
+        offset += size
+    return tuple(out), align(offset, 128)
+
+
+def check_traits(traits):
+    from b12x.attention._shared.mla.traits import ComputeMode, ModelType, ScaleFormat
+    want = dict(model_type=ModelType.DSV41, compute_mode=ComputeMode.BF16, scale_format=ScaleFormat.NVFP4_E4M3,
+                d_nope=D_NOPE, d_rope=0, d_v=512, quant_tile=64, num_scales=8, n_v_chunks=N_V_CHUNKS,
+                nt_per_warp_xv=1, kv_smem_stride=KV_SMEM_STRIDE, q_nope_stride=Q_NOPE_STRIDE, bi=BI, hpb=16,
+                block_threads=BLOCK_THREADS, math_threads=MATH_THREADS, v_has_rope=False, has_extra_cache=True,
+                fp8_rope=False, latent_scale_per_token=False, fp8_internal=False)
+    have = {name: getattr(traits, name) for name in want}
+    if have != want:
+        raise ValueError(f"H24 decode needs DSV41 BF16 traits {want}, got {have}")
+    from b12x.attention._shared.mla.smem import make_smem_layout
+    layout = make_smem_layout(traits)
+    if (layout.sm_p_full_stride, layout.kv_bufs, layout.token_idx_buf_bytes) != (SM_P_STRIDE, 2, BI * 4):
+        raise ValueError("H24 decode: b12x DSV41 shared-memory strides changed")
+
+
+# b12x keys a CuTe program by its explicit spec *and* a fingerprint of the compiled function. Functions outside b12x get
+# compiler._function_fingerprint = sha256(inspect.getsource(inspect.unwrap(f))), which is not stable within a process:
+# CuTe's first real compile of a @cute.jit method rewrites the function's __code__ (decorator stripped, first line + 1),
+# so later getsource calls return other text. A planning process (no real compile yet) and a compile worker (after one)
+# then disagree on the key (E2 seq348: "factory program keys changed between planning and compilation"). For our kernel
+# module the fingerprint is the module file's bytes instead (the spec also carries flare_source).
+STABLE_FINGERPRINT_MODULES = (
+    "hyperflare_recipes.components.mla_h24_kernel",
+    "hyperflare_recipes.components.mla_h24_prefill_kernel",
+)
+
+
+@functools.lru_cache(maxsize=None)
+def _module_digest(module):
+    import sys
+    return hashlib.sha256(Path(sys.modules[module].__file__).read_bytes()).hexdigest()
+
+
+class _StableFingerprint:
+    def __init__(self, original):
+        self.original = original
+
+    def __call__(self, func):
+        target = inspect.unwrap(func)
+        module = getattr(target, "__module__", "") or ""
+        if module in STABLE_FINGERPRINT_MODULES:
+            qualname = getattr(target, "__qualname__", getattr(target, "__name__", type(target).__qualname__))
+            return module, qualname, _module_digest(module)
+        return self.original(func)
+
+
+def install_stable_fingerprint(compiler=None):
+    """Wrap b12x's compile-target fingerprint for our kernel module (idempotent). Returns the wrapper."""
+    if compiler is None:
+        from b12x._lib import compiler
+    current = compiler._function_fingerprint
+    if isinstance(current, _StableFingerprint):
+        return current
+    wrapper = _StableFingerprint(current)
+    compiler._function_fingerprint = wrapper
+    return wrapper
+
+
+_ROPE_STATE = threading.local()
+
+
+def current_q_rope_angles():
+    """Return the active thread-local Q-RoPE angles tensor (or ``None`` when unfused)."""
+    return getattr(_ROPE_STATE, "angles", None)
+
+
+@contextlib.contextmanager
+def q_rope_angles(angles):
+    """Scope an FP32 rotary angles tensor ``[rows, 64]`` (split) or ``[rows, 32, 2]`` for fused H24 Q-RoPE."""
+    prev = getattr(_ROPE_STATE, "angles", None)
+    _ROPE_STATE.angles = angles
+    try:
+        yield
+    finally:
+        _ROPE_STATE.angles = prev
+
+
+def _compile_time_angles(q, split_angles=True):
+    import torch
+    shape = (int(q.shape[0]), 64) if split_angles else (int(q.shape[0]), 32, 2)
+    return q.new_empty(shape, dtype=torch.float32)
+
+
+def q_rope_enabled_from_environment(env=None) -> bool:
+    return (os.environ if env is None else env).get(ENV_Q_ROPE, "").strip() == "1"
+
+
+def _normalize_angles(angles, rows):
+    """Validate and normalize optional FP32 rotary angles to ``(angles_2d, split_angles)``."""
+    if angles is None:
+        return None, True
+    import torch
+    from torch._subclasses.fake_tensor import FakeTensor
+
+    if angles.dtype != torch.float32 or int(angles.shape[0]) != int(rows):
+        raise ValueError(f"H24 fused Q-RoPE expects FP32 angles for {rows} rows, got {tuple(angles.shape)} {angles.dtype}")
+    if angles.ndim == 2 and int(angles.shape[1]) == 64:
+        if int(angles.stride(1)) != 1 or int(angles.stride(0)) % 4 != 0:
+            raise ValueError(f"H24 fused Q-RoPE requires 16B-aligned row stride and unit col stride, got {tuple(angles.stride())}")
+        angles_2d, split_angles = angles, True
+    elif angles.ndim == 3 and tuple(angles.shape[1:]) == (32, 2):
+        if not angles.is_contiguous():
+            raise ValueError("H24 fused Q-RoPE interleaved [rows, 32, 2] angles must be contiguous")
+        angles_2d, split_angles = angles.view(int(rows), 64), False
+    else:
+        raise ValueError(f"H24 fused Q-RoPE expects [rows, 64] or [rows, 32, 2] FP32 angles, got {tuple(angles.shape)}")
+    if not (isinstance(angles_2d, FakeTensor) or getattr(angles_2d, "is_meta", False)):
+        if int(angles_2d.data_ptr()) % 16 != 0:
+            raise ValueError("H24 fused Q-RoPE requires 16-byte aligned angles storage")
+    return angles_2d, split_angles
+
+
+def _decode_runtime_args(q_all, kv_flat, swa_indices, mid_out, mid_lse, swa_len_t, extra_kv_flat, extra_indices_t,
+                         extra_len_t, sm_scale, latent_scale, num_main_chunks, stride_kv_block, stride_extra_kv_block,
+                         indexed_page_table, indexed_num_pages, *, has_extra=True, angles_2d=None,
+                         output=None, attn_sink=None):
+    import cuda.bindings.driver as cuda
+    import cutlass
+    import torch
+    from cutlass import Float32, Int32, Int64
+    from b12x.attention._shared.mla.kernel import LOG2_E, _to_cute
+
+    rows = int(q_all.shape[0])
+    stream = cuda.CUstream(torch.cuda.current_stream().cuda_stream)
+    final_epilogue = output is not None
+    out_tensor = output if final_epilogue else mid_out
+    base = (_to_cute(q_all, cutlass.BFloat16, dynamic_layout=True),
+            _to_cute(kv_flat, cutlass.Uint8, align=16),
+            _to_cute(swa_indices, cutlass.Int32, align=4, dynamic_layout=True),
+            _to_cute(out_tensor, cutlass.BFloat16, align=16, dynamic_layout=True),
+            _to_cute(mid_lse, cutlass.Float32, align=4, dynamic_layout=True),
+            Float32(float(sm_scale) * LOG2_E), Float32(float(latent_scale)),
+            _to_cute(swa_len_t, cutlass.Int32, align=4, dynamic_layout=True), Int64(stride_kv_block))
+    if has_extra:
+        if indexed_page_table is None:
+            table_flat, table_width, table_stride = extra_indices_t.view(-1), -1, 0
+        else:
+            table_width, table_stride = int(indexed_page_table.shape[1]), int(indexed_page_table.stride(0))
+            table_flat = (extra_indices_t.view(-1) if table_width == 0
+                          else indexed_page_table.as_strided((table_width,), (1,)) if table_stride == 0
+                          else indexed_page_table.view(-1))
+        args = base + (
+            _to_cute(extra_kv_flat, cutlass.Uint8, align=16),
+            _to_cute(extra_indices_t, cutlass.Int32, align=4, dynamic_layout=True),
+            _to_cute(extra_len_t, cutlass.Int32, align=4, dynamic_layout=True),
+            Int32(num_main_chunks), Int64(stride_extra_kv_block),
+            _to_cute(table_flat, cutlass.Int32, align=4, dynamic_layout=True), Int32(table_width),
+            Int64(table_stride), Int64(indexed_num_pages),
+        )
+    else:
+        args = base
+    if angles_2d is not None:
+        args = args + (_to_cute(angles_2d, cutlass.Float32, align=16, dynamic_layout=True),)
+    if final_epilogue:
+        sink_t = attn_sink if attn_sink is not None else mid_lse[0, :, 0]
+        args = args + (_to_cute(sink_t, cutlass.Float32, align=4, dynamic_layout=(attn_sink is None)),)
+    return args + (Int32(rows), stream)
+
+
+def launch_h24(q_all, kv_flat, swa_indices, mid_out, mid_lse, swa_len_t, extra_kv_flat, extra_indices_t,
+               extra_len_t, sm_scale, latent_scale, swa_page_size, topk, extra_topk, num_main_chunks, num_splits,
+               chunks_per_split, stride_kv_block, pbs_extra, stride_extra_kv_block, indexed_page_table,
+               indexed_num_pages, *, has_extra=True, angles=None, output=None, attn_sink=None):
+    """Compile (or, in a compile-only scope, plan) and launch the H24 decode program.
+
+    When ``angles=None`` and ``output=None``, the runtime argument tuple matches b12x's ``call_mapped_extra_pertok``
+    (``has_extra=True``) or ``call_pertok`` (``has_extra=False``, SWA-only), so a prepared H24 program replays
+    directly through b12x. When ``output`` is provided with ``num_splits == 1``, ``H24DecodeKernel`` runs single-pass
+    ``EPILOGUE_FINAL_BF16`` directly into ``output`` (folding ``attn_sink`` and bypassing the split merge kernel).
+    When ``angles`` is provided (FP32 ``[rows, 64]`` split or ``[rows, 32, 2]`` interleaved), Q-RoPE on dims [448, 512)
+    is fused into ``s0_load_q24``.
+    """
+    from b12x._lib.compiler import DimKey, KernelCompileSpec, key_field, launch, tensor_key
+    from b12x.attention._shared.mla.kernel import _topk_bucket
+    from b12x.attention._shared.mla.traits import ComputeMode, ModelType, ScaleFormat, make_unified_traits
+
+    traits = make_unified_traits(ModelType.DSV41, ComputeMode.BF16, ScaleFormat.NVFP4_E4M3, fp8_rope=False)
+    rows = int(q_all.shape[0])
+    if tuple(q_all.shape[1:]) != (HEADS, D_NOPE) or int(q_all.stride(2)) != 1:
+        raise ValueError(f"H24 decode needs q (rows, 24, 512) with unit dim stride, got {tuple(q_all.shape)}")
+    has_extra = bool(has_extra)
+    final_epilogue = output is not None
+    if final_epilogue and int(num_splits) != 1:
+        raise ValueError(f"H24 final epilogue requires num_splits == 1, got {num_splits}")
+    has_sink = final_epilogue and attn_sink is not None
+    angles_2d, split_angles = _normalize_angles(angles, rows)
+    fuse_rope = angles_2d is not None
+    args = _decode_runtime_args(
+        q_all, kv_flat, swa_indices, mid_out, mid_lse, swa_len_t, extra_kv_flat, extra_indices_t,
+        extra_len_t, sm_scale, latent_scale, num_main_chunks, stride_kv_block, stride_extra_kv_block,
+        indexed_page_table, indexed_num_pages, has_extra=has_extra, angles_2d=angles_2d,
+        output=output, attn_sink=attn_sink)
+    from hyperflare_recipes.components.mla_h24_kernel import H24DecodeKernel
+    extra_stride0 = int(extra_indices_t.stride(0)) if has_extra and extra_indices_t is not None else 0
+    kernel = H24DecodeKernel(
+        traits, int(swa_page_size), int(chunks_per_split), int(num_splits), int(topk),
+        int(extra_topk) if has_extra else 0, tuple(q_all.stride()), int(swa_indices.stride(0)),
+        extra_stride0, tuple(mid_out.stride()), tuple(mid_lse.stride()),
+        int(pbs_extra) if has_extra else 1, has_extra=has_extra,
+        angles_stride0=int(angles_2d.stride(0)) if fuse_rope else 64,
+        split_angles=split_angles,
+        final_epilogue=final_epilogue,
+        has_sink=has_sink,
+        output_stride=tuple(output.stride()) if final_epilogue else (0, 0, 1))
+    own, base = source_identity()
+    spec_fields = [
+        key_field("flare_source", own), key_field("b12x_mla_source", base),
+        key_field("has_extra", int(has_extra)),
+        key_field("num_splits", int(num_splits)), key_field("chunks_per_split", int(chunks_per_split)),
+        key_field("page_block_size", int(swa_page_size)),
+        key_field("topk", int(topk)), key_field("topk_bucket", _topk_bucket(topk)),
+        key_field("latent_scale_identity", int(float(latent_scale) == 1.0)),
+        tensor_key("q_all", q_all, dims=(DimKey.dynamic(), DimKey.exact(HEADS), DimKey.exact(D_NOPE))),
+        tensor_key("swa_indices", swa_indices, dims=(DimKey.dynamic(), DimKey.bucket(topk))),
+        tensor_key("mid_lse", mid_lse, dims=(DimKey.dynamic(), DimKey.exact(HEADS), DimKey.bucket(num_splits))),
+        tensor_key("topk_length", swa_len_t, dims=(DimKey.dynamic(),)),
+    ]
+    if final_epilogue:
+        spec_fields.extend([
+            key_field("final_epilogue", 1),
+            key_field("has_sink", int(has_sink)),
+            tensor_key("output", output, dims=(DimKey.dynamic(), DimKey.exact(HEADS), DimKey.exact(512))),
+        ])
+    else:
+        spec_fields.append(
+            tensor_key("mid_out", mid_out, dims=(DimKey.dynamic(), DimKey.exact(HEADS), DimKey.bucket(num_splits),
+                                                 DimKey.exact(512))),
+        )
+    if has_extra:
+        spec_fields.extend([
+            key_field("pbs_extra", int(pbs_extra)),
+            key_field("extra_topk", int(extra_topk)),
+            tensor_key("extra_indices", extra_indices_t, dims=(DimKey.dynamic(), DimKey.bucket(max(extra_topk, 1)))),
+            tensor_key("extra_topk_length", extra_len_t, dims=(DimKey.dynamic(),)),
+        ])
+    if fuse_rope:
+        spec_fields.extend([
+            key_field("split_angles", int(split_angles)),
+            tensor_key("angles", angles_2d, dims=(DimKey.dynamic(), DimKey.exact(64))),
+        ])
+    spec = KernelCompileSpec.from_fields(KERNEL_ID_ROPE if fuse_rope else KERNEL_ID, KERNEL_VERSION, *spec_fields)
+    install_stable_fingerprint()
+    if final_epilogue:
+        if has_extra:
+            entry = kernel.call_mapped_extra_pertok_final_rope if fuse_rope else kernel.call_mapped_extra_pertok_final
+        else:
+            entry = kernel.call_pertok_final_rope if fuse_rope else kernel.call_pertok_final
+    elif has_extra:
+        entry = kernel.call_mapped_extra_pertok_rope if fuse_rope else kernel.call_mapped_extra_pertok
+    else:
+        entry = kernel.call_pertok_rope if fuse_rope else kernel.call_pertok
+    return launch(entry, compile_spec=spec, compile_args=args, runtime_args=args)
+
+
+# ---------------------------------------------------------------------------------------------------------------
+# Hook around b12x's grid launcher (and merge bypass for single-pass num_splits == 1)
+# ---------------------------------------------------------------------------------------------------------------
+class _RemainderDone:
+    """Prepared launcher for the remainder grid an H24 launch already covered: launches nothing. Callable (b12x's
+    run_compiled calls it with the runtime arguments when this hook is absent at replay) and carries no programs."""
+
+    __b12x_programs__ = ()
+    __b12x_dependencies__ = ()
+
+    def __call__(self, *args, **kwargs):
+        return None
+
+    def __repr__(self):
+        return "REMAINDER_DONE"
+
+
+class _MergeDone:
+    """Prepared merge launcher when H24 single-pass EPILOGUE_FINAL_BF16 already wrote final output: launches nothing."""
+
+    __b12x_programs__ = ()
+    __b12x_dependencies__ = ()
+
+    def __call__(self, *args, **kwargs):
+        return None
+
+    def __repr__(self):
+        return "MERGE_DONE"
+
+
+REMAINDER_DONE = _RemainderDone()
+MERGE_DONE = _MergeDone()
+
+_DECODE_CTX = threading.local()
+
+
+class _DecodeCallCtx:
+    __slots__ = ("output", "attn_sink", "return_lse", "prepared_final")
+
+    def __init__(self, output, attn_sink, return_lse, prepared_final):
+        self.output = output
+        self.attn_sink = attn_sink
+        self.return_lse = bool(return_lse)
+        self.prepared_final = bool(prepared_final)
+
+
+def _tensor_ptr(tensor):
+    from torch._subclasses.fake_tensor import FakeTensor
+    if isinstance(tensor, FakeTensor) or getattr(tensor, "is_meta", False):
+        return id(tensor)
+    try:
+        return int(tensor.data_ptr())
+    except Exception:
+        return id(tensor)
+
+
+def _is_h24_program(prepared):
+    return any(getattr(key, "name", "") == KERNEL_ID for key in getattr(prepared, "__b12x_programs__", ()) or ())
+
+
+def _is_h24_rope_program(prepared):
+    return any(getattr(key, "name", "") == KERNEL_ID_ROPE for key in getattr(prepared, "__b12x_programs__", ()) or ())
+
+
+class _RunUnifiedDecodeWrapper:
+    """Thread-local context carrier around b12x kernel.run_unified_decode for H24 single-pass final epilogue."""
+
+    def __init__(self, original):
+        self.original = original
+        self.signature = inspect.signature(original)
+
+    def __call__(self, *args, **kwargs):
+        bound = self.signature.bind(*args, **kwargs)
+        bound.apply_defaults()
+        a = bound.arguments
+        q_all = a.get("q_all")
+        out = a.get("out")
+        workspace = a.get("workspace")
+        output = out
+        if output is None and workspace is not None and getattr(workspace, "output_buffer", None) is not None and q_all is not None:
+            rows, heads = int(q_all.shape[0]), int(q_all.shape[1])
+            output = workspace.output_buffer.as_strided((rows, heads, D_NOPE), workspace.output_buffer.stride())
+        prepared = a.get("prepared")
+        merge_prog = getattr(prepared, "merge_program", None) if prepared is not None else None
+        prepared_final = merge_prog is MERGE_DONE or isinstance(merge_prog, _MergeDone)
+        prev = getattr(_DECODE_CTX, "state", None)
+        _DECODE_CTX.state = _DecodeCallCtx(output, a.get("attn_sink"), a.get("return_lse", False), prepared_final)
+        try:
+            return self.original(*args, **kwargs)
+        finally:
+            _DECODE_CTX.state = prev
+
+
+class _MergeBypassWrapper:
+    """Skips SparseMLASplitDecodeSinkMergeKernel when H24DecodeKernel already ran single-pass EPILOGUE_FINAL_BF16."""
+
+    def __init__(self, original, h24_launch):
+        self.original = original
+        self.h24_launch = h24_launch
+        self.signature = inspect.signature(original)
+
+    def __call__(self, *args, **kwargs):
+        bound = self.signature.bind(*args, **kwargs)
+        bound.apply_defaults()
+        a = bound.arguments
+        prepared = a.get("_prepared")
+        if prepared is MERGE_DONE or isinstance(prepared, _MergeDone):
+            return None
+        if prepared is None:
+            binding = a.get("binding")
+            tmp_output = binding.tmp_output if binding is not None else a.get("tmp_output")
+            if tmp_output is not None and self.h24_launch.consume_merge_skip(tmp_output):
+                return MERGE_DONE
+        return self.original(*args, **kwargs)
+
+
+class _H24Launch:
+    """Replacement for kernel._sparse_mla_decode_grid_flat_launch; delegates every call it does not take over."""
+
+    def __init__(self, inner, real, policy, launcher=launch_h24, *, fuse_q_rope=False, split_angles=True):
+        self.inner = inner          # what was installed before (e.g. the remainder-stream wrapper)
+        self.real = real            # b12x's own launcher (runs a prepared H24 program without a stream fork)
+        self.policy = tuple(policy)
+        self.launcher = launcher
+        self.fuse_q_rope = bool(fuse_q_rope)
+        self.split_angles = bool(split_angles)
+        self.signature = inspect.signature(real)
+        self.pending = {}           # device index -> (q ptr, mid_out ptr) of an H24 launch awaiting its remainder call
+        self.pending_merge = {}     # device index -> mid_out ptr of an H24 single-pass launch awaiting its merge call
+        self.applied = []           # (rows, num_splits) per H24 launch, for logs and tests
+        self.replays = 0            # prepared H24 programs run (eager or captured), for the bench's self-check
+
+    def consume_merge_skip(self, tmp_output) -> bool:
+        index = getattr(getattr(tmp_output, "device", None), "index", None)
+        expected = self.pending_merge.get(index)
+        if expected is not None and expected == _tensor_ptr(tmp_output):
+            del self.pending_merge[index]
+            return True
+        return False
+
+    def _eligible(self, a):
+        q = a["q_all"]
+        return (int(q.shape[1]) == HEADS and int(a["model_type"]) == 3 and int(a["compute_mode"]) == 1
+                and int(a["scale_format"]) == 2 and not a["fp8_rope"] and a["per_token_len"]
+                and not a["latent_scale_per_token"] and not a["v41_fp8_internal"]
+                and int(a["v41_heads_per_block"]) == 16 and int(a["topk"]) > 0
+                and (not a["has_extra"] or int(a["extra_topk"]) > 0)
+                and selected(self.policy, int(q.shape[0])))
+
+    @staticmethod
+    def _identity(a):
+        q = a["q_all"]
+        index = getattr(getattr(q, "device", None), "index", None)
+        return index, (_tensor_ptr(q), _tensor_ptr(a["mid_out"]))
+
+    def __call__(self, *args, **kwargs):
+        bound = self.signature.bind(*args, **kwargs)
+        bound.apply_defaults()
+        a = bound.arguments
+        prepared = a.get("_prepared")
+        if prepared is REMAINDER_DONE or isinstance(prepared, _RemainderDone):
+            return None
+        ctx = getattr(_DECODE_CTX, "state", None)
+        if prepared is not None and ctx is not None and ctx.prepared_final:
+            from b12x._lib.compiler import run_compiled
+            if _is_h24_rope_program(prepared):
+                angles = current_q_rope_angles()
+                if angles is None:
+                    raise RuntimeError("H24 RoPE-fused decode replay requires active mla_h24_decode.q_rope_angles(angles)")
+                angles_2d, _ = _normalize_angles(angles, int(a["q_all"].shape[0]))
+            elif _is_h24_program(prepared):
+                if current_q_rope_angles() is not None:
+                    raise RuntimeError("H24 decode: q_rope_angles is active during replay of a non-RoPE prepared program")
+                angles_2d = None
+            else:
+                return self.inner(*args, **kwargs)
+            runtime_args = _decode_runtime_args(
+                a["q_all"], a["kv_flat"], a["swa_indices"], a["mid_out"], a["mid_lse"], a["swa_len_t"],
+                a["extra_kv_flat"], a["extra_indices_t"], a["extra_len_t"], a["sm_scale"], a["latent_scale"],
+                a["num_main_chunks"], a["stride_kv_block"], a["stride_extra_kv_block"],
+                a["indexed_page_table"], a["indexed_num_pages"],
+                has_extra=bool(a["has_extra"]), angles_2d=angles_2d,
+                output=ctx.output, attn_sink=ctx.attn_sink)
+            self.replays += 1
+            return run_compiled(prepared, runtime_args)
+        if prepared is not None and _is_h24_rope_program(prepared):
+            from b12x._lib.compiler import run_compiled
+            angles = current_q_rope_angles()
+            if angles is None:
+                raise RuntimeError("H24 RoPE-fused decode replay requires active mla_h24_decode.q_rope_angles(angles)")
+            angles_2d, _ = _normalize_angles(angles, int(a["q_all"].shape[0]))
+            runtime_args = _decode_runtime_args(
+                a["q_all"], a["kv_flat"], a["swa_indices"], a["mid_out"], a["mid_lse"], a["swa_len_t"],
+                a["extra_kv_flat"], a["extra_indices_t"], a["extra_len_t"], a["sm_scale"], a["latent_scale"],
+                a["num_main_chunks"], a["stride_kv_block"], a["stride_extra_kv_block"],
+                a["indexed_page_table"], a["indexed_num_pages"],
+                has_extra=bool(a["has_extra"]), angles_2d=angles_2d)
+            self.replays += 1
+            return run_compiled(prepared, runtime_args)
+        if prepared is not None and _is_h24_program(prepared):
+            if current_q_rope_angles() is not None:
+                raise RuntimeError("H24 decode: q_rope_angles is active during replay of a non-RoPE prepared program")
+            self.replays += 1
+            return self.real(*args, **kwargs)  # b12x builds the identical runtime tuple and runs our program
+        if prepared is None and int(a["head_block_offset"]) == 0:
+            self.pending_merge.pop(getattr(getattr(a["q_all"], "device", None), "index", None), None)
+        if prepared is not None or not self._eligible(a):
+            if prepared is not None and current_q_rope_angles() is not None:
+                raise RuntimeError("H24 decode: q_rope_angles is active during replay of a non-H24 prepared program")
+            # A prepared b12x program (rows not selected when it was prepared) replays through b12x unchanged.
+            return self.inner(*args, **kwargs)
+        offset, blocks, valid = int(a["head_block_offset"]), int(a["grid_h_blocks"]), int(a["valid_hpb"])
+        index, identity = self._identity(a)
+        if (offset, blocks, valid) == (0, 1, 16):
+            angles = current_q_rope_angles()
+            if angles is None and self.fuse_q_rope:
+                angles = _compile_time_angles(a["q_all"], self.split_angles)
+            kw = {}
+            if not a["has_extra"]:
+                kw["has_extra"] = False
+            if angles is not None:
+                kw["angles"] = angles
+            use_final = (
+                int(a["num_splits"]) == 1
+                and ctx is not None
+                and not ctx.return_lse
+                and ctx.output is not None
+                and int(ctx.output.stride(2)) == 1
+                and int(ctx.output.stride(1)) == D_NOPE
+            )
+            if use_final:
+                kw["output"] = ctx.output
+                kw["attn_sink"] = ctx.attn_sink
+            launched = self.launcher(
+                a["q_all"], a["kv_flat"], a["swa_indices"], a["mid_out"], a["mid_lse"], a["swa_len_t"],
+                a["extra_kv_flat"], a["extra_indices_t"], a["extra_len_t"], a["sm_scale"], a["latent_scale"],
+                a["swa_page_size"], a["topk"], a["extra_topk"], a["num_main_chunks"], a["num_splits"],
+                a["chunks_per_split"], a["stride_kv_block"], a["pbs_extra"], a["stride_extra_kv_block"],
+                a["indexed_page_table"], a["indexed_num_pages"], **kw)
+            self.pending[index] = identity
+            if use_final:
+                self.pending_merge[index] = identity[1]
+            self.applied.append((int(a["q_all"].shape[0]), int(a["num_splits"])))
+            return launched
+        if (offset, blocks, valid) == (1, 1, 8) and self.pending.get(index) == identity:
+            del self.pending[index]
+            return REMAINDER_DONE
+        raise RuntimeError(f"H24 decode: unexpected grid call (offset {offset}, blocks {blocks}, valid {valid}) "
+                           "for a selected 24-head decode")
+
+
+def _kernel_module():
+    from b12x.attention._shared.mla import kernel
+    return kernel
+
+
+def _merge_module():
+    from b12x.attention._shared.mla import merge
+    return merge
+
+
+def install(policy, kernel=None, launcher=launch_h24, *, fuse_q_rope=False, split_angles=True, merge=None):
+    """Wrap b12x's grid launcher with ``policy`` (outermost; replaces an earlier H24 wrapper). Returns the wrapper."""
+    default_kernel = kernel is None
+    kernel = _kernel_module() if default_kernel else kernel
+    current = getattr(kernel, _TARGET)
+    inner = current.inner if isinstance(current, _H24Launch) else current
+    real = getattr(kernel, "_flare_remainder_stream_original", None) or inner
+    wrapper = _H24Launch(inner, real, policy, launcher, fuse_q_rope=fuse_q_rope, split_angles=split_angles)
+    setattr(kernel, _ORIGINAL, inner)
+    setattr(kernel, _TARGET, wrapper)
+    if hasattr(kernel, _RUN_TARGET):
+        cur_run = getattr(kernel, _RUN_TARGET)
+        orig_run = cur_run.original if isinstance(cur_run, _RunUnifiedDecodeWrapper) else cur_run
+        setattr(kernel, _RUN_ORIGINAL, orig_run)
+        setattr(kernel, _RUN_TARGET, _RunUnifiedDecodeWrapper(orig_run))
+    if merge is None and default_kernel:
+        merge = _merge_module()
+    if merge is not None and hasattr(merge, _MERGE_TARGET):
+        cur_merge = getattr(merge, _MERGE_TARGET)
+        orig_merge = cur_merge.original if isinstance(cur_merge, _MergeBypassWrapper) else cur_merge
+        setattr(merge, _MERGE_ORIGINAL, orig_merge)
+        setattr(merge, _MERGE_TARGET, _MergeBypassWrapper(orig_merge, wrapper))
+    from . import mla_discovery_key  # the H24 program is ours: key b12x's persisted discovery to policy and source
+    mla_discovery_key.install()
+    install_stable_fingerprint()
+    return wrapper
+
+
+def uninstall(kernel=None, merge=None):
+    default_kernel = kernel is None
+    kernel = _kernel_module() if default_kernel else kernel
+    original = getattr(kernel, _ORIGINAL, None)
+    if original is not None:
+        setattr(kernel, _TARGET, original)
+        delattr(kernel, _ORIGINAL)
+    orig_run = getattr(kernel, _RUN_ORIGINAL, None)
+    if orig_run is not None:
+        setattr(kernel, _RUN_TARGET, orig_run)
+        delattr(kernel, _RUN_ORIGINAL)
+    if merge is None and default_kernel:
+        merge = _merge_module()
+    if merge is not None:
+        orig_merge = getattr(merge, _MERGE_ORIGINAL, None)
+        if orig_merge is not None:
+            setattr(merge, _MERGE_TARGET, orig_merge)
+            delattr(merge, _MERGE_ORIGINAL)
+
+
+def install_from_environment():
+    """Install only when a policy is set, so the default leaves b12x exactly as shipped."""
+    policy = policy_from_environment()
+    if policy:
+        fuse_rope = q_rope_enabled_from_environment()
+        wrapper = install(policy, fuse_q_rope=fuse_rope)
+        rope_msg = " + fused Q-RoPE" if fuse_rope else ""
+        print(f"[flare] {ENV}={format_policy(policy)}: DSV41 24-head one-launch decode{rope_msg} installed "
+              f"(pid {os.getpid()})", flush=True)
+        return wrapper
+    return None
+
+
+def installed_policy(kernel=None):
+    kernel = _kernel_module() if kernel is None else kernel
+    current = getattr(kernel, _TARGET)
+    return current.policy if isinstance(current, _H24Launch) else ()
+
+
+def will_fuse_q_rope(rows, kernel=None) -> bool:
+    """Return True if H24 decode with fused Q-RoPE is installed and selects ``rows``."""
+    kernel = _kernel_module() if kernel is None else kernel
+    current = getattr(kernel, _TARGET)
+    return isinstance(current, _H24Launch) and current.fuse_q_rope and selected(current.policy, int(rows))
