+@cute.jit
+def s7_epilogue_h24(
+    acc0_frag: cute.Tensor,
+    acc1_frag: cute.Tensor,
+    gmax0: Float32,
+    gmax1: Float32,
+    gmax2: Float32,
+    gsum0: Float32,
+    gsum1: Float32,
+    gsum2: Float32,
+    out_o: cute.Tensor,
+    out_lse: cute.Tensor,
+    warp_id: Int32,
+    lane: Int32,
+    tid_flat: Int32,
+    staging_base_addr: Int32,
+    *,
+    out_stride_head: cutlass.Constexpr,
+    epilogue_mode: cutlass.Constexpr = EPILOGUE_PARTIAL_WRITEBACK,
+    has_attn_sink: cutlass.Constexpr = False,
+    attn_sink=None,
+    fast_rcp: cutlass.Constexpr = False,
+    coalesced_output: cutlass.Constexpr = True,
+):
+    """Single-pass 24-head S7 epilogue: stages all 24 x 512 BF16 (24 KB) in kv_addr with st.shared.u32,
+    1 bar.sync (instead of 3), and exact 6 v4 global stores/thread, plus 24-head base-2 LSE writeback.
+    """
+    gid = lane >> Int32(2)
+    tid = lane & Int32(3)
+
+    inv_g0 = Float32(0.0)
+    inv_g1 = Float32(0.0)
+    inv_g2 = Float32(0.0)
+    sink0 = Float32(0.0)
+    sink1 = Float32(0.0)
+    sink2 = Float32(0.0)
+    if cutlass.const_expr(epilogue_mode == EPILOGUE_FINAL_BF16 and has_attn_sink):
+        sink0 = Float32(attn_sink[gid]) * Float32(LOG2_E)
+        sink1 = Float32(attn_sink[gid + Int32(8)]) * Float32(LOG2_E)
+        sink2 = Float32(attn_sink[gid + Int32(16)]) * Float32(LOG2_E)
+        denom0 = gsum0 + _exp2_approx_ftz_f32(sink0 - gmax0)
+        denom1 = gsum1 + _exp2_approx_ftz_f32(sink1 - gmax1)
+        denom2 = gsum2 + _exp2_approx_ftz_f32(sink2 - gmax2)
+        if denom0 != Float32(0.0):
+            inv_g0 = rcp_approx_ftz(denom0) if cutlass.const_expr(fast_rcp) else Float32(1.0) / denom0
+        if denom1 != Float32(0.0):
+            inv_g1 = rcp_approx_ftz(denom1) if cutlass.const_expr(fast_rcp) else Float32(1.0) / denom1
+        if denom2 != Float32(0.0):
+            inv_g2 = rcp_approx_ftz(denom2) if cutlass.const_expr(fast_rcp) else Float32(1.0) / denom2
+    else:
+        if gsum0 != Float32(0.0):
+            inv_g0 = rcp_approx_ftz(gsum0) if cutlass.const_expr(fast_rcp) else Float32(1.0) / gsum0
+        if gsum1 != Float32(0.0):
+            inv_g1 = rcp_approx_ftz(gsum1) if cutlass.const_expr(fast_rcp) else Float32(1.0) / gsum1
+        if gsum2 != Float32(0.0):
+            inv_g2 = rcp_approx_ftz(gsum2) if cutlass.const_expr(fast_rcp) else Float32(1.0) / gsum2
+
+    for vc in cutlass.range_constexpr(N_V_CHUNKS):
+        d0 = Int32(vc * 64) + warp_id * Int32(8) + tid * Int32(2)
+        if cutlass.const_expr(coalesced_output):
+            st_shared_bf16x2_from_f32(
+                staging_base_addr + (gid * Int32(D_NOPE) + d0) * Int32(2),
+                acc0_frag[vc * 4 + 0] * inv_g0,
+                acc0_frag[vc * 4 + 1] * inv_g0,
+            )
+            st_shared_bf16x2_from_f32(
+                staging_base_addr + ((gid + Int32(8)) * Int32(D_NOPE) + d0) * Int32(2),
+                acc0_frag[vc * 4 + 2] * inv_g1,
+                acc0_frag[vc * 4 + 3] * inv_g1,
+            )
+            st_shared_bf16x2_from_f32(
+                staging_base_addr + ((gid + Int32(16)) * Int32(D_NOPE) + d0) * Int32(2),
+                acc1_frag[vc * 2 + 0] * inv_g2,
+                acc1_frag[vc * 2 + 1] * inv_g2,
+            )
+        else:
+            store_bf16x2(
+                get_ptr_as_int64(out_o, cute.crd2idx((gid, d0), out_o.layout)),
+                acc0_frag[vc * 4 + 0] * inv_g0,
+                acc0_frag[vc * 4 + 1] * inv_g0,
+            )
+            store_bf16x2(
+                get_ptr_as_int64(out_o, cute.crd2idx((gid + Int32(8), d0), out_o.layout)),
+                acc0_frag[vc * 4 + 2] * inv_g1,
+                acc0_frag[vc * 4 + 3] * inv_g1,
+            )
+            store_bf16x2(
+                get_ptr_as_int64(out_o, cute.crd2idx((gid + Int32(16), d0), out_o.layout)),
+                acc1_frag[vc * 2 + 0] * inv_g2,
+                acc1_frag[vc * 2 + 1] * inv_g2,
+            )
+
+    if cutlass.const_expr(coalesced_output):
+        cute.arch.barrier(barrier_id=3, number_of_threads=MATH_THREADS)
+        pack = tid_flat & Int32(63)
+        h0 = tid_flat >> Int32(6)
+        d8 = pack * Int32(8)
+        for step in cutlass.range_constexpr((HEADS * (D_NOPE // 8)) // MATH_THREADS):
+            h = h0 + Int32(step * 4)
+            v0, v1, v2, v3 = ld_shared_v4_u32(staging_base_addr + (h * Int32(D_NOPE) + d8) * Int32(2))
+            st_global_v4_u32(
+                get_ptr_as_int64(out_o, h.to(Int64) * Int64(out_stride_head) + d8.to(Int64)),
+                v0, v1, v2, v3,
+            )
+
+    if warp_id == Int32(0) and tid == Int32(0):
+        lse0 = Float32(_NEG_INF)
+        lse1 = Float32(_NEG_INF)
+        lse2 = Float32(_NEG_INF)
+        if gsum0 != Float32(0.0):
+            lse0 = _log2_approx_ftz_f32(gsum0) + gmax0
+        if gsum1 != Float32(0.0):
+            lse1 = _log2_approx_ftz_f32(gsum1) + gmax1
+        if gsum2 != Float32(0.0):
+            lse2 = _log2_approx_ftz_f32(gsum2) + gmax2
+        if cutlass.const_expr(epilogue_mode == EPILOGUE_FINAL_BF16 and has_attn_sink):
+            m0 = fmax_f32(lse0, sink0)
+            lse0 = m0 + _log2_approx_ftz_f32(_exp2_approx_ftz_f32(lse0 - m0) + _exp2_approx_ftz_f32(sink0 - m0))
+            m1 = fmax_f32(lse1, sink1)
+            lse1 = m1 + _log2_approx_ftz_f32(_exp2_approx_ftz_f32(lse1 - m1) + _exp2_approx_ftz_f32(sink1 - m1))
+            m2 = fmax_f32(lse2, sink2)
+            lse2 = m2 + _log2_approx_ftz_f32(_exp2_approx_ftz_f32(lse2 - m2) + _exp2_approx_ftz_f32(sink2 - m2))
+        out_lse[gid] = lse0
+        out_lse[gid + Int32(8)] = lse1
+        out_lse[gid + Int32(16)] = lse2
+
+
+class H24DecodeKernel:
+    """DSV41 BF16 decode for 24 heads in one CTA per (row, split): SWA-only and dual-cache, optional fused Q-RoPE.
+
+    When ``final_epilogue=True`` (``num_splits == 1``), folds ``attn_sink`` directly in ``s7_epilogue`` with
+    ``EPILOGUE_FINAL_BF16`` and ``coalesced_output=True`` (staging via ``kv_addr``), writing final BF16 output
+    and bypassing ``mid_out``/``SparseMLASplitDecodeSinkMergeKernel`` completely.
+    """
+
+    def __init__(self, traits, page_block_size, chunks_per_split, num_splits, topk, extra_topk, q_stride,
+                 swa_indices_stride0, extra_indices_stride0, mid_out_stride, mid_lse_stride, pbs_extra, *,
+                 has_extra=True, angles_stride0=64, split_angles=True, final_epilogue=False, has_sink=False,
+                 output_stride=(0, 0, 1)):
+        check_traits(traits)
+        self.traits = traits
+        self.page_block_size = int(page_block_size)
+        self.chunks_per_split = int(chunks_per_split)
+        self.num_splits = int(num_splits)
+        self.topk = int(topk)
+        self.has_extra = bool(has_extra)
+        self.extra_topk = int(extra_topk) if self.has_extra else 0
+        if self.topk <= 0:
+            raise ValueError("H24 decode needs topk > 0")
+        if self.has_extra and self.extra_topk <= 0:
+            raise ValueError("H24 dual-cache decode needs extra_topk > 0")
+        self.q_stride_row, self.q_stride_head, self.q_stride_dim = (int(v) for v in q_stride)
+        self.swa_indices_stride_row = int(swa_indices_stride0)
+        self.extra_indices_stride_row = int(extra_indices_stride0)
+        self.final_epilogue = bool(final_epilogue)
+        self.has_sink = bool(has_sink)
+        if self.final_epilogue:
+            self.output_stride_row, self.output_stride_head, self.output_stride_dim = (int(v) for v in output_stride)
+            self.mid_out_stride_row = self.mid_out_stride_head = self.mid_out_stride_split = 0
+            self.mid_out_stride_dim = 1
+        else:
+            (self.mid_out_stride_row, self.mid_out_stride_head, self.mid_out_stride_split,
+             self.mid_out_stride_dim) = (int(v) for v in mid_out_stride)
+            self.output_stride_row = self.output_stride_head = 0
+            self.output_stride_dim = 1
+        self.mid_lse_stride_row, self.mid_lse_stride_head, self.mid_lse_stride_split = (
+            int(v) for v in mid_lse_stride)
+        self.pbs_extra = int(pbs_extra)
+        self.angles_stride_row = int(angles_stride0)
+        self.split_angles = bool(split_angles)
