+
+@triton.jit
+def _publish_single_row(Slots, Leader, Record, Idle, Frame, Extent, SurvivalIn, Counters, Offset, Epoch,
+                        Consumed, Generated, Pending, Status, Error, RngCounter, TargetOffset, RngGeneration,
+                        Histogram, Records, Survival, BATCH: tl.constexpr, CAPACITY: tl.constexpr,
+                        WIDTH: tl.constexpr, TOKEN_CAP: tl.constexpr, FIELDS: tl.constexpr, VOCAB: tl.constexpr,
+                        CONSUMED_STRIDE: tl.constexpr, BLOCK: tl.constexpr, COUNT: tl.constexpr,
+                        TOKEN: tl.constexpr, IDS: tl.constexpr):
+    slot = tl.program_id(0)
+    lane = tl.arange(0, BLOCK)
+    if BATCH == 1:
+        owned = (slot == tl.load(Slots)) & tl.load(Leader).to(tl.int1)
+        source = 0
+    else:
+        r = tl.arange(0, BATCH)
+        match = (tl.load(Slots + r) == slot) & tl.load(Leader + r).to(tl.int1)
+        owned = tl.sum(match.to(tl.int32), 0) != 0
+        source = tl.sum(tl.where(match, r, 0), 0)
+    frame_slot = tl.load(Frame) * CAPACITY + slot
+    rec_base = Record + source * FIELDS
+    field = tl.load(rec_base + lane, lane < FIELDS, other=0)
+    idle = tl.load(Idle + lane, lane < FIELDS, other=0)
+    tl.store(Records + frame_slot * FIELDS + lane, tl.where(owned, field, idle), lane < FIELDS)
+    if WIDTH > 1:
+        observed = owned & (lane < WIDTH - 1) & (lane < tl.load(Extent + source))
+        survival = tl.load(SurvivalIn + source * (WIDTH - 1) + lane, observed, other=-1.0)
+    else:
+        survival = tl.full((BLOCK,), -1.0, tl.float32)
+    tl.store(Survival + frame_slot * (TOKEN_CAP - 1) + lane, survival, lane < TOKEN_CAP - 1)
+    if owned:
+        # State and the completion frame consume the same clipped prefix and status.
+        emitted = tl.load(rec_base + COUNT)
+        tl.store(Consumed + slot * CONSUMED_STRIDE, tl.load(rec_base + 2))
+        tl.store(Generated + slot, tl.load(rec_base + 3))
+        if emitted > 0:
+            tl.store(Pending + slot, tl.load(rec_base + TOKEN))
+        tl.store(Status + slot, tl.load(rec_base + 5))
+        tl.store(Error + slot, tl.load(rec_base + 6))
+        tl.store(RngCounter + slot, tl.load(Counters + source))
+        tl.store(TargetOffset + slot, tl.load(Offset + source))
+        tl.store(RngGeneration + slot, tl.load(Epoch + source))
+        token = tl.load(rec_base + IDS + lane, lane < emitted, other=0)
+        # A prefix can contain the same token more than once.
+        tl.atomic_add(Histogram + slot * VOCAB + token, 1, mask=lane < emitted, sem="relaxed")
+
+
+class PreparedSingleRowPublication:
+    """Bind a verification commit (batch in {1, 2, 4, 8, 16}) to the two persistent completion frames."""
+
+    @staticmethod
+    def supports(commit):
+        s = commit.state
+        return (commit.inputs.device.type == "cuda" and commit.inputs.shape[0] in (1, 2, 4, 8, 16)
+                and s.capacity == 16 and commit.token_capacity == 6 and 1 <= commit.inputs.shape[1] <= 6
+                and commit.history is None and commit.rng is not None and commit.survival is not None
+                # Each slot's row offset is computed in signed int32 before pointer addition.
+                and (s.capacity - 1) * max(s.vocab_size, s.consumed_tokens.stride(0)) < 1 << 31
+                and s.rng_counter.shape == (s.capacity,) and all(t.is_contiguous() for t in (
+                    s.generated_tokens, s.pending_token, s.status, s.error_code, s.rng_counter, s.histogram,
+                    commit.survival, commit.acceptance.survival))
+                and torch.cuda.get_device_capability(commit.inputs.device) == (12, 0))
+
+    def __init__(self, commit):
+        s = commit.state
+        batch = commit.inputs.shape[0]
+        self.grid = (s.capacity, 1, 1)
+        fields = commit.records.shape[-1]
+        self.options = dict(BATCH=batch, CAPACITY=s.capacity, WIDTH=commit.inputs.shape[1],
+                            TOKEN_CAP=commit.token_capacity, FIELDS=fields, VOCAB=s.vocab_size,
+                            CONSUMED_STRIDE=s.consumed_tokens.stride(0), BLOCK=triton.next_power_of_2(fields),
+                            COUNT=EMITTED_COUNT_FIELD, TOKEN=TOKEN_FIELD, IDS=VECTOR_TOKENS_FIELD, num_warps=1)
+        self.frame = commit.frame
+        self.destinations = (s.consumed_tokens, s.generated_tokens, s.pending_token, s.status, s.error_code,
+                             s.rng_counter.view(torch.int64), commit.rng.target_offset, commit.rng.generation,
+                             s.histogram, commit.records, commit.survival)
+        scalar = commit.consumed_before
+        examples = (commit.slots, commit.acceptance.valid, commit._records[:batch], commit.idle_record, self.frame,
+                    scalar, commit.acceptance.survival, scalar, scalar, scalar, *self.destinations)
+        self.compiled = warmup_triton(_publish_single_row, examples, self.grid, **self.options)
+
+    def __call__(self, slots, leader, record, idle, extent, survival, counters, offset, epoch):
+        args = (slots, leader, record, idle, self.frame, extent, survival, counters, offset, epoch, *self.destinations)
+        launch_triton(_publish_single_row, self.compiled, args, self.grid, **self.options)
