+int64_t inbox_bytes() { return 2L * 2 * PUSH_SLOTS * PUB_SLOT * sizeof(__nv_bfloat16); }
+#else
+int64_t inbox_bytes() { return 2L * 2 * 2 * PUB_SLOT * sizeof(__nv_bfloat16); }
