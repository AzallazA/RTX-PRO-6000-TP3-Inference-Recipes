+                    cons_phase ^= Int32(1)
+
+            # Single-pass 24-head S7 epilogue (1 barrier instead of 3): either EPILOGUE_FINAL_BF16
+            # directly to output (num_splits == 1) or PARTIAL_WRITEBACK into mid_out/mid_lse.
+            if cutlass.const_expr(final_epilogue):
