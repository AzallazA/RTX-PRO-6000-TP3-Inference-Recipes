+                                    latent_scale, ci < num_main_chunks)
+                else:
+                    _pv_pair_inplace(accn, accn2, sm_p_addr, sm_p2_addr, kv_b, warp_id, lane,
+                                     latent_scale, known_swa=True)
+
+                cute.arch.barrier(barrier_id=3, number_of_threads=MATH_THREADS)
+                if tid == Int32(0):
